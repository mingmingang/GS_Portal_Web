                    { title: "Surat Jaminan", icon: "location_city", iconType: "MaterialIcons", color: "#C9E6C1", url: "@Url.Action("ManageSuratJaminanKaryawan", "Manage")" },
                    { title: "Lembur", icon: "account_balance_wallet", iconType: "MaterialIcons", color: "#E8D4AE", url: "@Url.Action("ManageOvertimeKaryawan", "Manage")" },
                    { title: "Reimburse", icon: "credit-card", iconType: "FontAwesome", color: "#C9E6E3", url: "@Url.Action("ManageReimbursementKaryawan", "Manage")" },
                    { title: "Request", icon: "local_cafe", iconType: "MaterialIcons", color: "#B4F1EE", url: "@Url.Action("ManagePermintaanBerkasKaryawan", "Manage")" },
                ],
                'HC': [
                    { title: "Absensi", icon: "home", iconType: "MaterialIcons", color: "#BFD7FF",url: "@Url.Action("ManageKehadiranKaryawan", "Manage")"},
                    { title: "Aktivitas", icon: "access_time", iconType: "MaterialIcons", color: "#F5D2B3", url: "@Url.Action("ManageKehadiranKaryawan", "Manage")" },
                    { title: "IMP", icon: "directions_walk", iconType: "MaterialIcons", color: "#FBE59D", url: "@Url.Action("ManageIMPAtasanAndHC1", "Manage")" },
                    { title: "Cuti", icon: "calendar_today", iconType: "MaterialIcons", color: "#F5C6C6", url: "@Url.Action("ManageCutiHC1", "Manage")" },
                    { title: "Lembur", icon: "account_balance_wallet", iconType: "MaterialIcons", color: "#E8D4AE", url: "@Url.Action("ManageOvertimeHc", "Manage")"  },
                    { title: "Jaminan", icon: "location_city", iconType: "MaterialIcons", color: "#C9E6C1", url: "#" },
                    { title: "Reimburse", icon: "credit-card", iconType: "FontAwesome", color: "#C9E6E3", url: "@Url.Action("ManageReimbursementKaryawan", "Manage")" },
                    { title: "Request", icon: "local_cafe", iconType: "MaterialIcons", color: "#B4F1EE", url: "@Url.Action("ManagePermintaanBerkasHC", "Manage")" },
                ],
                'Atasan': [
                    { title: "Absensi", icon: "home", iconType: "MaterialIcons", color: "#BFD7FF", url: "@Url.Action("ManageKehadiranKaryawan", "Manage")" },
                    { title: "Aktivitas", icon: "access_time", iconType: "MaterialIcons", color: "#F5D2B3", url: "@Url.Action("ListManageActivityMarketing", "Manage")" },
                    { title: "IMP", icon: "directions_walk", iconType: "MaterialIcons", color: "#FBE59D", url: "@Url.Action("ManageIMPAtasanAndHC1", "Manage")" },
                    { title: "Cuti", icon: "calendar_today", iconType: "MaterialIcons", color: "#F5C6C6", url: "@Url.Action("ManageCutiAtasan", "Manage")" },
                    { title: "Lembur", icon: "account_balance_wallet", iconType: "MaterialIcons", color: "#E8D4AE", url: "#" },
                    { title: "Jaminan", icon: "location_city", iconType: "MaterialIcons", color: "#C9E6C1", url: "#" },
                    { title: "Reimburse", icon: "credit-card", iconType: "FontAwesome", color: "#C9E6E3", url: "@Url.Action("ManageReimbursementKaryawan", "Manage")" },
                    { title: "Request", icon: "local_cafe", iconType: "MaterialIcons", color: "#B4F1EE", url: "@Url.Action("ManagePermintaanBerkasKaryawan", "Manage")" },
                ]
            };

            // Ambil menu berdasarkan role, default ke Karyawan jika tidak ada
            var menuItemsToShow = menusByRole[userRole] || menusByRole['Karyawan'];

            // Filter menu Reimburse untuk kondisi khusus
            menuItemsToShow = menuItemsToShow.filter(function(item) {
                if (item.title === "Reimburse" && userPlant === 'Semarang' && (golongan == '1' || golongan == '2' || golongan == '3')) {
                    return false;
                }
                return true;
            });

            // Generate menu items
            var menuGrid = $('.menu-grid');
            menuItemsToShow.forEach(function(item) {
                var iconTag = item.iconType === 'FontAwesome'
                    ? '<i class="fas fa-' + item.icon + '"></i>'
                    : '<i class="material-icons">' + item.icon + '</i>';

                var menuItemHtml = '<a href="' + item.url + '" class="menu-item-link">' +
                    '<div class="menu-item">' +
                    '<div class="menu-icon-box" style="background-color: ' + item.color + ';">' +
                    iconTag +
                    '</div>' +
                    '<span class="menu-text">' + item.title + '</span>' +
                    '</div>' +
                    '</a>';

                menuGrid.append(menuItemHtml);
            });

            // Set tanggal saat ini
            $('#current-date').text(new Date().toLocaleDateString('id-ID', {
                day: '2-digit',
                month: 'short',
                year: 'numeric'
            }));

            // Fungsi untuk load data kehadiran
            function loadCurrentHadir() {
                if (!npk) {
                    console.log('NPK tidak tersedia');
                    return;
                }

                $.ajax({
                    url: "http://ALAMAT_IP_SERVER_ANDA/api/kehadiran/currenthadir",
                    type: "POST",
                    contentType: "application/json",
                    data: JSON.stringify({ idKaryawan: npk }),
                    success: function (r) {
                        var formatJam = function(dt) {
                            if (!dt) return "-";
                            var date = new Date(dt);
                            var hours = date.getHours().toString();
                            var minutes = date.getMinutes().toString();
                            if (hours.length < 2) hours = '0' + hours;
                            if (minutes.length < 2) minutes = '0' + minutes;
                            return hours + ':' + minutes;
                        };

                        if (r.result === 200 && r.data) {
                            $('#jam-masuk').text(formatJam(r.data.masukAbsen));
                            $('#jam-keluar').text(formatJam(r.data.keluarAbsen));
                        } else {
                            $('#jam-masuk, #jam-keluar').text("-");
                        }
                    },
                    error: function(xhr, status, error) {
                        console.error('Error loading kehadiran:', error);
                        $('#jam-masuk, #jam-keluar').text("-");
                    }
                });
            }

            // Fungsi untuk update status tag
            function updateStatusTag(elementId, text, isConnected) {
                var el = $('#' + elementId);
                el.find('span:last-child').text(text);
                el.removeClass(isConnected ? 'status-disconnected' : 'status-connected')
                  .addClass(isConnected ? 'status-connected' : 'status-disconnected');
            }

            // Fungsi untuk cek status server
            function checkServerStatus() {
                $.ajax({
                    url: "http://ALAMAT_IP_SERVER_ANDA/api/service/shoot",
                    type: "GET",
                    timeout: 4000,
                    success: function() {
                        updateStatusTag('server-status', 'Server Terhubung', true);
                    },
                    error: function() {
                        updateStatusTag('server-status', 'Server Terputus', false);
                    }
                });
            }

            // Fungsi untuk cek status GPS
            function checkGpsStatus() {
                if (!navigator.geolocation) {
                    updateStatusTag('gps-status', 'GPS Tidak Didukung', false);
                    return;
                }

                navigator.geolocation.getCurrentPosition(
                    function() {
                        updateStatusTag('gps-status', 'GPS Aktif', true);
                    },
                    function() {
                        updateStatusTag('gps-status', 'GPS Tidak Aktif', false);
                    },
                    { timeout: 10000, enableHighAccuracy: true }
                );
            }

            // Jalankan fungsi saat halaman load
            loadCurrentHadir();
            checkServerStatus();
            checkGpsStatus();

            // Set interval untuk update berkala
            setInterval(checkServerStatus, 5000);
            setInterval(checkGpsStatus, 10000);
        });
    </script>
</body>
</html>