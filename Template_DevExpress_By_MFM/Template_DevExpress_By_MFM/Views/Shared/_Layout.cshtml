                <div class="d-flex align-items-center gap-2 ml-3 mr-3">

                    @if (logSession != null && !string.IsNullOrEmpty(logSession.fullname))
                    {
                        // Ambil huruf pertama dari nama lengkap dan ubah jadi huruf besar
                        var initial = logSession.fullname.Substring(0, 1).ToUpper();

                        <!-- Ini adalah Avatar Inisial yang baru -->
                        <div class="profile-initial-avatar rounded-circle d-flex justify-content-center align-items-center mr-3">
                            <span class="fw-bold">@initial</span>
                        </div>
