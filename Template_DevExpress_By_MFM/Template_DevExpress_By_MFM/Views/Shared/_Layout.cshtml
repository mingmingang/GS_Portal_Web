    <style>
        body {
            font-family: Inter;
        }

        .footer-section {
            background-color: #1b2e56;
            color: white;
            padding: 40px 0px 0;
            font-family: 'Inter', sans-serif;
        }

        .footer-container {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
            gap: 40px;
            padding-bottom: 30px;
            border-bottom: 1px solid #fff3;
            max-width: 1250px;
            margin: auto;
        }

        .footer-column h3, .footer-column h4 {
            font-weight: 600;
        }

        .logo-gs {
            color: #ffffff;
            padding: 2px 6px;
            border-radius: 4px;
        }

        .footer-column hr {
            border: 0;
            height: 2px;
            background-color: #778;
            width: 80%;
            margin: 8px 0;
        }

        .footer-column ul {
            list-style: none;
            padding: 0;
            margin: 0;
        }

            .footer-column ul li {
                margin-bottom: 8px;
            }

        .footer-bottom {
            display: flex;
            justify-content: space-between;
            align-items: center;
            flex-wrap: wrap;
            font-size: 14px;
            padding: 16px 20px;
            color: #111;
        }

        .footer-social {
            display: flex;
            align-items: center;
            gap: 10px;
            font-size: 18px;
        }

            .footer-social i {
                color: #12349F;
                transition: 0.3s;
                cursor: pointer;
            }

                .footer-social i:hover {
                    color: #0f2d89;
                }

        .left.side-menu {
            background-color: #1C2D5A;
            color: white;
            width: 250px;
            padding: 20px;
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            align-items: center;
            font-family: 'Inter', sans-serif;
            padding-top: 0px;
        }

        .profile-section {
            text-align: center;
            margin-bottom: 30px;
        }

            .profile-section img {
                width: 80px;
                height: 80px;
                object-fit: cover;
                border-radius: 50%;
                margin: 10px 0;
            }

        .profile-name {
            font-weight: 600;
            font-size: 18px;
        }

        .profile-role {
            background: white;
            color: #1C2D5A;
            padding: 6px 12px;
            border-radius: 20px;
            font-size: 12px;
            font-weight: 500;
            display: inline-block;
            margin-top: 5px;
        }

        .sidebar-menu ul {
            list-style: none;
            padding: 0;
            width: 100%;
        }

        .sidebar-menu li {
            margin-bottom: 15px;
        }

        .sidebar-menu a {
            color: white;
            text-decoration: none;
            display: flex;
            align-items: center;
            padding: 10px 15px;
            border-radius: 10px;
            transition: 0.2s;
        }

            .sidebar-menu a i {
                margin-right: 12px;
            }

            .sidebar-menu a.active,
            .sidebar-menu a:hover {
                background-color: #90A9F9;
                color: white;
            }

        .custom-topbar {
            background-color: #1C2D5A; /* Biru tua */
            padding: 10px 20px;
            height: 70px;
            float: left;
            text-align: center;
            height: 70px;
            position: relative;
            width: 250px;
            z-index: 1;
        }

            .custom-topbar .logo img {
                height: 50px;
