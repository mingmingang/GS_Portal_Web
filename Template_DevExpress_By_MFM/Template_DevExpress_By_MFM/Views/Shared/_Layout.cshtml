    <style>

        /* Header warna biru muda */
        #gridListCuti .dx-datagrid-headers {
            background-color: #1B3D97;
            color: white;
            font-weight: bold;
        }

            /* Ujung kiri header */
            #gridListCuti .dx-datagrid-headers .dx-header-row td:first-child {
                border-top-left-radius: 8px;
            }

            /* Ujung kanan header */
            #gridListCuti .dx-datagrid-headers .dx-header-row td:last-child {
                border-top-right-radius: 8px;
            }

            /* Supaya radius terlihat rapi */
            #gridListCuti .dx-datagrid-headers .dx-row > td {
                overflow: hidden;
            }

        #gridListCuti {
            font-family: 'Inter', sans-serif;
            font-size: 14px;
        }

            #gridListCuti .dx-datagrid-headers {
                font-weight: 600;
            }

            /* Border tabel */
            #gridListCuti .dx-datagrid-borders > .dx-datagrid-headers,
            #gridListCuti .dx-datagrid-borders > .dx-datagrid-rowsview,
            #gridListCuti .dx-datagrid-borders > .dx-datagrid-pager {
                border-color: #1B3D97;
            }

            /* Garis antar kolom & baris */
            #gridListCuti .dx-datagrid-headers td,
            #gridListCuti .dx-datagrid-rowsview td {
                border-color: #1B3D97;
            }

            /* Pager border */
            #gridListCuti .dx-pager .dx-page,
            #gridListCuti .dx-pager .dx-page-size {
                border-color: #1B3D97;
            }

            /* Area kosong (white space bawah grid) */
            #gridListCuti .dx-datagrid-content .dx-datagrid-empty-space {
                background-color: #1B3D97;
            }


            /* Border tabel */

            /* Hover row */
            /*    #gridListCuti .dx-row:hover {
            background-color: #f0f8ff !important;
        }*/

            /* Alternating row warna */
            #gridListCuti .dx-row-alt {
                background-color: #fafafa;
            }


            /* Styling untuk Search Panel di DevExtreme */
            #gridListCuti .dx-searchbox {
                padding: 0;
                border: none;
                background: transparent;
            }

                #gridListCuti .dx-searchbox .dx-texteditor-input {
                    padding: 8px 12px 8px 35px; /* ruang kiri untuk icon */
                    border-radius: 10px; /* lebih curve */
                    border: 1px solid #ccc;
                    font-size: 14px;
                    height: 38px;
                    box-sizing: border-box;
                    background-image: url('data:image/svg+xml;utf8,<svg fill="%23aaa" height="16" viewBox="0 0 24 24" width="16" xmlns="http://www.w3.org/2000/svg"><path d="M15.5 14h-.79l-.28-.27A6.471 6.471 0 0016 9.5 6.5 6.5 0 109.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0C8.01 14 6 11.99 6 9.5S8.01 5 10.5 5 15 7.01 15 9.5 12.99 14 10.5 14z"/></svg>');
                    background-repeat: no-repeat;
                    background-position: 10px center;
                    background-size: 16px;
                }

                /* Biar search icon DevExtreme nggak nabrak */
                #gridListCuti .dx-searchbox .dx-icon-search {
                    display: none;
                }

            /* Font untuk pager */
            #gridListCuti .dx-pager {
                font-family: 'Inter', sans-serif;
            }

                /* Warna default pager number */
                #gridListCuti .dx-pager .dx-page {
                    border-radius: 6px;
                    padding: 5px 10px;
                    color: #1B3D97;
                    font-weight: 500;
                }

                    /* Pager number saat hover */
                    #gridListCuti .dx-pager .dx-page:hover {
                        background-color: rgba(27, 61, 151, 0.1);
                        color: #1B3D97;
                    }

                    /* Pager number saat aktif */
                    #gridListCuti .dx-pager .dx-page.dx-selection {
                        background-color: #1B3D97;
                        color: #fff !important;
                        font-weight: 600;
                        border-radius: 6px;
                    }

                /* Tombol prev/next */
                #gridListCuti .dx-pager .dx-prev-button,
                #gridListCuti .dx-pager .dx-next-button {
                    color: #1B3D97;
                }

                    #gridListCuti .dx-pager .dx-prev-button:hover,
                    #gridListCuti .dx-pager .dx-next-button:hover {
                        background-color: rgba(27, 61, 151, 0.1);
                        border-radius: 6px;
                    }

            #gridListCuti .dx-datagrid-pager .dx-page.dx-selection {
                background-color: #1B3D97 !important;
                color: #fff !important;
                border-radius: 6px !important;
                font-weight: 600;
            }

            /* Hover */
            #gridListCuti .dx-datagrid-pager .dx-page:hover {
                background-color: rgba(27, 61, 151, 0.1) !important;
                color: #1B3D97 !important;
            }

            /* Dropdown page size selector */
            #gridListCuti .dx-datagrid-pager .dx-page-size {
                font-family: 'Inter', sans-serif;
                border-radius: 6px;
                color: #1B3D97;
            }

                #gridListCuti .dx-datagrid-pager .dx-page-size.dx-selection {
                    background-color: #1B3D97 !important;
                    color: #fff !important;
                }

            /* Ubah warna icon filter header jadi putih */
            #gridListCuti .dx-header-filter {
                color: white !important;
                opacity: 1 !important; /* biar gak jadi abu-abu */
            }

                /* Kalau pakai SVG bawaan DevExpress */
                #gridListCuti .dx-header-filter .dx-icon {
                    fill: white !important;
                }

