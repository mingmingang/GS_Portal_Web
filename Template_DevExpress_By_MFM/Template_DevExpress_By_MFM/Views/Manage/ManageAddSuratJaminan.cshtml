@using DevExtreme.AspNet.Mvc;
@{
    ViewBag.Title = "Tambah Surat Jaminan";
    Layout = null;
}
<!DOCTYPE html>
<html>
<head>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewBag.Title</title>
    <!-- Referensi Font Awesome, jQuery & Select2 -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/select2/4.0.13/css/select2.min.css" rel="stylesheet" />
    <script src="https://ajax.googleapis.com/ajax/libs/jquery/3.6.0/jquery.min.js"></script>

    <style>
        body {
            margin: 0;
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
            -webkit-font-smoothing: antialiased;
            -moz-osx-font-smoothing: grayscale;
            background-color: #FFFFFF;
        }

        .surat-jaminan-page-container {
            background-color: #FFFFFF
        }

        .blue-section {
            background-color: #2A458A;
            padding-bottom: 70px;
            background-image: url('../../../../assets/bg_navbarbot_index_reimbursement.png');
            background-size: cover;
            background-position: center;
            background-repeat: no-repeat
        }

        .page-header-standalone {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 16px;
            position: relative
        }

        .back-button {
            color: #fff;
            font-size: 20px;
            text-decoration: none;
            position: absolute;
            left: 16px;
            top: 50%;
            transform: translateY(-50%);
            z-index: 2
        }

        .page-header-title {
            color: #fff;
            font-size: 18px;
            font-weight: bold;
            margin: 0;
            text-align: center;
            width: 100%;
            z-index: 1
        }

        .form-content-section {
            background-color: #FFFFFF;
            margin-top: -60px;
            padding: 20px 16px 24px 16px
        }

        #suratJaminanForm.form {
            display: flex;
            flex-direction: column;
            gap: 24px;
            margin: 0;
            padding-top: 24px
        }

        .form-row {
            display: flex;
            flex-wrap: wrap;
            gap: 20px
        }

        .form-col {
            width: calc((100% - 40px) / 3);
            flex-shrink: 0
        }

        @@media (max-width:768px) {
            .form-col {
                width: 100%
            }
        }

        .surat-jaminan-header {
            margin-bottom: 25px
        }

        .form-title {
            font-size: 20px;
            font-weight: 700;
            color: #111827;
            margin: 0 0 5px 0;
            display: flex;
            align-items: center;
            gap: 10px
        }

        .title-icon {
            color: #1B3D97;
            font-size: 20px
        }

        .form-subtitle {
            font-size: 14px;
            color: #6B7280;
            margin: 0
        }

        label {
            font-weight: 600;
            margin-bottom: 8px;
            display: flex;
            align-items: baseline;
            flex-wrap: wrap;
            font-size: 14px;
            color: #374151;
        }

        .text-danger {
            color: #DC2626;
            margin: 0 8px;
        }

        .error-message {
            color: #DC2626;
            font-size: 12px;
            font-weight: 500;
            font-style: italic;
        }

        small {
            color: #6B7280;
            font-size: 12px;
            margin-top: 4px;
            display: block
        }

        .form-control.is-invalid {
            border-color: #DC2626 !important
        }

        .form-control, .select2-container .select2-selection--single {
            width: 100%;
            padding: 10px 12px;
            border: 1px solid #D1D5DB;
            border-radius: 8px;
            font-size: 14px;
            box-sizing: border-box;
            background-color: #ffffff;
            height: 42px !important
        }

        .form-control:disabled, input[readonly] {
            background-color: #F3F4F6;
            cursor: not-allowed;
            color: #6B7280
        }

        .form-control.textarea {
            height: auto;
            min-height: 80px;
            resize: vertical;
            padding: 12px;
        }

        .select2-container--default .select2-selection--single .select2-selection__rendered {
            line-height: 20px;
            padding-left: 0;
            color: #1F2937
        }

        .select2-container--default .select2-selection--single .select2-selection__arrow {
            height: 40px
        }

        .select2-dropdown {
            border-radius: 8px;
            border: 1px solid #D1D5DB
        }

        .note-box {
            background-color: #EFF6FF;
            padding: 15px;
            border-radius: 8px;
            font-size: 14px;
            color: #1E40AF;
            border-left: 4px solid #3B82F6
        }

        .note-box strong {
            color: #1D4ED8
        }

        .note-box.error {
            background-color: #FEF2F2;
            color: #991B1B;
            border-left-color: #EF4444
        }

        .note-box.warning {
            background-color: #FFFBEB;
            color: #92400E;
            border-left-color: #F59E0B
        }

        .form-actions {
            display: flex;
            justify-content: flex-end;
            gap: 12px
        }

        .btn {
            padding: 10px 28px;
            font-size: 14px;
            font-weight: 600;
            border-radius: 8px;
            border: 1px solid transparent;
            cursor: pointer;
            transition: all .2s
        }

        .btn-batal {
            background-color: #F3F4F6;
            color: #374151;
            border-color: #D1D5DB
        }

        .btn-batal:hover {
            background-color: #E5E7EB
        }

        .btn-preview {
            background-color: #2563EB;
            color: white
        }

        .btn-preview:hover {
            background-color: #1D4ED8
        }

        .btn-simpan {
            background-color: #16A34A;
            color: white
        }

        .btn-simpan:hover {
            background-color: #15803D
        }

        .btn-simpan:disabled, .btn-preview:disabled {
            background-color: #86EFAC;
            cursor: not-allowed
        }

        .custom-modal-overlay {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(0,0,0,0.5);
            display: none;
            align-items: center;
            justify-content: center;
            z-index: 1050;
            opacity: 0;
            transition: opacity .2s ease
        }

        .custom-modal-overlay.show {
            display: flex !important;
            opacity: 1
        }

        .custom-modal {
            background: white;
            padding: 30px 35px;
            border-radius: 16px;
            width: 90%;
            max-width: 400px;
            box-shadow: 0 5px 15px rgba(0,0,0,0.2);
            text-align: center;
            transform: scale(0.95);
            transition: transform .2s ease
        }

        .custom-modal-overlay.show .custom-modal {
            transform: scale(1)
        }

        .modal-title {
            font-size: 24px;
            font-weight: bold;
            color: #333;
            margin: 0 0 15px 0
        }

        .modal-text {
            font-size: 16px;
            color: #666;
            margin-bottom: 30px
        }

        .modal-actions {
            display: flex;
            justify-content: center;
            gap: 15px
        }

        .modal-btn {
            flex: 1;
            padding: 12px 20px;
            border-radius: 8px;
            border: none;
            font-size: 16px;
            font-weight: bold;
            cursor: pointer;
            transition: background-color .2s
        }

        .modal-btn-cancel {
            background-color: #E9ECEF;
            color: #495057
        }

        .modal-btn-cancel:hover {
            background-color: #dee2e6
        }

        .modal-btn-confirm {
            background-color: #1F4AB8;
            color: white
        }

        .modal-btn-confirm:hover {
            background-color: #1a3f99
        }

        .modal-icon-success .checkmark {
            width: 80px;
            height: 80px;
            border-radius: 50%;
            display: inline-block;
            stroke-width: 3;
            stroke: #fff;
            stroke-miterlimit: 10;
            box-shadow: inset 0 0 0 #28a745;
            animation: fill .4s ease-in-out .4s forwards,scale .3s ease-in-out .9s both
        }

        .modal-icon-success .checkmark-circle {
            stroke-dasharray: 166;
            stroke-dashoffset: 166;
            stroke-width: 3;
            stroke-miterlimit: 10;
            stroke: #28a745;
            fill: none;
            animation: stroke .6s cubic-bezier(0.65,0,0.45,1) forwards
        }

        .modal-icon-success .checkmark-check {
            transform-origin: 50% 50%;
            stroke-dasharray: 48;
            stroke-dashoffset: 48;
            animation: stroke .3s cubic-bezier(0.65,0,0.45,1) .8s forwards
        }

        @@keyframes stroke {
            100% {
                stroke-dashoffset: 0
            }
        }

        @@keyframes scale {
            0%, 100% {
                transform: none
            }

            50% {
                transform: scale3d(1.1,1.1,1)
            }
        }

        @@keyframes fill {
            100% {
                box-shadow: inset 0 0 0 50px #28a745
            }
        }

        .modal-text-success {
            font-size: 18px;
            color: #495057;
            margin-top: 15px;
            margin-bottom: 25px
        }
    </style>
</head>
<body>
    <div class="surat-jaminan-page-container">
        <div class="blue-section">
            <div class="page-header-standalone">
                <a href="javascript:window.history.back()" class="back-button" aria-label="Kembali">
                    <i class="fas fa-arrow-left"></i>
                </a>
                <h1 class="page-header-title">@ViewBag.Title</h1>
            </div>
        </div>

        <!-- Form Content Area -->
        <div class="form-content-section">
            <div class="surat-jaminan-container">

                <div id="dateValidationError" class="note-box error" style="display: none;"></div>

                <form id="suratJaminanForm" class="form" novalidate>

                    <!-- Baris 1: Info Karyawan (Readonly) -->
                    <div class="form-row">
                        @*<div class="form-col">
                            <label>No. Pengajuan</label>
                            <input type="text" id="PsjNoRequest" name="PsjNoRequest" class="form-control" value="Memuat..." readonly>
                        </div>*@
                        <div class="form-col">
                            <label>NPK</label>
                            <input type="text" id="PsjNpk" name="PsjNpk" class="form-control" value="@ViewBag.Npk" readonly>
                        </div>
                        <div class="form-col">
                            <label>Nama Karyawan</label>
                            <input type="text" id="namaKaryawan" name="NamaKaryawan" class="form-control" value="@ViewBag.NamaKaryawan" readonly>
                        </div>
                    </div>

                    <input type="hidden" name="PsjPlant" value="@ViewBag.Plant">

                    <!-- Baris 2: Data Pasien & Tipe Jaminan -->
                    <div class="form-row">
                        <div class="form-col">
                            <label>Nama Pasien <span class="text-danger">*</span><span class="error-message"></span></label>
                            <select id="namaPasien" name="PsjPasien" class="form-control searchable-select" required data-placeholder="Pilih Nama Pasien"></select>
                        </div>
                        <div class="form-col">
                            <label>Hubungan Pasien</label>
                            <input type="text" id="hubunganPasien" name="HubunganPasien" class="form-control" readonly>
                        </div>
                        <div class="form-col">
                            <label>Tipe Surat Jaminan <span class="text-danger">*</span><span class="error-message"></span></label>
                            <select id="tipeSuratJaminan" name="PsjTipeJaminan" class="form-control" required>
                                <option value="">Pilih Tipe Surat Jaminan</option>
                                <option value="Rawat Jalan">Rawat Jalan</option>
                                <option value="Rawat Inap">Rawat Inap</option>
                            </select>
                        </div>
                    </div>

                    <!-- Baris 3: Rumah Sakit & Tanggal -->
                    <div class="form-row">
                        <div class="form-col">
                            <label>Rumah Sakit <span class="text-danger">*</span><span class="error-message"></span></label>
                            <select id="rumahSakit" name="PsjRumahSakit" class="form-control searchable-select" required data-placeholder="Pilih Rumah Sakit"></select>
                        </div>
                        <div class="form-col">
                            <label>Tanggal Periksa <span class="text-danger">*</span><span class="error-message"></span></label>
                            <input type="date" id="tanggalPeriksa" name="PsjTanggalPeriksa" class="form-control" required>
                        </div>
                        <div class="form-col">
                            <!-- Empty column for grid alignment -->
                        </div>
                    </div>

                    <!-- Baris 4: Keterangan Tambahan -->
                    <div class="form-row">
                        <div class="form-col" style="width: 100%;">
                            <label>Keterangan Tambahan</label>
                            <textarea id="keteranganTambahan" name="PsjKeterangan" class="form-control textarea" rows="3" placeholder="Masukkan keterangan tambahan jika diperlukan..."></textarea>
                        </div>
                    </div>

                    <!-- Note Box -->
                    <div class="note-box" id="infoNote">
                        <strong>Informasi:</strong> Surat Jaminan ini berlaku 2 x 24 jam dari tanggal diterbitkan. Harap simpan nomor pengajuan untuk referensi.
                    </div>

                    <div id="plafonWarning" class="note-box warning" style="display: none;">
                        <strong>Perhatian:</strong> <span id="plafonWarningText"></span>
                    </div>

                    <!-- Tombol Aksi -->
                    <div class="form-actions">
                        <button type="button" class="btn btn-batal">Batal</button>
                        <button type="button" class="btn btn-preview">Preview</button>
                        <button type="submit" class="btn btn-simpan">Simpan Pengajuan</button>
                    </div>

                </form>
            </div>
        </div>

        <!-- Modals -->
        <div id="confirmModal" class="custom-modal-overlay">
            <div class="custom-modal">
                <h2 class="modal-title">Konfirmasi Pengajuan</h2>
                <p class="modal-text">Apakah Anda yakin data yang dimasukkan sudah benar?</p>
                <div class="modal-actions">
                    <button id="cancel-save-btn" class="modal-btn modal-btn-cancel">Periksa Lagi</button>
                    <button id="confirm-save-btn" class="modal-btn modal-btn-confirm">Ya, Simpan</button>
                </div>
            </div>
        </div>

        <div id="successModal" class="custom-modal-overlay">
            <div class="custom-modal">
                <div class="modal-icon-success">
                    <svg class="checkmark" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 52 52">
                        <circle class="checkmark-circle" cx="26" cy="26" r="25" fill="none" />
                        <path class="checkmark-check" fill="none" d="M14.1 27.2l7.1 7.2 16.7-16.8" />
                    </svg>
                </div>
                <p class="modal-text-success">Pengajuan Surat Jaminan berhasil disimpan!</p>
                <button id="close-success-btn" class="modal-btn modal-btn-confirm" style="width: 50%; margin: 0 auto;">OK</button>
            </div>
        </div>
    </div>

    <!-- Script Libraries -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/select2/4.0.13/js/select2.min.js"></script>

    <script>
    $(document).ready(function () {
        const select2Options = {
            width: '100%',
            placeholder: 'Pilih...',
            dropdownParent: $('#suratJaminanForm')
        };

        const $submitButton = $('.btn-simpan');
        const $previewButton = $('.btn-preview');
        const originalSubmitButtonHtml = $submitButton.html();
        const originalPreviewButtonHtml = $previewButton.html();

        let currentPasienData = null;
        let currentRumahSakitData = null;

        function populatePasienDropdown() {
            return $.getJSON('@Url.Content("~/api/ReimbursementApi/list_keluarga")',
                r => {
                    const d = $('#namaPasien'), data = r.data || [];
                    d.empty().append('<option></option>');

                    if (data.length > 0) $.each(data, (i, item) => {
                        let rel = item.relationship.toLowerCase() === 'sendiri'
                            ? 'Anda' : item.relationship.charAt(0).toUpperCase() + item.relationship.slice(1);

                        d.append($('<option>', {
                            value: item.empfamily_id,
                            text: `${item.name} (${rel})`,
                            'data-relationship': rel,
                            'data-name': item.name
                        }));
                    });
                    d.trigger('change');
                });
        }

        function populateRumahSakitDropdown() {
            return $.getJSON('@Url.Content("~/api/ReimbursementApi/getDoctorHospital")',
                r => {
                    const d = $('#rumahSakit'),
                        data = r.data || [];
                    d.empty().append('<option></option>');

                    if (data.length > 0) {
                        // Filter only hospitals with DoctorHospitalType 'HS'
                        const filteredData = data.filter(item =>
                            item.DoctorHospitalType && item.DoctorHospitalType.trim() === 'HS'
                        );

                        filteredData.forEach(item => d.append($('<option>', {
                            value: item.DoctorHospitalCode,
                            text: item.DoctorHospitalName,
                            'data-address': item.DoctorHospitalAddress,
                            'data-phone': item.DoctorHospitalPhone
                        })));
                    }
                    d.trigger('change');
                });
        }

        function getAndSetSuratJaminanId() {
            const n = "@ViewBag.Npk",
                f = $("#PsjNoRequest");
            $submitButton.prop("disabled", true).text("Memuat...");

            $.ajax({
                url: `/api/SuratJaminanApi/generateSuratJaminanNo`,
                type: "GET",
                success: r => {
                    if (r && r.data && r.data.PsjNoRequest) {
                        f.val(r.data.PsjNoRequest);
                        $submitButton.prop("disabled", false).html(originalSubmitButtonHtml);
                    } else {
                        f.val("GAGAL");
                        alert("Gagal mendapatkan nomor pengajuan.");
                    }
                },
                error: () => {
                    f.val("ERROR!");
                    alert("Gagal terhubung untuk mengambil nomor pengajuan.");
                }
            });
        }

        function checkPlafonForRawatJalan() {
            const tipeSurat = $('#tipeSuratJaminan').val();
            const $plafonWarning = $('#plafonWarning');

            if (tipeSurat === 'Rawat Jalan') {
                // Check plafon status
                const npk = "@ViewBag.Npk";
                const plant = "@ViewBag.Plant";
                const currentYear = new Date().getFullYear();

                $.ajax({
                    url: `/api/ReimbursementApi/getReimbursementSummary/${npk}/${plant}?year=${currentYear}`,
                    type: "GET",
                    success: function(response) {
                        if (response && response.data && response.data.collapsedSummary) {
                            const sisaPlafon = response.data.collapsedSummary.sisa || 0;

                            if (sisaPlafon > 0) {
                                $('#plafonWarningText').text(`Sisa plafon Anda: Rp ${sisaPlafon.toLocaleString('id-ID')}. Surat jaminan akan otomatis disetujui.`);
                                $plafonWarning.removeClass('warning').addClass('note-box').show();
                            } else {
                                $('#plafonWarningText').text('Sisa plafon Anda: Rp 0. Surat jaminan memerlukan persetujuan HC.');
                                $plafonWarning.removeClass('note-box').addClass('warning').show();
                            }
                        }
                    },
                    error: function() {
                        $plafonWarning.hide();
                    }
                });
            } else {
                $plafonWarning.hide();
            }
        }

        function validateDateConstraints() {
            const tipeSurat = $('#tipeSuratJaminan').val();
            const tanggalPeriksa = $('#tanggalPeriksa').val();

            if (!tipeSurat || !tanggalPeriksa) return true;

            const selectedDate = new Date(tanggalPeriksa);
            const today = new Date();
            today.setHours(0, 0, 0, 0);
            selectedDate.setHours(0, 0, 0, 0);

            const yesterday = new Date(today);
            yesterday.setDate(today.getDate() - 1);

            const oneMonthBefore = new Date(today);
            oneMonthBefore.setMonth(today.getMonth() - 1);

            const oneMonthAfter = new Date(today);
            oneMonthAfter.setMonth(today.getMonth() + 1);

            $('#dateValidationError').hide();

            if (tipeSurat === 'Rawat Jalan') {
                if (selectedDate < yesterday || selectedDate > today) {
                    $('#dateValidationError').text("Untuk Rawat Jalan, tanggal periksa hanya bisa kemarin atau hari ini.").show();
                    return false;
                }
            } else if (tipeSurat === 'Rawat Inap') {
                if (selectedDate < oneMonthBefore || selectedDate > oneMonthAfter) {
                    $('#dateValidationError').text("Untuk Rawat Inap, tanggal periksa tidak boleh lebih dari 1 bulan sebelum atau setelah hari ini.").show();
                    return false;
                }
            }

            return true;
        }

        function submitFormAjax() {
            const $confirmButton = $('#confirm-save-btn');
            $confirmButton.prop('disabled', true).html('<i class="fas fa-spinner fa-spin"></i> Menyimpan...');

            const formData = new FormData();

            // Collect form data
            formData.append('PsjNpk', $('#PsjNpk').val());
            formData.append('PsjPasien', $('#namaPasien').val());
            formData.append('PsjTipeJaminan', $('#tipeSuratJaminan').val());
            formData.append('PsjRumahSakit', $('#rumahSakit').val());
            formData.append('PsjTanggalPeriksa', $('#tanggalPeriksa').val());
            formData.append('PsjKeterangan', $('#keteranganTambahan').val() || '');
            formData.append('PsjCreatedBy', '@ViewBag.NamaKaryawan');

            // Create values object for API compatibility
            const formObject = {
                PsjNpk: $('#PsjNpk').val(),
                PsjPasien: $('#namaPasien').val(),
                PsjTipeJaminan: $('#tipeSuratJaminan').val(),
                PsjRumahSakit: $('#rumahSakit').val(),
                PsjTanggalPeriksa: $('#tanggalPeriksa').val(),
                PsjKeterangan: $('#keteranganTambahan').val() || '',
                PsjCreatedBy: '@ViewBag.NamaKaryawan'
            };

            formData.append('values', JSON.stringify(formObject));

            $.ajax({
                url: '/api/SuratJaminanApi/createSuratJaminan',
                type: 'POST',
                data: formData,
                processData: false,
                contentType: false,
                success: function (response) {
                    console.log('AJAX Success:', response);
                    // Store the jaminan ID for redirection
                    if (response && response.data && response.data.PsjId) {
                        window.lastCreatedJaminanId = response.data.PsjId;
                    }
                    $('#confirmModal').removeClass('show');
                    $('#successModal').addClass('show');
                },
                error: function (jqXHR) {
                    console.error('AJAX Error:', jqXHR);
                    $('#confirmModal').removeClass('show');
                    let msg = (jqXHR.responseJSON && jqXHR.responseJSON.message) || 'Terjadi kesalahan saat menyimpan.';
                    alert('Error: ' + msg);
                    $submitButton.prop('disabled', false);
                },
                complete: function() {
                    if (!$('#successModal').is(':visible')) {
                       $confirmButton.prop('disabled', false).text('Ya, Simpan');
                    }
                }
            });
        }

        function validateField($field) {
            const $errorSpan = $field.closest('.form-col').find('.error-message');
            let hasValue = $field.val() && $.trim($field.val()) !== '';

            if (!hasValue && $field.is('[required]:visible')) {
                $errorSpan.text('Wajib diisi.');
                $field.addClass('is-invalid');
                return false;
            } else {
                $errorSpan.text('');
                $field.removeClass('is-invalid');
                return true;
            }
        }

        function initRealTimeValidation() {
            $('#suratJaminanForm').on('blur input change', ':input[required]', function() {
                validateField($(this));
            });
        }

        function loadAllMasterData() {
            getAndSetSuratJaminanId();

            $.when(populatePasienDropdown(), populateRumahSakitDropdown()).done(() => {
                console.log("SUKSES: Semua data API berhasil dimuat.");
                $('.searchable-select').select2(select2Options);

                // Event handlers
                $('#namaPasien').on('change', function () {
                    const selectedOption = $(this).find('option:selected');
                    const relationship = selectedOption.data('relationship') || '';
                    $('#hubunganPasien').val(relationship);
                    currentPasienData = {
                        id: $(this).val(),
                        name: selectedOption.data('name') || '',
                        relationship: relationship
                    };
                });

                $('#rumahSakit').on('change', function () {
                    const selectedOption = $(this).find('option:selected');
                    currentRumahSakitData = {
                        code: $(this).val(),
                        name: selectedOption.text() || '',
                        address: selectedOption.data('address') || '',
                        phone: selectedOption.data('phone') || ''
                    };
                });

                $('#tipeSuratJaminan').on('change', function () {
                    checkPlafonForRawatJalan();
                    // Reset date when type changes
                    $('#tanggalPeriksa').val('');
                });

                $('#tanggalPeriksa').on('change', function () {
                    validateDateConstraints();
                });

                initRealTimeValidation();
            }).fail(() => alert("Gagal memuat data master. Silakan muat ulang halaman."));
        }

        // Event Handlers
        $('.btn-batal').on('click', () => window.history.back());

        $('.btn-preview').on('click', function() {
            // Validate form first
            let isFormValid = true;
            $('#dateValidationError').hide();

            $('#suratJaminanForm').find(':input[required]:visible').each(function () {
                if (!validateField($(this))) {
                    isFormValid = false;
                }
            });

            if (!validateDateConstraints()) {
                isFormValid = false;
            }

            if (isFormValid) {
                $previewButton.prop('disabled', true).text('Loading...');

                // Prepare preview data
                const previewData = {
                    PsjNoRequest: $('#PsjNoRequest').val(),
                    PsjNpk: $('#PsjNpk').val(),
                    NamaKaryawan: $('#namaKaryawan').val(),
                    NamaPasien: currentPasienData ? currentPasienData.name : '',
                    HubunganPasien: $('#hubunganPasien').val(),
                    PsjTipeJaminan: $('#tipeSuratJaminan').val(),
                    RumahSakitNama: currentRumahSakitData ? currentRumahSakitData.name : '',
                    PsjTanggalPeriksa: $('#tanggalPeriksa').val(),
                    PsjKeterangan: $('#keteranganTambahan').val()
                };

                // Navigate to preview page (you'll need to create this)
                const params = new URLSearchParams(previewData).toString();
                window.open(`/Manage/ManagePreviewJaminan?${params}`, '_blank');

                setTimeout(() => {
                    $previewButton.prop('disabled', false).html(originalPreviewButtonHtml);
                }, 1000);
            }
        });

        $('#suratJaminanForm').on('submit', function (event) {
            event.preventDefault();

            let isFormValid = true;
            $('#dateValidationError').hide();

            $(this).find(':input[required]:visible').each(function () {
                if (!validateField($(this))) {
                    isFormValid = false;
                }
            });

            if (!validateDateConstraints()) {
                isFormValid = false;
            }

            if (isFormValid) {
                $submitButton.prop('disabled', true);
                $('#confirmModal').addClass('show');
            }
        });

        $('#confirm-save-btn').on('click', submitFormAjax);

        $('#cancel-save-btn, .custom-modal-overlay').on('click', function(e) {
            if (e.target === this || $(this).is('#cancel-save-btn')) {
                $(this).closest('.custom-modal-overlay').removeClass('show');
                $submitButton.prop('disabled', false);
            }
        });

        $('#close-success-btn').on('click', () => {
            // Check if we have the jaminan ID from response to redirect to print page
            if (window.lastCreatedJaminanId) {
                window.location.href = `/Manage/ManageCetakJaminan?id=${window.lastCreatedJaminanId}`;
            } else {
                window.location.href = `/Manage/ManageSuratJaminan`;
            }
        });

        // Initialize
        try {
            loadAllMasterData();
        } catch (e) {
            alert("Terjadi kesalahan, form tidak dapat dimuat.");
            $('#suratJaminanForm :input').prop('disabled', true);
        }
    });
    </script>
</body>
</html>