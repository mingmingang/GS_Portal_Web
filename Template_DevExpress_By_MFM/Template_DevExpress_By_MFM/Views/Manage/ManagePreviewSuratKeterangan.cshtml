                                    line-height: 1.5;
                                }
                                .info-table {
                                    width: 100%;
                                    margin: 15px 0;
                                    border-collapse: collapse;
                                }
                                .info-table td {
                                    padding: 4px 0;
                                    vertical-align: top;
                                    font-size: 11pt;
                                }
                                .info-table td:first-child {
                                    width: 100px;
                                }
                                .info-table td:nth-child(2) {
                                    width: 10px;
                                }
                                .signature-section {
                                    margin-top: 40px;
                                    text-align: right;
                                }
                                .signature-box {
                                    display: inline-block;
                                    text-align: center;
                                    min-width: 180px;
                                }
                                .signature-box .location-date {
                                    margin-bottom: 50px;
