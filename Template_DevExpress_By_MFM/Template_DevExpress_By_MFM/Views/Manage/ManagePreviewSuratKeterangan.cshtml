/**
 * ✅ UPDATED: Dynamic back navigation berdasarkan role dan context
 */
function handleBack() {
    const urlParams = new URLSearchParams(window.location.search);
    const fromAdd = urlParams.get('fromAdd') === 'true';

    console.log('=== HANDLE BACK ===');
    console.log('From Add:', fromAdd);
    console.log('User Role:', userRole);

    // PRIORITAS 1: Gunakan BackUrl dari server (paling akurat)
    if (backUrlFromServer && backUrlFromServer !== '') {
        console.log('✅ Using BackUrl from server:', backUrlFromServer);
        window.location.href = backUrlFromServer;
        return;
    }

    // PRIORITAS 2: Logic fallback jika server tidak mengirim BackUrl
    if (fromAdd) {
        // Dari Add Form -> Kembali ke form
        const params = new URLSearchParams({
            alasanPermintaan: urlParams.get('alasanPermintaan') || '',
            keterangan: urlParams.get('keterangan') || ''
        });
        console.log('⬅️ Returning to Add Form');
        window.location.href = '/Manage/ManageAddPermintaanSuratKeterangan?' + params.toString();
    } else {
        // Dari List -> Kembali sesuai role
        const userRoleLower = userRole.toLowerCase();

        if (userRoleLower === 'hc') {
            console.log('⬅️ Returning to HC View');
            window.location.href = '/Manage/ManagePermintaanBerkasHC';
        } else {
            // Default ke Karyawan view dengan tab SK
            console.log('⬅️ Returning to Karyawan View');
            window.location.href = '/Manage/ManagePermintaanBerkasKaryawan?tab=sk';
        }
    }
}

/**
 * 🔥 FUNGSI DOWNLOAD PDF - LANGSUNG DOWNLOAD TANPA PRINT DIALOG
 */
function printSurat() {
    // Ambil data dari URL params untuk nama file
    const urlParams = new URLSearchParams(window.location.search);
    const skpId = urlParams.get('skpId') || 'Surat_Keterangan';

    // Ambil elemen surat yang akan di-convert
    const element = document.getElementById('suratContent');

    if (!element) {
        alert('Konten surat tidak ditemukan!');
        return;
    }

    // Clone element untuk manipulasi tanpa merusak tampilan
    const clonedElement = element.cloneNode(true);

    // Tampilkan loading
    const btnPrint = document.getElementById('btnPrint');
    const originalBtnText = btnPrint.innerHTML;
    btnPrint.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Mengunduh PDF...';
    btnPrint.disabled = true;

    // Konfigurasi html2pdf
    const opt = {
        margin: [20, 15, 15, 15], // [top, right, bottom, left] dalam mm
        filename: `${skpId}.pdf`,
        image: { type: 'jpeg', quality: 0.98 },
        html2canvas: {
            scale: 2,
            useCORS: true,
            logging: false,
            letterRendering: true
        },
        jsPDF: {
            unit: 'mm',
            format: 'a4',
            orientation: 'portrait'
        },
        pagebreak: { mode: ['avoid-all', 'css', 'legacy'] }
    };

    // Generate dan download PDF
    html2pdf()
        .set(opt)
        .from(clonedElement)
        .save()
        .then(() => {
            // Restore button setelah selesai
            btnPrint.innerHTML = originalBtnText;
            btnPrint.disabled = false;
            console.log('✅ PDF berhasil diunduh');
        })
        .catch((error) => {
            console.error('❌ Error saat generate PDF:', error);
            alert('Gagal mengunduh PDF. Silakan coba lagi.');
            btnPrint.innerHTML = originalBtnText;
            btnPrint.disabled = false;
        });
}

// ==========================================
// MAIN INITIALIZATION
// ==========================================
$(document).ready(function () {
    const urlParams = new URLSearchParams(window.location.search);
    const skpId = urlParams.get('skpId');
    const fromAdd = urlParams.get('fromAdd') === 'true';
    const alasanPermintaan = decodeURIComponent(urlParams.get('alasanPermintaan') || '');
    const keterangan = decodeURIComponent(urlParams.get('keterangan') || '');

    console.log('=== PREVIEW DATA ===');
    console.log('SKP ID:', skpId);
    console.log('From Add:', fromAdd);
    console.log('Alasan:', alasanPermintaan);

    // ==========================================
    // MODE 1: PREVIEW FROM ADD FORM (NEW DATA)
    // ==========================================
    if (fromAdd) {
        console.log('Mode: Preview dari Add Form (Data Baru)');

        const data = {
            npk: '@npk',
            nama: '@nama',
            plant: '@plant',
            alasanPermintaan: alasanPermintaan,
            keterangan: keterangan,
            skpId: null,
            skp_crea_date: null,
            skp_status: 'Draft',
            skp_modi_by_name: null,
            skp_modi_by_jabatan: null
        };

        renderSummary(data);
        $('#suratContent').html(createSuratKeteranganContent(data));
        $('#suratInfo').text(`Draft Preview - ${data.alasanPermintaan}`);
        $('#noteText').text('Ini adalah preview surat keterangan yang akan dicetak. Nomor surat, tanggal, dan penandatangan akan diisi otomatis setelah disetujui oleh HC.');

        // Update status bar untuk mode draft
        updateStatusBar('draft', 'Status Surat');

        $('#btnEdit').show();
        $('#btnPrint').hide();
        $('#backButtonText').text('Kembali ke Form');
    }
    // ==========================================
    // MODE 2: PREVIEW FROM LIST (EXISTING DATA)
    // ==========================================
    else if (skpId) {
        console.log('Mode: Preview dari List (Data Sudah Ada)');

        const npk = '@npk';
        const plant = '@plant';

        $.ajax({
            url: `/api/PermintaanApi/skp/${npk}/${plant}`,
            method: 'GET',
            dataType: 'json',
            success: function (response) {
                console.log('=== RAW API RESPONSE ===');
                console.log('Full Response:', response);

                let actualData = null;
                if (response && response.code === 200) {
                    if (response.data && Array.isArray(response.data) && response.data.length > 0) {
                        const firstItem = response.data[0];
                        if (firstItem.data && Array.isArray(firstItem.data)) {
                            actualData = firstItem.data;
                        }
                    }
                }

                if (!actualData || actualData.length === 0) {
                    console.error('❌ No data found in response');
                    $('#summaryContainer').html('<p style="text-align:center; color:#999;">Data tidak ditemukan</p>');
                    $('#suratContent').html('<p style="text-align:center; color:#999;">Data tidak ditemukan</p>');
                    return;
                }

                console.log('=== ACTUAL DATA ARRAY ===');
                console.log('Total items:', actualData.length);

                const skpData = actualData.find(item => item.skp_id === skpId);

                if (!skpData) {
                    console.error('❌ SKP not found with ID:', skpId);
                    $('#summaryContainer').html('<p style="text-align:center; color:#999;">Data surat tidak ditemukan</p>');
                    $('#suratContent').html('<p style="text-align:center; color:#999;">Data surat tidak ditemukan</p>');
                    return;
                }

                console.log('=== FOUND SKP DATA ===');
                console.log('SKP ID:', skpData.skp_id);
                console.log('Status:', skpData.skp_status);
                console.log('HC Name:', skpData.skp_modi_by_name);
                console.log('HC Jabatan:', skpData.skp_modi_by_jabatan);

                const data = {
                    npk: skpData.kry_npk || '@npk',
                    nama: skpData.kry_nama_karyawan || '@nama',
                    plant: skpData.kry_plant || '@plant',
                    alasanPermintaan: skpData.skp_ap || alasanPermintaan,
                    keterangan: skpData.skp_ket || keterangan,
                    skpId: skpData.skp_id,
                    skp_crea_date: skpData.skp_crea_date,
                    skp_status: skpData.skp_status,
                    skp_modi_by_name: skpData.skp_modi_by_name || null,
                    skp_modi_by_jabatan: skpData.skp_modi_by_jabatan || null
                };

                renderSummary(data);
                $('#suratContent').html(createSuratKeteranganContent(data));
                $('#suratInfo').text(`Surat Keterangan - ${data.skpId}`);

                // Update status bar berdasarkan status
                if (data.skp_status === 'Disetujui') {
                    updateStatusBar('approved', 'Status Surat');
                    $('#noteText').text('Status Surat');
                    $('#noteBox').css({
                        'background-color': '#D1FAE5',
                        'border-left-color': '#10B981'
                    });
                    $('#noteBox').find('strong').css('color', '#047857');
                } else if (data.skp_status === 'Ditolak') {
                    updateStatusBar('rejected', 'Status Surat');
                    $('#noteText').text('Status Surat');
                    $('#noteBox').css({
                        'background-color': '#FEE2E2',
                        'border-left-color': '#EF4444'
                    });
                    $('#noteBox').find('strong').css('color', '#991B1B');
                } else {
                    updateStatusBar('pending', 'Status Surat');
                    $('#noteText').text('Status Surat');
                }

                $('#btnEdit').hide();
                $('#btnPrint').show();
                $('#backButtonText').text('Kembali');
            },
            error: function (xhr, status, error) {
                console.error('AJAX Error:', error);
                console.error('Status:', status);
                console.error('Response:', xhr.responseText);
                $('#summaryContainer').html('<p style="text-align:center; color:#dc2626;">Gagal memuat data dari server</p>');
                $('#suratContent').html('<p style="text-align:center; color:#dc2626;">Gagal memuat data surat</p>');
            }
        });
    }
    // ==========================================
    // MODE 3: FALLBACK
    // ==========================================
    else {
        console.log('Mode: Fallback - No skpId provided');

        const data = {
            npk: '@npk',
            nama: '@nama',
            plant: '@plant',
            alasanPermintaan: alasanPermintaan || 'Tidak ada alasan',
            keterangan: keterangan || 'Tidak ada keterangan',
            skpId: null,
            skp_crea_date: null,
            skp_status: 'Unknown',
            skp_modi_by_name: null,
            skp_modi_by_jabatan: null
        };

        renderSummary(data);
        $('#suratContent').html(createSuratKeteranganContent(data));
        $('#suratInfo').text('Preview Surat');
        $('#noteText').text('Data tidak lengkap. Silakan kembali ke form pengajuan.');

        // Update status bar untuk mode fallback
        updateStatusBar('secondary', 'Status tidak diketahui');

        $('#btnEdit').hide();
        $('#btnPrint').hide();
        $('#backButtonText').text('Kembali');
    }
});

