                                        padding: 20mm 25mm;
                                        -webkit-print-color-adjust: exact;
                                        print-color-adjust: exact;
                                    }
                                }
                                .surat-header {
                                    display: flex;
                                    justify-content: space-between;
                                    align-items: flex-start;
                                    margin-bottom: 20px;
                                    padding-bottom: 15px;
                                    border-bottom: 2px solid #000;
                                }
                                .surat-header-left, .surat-header-right {
                                    width: 45%;
                                    font-size: 9pt;
                                    line-height: 1.3;
                                }
                                .surat-header-center {
                                    text-align: center;
                                    width: 30%;
                                }
                                .logo-container {
                                    display: flex;
                                    flex-direction: column;
                                    align-items: center;
                                    margin-bottom: 8px;
                                }
                                .logo-image {
                                    width: 70px;
                                    height: 70px;
                                    margin-bottom: 6px;
                                    object-fit: contain;
                                }
                                .company-name {
                                    font-size: 13pt;
                                    font-weight: bold;
                                    margin-bottom: 2px;
                                }
                                .company-subtitle {
                                    font-size: 8pt;
                                }
                                .surat-title {
                                    text-align: center;
                                    margin: 20px 0 15px 0;
                                }
                                .surat-title h2 {
                                    text-decoration: underline;
