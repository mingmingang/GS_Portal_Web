<body>
    <div class="preview-page-container">
        <!-- Header - Matching ManagePermintaanBerkasKaryawan -->
        <div class="header">
            <span class="back-button" onclick="handleBack()">
                <i class="fas fa-arrow-left"></i>
            </span>
            <div class="header-text">Preview Surat Keterangan</div>
            <div class="header-spacer"></div>
        </div>

        <!-- Content Section -->
        <div class="form-content-section">
            <!-- Status Info Bar - DARI V3 - DISESUAIKAN DENGAN DETAIL REIMBURSEMENT -->
            <div class="status-info-bar no-print" id="statusInfoBar">
                <span class="status-info-label">
                    <i class="fas fa-info-circle"></i>
                    <span id="statusLabel">Status Surat</span>
                </span>
                <span id="statusBadge" class="status-badge badge-draft">Draft</span>
            </div>

            <div class="preview-container">
                <!-- Preview Header -->
                <div class="preview-header no-print">
                    <h3 class="preview-title">
                        <i class="fas fa-eye title-icon"></i>
                        Preview Surat Keterangan
                    </h3>
                    <div class="preview-info">
                        <i class="fas fa-info-circle"></i>
                        <span id="suratInfo">Draft Preview</span>
                    </div>
                </div>

                <!-- Data Summary -->
                <div class="data-summary no-print">
                    <div class="data-summary-title">
                        <i class="fas fa-clipboard-list"></i>
                        Ringkasan Data Pengajuan
                    </div>
                    <div id="summaryContainer">
                        <div class="loading-spinner">
                            <i class="fas fa-spinner fa-spin fa-2x"></i>
                            <p>Memuat data...</p>
                        </div>
                    </div>
                </div>

                <!-- Preview Content -->
                <div class="preview-content">
                    <div id="suratContent" class="surat-preview">
                        <div class="loading-spinner">
                            <i class="fas fa-spinner fa-spin fa-2x"></i>
                            <p>Memuat surat...</p>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Action Buttons -->
            <div class="form-actions no-print" id="actionButtons">
                <a href="javascript:void(0)" class="btn btn-kembali" id="btnKembali" onclick="handleBack()">
                    <i class="fas fa-arrow-left"></i>
                    <span id="backButtonText">Kembali</span>
                </a>
                <a href="javascript:void(0)" class="btn btn-edit" id="btnEdit" onclick="editForm()" style="display:none;">
                    <i class="fas fa-edit"></i>
                    Edit Data
                </a>
                <a href="javascript:void(0)" class="btn btn-print" id="btnPrint" onclick="printSurat()" style="display:none;">
                    <i class="fas fa-print"></i>
                    Cetak Surat
                </a>
            </div>
        </div>
    </div>

    <script>
// ==========================================
// CONSTANTS & DATA
// ==========================================
const logoGS = "data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'%3E%3Ccircle cx='50' cy='50' r='45' fill='%23e74c3c'/%3E%3Ctext x='50' y='65' font-size='40' font-weight='bold' fill='white' text-anchor='middle'%3EGS%3C/text%3E%3C/svg%3E";

const monthNames = [
    'Januari', 'Februari', 'Maret', 'April', 'Mei', 'Juni',
    'Juli', 'Agustus', 'September', 'Oktober', 'November', 'Desember'
];

const userRole = '@ViewBag.UserRole' || 'Karyawan';
const backUrlFromServer = '@ViewBag.BackUrl' || '';

console.log('=== USER ROLE & BACK URL ===');
console.log('User Role:', userRole);
console.log('Back URL from Server:', backUrlFromServer);

// ==========================================
// HELPER FUNCTIONS
// ==========================================
function formatDate(dateString) {
    if (!dateString) return '';
    const date = new Date(dateString);
    const day = date.getDate();
    const month = monthNames[date.getMonth()];
    const year = date.getFullYear();
    return `${day} ${month} ${year}`;
}

// ==========================================
// FUNGSI UPDATE STATUS BAR (DARI V3)
// ==========================================
function updateStatusBar(status, message) {
    const statusBar = $('#statusInfoBar');
    const statusBadge = $('#statusBadge');
    const statusLabel = $('#statusLabel');

    statusLabel.text(message || 'Status Surat');
    statusBadge.removeClass('badge-draft badge-pending badge-approved badge-rejected badge-secondary');

    switch (status) {
        case 'draft':
            statusBadge.addClass('badge-draft').text('Draft');
            break;
        case 'pending':
            statusBadge.addClass('badge-pending').text('Menunggu Verifikasi');
            break;
        case 'approved':
            statusBadge.addClass('badge-approved').text('Disetujui');
            break;
        case 'rejected':
            statusBadge.addClass('badge-rejected').text('Ditolak');
            break;
        default:
            statusBadge.addClass('badge-secondary').text(status);
            break;
    }
}

