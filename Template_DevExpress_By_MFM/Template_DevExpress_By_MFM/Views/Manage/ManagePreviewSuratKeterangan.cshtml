        function getCurrentData() {
            const urlParams = new URLSearchParams(window.location.search);
            const fromAdd = urlParams.get('fromAdd') === 'true';
            const alasanPermintaan = decodeURIComponent(urlParams.get('alasanPermintaan') || '');
            const keterangan = decodeURIComponent(urlParams.get('keterangan') || '');

            if (fromAdd) {
                return {
                    npk: '@ViewBag.Npk',
                    nama: '@ViewBag.Nama',
                    plant: '@ViewBag.Plant',
                    departemen: '@ViewBag.EmployeeDept',
                    alasanPermintaan: alasanPermintaan,
                    keterangan: keterangan,
                    skpId: null,
                    skp_crea_date: null,
                    skp_status: 'Draft',
                    skp_modi_by_name: null,
                    skp_modi_by_jabatan: null
                };
            } else {
                const currentData = window.currentSuratData || {};
                return {
                    npk: currentData.npk || '@ViewBag.Npk',
                    nama: currentData.nama || '@ViewBag.Nama',
                    plant: currentData.plant || '@ViewBag.Plant',
                    departemen: currentData.departemen || '@ViewBag.EmployeeDept',
                    alasanPermintaan: currentData.alasanPermintaan || alasanPermintaan,
                    keterangan: currentData.keterangan || keterangan,
                    skpId: currentData.skpId || urlParams.get('skpId'),
                    skp_crea_date: currentData.skp_crea_date || null,
                    skp_status: currentData.skp_status || 'Disetujui',
                    skp_modi_by_name: currentData.skp_modi_by_name || defaultNamaHC,
                    skp_modi_by_jabatan: currentData.skp_modi_by_jabatan || defaultJabatanHC
                };
            }
        }

        $(document).ready(function () {
            const urlParams = new URLSearchParams(window.location.search);
            const skpId = urlParams.get('skpId');
            const fromAdd = urlParams.get('fromAdd') === 'true';
            const alasanPermintaan = decodeURIComponent(urlParams.get('alasanPermintaan') || '');
            const keterangan = decodeURIComponent(urlParams.get('keterangan') || '');

            if (fromAdd) {
                const data = {
                    npk: '@ViewBag.Npk',
                    nama: '@ViewBag.Nama',
                    plant: '@ViewBag.Plant',
                    departemen: '@ViewBag.EmployeeDept',
                    alasanPermintaan: alasanPermintaan,
                    keterangan: keterangan,
                    skpId: null,
                    skp_crea_date: null,
                    skp_status: 'Draft',
                    skp_modi_by_name: null,
                    skp_modi_by_jabatan: null
                };

                window.currentSuratData = data;
                renderSummary(data);
                $('#suratContent').html(createSuratKeteranganContent(data));
                $('#suratInfo').text(`Draft Preview - ${data.alasanPermintaan}`);
                updateStatusBar('draft', 'Status Surat');
                $('#btnDownload').hide();
                $('#backButtonText').text('Kembali ke Form');
            }
            else if (skpId) {
                const npk = '@ViewBag.Npk';
                const plant = '@ViewBag.Plant';

                $.ajax({
                    url: `/api/PermintaanApi/skp/${npk}/${plant}`,
                    method: 'GET',
                    dataType: 'json',
                    success: function (response) {
                        let actualData = null;
                        if (response && response.code === 200) {
                            if (response.data && Array.isArray(response.data) && response.data.length > 0) {
                                const firstItem = response.data[0];
                                if (firstItem.data && Array.isArray(firstItem.data)) {
                                    actualData = firstItem.data;
                                }
                            }
                        }

                        if (!actualData || actualData.length === 0) {
                            $('#summaryContainer').html('<p style="text-align:center; color:#999;">Data tidak ditemukan</p>');
                            $('#suratContent').html('<p style="text-align:center; color:#999;">Data tidak ditemukan</p>');
                            return;
                        }

                        const skpData = actualData.find(item => item.skp_id === skpId);

                        if (!skpData) {
                            $('#summaryContainer').html('<p style="text-align:center; color:#999;">Data surat tidak ditemukan</p>');
                            $('#suratContent').html('<p style="text-align:center; color:#999;">Data surat tidak ditemukan</p>');
                            return;
                        }

                        const data = {
                            npk: skpData.kry_npk || '@ViewBag.Npk',
                            nama: skpData.kry_nama_karyawan || '@ViewBag.Nama',
                            plant: skpData.kry_plant || '@ViewBag.Plant',
                            departemen: '@ViewBag.EmployeeDept',
                            alasanPermintaan: skpData.skp_ap || alasanPermintaan,
                            keterangan: skpData.skp_ket || keterangan,
                            skpId: skpData.skp_id,
                            skp_crea_date: skpData.skp_crea_date,
                            skp_status: skpData.skp_status,
                            skp_modi_by_name: skpData.skp_modi_by_name || defaultNamaHC,
                            skp_modi_by_jabatan: skpData.skp_modi_by_jabatan || defaultJabatanHC
                        };

                        window.currentSuratData = data;
                        renderSummary(data);
                        $('#suratContent').html(createSuratKeteranganContent(data));
                        $('#suratInfo').text(`Surat Keterangan - ${data.skpId}`);

                        const statusLower = (data.skp_status || '').toLowerCase();

                        if (statusLower === 'disetujui') {
                            updateStatusBar('approved', 'Status Surat');
                            $('#btnDownload').show();
                        } else if (statusLower === 'ditolak') {
                            updateStatusBar('rejected', 'Status Surat');
                            $('#btnDownload').show();
                        } else if (statusLower.includes('menunggu') || statusLower.includes('verifikasi') || statusLower.includes('belum')) {
                            updateStatusBar('pending', 'Status Surat');
                            $('#btnDownload').hide();
                        } else {
                            updateStatusBar('draft', 'Status Surat');
                            $('#btnDownload').hide();
                        }

                        $('#backButtonText').text('Kembali');
                    },
                    error: function (xhr, status, error) {
                        console.error('AJAX Error:', error);
                        $('#summaryContainer').html('<p style="text-align:center; color:#dc2626;">Gagal memuat data dari server</p>');
                        $('#suratContent').html('<p style="text-align:center; color:#dc2626;">Gagal memuat data surat</p>');
                    }
                });
            }
            else {
                const data = {
                    npk: '@ViewBag.Npk',
                    nama: '@ViewBag.Nama',
                    plant: '@ViewBag.Plant',
                    departemen: '@ViewBag.EmployeeDept',
                    alasanPermintaan: alasanPermintaan || 'Tidak ada alasan',
                    keterangan: keterangan || 'Tidak ada keterangan',
                    skpId: null,
                    skp_crea_date: null,
                    skp_status: 'Unknown',
                    skp_modi_by_name: defaultNamaHC,
                    skp_modi_by_jabatan: defaultJabatanHC
                };

                window.currentSuratData = data;
                renderSummary(data);
                $('#suratContent').html(createSuratKeteranganContent(data));
                $('#suratInfo').text('Preview Surat');
                updateStatusBar('secondary', 'Status tidak diketahui');
                $('#btnDownload').hide();
                $('#backButtonText').text('Kembali');
            }
        });

        document.addEventListener('DOMContentLoaded', function() {
            const backBtn = document.querySelector('.back-button');
            if (backBtn) {
                backBtn.addEventListener('click', function (e) {
                    e.preventDefault();
                    handleBack();
                });
            }

            const btnKembali = document.getElementById('btnKembali');
            if (btnKembali) {
                btnKembali.addEventListener('click', function (e) {
                    e.preventDefault();
                    handleBack();
                });
            }

            document.addEventListener('keydown', function(e) {
                if (e.key === 'Escape') {
                    handleBack();
                }
            });
        });
    </script>
</body>
</html>