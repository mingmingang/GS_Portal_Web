        </div>
        <div class="data-row">
            <span class="data-label">Alasan Permintaan:</span>
            <span class="data-value">${data.alasanPermintaan}</span>
        </div>
        <div class="data-row">
            <span class="data-label">Plant:</span>
            <span class="data-value">${data.plant}</span>
        </div>
    `;

    if (data.skpId) {
        summaryHtml += `
            <div class="data-row">
                <span class="data-label">Nomor Surat:</span>
                <span class="data-value">${data.skpId}</span>
            </div>
        `;
    }

    if (data.skp_crea_date) {
        summaryHtml += `
            <div class="data-row">
                <span class="data-label">Tanggal Dibuat:</span>
                <span class="data-value">${formatDate(data.skp_crea_date)}</span>
