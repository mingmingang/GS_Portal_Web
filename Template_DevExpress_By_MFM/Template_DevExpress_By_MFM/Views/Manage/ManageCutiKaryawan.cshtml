@{
    var logSession = HttpContext.Current.Session["SHealth"] as Template_DevExpress_By_MFM.Models.SessionLogin;
    Layout = null;
    string employeeIdValue = logSession.empid ?? "";
    ViewBag.Title = "Cuti Karyawan";
    Layout = null;

    var containerClass = "cuti-page-container";
    var bodyClass = "";

    if (Layout != null)
    {
        containerClass += " content-wrapper-layout";
        bodyClass = "sidebar-open";
    }
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Menu Cuti</title>

    <!-- Memuat Library CSS (Bootstrap & Font Awesome) -->
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css" rel="stylesheet" />
    <link href="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/css/bootstrap.min.css" rel="stylesheet">

    <!-- Memuat file CSS kustom Anda -->
    <link href="~/Content/CutiStyle/CutiMenu.css" rel="stylesheet" />
    <style>
        .cuti-header-section {
            background-color: #2A458A;
            display: flex;
            justify-content: center;
            align-items: center;
            padding: 15px;
            border-bottom: 1px solid #eee; /* Mungkin tidak akan terlihat, tapi tidak apa-apa */
            /* === Perubahan Utama Dimulai di Sini === */
            position: fixed; /* Membuatnya tetap di layar */
            top: 0; /* Menempel di bagian paling atas */
            left: 0; /* Menempel di bagian paling kiri */
            width: 100%; /* Memastikan lebarnya penuh */
            z-index: 1000; /* Memastikan header selalu di atas konten lain */
            box-sizing: border-box; /* Opsional, tapi praktek yang baik agar padding tidak menambah lebar total */
        }

            .cuti-header-section .back-button {
                position: absolute;
                left: 15px;
                font-size: 1.5rem;
                color: white;
                text-decoration: none;
            }

            .cuti-header-section h1 {
                margin: 0;
                font-size: 1.2rem;
                font-weight: 600;
                color: white; /* Tambahan agar teks judul terlihat jelas */
            }
        /* Claim Action Container */
        .claim-action-container {
            margin-bottom: 28px; /* Perbesar margin */
            display: flex;
            flex-direction: column;
            align-items: center;
        }

        .action-button {
            width: 50%;
            border: none;
            padding: 16px; /* Perbesar padding */
            border-radius: 8px;
            text-align: center;
            font-size: var(--font-size-medium); /* Perbesar font */
            font-weight: 600; /* Font lebih tebal */
            cursor: pointer;
            background-color: #2f4a8f;
            color: #fff;
            transition: all 0.3s ease;
            text-decoration: none;
        }

            .action-button:hover {
                background-color: #233870;
                transform: translateY(-2px);
                box-shadow: 0 4px 8px rgba(47, 74, 143, 0.3);
                color:white;
                text-decoration:none;
            }

            .action-button:active {
                transform: translateY(0);
            }
        .filter-bar .filter-icons i {
            font-size: 20px;
            color: #1E2D56;
            cursor: pointer;
        }

        /* --- CSS BARU UNTUK MODAL PANDUAN (SESUAI GAMBAR) --- */
        /* --- CSS LENGKAP UNTUK MODAL PANDUAN --- */

        /* Menata ulang keseluruhan modal content */
        #panduanModal.modal-content {
            padding: 24px;
            border-radius: 16px;
        }

        /* Header baru */
        .modal-header-new {
            display: flex;
            align-items: center;
            gap: 12px;
            margin-bottom: 16px;
        }

        .icon-bg-new {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            width: 40px;
            height: 40px;
            background-color: #E0E7FF;
            border-radius: 8px;
            color: #3730A3;
            font-size: 20px;
        }

        .modal-title-new {
            margin: 0;
            font-size: 20px;
            font-weight: bold;
            color: #1F2937;
        }

        /* Teks pengantar */
        .modal-intro-text {
            font-size: 15px;
            color: #4B5563;
            margin-bottom: 24px;
        }

        /* Body/List Status baru */
        .modal-body-new {
            display: flex;
            flex-direction: column;
            gap: 20px;
            max-height: 50vh; /* Agar bisa di-scroll di layar kecil */
            overflow-y: auto; /* Aktifkan scroll vertikal jika perlu */
        }

        .status-guide-item-new {
            display: grid;
            grid-template-columns: 160px 1fr; /* Kolom badge 160px */
            align-items: center;
            gap: 15px;
        }

        .status-guide-badge {
            padding: 6px 12px;
            border-radius: 6px;
            font-size: 14px;
            font-weight: 500;
            text-align: center;
            white-space: nowrap; /* Mencegah teks badge turun baris */
        }

        .status-guide-desc {
            margin: 0;
            font-size: 14px;
            color: #4B5563;
            line-height: 1.5;
        }

        /* --- Warna-warna Lengkap untuk Semua Badge Cuti --- */
        .badge-draft {
            background-color: #F3F4F6; /* Abu-abu muda */
            color: #4B5563;
        }

        .badge-pending {
            background-color: #FEF3C7; /* Kuning muda */
            color: #9A5B03;
        }

        .badge-approved {
            background-color: #DBEAFE; /* Biru muda */
            color: #1E40AF;
        }

        .badge-closed {
            background-color: #D1FAE5; /* Hijau muda */
            color: #065F46;
        }

        .badge-rejected {
            background-color: #FEE2E2; /* Merah muda */
            color: #991B1B;
        }

        .badge-cancelled {
            background-color: #FFEDD5; /* Oranye muda */
            color: #9A3412;
        }


        /* Footer dan tombol baru */
        .modal-footer-new {
            margin-top: 24px;
        }

        .modal-confirm-btn {
            width: 100%;
            padding: 12px;
            background-color: #2f4a8f;
            color: white;
            border: none;
            border-radius: 8px;
            font-size: 16px;
            font-weight: 500;
            cursor: pointer;
            transition: background-color 0.2s ease;
        }

            .modal-confirm-btn:hover {
                background-color: #2f4a8f;
            }

        /* --- CSS BARU UNTUK MODAL FILTER TAHUN --- */

        /* Menata ulang keseluruhan modal content */
        #filterTahunModal.modal-content {
            padding: 20px;
            border-radius: 16px;
            width: 90%;
            max-width: 350px;
        }

        /* Header baru */
        .filter-modal-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 24px;
        }

        .filter-modal-title {
            margin: 0;
            font-size: 18px;
            font-weight: bold;
            color: #2A458A;
        }

        .filter-back-icon, .filter-help-icon {
            font-size: 20px;
            color: #2A458A;
            cursor: pointer;
        }

        /* Body dan Year Picker */
        .filter-modal-body {
            text-align: center;
        }

        .year-picker-container {
            user-select: none; /* Mencegah teks tahun ter-highlight saat di-klik */
        }

        .year-chevron {
            font-size: 28px;
            color: #2A458A;
            cursor: pointer;
            padding: 10px;
        }

        .year-display {
            margin: 10px 0;
        }

        .year-text-active {
            font-size: 48px;
            font-weight: bold;
            color: #2A458A;
            margin: 8px 0;
        }

        .year-text-inactive {
            font-size: 24px;
            color: #D1D5DB; /* Abu-abu muda */
            font-weight: 500;
        }

        /* Footer dan Tombol "Terapkan" */
        .filter-modal-footer {
            margin-top: 24px;
        }

        .apply-button {
            width: 100%;
            padding: 14px;
            background-color: #2A458A;
            color: white;
            border: none;
            border-radius: 12px;
            font-size: 16px;
            font-weight: 500;
            cursor: pointer;
            transition: background-color 0.2s ease;
        }

            .apply-button:hover {
                background-color: #233870;
            }

        /* Sembunyikan header dan body lama dari filter modal agar tidak bentrok */
        #filterTahunModal .modal-header, #filterTahunModal .modal-body {
            display: none;
        }
    </style>
</head>
<body>


    <!--
      Struktur HTML utama untuk halaman Cuti.
      data-employee-id digunakan untuk mengirim ID karyawan ke JavaScript.
    -->
    <div class="cuti-page-container" data-employee-id="@employeeIdValue">
        <div class="cuti-header">
            <div class="cuti-header-section">
                <a href="@Url.Action("Index", "Home")" class="back-button" aria-label="Kembali ke Dashboard">
                    <i class="fas fa-arrow-left"></i>
                </a>
                <h1>Menu Cuti</h1>
            </div>
        </div>

        <div class="cuti-tabs" style="margin-top:80px;">
            <div class="cuti-tab-item active" data-tab-code="CP">Cuti Pribadi</div>
            <div class="cuti-tab-item" data-tab-code="CB">Cuti Besar</div>
            <div class="cuti-tab-item" data-tab-code="CK">Cuti Khusus</div>
        </div>

        <div class="cuti-main-content">
            <div class="filter-bar">
                <span class="date-range">Loading...</span>
                <div class="filter-icons">
                    <i class="fas fa-book" id="panduanBtn"></i>
                    <i class="fas fa-filter" id="filterBtn"></i>
                </div>
            </div>

            <div id="summary-card-container" class="summary-card">
                <table class="summary-table">
                    <tbody id="summary-tbody">
                        <tr><td colspan="2" style="text-align:center;">Memuat data...</td></tr>
                    </tbody>
                </table>
            </div>

            <div id="masa-berlaku-container" class="masa-berlaku" style="margin-bottom:20px;">
                <i class="fas fa-calendar-alt"></i>
                <span id="masa-berlaku-text">Masa berlaku cuti sampai dengan: <span class="date-highlight">...</span></span>
            </div>

            <div class="claim-action-container">
                <a class="action-button" id="idCardActionButton" href="@Url.Action("ManageAddCuti", "Manage")">
                    Ajukan Pengajuan Cuti
                </a>
            </div>

            <div class="status-filter-container">
                <span class="status-filter-badge active" data-status="Semua">Semua</span>
                <span class="status-filter-badge" data-status="Draft">Draft</span>
                <span class="status-filter-badge" data-status="Disetujui">Disetujui</span>
                <span class="status-filter-badge" data-status="Menunggu Persetujuan">Menunggu Persetujuan</span>
                <span class="status-filter-badge" data-status="Ditolak">Ditolak</span>
                <span class="status-filter-badge" data-status="Dibatalkan">Dibatalkan</span>
            </div>

            <div class="cuti-list-container"></div>

            <div class="no-data-message" style="display: block;">Memuat daftar cuti...</div>

            <div id="pagination-controls" class="pagination-controls" style="display: none;">
                <button id="prev-page-btn" class="pagination-btn">&laquo; Sebelumnya</button>
                <span id="page-info"></span>
                <button id="next-page-btn" class="pagination-btn">Berikutnya &raquo;</button>
            </div>
        </div>

        @*<a  href="@Url.Action("ManageAddCuti", "Manage")" class="add">+</a>*@
    </div>

    <!-- Struktur HTML untuk Modals -->
    <div id="modalBackdrop" class="modal-backdrop">

        <div id="panduanModal" class="modal-content" style="display: none;">

            <!-- Bagian Header Modal -->
            <div class="modal-header-new">
                <span class="icon-bg-new"><i class="fas fa-book-open"></i></span>
                <h2 class="modal-title-new">Panduan Status Cuti</h2>
            </div>

            <!-- Bagian Isi/List Status -->
            <div class="modal-body-new">

                <!-- Item Status: Draft -->
                <div class="status-guide-item-new">
                    <span class="status-guide-badge badge-draft">Draft</span>
                    <p class="status-guide-desc">Pengajuan cuti yang telah Anda simpan namun belum diajukan.</p>
                </div>

                <!-- Item Status: Menunggu Persetujuan -->
                <div class="status-guide-item-new">
                    <span class="status-guide-badge badge-pending">Menunggu Persetujuan</span>
                    <p class="status-guide-desc">Cuti masih dalam tahap persetujuan dari atasan.</p>
                </div>

                <!-- Item Status: Disetujui -->
                <div class="status-guide-item-new">
                    <span class="status-guide-badge badge-approved">Disetujui</span>
                    <p class="status-guide-desc">Cuti telah disetujui namun belum tanggal pelaksanaannya.</p>
                </div>

                <!-- Item Status: Terlaksana -->
                <div class="status-guide-item-new">
                    <span class="status-guide-badge badge-closed">Terlaksana</span>
                    <p class="status-guide-desc">Cuti telah Anda laksanakan dan tidak dapat dibatalkan.</p>
                </div>

                <!-- Item Status: Ditolak -->
                <div class="status-guide-item-new">
                    <span class="status-guide-badge badge-rejected">Ditolak</span>
                    <p class="status-guide-desc">Pengajuan cuti Anda tidak disetujui oleh atasan.</p>
                </div>

                <!-- Item Status: Dibatalkan -->
                <div class="status-guide-item-new">
                    <span class="status-guide-badge badge-cancelled">Dibatalkan</span>
                    <p class="status-guide-desc">Pengajuan cuti yang telah Anda batalkan.</p>
                </div>

            </div>

            <!-- Bagian Footer dengan Tombol -->
            <div class="modal-footer-new">
                <button id="closePanduanBtn" class="modal-confirm-btn">Mengerti</button>
            </div>

        </div>

        <div id="filterTahunModal" class="modal-content" style="display: none;">

            <div class="filter-modal-header">
                <i class="fas fa-chevron-left filter-back-icon"></i>
                <h2 class="filter-modal-title">Filter Tahun</h2>
                <i class="fas fa-question-circle filter-help-icon"></i>
            </div>

            <!-- Bagian Isi/Picker Tahun Baru -->
            <div class="filter-modal-body">
                <div id="year-picker-container" class="year-picker-container">
                    <!-- Konten ini akan diisi oleh JavaScript -->
                </div>
            </div>

            <!-- Bagian Footer dengan Tombol Terapkan -->
            <div class="filter-modal-footer">
                <button id="applyYearFilterBtn" class="apply-button">Terapkan</button>
            </div>

        </div>
    </div>

    <!-- Memuat Library JavaScript (jQuery harus pertama) -->
    <script src="https://code.jquery.com/jquery-3.5.1.min.js"></script>
    <script src="~/Scripts/CutiScript/CutiMenu.js"></script>
</body>
</html>