@section Scripts {
    <script>
$(document).ready(function () {
   @{
    string employeeIdValue = "";
    if (logSession != null)
    {
        employeeIdValue = logSession.npk;
    }
}
    const employeeId = '@employeeIdValue';
    let currentYear = 2020;

    var backdrop = $('#modalBackdrop');
    var panduanModal = $('#panduanModal');
    var filterTahunModal = $('#filterTahunModal');

    function openModal(modalElement) {
        backdrop.addClass('show');
        modalElement.show();
    }

    function closeModal() {
        backdrop.removeClass('show');
        panduanModal.hide();
        filterTahunModal.hide();
    }

    $('#panduanBtn').on('click', function () {
        openModal(panduanModal);
    });

    $('#filterBtn').on('click', function () {
        openModal(filterTahunModal);
    });

    $('.modal-close-btn').on('click', function () {
        closeModal();
    });

    backdrop.on('click', function (e) {
        if ($(e.target).is(backdrop)) {
            closeModal();
        }
    });


    function loadSummaryData(leaveCode) {
        if (!employeeId) return;

        const fromDate = `${currentYear}-01-01`;
        const toDate = `${currentYear}-12-31`;

        const url = `/api/CutiApi/listJatahCuti?emp_id=${employeeId}&leave_code=${leaveCode}&from=${fromDate}&to=${toDate}`;
        const $summaryTbody = $('#summary-tbody');
        const $masaBerlakuText = $('#masa-berlaku-text');

        $summaryTbody.html('<tr><td colspan="2" style="text-align:center;">Memuat data...</td></tr>');
        $masaBerlakuText.find('.date-highlight').text('...');

        $.ajax({
            url: url,
            type: 'GET',
            success: function (response) {
                if (response && response.data && response.data.length > 0) {
                    const data = response.data[0]; 

                    const totalEntitlement = (data.entitlement || 0) + (data.bringforward || 0) + (data.adjustment || 0);

                    const summaryHtml = `
                        <tr><td>Hak Cuti</td><td>${totalEntitlement.toFixed(2)}</td></tr>
                        <tr><td>Pemakaian Cuti</td><td>${(data.used || 0).toFixed(2)}</td></tr>
                        <tr id="cuti-on-progress-row"><td>Cuti On Progress</td><td>0.00</td></tr>
                        <tr class="sisa-cuti"><td>Sisa Cuti</td><td>${(data.remaining || 0).toFixed(2)}</td></tr>
                    `;
                    $summaryTbody.html(summaryHtml);

                    if(data.endvaliddate) {
                        const options = { year: 'numeric', month: 'long', day: 'numeric' };
                        const endDate = new Date(data.endvaliddate);
                        $masaBerlakuText.find('.date-highlight').text(endDate.toLocaleDateString('id-ID', options));
                    } else {
                         $masaBerlakuText.find('.date-highlight').text('Tidak terbatas');
                    }

                } else {
                    $summaryTbody.html('<tr><td colspan="2" style="text-align:center;">Data jatah cuti tidak ditemukan.</td></tr>');
                    $masaBerlakuText.find('.date-highlight').text('-');
                }
            },
            error: function () {
                $summaryTbody.html('<tr><td colspan="2" style="text-align:center;">Gagal memuat data.</td></tr>');
                 $masaBerlakuText.find('.date-highlight').text('-');
            }
        });
    }

    function loadCutiList(year) {
        if (!employeeId) return;

        const fromDate = `01/01/${year}`;
        const toDate = `31/12/${year}`;
        const url = `/api/CutiApi/listCuti?emp_id=${employeeId}&from=${fromDate}&to=${toDate}`;

        const $listContainer = $('.cuti-list-container');
        const $noDataMessage = $('.no-data-message');

        $listContainer.html(''); 
        $noDataMessage.text('Memuat daftar cuti...').show();

        $.ajax({
            url: url,
            type: 'GET',
            success: function (response) {
                console.log("daftar cuti", response);
                $noDataMessage.hide();
                if (response && response.data && response.data.length > 0) {
                    let onProgressCount = 0;

                    response.data.forEach(cuti => {
                        let statusText = mapStatus(cuti.request_status);
                        let statusClass = 'status-' + statusText.toLowerCase().replace(/ /g, '-');

                        const startDate = new Date(cuti.startdate).toLocaleDateString('id-ID', { day: '2-digit', month: 'short', year: 'numeric' });
                        const endDate = new Date(cuti.enddate).toLocaleDateString('id-ID', { day: '2-digit', month: 'short', year: 'numeric' });

                        const canCancel = statusText !== 'Terlaksana' && statusText !== 'Ditolak' && statusText !== 'Dibatalkan';

                        const cardHtml = `
                            <div class="cuti-item-card" data-category="${cuti.leave_code}" data-status="${statusText}">
                                <div class="cuti-item-header">
                                    <span class="cuti-id">${cuti.request_no}</span>
                                    <div>
                                        <span class="cuti-item-status ${statusClass}">${statusText}</span>
                                        ${canCancel ? `<button class="cuti-item-cancel-btn" data-id="${cuti.request_no}">X</button>` : ''}
                                    </div>
                                </div>
                                <div class="cuti-item-body"><div class="cuti-type">${cuti.leave_code}</div></div>
                                <div class="cuti-item-footer">
                                    <div class="date-info"><i class="fas fa-clock"></i> <span>${startDate} s/d ${endDate}</span></div>
                                   <a href="/Manage/ManageDetailCuti?id=${cuti.request_no}" class="lihat-link">Lihat &rarr;</a>
                                </div>
                            </div>
                        `;
                        $listContainer.append(cardHtml);

                        if (statusText === 'Menunggu Persetujuan') {
                            onProgressCount += cuti.totaldays;
                        }
                    });

                    $('#cuti-on-progress-row td:last-child').text(onProgressCount.toFixed(2));
                } else {
                    $noDataMessage.text('Tidak ada data pengajuan cuti di tahun ini.').show();
                }
                updateCutiListView(); 
            },
            error: function () {
                $noDataMessage.text('Gagal memuat daftar pengajuan cuti.').show();
            }
        });
    }


    function mapStatus(apiStatus) {
        const statusMap = {
            "Fully Approved": "Terlaksana",
            "Closed": "Terlaksana",
            "Pending": "Menunggu Persetujuan",
            "Rejected": "Ditolak",
            "Cancelled": "Dibatalkan",
        };
        return statusMap[apiStatus] || apiStatus;
    }

    function updateCutiListView() {
        var selectedCategoryCode = $('.cuti-tab-item.active').data('tab-code'); 
        var selectedStatus = $('.status-filter-badge.active').data('status'); 
        let visibleCount = 0;

        $('.cuti-item-card').each(function () {
            var cardCategoryApi = $(this).data('category');
            var cardStatus = $(this).data('status');



            let categoryMatch = false;
            if (selectedCategoryCode === 'CP' && cardCategoryApi.includes('CP - Cuti Pribadi')) {
                categoryMatch = true;
            } else if (selectedCategoryCode === 'CB' && cardCategoryApi.includes('Cuti Besar')) {
                categoryMatch = true;
            } else if (selectedCategoryCode === 'CK' && cardCategoryApi.includes('Cuti Khusus')) { 
                categoryMatch = true;
            }


            var statusMatch = (selectedStatus === 'Semua') || (cardStatus === selectedStatus);
            if (selectedStatus === 'Terlaksana' && (cardStatus === 'Terlaksana' || cardStatus === 'Belum Terlaksana')) {
                statusMatch = true;
            }

            if (categoryMatch && statusMatch) {
                $(this).show();
                visibleCount++;
            } else {
                $(this).hide();
            }
        });

        const $noDataMessage = $('.no-data-message');
        const totalCardsInList = $('.cuti-list-container .cuti-item-card').length;

        if (visibleCount > 0) {
            $noDataMessage.hide();
        } else {
            if (totalCardsInList > 0) {
                $noDataMessage.text('Tidak ada data cuti untuk filter ini.').show();
            } else {
               
                $noDataMessage.show(); 
            }
        }
    }

    $('.cuti-tab-item').on('click', function () {
        $('.cuti-tab-item').removeClass('active');
        $(this).addClass('active');

        const selectedLeaveCode = $(this).data('tab-code');
        const $summaryCard = $('#summary-card-container');
        const $masaBerlaku = $('#masa-berlaku-container'); 

        if (selectedLeaveCode === 'CK') {
            $summaryCard.hide();
            $masaBerlaku.hide(); 
        } else {
            $summaryCard.show();
            $masaBerlaku.show(); 
            loadSummaryData(selectedLeaveCode);
        }

        updateCutiListView();
    });


    $('.status-filter-badge').on('click', function () {
        $('.status-filter-badge').removeClass('active');
        $(this).addClass('active');
        updateCutiListView();
    });

    // ... (Kode event handler untuk modal tetap sama) ...
    $('.year-item').on('click', function () {
       var selectedYear = $(this).text().trim();
       currentYear = parseInt(selectedYear); // Update variabel global
       // ... (Logika update UI filter tahun) ...

       // Panggil ulang semua fungsi data dengan tahun baru
       const activeLeaveCode = $('.cuti-tab-item.active').data('tab-code');
       loadSummaryData(activeLeaveCode); // Summary biasanya terkait tahun ini
       loadCutiList(currentYear);
    });

    function initializePage() {
        $('.date-range').text('1 Januari ' + currentYear + ' - 31 Desember ' + currentYear);
        const initialLeaveCode = $('.cuti-tab-item.active').data('tab-code');
        loadSummaryData(initialLeaveCode);
        loadCutiList(currentYear);
    }

    initializePage();
});
    </script>
}