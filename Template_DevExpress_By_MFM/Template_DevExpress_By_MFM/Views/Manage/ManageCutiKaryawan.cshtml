@{
    var logSession = HttpContext.Current.Session["SHealth"] as Template_DevExpress_By_MFM.Models.SessionLogin;
    Layout = null;
    string employeeIdValue = logSession.empid ?? "";
    ViewBag.Title = "Cuti Karyawan";
    Layout = null;

    var containerClass = "cuti-page-container";
    var bodyClass = "";

    if (Layout != null)
    {
        containerClass += " content-wrapper-layout";
        bodyClass = "sidebar-open";
    }
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Menu Cuti</title>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css" rel="stylesheet" />
    <link href="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/css/bootstrap.min.css" rel="stylesheet">
    <link href="~/Content/CutiStyle/CutiMenu.css" rel="stylesheet" />
    <style>
            .cuti-header-section {
                background-color: #2A458A;
                display: flex;
                justify-content: center;
                align-items: center;
                padding: 15px;
                border-bottom: 1px solid #eee;
                position: fixed;
                top: 0;
                left: 0;
                width: 100%;
                z-index: 1000;
                box-sizing: border-box;
            }

            .cuti-header-section .back-button {
                position: absolute;
                left: 15px;
                font-size: 1.5rem;
                color: white;
                text-decoration: none;
            }

            .cuti-header-section h1 {
                margin: 0;
                font-size: 1.2rem;
                font-weight: 600;
                color: white;
            }

            .claim-action-container {
                margin-bottom: 28px;
                display: flex;
                flex-direction: column;
                align-items: center;
            }

            .action-button {
                width: 50%;
                border: none;
                padding: 16px;
                border-radius: 8px;
                text-align: center;
                font-size: var(--font-size-medium);
                font-weight: 600;
                cursor: pointer;
                background-color: #1E2D56;
                color: #fff;
                transition: all 0.3s ease;
                text-decoration: none;
            }

            .action-button:hover {
                background-color: #233870;
                transform: translateY(-2px);
                box-shadow: 0 4px 8px rgba(47, 74, 143, 0.3);
                color:white;
                text-decoration:none;
            }

            .action-button:active {
                transform: translateY(0);
            }

            .filter-bar .filter-icons i {
                font-size: 20px;
                color: #1E2D56;
                cursor: pointer;
            }

            #panduanModal.modal-content {
                padding: 24px;
                border-radius: 16px;
            }

            .modal-header-new {
                display: flex;
                align-items: center;
                gap: 12px;
                margin-bottom: 16px;
            }

            .icon-bg-new {
                display: inline-flex;
                align-items: center;
                justify-content: center;
                width: 40px;
                height: 40px;
                background-color: #E0E7FF;
                border-radius: 8px;
                color: #3730A3;
                font-size: 20px;
            }

            .modal-title-new {
                margin: 0;
                font-size: 20px;
                font-weight: bold;
                color: #1F2937;
            }

            .modal-intro-text {
                font-size: 15px;
                color: #4B5563;
                margin-bottom: 24px;
            }

            .modal-body-new {
                display: flex;
                flex-direction: column;
                gap: 20px;
                max-height: 50vh;
                overflow-y: auto;
            }

            .status-guide-item-new {
                display: grid;
                grid-template-columns: 160px 1fr;
                align-items: center;
                gap: 15px;
            }

            .status-guide-badge {
                padding: 6px 12px;
                border-radius: 6px;
                font-size: 11px;
                font-weight: 500;
                text-align: center;
                white-space: nowrap;
            }

            .status-guide-desc {
                margin: 0;
                font-size: 14px;
                color: #4B5563;
                line-height: 1.5;
            }

            .badge-draft {
                background-color: #F3F4F6;
                color: #4B5563;
            }

            .badge-pending {
                background-color: #cfe2ff;
                color: #0d6efd;
            }

            .badge-pending-hc {
                background-color: #FEF3C7;
                color: #9A5B03;
            }

            .badge-approved {
                background-color: #dac8ff;
                color: #7b20ff;
            }

            .badge-closed {
                background-color: #D1FAE5;
                color: #065F46;
            }

            .badge-rejected {
                background-color: #FEE2E2;
                color: #991B1B;
            }

            .badge-cancelled {
                background-color: #FFEDD5;
                color: #9A3412;
            }

            .status-disetujui, .status-terlaksana {
                background-color: #D1FAE5;
                color: #065F46;
            }

            .status-belum-terlaksana {
                background-color: #dac8ff;
                color: #7b20ff;
            }

            .status-disetujui-sebagian {
                background-color: #FEF3C7;
                color: #9A5B03;
            }

            .status-menunggu-persetujuan, .status-direvisi {
                background-color: #cfe2ff;
                color: #0d6efd;
            }

            .status-ditolak {
                background-color: #FEE2E2;
                color: #991B1B;
            }
            .status-dibatalkan {
                background-color: #FFEDD5;
                color: #9A3412;
            }

            .status-draft {
                background-color: var(--grey-status-bg);
                color: var(--grey-status);
            }

            .cuti-item-cancel-btn{
                margin-left:0;
            }

            .modal-footer-new {
                margin-top: 24px;
            }

            .modal-confirm-btn {
                width: 100%;
                padding: 12px;
                background-color: #2f4a8f;
                color: white;
                border: none;
                border-radius: 8px;
                font-size: 16px;
                font-weight: 500;
                cursor: pointer;
                transition: background-color 0.2s ease;
            }

            .modal-confirm-btn:hover {
                background-color: #2f4a8f;
            }

            #filterTahunModal.modal-content {
                padding: 20px;
                border-radius: 16px;
                width: 90%;
                max-width: 350px;
            }

            .filter-modal-header {
                display: flex;
                justify-content: space-between;
                align-items: center;
                margin-bottom: 24px;
            }

            .filter-modal-title {
                margin: 0;
                font-size: 18px;
                font-weight: bold;
                color: #2A458A;
            }

            .filter-back-icon, .filter-help-icon {
                font-size: 20px;
                color: #2A458A;
                cursor: pointer;
            }

            .filter-modal-body {
                text-align: center;
            }

            .year-picker-container {
                user-select: none;
            }

            .year-chevron {
                font-size: 28px;
                color: #2A458A;
                cursor: pointer;
                padding: 10px;
            }

            .year-display {
                margin: 10px 0;
            }

            .year-text-active {
                font-size: 48px;
                font-weight: bold;
                color: #2A458A;
                margin: 8px 0;
            }

            .year-text-inactive {
                font-size: 24px;
                color: #D1D5DB;
                font-weight: 500;
            }

            .filter-modal-footer {
                margin-top: 24px;
            }

            .status-menunggu-persetujuan-hc {
                background-color: #FEF3C7;
                color: #9A5B03;
            }

            .apply-button {
                width: 100%;
                padding: 14px;
                background-color: #2A458A;
                color: white;
                border: none;
                border-radius: 12px;
                font-size: 16px;
                font-weight: 500;
                cursor: pointer;
                transition: background-color 0.2s ease;
            }

            .apply-button:hover {
                background-color: #233870;
            }

            #filterTahunModal .modal-header, #filterTahunModal .modal-body {
                display: none;
            }

            .cuti-header-section {
                background-color: #2A458A;
                background: linear-gradient(135deg, #1E2D56 0%, #2A4A7B 100%);
            }

            .status-filter-badge.active {
                background-color: #1E2D56;
            }

            .summary-cards-grid {
                display: grid;
                grid-template-columns: repeat(4, 1fr);
                gap: 15px;
                margin-bottom: 25px;
            }

            .summary-card-item {
                background-color: #fff;
                border: 1px solid #eee;
                border-radius: 12px;
                padding: 15px;
                display: flex;
                align-items: center;
                gap: 12px;
                box-shadow: 0 2px 5px rgba(0,0,0,0.03);
                transition: transform 0.2s;
            }

            .summary-card-item:hover {
                transform: translateY(-2px);
                box-shadow: 0 4px 10px rgba(0,0,0,0.08);
            }

            .icon-box {
                width: 42px;
                height: 42px;
                border-radius: 10px;
                display: flex;
                align-items: center;
                justify-content: center;
                font-size: 18px;
            }
            .blue-box   { background-color: #E3F2FD; color: #1565C0; }
            .green-box  { background-color: #E8F5E9; color: #2E7D32; }
            .orange-box { background-color: #FFF3E0; color: #EF6C00; }
            .purple-box { background-color: #F3E5F5; color: #7B1FA2; }

            .info-box { display: flex; flex-direction: column; }
            .label-text { font-size: 12px; color: #888; font-weight: 500; }
            .value-text { font-size: 20px; color: #333; font-weight: 700; line-height: 1.2; }
            .main-value { color: #2A458A; }

            .highlight-card { border: 1px solid #D1C4E9; background-color: #FAFAFA; }

            @@media (max-width: 768px) {
                .summary-cards-grid { grid-template-columns: repeat(2, 1fr); }
            }
    </style>
</head>
<body>
    <div class="cuti-page-container" data-employee-id="@employeeIdValue">
        <div class="cuti-header">
            <div class="cuti-header-section">
                <a href="@Url.Action("Index", "Home")" class="back-button" aria-label="Kembali ke Dashboard">
                    <i class="fas fa-arrow-left"></i>
                </a>
                <h1>Menu Cuti</h1>
            </div>
        </div>

        <div class="cuti-tabs" style="margin-top:80px;">
            <div class="cuti-tab-item active" data-tab-code="CP">Cuti Pribadi</div>
            <div class="cuti-tab-item" data-tab-code="CB">Cuti Besar</div>
            <div class="cuti-tab-item" data-tab-code="CK">Cuti Khusus</div>
        </div>

        <div class="cuti-main-content">
            <div class="filter-bar">
                <span class="date-range">Loading...</span>
                <div class="filter-icons">
                    <i class="fas fa-book" id="panduanBtn"></i>
                    <i class="fas fa-filter" id="filterBtn"></i>
                </div>
            </div>

            <div id="summary-cards-wrapper" class="summary-cards-grid">

                <div class="summary-card-item">
                    <div class="icon-box blue-box"><i class="fas fa-calendar-check"></i></div>
                    <div class="info-box">
                        <span class="label-text">Hak Cuti</span>
                        <span class="value-text" id="val-hak-cuti">0</span>
                    </div>
                </div>

                <div class="summary-card-item">
                    <div class="icon-box green-box"><i class="fas fa-check-circle"></i></div>
                    <div class="info-box">
                        <span class="label-text">Terpakai</span>
                        <span class="value-text" id="val-terpakai">0</span>
                    </div>
                </div>

                <div class="summary-card-item">
                    <div class="icon-box orange-box"><i class="fas fa-spinner"></i></div>
                    <div class="info-box">
                        <span class="label-text">Proses</span>
                        <span class="value-text" id="val-on-progress">0</span>
                    </div>
                </div>

                <div class="summary-card-item highlight-card">
                    <div class="icon-box purple-box"><i class="fas fa-wallet"></i></div>
                    <div class="info-box">
                        <span class="label-text">Sisa Cuti</span>
                        <span class="value-text main-value" id="val-sisa-cuti">0</span>
                    </div>
                </div>

            </div>

            <input type="hidden" id="hidden-total-entitlement" value="0">

            <div id="masa-berlaku-container" class="masa-berlaku" style="margin-bottom:20px; text-align:center; font-size:0.9rem; color:#666;">
                <i class="fas fa-calendar-alt"></i>
                <span id="masa-berlaku-text">Masa berlaku sampai dengan: <span class="date-highlight" style="font-weight:bold; color:#2A458A;">-</span></span>
            </div>

            <div class="claim-action-container">
                <a class="action-button" href="@Url.Action("ManageTambahCuti", "Manage")">
                    Ajukan Pengajuan Cuti
                </a>
            </div>

            <div class="status-filter-container">
                <span class="status-filter-badge active" data-status="Semua">Semua</span>
                <span class="status-filter-badge" data-status="Draft">Draft</span>
                <span class="status-filter-badge" data-status="Disetujui">Disetujui</span>
                <span class="status-filter-badge" data-status="Menunggu Persetujuan">Menunggu Persetujuan</span>
                <span class="status-filter-badge" data-status="Ditolak">Ditolak</span>
                <span class="status-filter-badge" data-status="Dibatalkan">Dibatalkan</span>
            </div>

            <div class="cuti-list-container"></div>

            <div class="no-data-message" style="display: block;">Memuat daftar cuti...</div>
        </div>
    </div>

    <div id="modalBackdrop" class="modal-backdrop">

        <div id="panduanModal" class="modal-content" style="display: none;">
            <div class="modal-header-new">
                <span class="icon-bg-new"><i class="fas fa-book-open"></i></span>
                <h2 class="modal-title-new">Panduan Status Cuti</h2>
            </div>
            <div class="modal-body-new">
                <div class="status-guide-item-new">
                    <span class="status-guide-badge badge-draft">Draft</span>
                    <p class="status-guide-desc">Pengajuan cuti yang telah Anda simpan namun belum diajukan.</p>
                </div>
                <div class="status-guide-item-new">
                    <span class="status-guide-badge badge-pending">Menunggu Persetujuan</span>
                    <p class="status-guide-desc">Cuti masih dalam tahap persetujuan dari Atasan.</p>
                </div>

                <div class="status-guide-item-new">
                    <span class="status-guide-badge badge-pending-hc">Menunggu Persetujuan</span>
                    <p class="status-guide-desc">Cuti masih dalam tahap persetujuan dari Human Capital.</p>
                </div>
                <div class="status-guide-item-new">
                    <span class="status-guide-badge badge-approved">Belum Terlaksana</span>
                    <p class="status-guide-desc">Cuti telah disetujui namun belum tanggal pelaksanaannya.</p>
                </div>
                <div class="status-guide-item-new">
                    <span class="status-guide-badge badge-closed">Terlaksana</span>
                    <p class="status-guide-desc">Cuti telah Anda laksanakan dan tidak dapat dibatalkan.</p>
                </div>
                <div class="status-guide-item-new">
                    <span class="status-guide-badge badge-rejected">Ditolak</span>
                    <p class="status-guide-desc">Pengajuan cuti Anda tidak disetujui oleh atasan.</p>
                </div>
                <div class="status-guide-item-new">
                    <span class="status-guide-badge badge-cancelled">Dibatalkan</span>
                    <p class="status-guide-desc">Pengajuan cuti yang telah Anda batalkan.</p>
                </div>
            </div>
            <div class="modal-footer-new">
                <button id="closePanduanBtn" class="modal-confirm-btn">Mengerti</button>
            </div>

        </div>

        <div id="filterTahunModal" class="modal-content" style="display: none;">

            <div class="filter-modal-header">
                <i class="fas fa-chevron-left filter-back-icon"></i>
                <h2 class="filter-modal-title">Filter Tahun</h2>
                <i class="fas fa-question-circle filter-help-icon"></i>
            </div>
            <div class="filter-modal-body">
                <div id="year-picker-container" class="year-picker-container">
                </div>
            </div>


            <div class="filter-modal-footer">
                <button id="applyYearFilterBtn" class="apply-button">Terapkan</button>
            </div>

        </div>
    </div>
    <script src="https://code.jquery.com/jquery-3.5.1.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    @*<script src="~/Scripts/CutiScript/CutiMenu.js"></script>*@

    <script>

        const CutiApp = {
            state: {
                employeeId: null,
                currentYear: new Date().getFullYear(),
                allCutiData: [],
                filteredData: [],
                currentRemainingBalance: 0,
                //currentPage: 1,
                //itemsPerPage: 6,
            },

            elements: {
                container: null,
                summaryTbody: null,
                masaBerlakuText: null,
                listContainer: null,
                noDataMessage: null,
                //paginationControls: null,
                backdrop: null,
                panduanModal: null,
                filterTahunModal: null,
                yearList: null,
            },

            init: function () {
                this.state.employeeId = $('.cuti-page-container').data('employee-id');
                if (!this.state.employeeId) {
                    console.error("Employee ID not found!");
                    return;
                }
                this.cacheDOMElements();
                this.bindEvents();
                this.loadInitialData();
                this.updateActionButton();
            },

            cacheDOMElements: function () {
                this.elements.container = $('.cuti-page-container');
                this.elements.summaryTbody = $('#summary-tbody');
                this.elements.masaBerlakuText = $('#masa-berlaku-text');
                this.elements.listContainer = $('.cuti-list-container');
                this.elements.noDataMessage = $('.no-data-message');
                //this.elements.paginationControls = $('#pagination-controls');
                this.elements.backdrop = $('#modalBackdrop');
                this.elements.panduanModal = $('#panduanModal');
                this.elements.filterTahunModal = $('#filterTahunModal');
                this.elements.yearList = $('.year-list');
                this.elements.actionButton = $('.action-button');
            },

            bindEvents: function () {
                const self = this;

                this.elements.actionButton.on('click', function (e) {
                    const selectedTab = $('.cuti-tab-item.active').data('tab-code');
                    const sisa = self.state.currentRemainingBalance;

                    if (selectedTab !== 'CK' && sisa <= 0) {
                        e.preventDefault();

                        Swal.fire({
                            icon: 'error',
                            title: 'Sisa Cuti Habis',
                            text: 'Anda tidak dapat mengajukan cuti karena sisa cuti Anda sudah 0.',
                            confirmButtonColor: '#2A458A'
                        });
                    }
                });

                this.elements.container.on('click', '.cuti-tab-item', function () {
                    $('.cuti-tab-item').removeClass('active');
                    $(this).addClass('active');
                    self.handleTabChange();
                });

                this.elements.container.on('click', '.status-filter-badge', function () {
                    $('.status-filter-badge').removeClass('active');
                    $(this).addClass('active');
                    self.updateCutiListView();
                });

                //$('#prev-page-btn').on('click', () => self.changePage(-1));
                //$('#next-page-btn').on('click', () => self.changePage(1));

                $('#panduanBtn').on('click', () => self.openModal(self.elements.panduanModal));
                $('#filterBtn').on('click', () => {
                    self.renderYearList(self.state.currentYear);
                    self.openModal(self.elements.filterTahunModal);
                });

                $('#closePanduanBtn').on('click', () => self.closeModal(self.elements.panduanModal));
                $('#filterTahunModal .filter-back-icon').on('click', () => self.closeModal(self.elements.filterTahunModal));

                $('#filterTahunModal').on('click', '.year-chevron', function () {
                    const direction = $(this).data('direction') === 'up' ? 1 : -1;
                    let tempYear = parseInt($('#filterTahunModal .year-text-active').text());
                    self.renderYearList(tempYear + direction);
                });

                $('#applyYearFilterBtn').on('click', () => {
                    self.state.currentYear = parseInt($('#filterTahunModal .year-text-active').text());
                    self.closeModal(self.elements.filterTahunModal);
                    self.handleYearChange();
                });

                this.elements.backdrop.on('click', (e) => {
                    if ($(e.target).is(self.elements.backdrop)) {
                        const visibleModal = self.elements.backdrop.find('.modal-content:visible');
                        if (visibleModal.length > 0) {
                            self.closeModal(visibleModal);
                        }
                    }
                });
            },

            handleTabChange: function () {
                const selectedLeaveCode = $('.cuti-tab-item.active').data('tab-code');
                const $summaryWrapper = $('#summary-cards-wrapper');
                const $masaBerlaku = $('#masa-berlaku-container');

                this.updateActionButton();

                if (selectedLeaveCode === 'CK') {
                    $summaryWrapper.hide(); 
                    $masaBerlaku.hide();
                } else {
                    $summaryWrapper.css('display', 'grid'); 
                    $masaBerlaku.show();
                    this.fetchSummaryData(selectedLeaveCode);
                }

                this.triggerDataLoad();
            },

            handleYearChange: function () {
                const activeLeaveCode = $('.cuti-tab-item.active').data('tab-code');
                if (activeLeaveCode !== 'CK') {
                    this.fetchSummaryData(activeLeaveCode);
                }
                this.triggerDataLoad();
            },

            loadInitialData: function () {
                const initialLeaveCode = $('.cuti-tab-item.active').data('tab-code');
                this.fetchSummaryData(initialLeaveCode);
                this.triggerDataLoad();
            },

            fetchSummaryData: function (leaveCode) {
                const { employeeId, currentYear } = this.state;
                const url = `/api/CutiApi/listJatahCuti?emp_id=${employeeId}&leave_code=${leaveCode}&from=${currentYear}-01-01&to=${currentYear}-12-31`;

                this.elements.summaryTbody.html('<tr><td colspan="2" style="text-align:center;">Memuat data...</td></tr>');
                this.elements.masaBerlakuText.find('.date-highlight').text('...');

                $.ajax({
                    url: url,
                    type: 'GET',
                    success: (response) => {
                        if (response && response.data && response.data.length > 0) {
                            const latestData = response.data.sort((a, b) => new Date(b.created_date) - new Date(a.created_date))[0];
                            this.renderSummary(latestData);
                        } else {
                            this.elements.summaryTbody.html('<tr><td colspan="2" style="text-align:center;">Data jatah cuti tidak ditemukan.</td></tr>');
                            this.elements.masaBerlakuText.find('.date-highlight').text('-');
                        }
                    },
                    error: () => {
                        this.elements.summaryTbody.html('<tr><td colspan="2" style="text-align:center;">Gagal memuat data.</td></tr>');
                        this.elements.masaBerlakuText.find('.date-highlight').text('-');
                    }
                });
            },

            updateActionButton: function(sisaCuti) {
                const selectedLeaveCode = $('.cuti-tab-item.active').data('tab-code');

                if (typeof sisaCuti === 'undefined' || sisaCuti === null) {
                    const currentText = $('.sisa-cuti td:last-child').text();
                    sisaCuti = !isNaN(parseFloat(currentText)) ? parseFloat(currentText) : 0;
                }

                console.log("data sisa", sisaCuti);

                let leaveTypeText = '';
                let buttonText = 'Ajukan Pengajuan Cuti';

                if (selectedLeaveCode === 'CP') {
                    leaveTypeText = 'Cuti Pribadi';
                    buttonText = 'Ajukan Pengajuan Cuti Pribadi';
                } else if (selectedLeaveCode === 'CB') {
                    leaveTypeText = 'Cuti Besar';
                    buttonText = 'Ajukan Pengajuan Cuti Besar';
                } else if (selectedLeaveCode === 'CK') {
                    leaveTypeText = 'Cuti Khusus';
                    buttonText = 'Ajukan Pengajuan Cuti Khusus';
                    sisaCuti = 0;
                }

                const baseUrl = '@Url.Action("ManageTambahCuti", "Manage")';

                const newUrl = `${baseUrl}?tipe=${encodeURIComponent(leaveTypeText)}&sisa=${sisaCuti.toFixed(0)}`;

                this.elements.actionButton.attr('href', newUrl);
                this.elements.actionButton.text(buttonText);
            },

            renderSummary: function (data) {
                const totalEntitlement = (data.entitlement || 0) + (data.bringforward || 0) + (data.adjustment || 0);
                const used = data.used || 0;
                const remaining = data.remaining || 0;

                $('#hidden-total-entitlement').val(totalEntitlement);

                $('#val-hak-cuti').text(totalEntitlement.toFixed(0));
                $('#val-terpakai').text(used.toFixed(0)); 
                $('#val-sisa-cuti').text(remaining.toFixed(0));

                if (data.endvaliddate) {
                    const endDate = new Date(data.endvaliddate);
                    $('#masa-berlaku-text .date-highlight').text(endDate.toLocaleDateString('id-ID', { year: 'numeric', month: 'long', day: 'numeric' }));
                } else {
                    $('#masa-berlaku-text .date-highlight').text('Tidak terbatas');
                }

                this.updateCutiListView();
            },

            formatDateToDDMMYYYY: function (date) {
                if (!(date instanceof Date) || isNaN(date)) {
                    return '';
                }
                const day = String(date.getDate()).padStart(2, '0');
                const month = String(date.getMonth() + 1).padStart(2, '0');
                const year = date.getFullYear();
                return `${day}/${month}/${year}`;
            },

            triggerDataLoad: function () {
                const selectedLeaveCode = $('.cuti-tab-item.active').data('tab-code');
                const { currentYear } = this.state;

                let fromDateObj, toDateObj, displayRangeText;

                if (selectedLeaveCode === 'CB') {
                    const startYear = currentYear - 4;
                    fromDateObj = new Date(startYear, 0, 1);
                    toDateObj = new Date(currentYear, 11, 31);
                    displayRangeText = `1 Jan ${startYear} - 31 Des ${currentYear}`;
                } else if (selectedLeaveCode === 'CP') {
                    const nextYear = currentYear + 1;
                    fromDateObj = new Date(currentYear, 0, 1);
                    toDateObj = new Date(nextYear, 2, 31);
                    displayRangeText = `1 Jan ${currentYear} - 31 Mar ${nextYear}`;
                } else {
                    fromDateObj = new Date(currentYear, 0, 1);
                    toDateObj = new Date(currentYear, 11, 31);
                    displayRangeText = `1 Jan ${currentYear} - 31 Des ${currentYear}`;
                }
                const fromDate = this.formatDateToDDMMYYYY(fromDateObj);
                const toDate = this.formatDateToDDMMYYYY(toDateObj);

                $('.date-range').text(displayRangeText);
                this.fetchCutiList(fromDate, toDate);
            },

            fetchCutiList: function (fromDate, toDate) {
                const url = `/api/CutiApi/listCuti?emp_id=${this.state.employeeId}&from=${fromDate}&to=${toDate}`;

                this.elements.listContainer.html('');
                //this.elements.paginationControls.hide();
                this.elements.noDataMessage.text('Memuat daftar cuti...').show();
                this.state.allCutiData = [];

                $.ajax({
                    url: url,
                    type: 'GET',
                    success: (response) => {
                        console.log("data cutinya", response)
                        this.state.allCutiData = (response && response.data) ? response.data : [];
                        this.updateCutiListView();
                    },
                    error: () => {
                        this.state.allCutiData = [];
                        this.updateCutiListView();
                        this.elements.noDataMessage.text('Gagal memuat daftar pengajuan cuti.').show();
                    }
                });
            },


            updateCutiListView: function () {
                const selectedCategoryCode = $('.cuti-tab-item.active').data('tab-code');
                const selectedStatus = $('.status-filter-badge.active').data('status');
                const myEmpId = String(this.state.employeeId).trim();

                let categoryData = [];
                if (selectedCategoryCode === 'CP') {
                    categoryData = this.state.allCutiData.filter(cuti => cuti.leave_code.startsWith('CP'));
                } else if (selectedCategoryCode === 'CB') {
                    categoryData = this.state.allCutiData.filter(cuti => cuti.leave_code === 'CB' || cuti.leave_code === 'Cuti Besar');
                } else {
                    categoryData = this.state.allCutiData.filter(cuti => !cuti.leave_code.startsWith('CP') && cuti.leave_code !== 'CB' && cuti.leave_code !== 'Cuti Besar');
                }

                const usedStatuses = ['Terlaksana', 'Belum Terlaksana'];
                const onProgressStatuses = ['Menunggu Persetujuan', 'Menunggu Persetujuan HC'];

                const usedCount = categoryData
                    .filter(cuti => String(cuti.requestedby).trim() === myEmpId)
                    .filter(cuti => usedStatuses.includes(this.mapStatus(cuti.request_status)))
                    .reduce((total, cuti) => total + (cuti.totaldays || 0), 0);

                const onProgressCount = categoryData
                    .filter(cuti => String(cuti.requestedby).trim() === myEmpId)
                    .filter(cuti => onProgressStatuses.includes(this.mapStatus(cuti.request_status)))
                    .reduce((total, cuti) => total + (cuti.totaldays || 0), 0);

                const totalEntitlement = parseFloat($('#hidden-total-entitlement').val()) || 0; // Ambil dari hidden
                const newRemaining = totalEntitlement - usedCount - onProgressCount;

                $('#val-terpakai').text(usedCount.toFixed(0));
                $('#val-on-progress').text(onProgressCount.toFixed(0));
                $('#val-sisa-cuti').text(newRemaining.toFixed(0));

                this.state.currentRemainingBalance = newRemaining;
                this.updateActionButton(newRemaining);

                this.state.filteredData = this.state.allCutiData.filter(cuti => {
                    const reqBy = String(cuti.requestedby).trim();
                    const isPunyaSaya = (reqBy === myEmpId);
                    const statusText = this.mapStatus(cuti.request_status);

                    let filterCategory = '';
                    if (cuti.leave_code.startsWith('CP')) filterCategory = 'CP';
                    else if (cuti.leave_code === 'Cuti Besar' || cuti.leave_code === 'CB') filterCategory = 'CB';
                    else filterCategory = 'CK';

                    const categoryMatch = (filterCategory === selectedCategoryCode);

                    let statusMatch = false;

                    if (!isPunyaSaya) {
                        if (statusText !== 'Menunggu Persetujuan' && statusText !== 'Menunggu Persetujuan HC') return false;
                    }

                    if (selectedStatus === 'Semua') {
                        statusMatch = true;
                    } else if (selectedStatus === 'Disetujui') {
                        statusMatch = (statusText === 'Belum Terlaksana' || statusText === 'Terlaksana');
                    } else if (selectedStatus === 'Menunggu Persetujuan') {
                        statusMatch = (statusText === 'Menunggu Persetujuan' || statusText === 'Menunggu Persetujuan HC');
                    } else {
                        statusMatch = (statusText === selectedStatus);
                    }

                    return categoryMatch && statusMatch;
                });

                this.renderCutiList();
            },

            renderPage: function (page) {
                this.elements.listContainer.html('');
                const { filteredData, itemsPerPage } = this.state;

                if (filteredData.length === 0) {
                    this.elements.noDataMessage.text(this.state.allCutiData.length > 0 ? 'Tidak ada data cuti.' : 'Tidak ada pengajuan cuti pada periode ini.').show();
                    return;
                }
                this.elements.noDataMessage.hide();

                const startIndex = (page - 1) * itemsPerPage;
                const pageData = filteredData.slice(startIndex, startIndex + itemsPerPage);

                const cardsHtml = pageData.map(cuti => this.createCutiCard(cuti)).join('');
                this.elements.listContainer.html(cardsHtml);
            },

            renderCutiList: function () {
                this.elements.listContainer.html('');
                const { filteredData } = this.state; 

                if (filteredData.length === 0) {
                    this.elements.noDataMessage.text(this.state.allCutiData.length > 0 ? 'Tidak ada data cuti.' : 'Tidak ada pengajuan cuti pada periode ini.').show();
                    return;
                }
                this.elements.noDataMessage.hide();
                const cardsHtml = filteredData.map(cuti => this.createCutiCard(cuti)).join('');
                this.elements.listContainer.html(cardsHtml);
            },

            createCutiCard: function (cuti) {
                const statusText = this.mapStatus(cuti.request_status);
                const statusClass = 'status-' + statusText.toLowerCase().replace(/ /g, '-');

                const startDate = new Date(cuti.startdate).toLocaleDateString('id-ID', { day: '2-digit', month: 'short', year: 'numeric' });
                const endDate = new Date(cuti.enddate).toLocaleDateString('id-ID', { day: '2-digit', month: 'short', year: 'numeric' });

                const myEmpId = String(this.state.employeeId).trim();
                const reqBy = String(cuti.requestedby).trim();
                const currentHolder = String(cuti.requestfor).trim(); // requestfor saat ini

                // Apakah ini cuti buatan saya?
                const isPunyaSaya = (reqBy === myEmpId);

                // --- GUARD CLAUSE: LOGIC PENAMPILAN ---

                // [RULE 1] Approval / Cuti Orang Lain (!isPunyaSaya)
                if (!isPunyaSaya) {

                    // a. Hanya muncul jika status 'Menunggu Persetujuan' atau 'Menunggu HC'
                    if (statusText !== 'Menunggu Persetujuan' && statusText !== 'Menunggu Persetujuan HC') {
                        return ''; // Hide
                    }

                    // [RULE 2 - PERMINTAAN ANDA] Exception Khusus
                    // Jika status = 'Menunggu Persetujuan HC' DAN Saya adalah RequestFor (last holder), sembunyikan.
                    // Karena di tahap HC, bola sudah lepas dari Manager.
                    if (statusText === 'Menunggu Persetujuan HC' && currentHolder === myEmpId) {
                        return ''; // Hide: Manager sudah approve, tidak perlu lihat lagi.
                    }
                }

                let headerTitle = cuti.request_no;
                let personNameHtml = "";
                let displayLeaveType = "";

                if (cuti.leave_code.startsWith('CP')) {
                    displayLeaveType = 'Cuti Pribadi';
                } else if (cuti.leave_code === 'CB') {
                    displayLeaveType = 'Cuti Besar';
                } else {
                    displayLeaveType = cuti.leave_desc || cuti.leave_code || 'Cuti';
                }

                // Nama Karyawan (Mode Approval)
                if (!isPunyaSaya) {
                    personNameHtml = `<div style="font-size:13px; font-weight:bold; color:#1E2D56; margin-bottom:4px;">
        <i class="fas fa-user-circle"></i> Menunggu Persetujuan ${cuti.full_name || currentHolder}
        </div>`;
                }

                // Action Icon
                let actionIconHtml = '';

                if (isPunyaSaya) {
                    // [Cuti Saya] - Icon Cancel
                    const canCancel = !['Terlaksana', 'Ditolak', 'Dibatalkan', 'Draft'].includes(statusText);
                    if (canCancel) {
                        actionIconHtml = `<a href="/Manage/ManagePembatalanCuti?id=${cuti.request_no}" class="cuti-item-cancel-btn" title="Batalkan Pengajuan">
            <i class="fas fa-times"></i>
        </a>`;
                    }
                } else {
                    if (statusText === 'Menunggu Persetujuan') {
                        actionIconHtml = `<a href="/Manage/ManageApprovalCuti?id=${cuti.request_no}" class="cuti-item-cancel-btn" style="background-color: #D1FAE5; color: #065F46;" title="Setujui Pengajuan">
            <i class="fas fa-check"></i>
        </a>`;
                    }
                }

                const sisaCuti = this.state.currentRemainingBalance.toFixed(0);
                let actionLink = '';

                if (isPunyaSaya && statusText === 'Draft') {
                    actionLink = `<a href="/Manage/ManageEditCuti?id=${cuti.request_no}&sisa=${sisaCuti}" class="lihat-link edit-link">Ubah &rarr;</a>`;
                }
                else if (!isPunyaSaya && statusText === 'Menunggu Persetujuan') {

                    actionLink = `<a href="/Manage/ManageApprovalCuti?id=${cuti.request_no}" class="lihat-link">Lihat &rarr;</a>`;
                }
                else {
                    actionLink = `<a href="/Manage/ManageDetailCuti?id=${cuti.request_no}" class="lihat-link">Lihat &rarr;</a>`;
                }

                const cardStyle = !isPunyaSaya ? 'border-left: 4px solid #F59E0B;' : '';

                return `
                    <div class="cuti-item-card" data-status="${statusText}" style="${cardStyle}">
                        <div class="cuti-item-header">
                            <span class="cuti-id">${headerTitle}</span>
                            <div>
                                <span class="cuti-item-status ${statusClass}">${statusText}</span>
                                ${actionIconHtml}
                            </div>
                        </div>
                        <div class="cuti-item-body">
                            ${personNameHtml}
                            <div class="cuti-type">${displayLeaveType}</div>
                        </div>
                        <div class="cuti-item-footer">
                            <div class="date-info"><i class="fas fa-clock"></i> <span>${startDate} s/d ${endDate}</span></div>
                            ${actionLink}
                        </div>
                    </div>`;
            },

            changePage: function (direction) {
                const newPage = this.state.currentPage + direction;
                const totalPages = Math.ceil(this.state.filteredData.length / this.state.itemsPerPage);
                if (newPage >= 1 && newPage <= totalPages) {
                    this.state.currentPage = newPage;
                    this.renderPage(newPage);
                    this.setupPagination();
                }
            },

            openModal: function (modalElement) {
                this.elements.backdrop.addClass('show');
                modalElement.show();
            },

            closeModal: function () {
                this.elements.backdrop.removeClass('show');
                this.elements.panduanModal.hide();
                this.elements.filterTahunModal.hide();
            },

            renderYearList: function (selectedYear) {
                const yearPickerHtml = `
                    <div class="year-chevron" data-direction="up"><i class="fas fa-chevron-up"></i></div>
                    <div class="year-display">
                        <div class="year-text-inactive">${selectedYear + 1}</div>
                        <div class="year-text-active">${selectedYear}</div>
                        <div class="year-text-inactive">${selectedYear - 1}</div>
                    </div>
                    <div class="year-chevron" data-direction="down"><i class="fas fa-chevron-down"></i></div>
                `;
                $('#year-picker-container').html(yearPickerHtml);
            },
            mapStatus: function (apiStatus) {
                const statusMap = {
                    "Unverified": "Menunggu Persetujuan",
                    "Partially Approved": "Menunggu Persetujuan",
                    "Fully Approved": "Belum Terlaksana",
                    "Rejected": "Ditolak",
                    "Cancelled": "Dibatalkan",
                    "Closed": "Terlaksana",
                    "Revised": "Direvisi",
                    "Draft": "Draft"
                };
                return statusMap[apiStatus] || apiStatus;
            }
        };

        $(document).ready(function () {
            CutiApp.init();
        });
    </script>
</body>
</html>