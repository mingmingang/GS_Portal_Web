@using Template_DevExpress_By_MFM.Models
@{
    var logSession = HttpContext.Current.Session["SHealth"] as Template_DevExpress_By_MFM.Models.SessionLogin;
}

<script>
    // Deklarasikan fungsi sebelum grid diinisialisasi
    window.calculateDuration = function () {
        var grid = $("#gridListCuti").dxDataGrid("instance");
        var formData = grid.option("editing.formData");

        if (formData.tanggal_awal && formData.tanggal_akhir) {
            var startDate = new Date(formData.tanggal_awal);
            var endDate = new Date(formData.tanggal_akhir);

            // Hitung selisih hari (termasuk hari pertama)
            var diffDays = Math.floor((endDate - startDate) / (1000 * 60 * 60 * 24)) + 1;

            // Update nilai durasi
            grid.option("editing.formData.durasi", diffDays > 0 ? diffDays + " hari" : "0 hari");

            // Validasi tanggal
            if (diffDays < 0) {
                DevExpress.ui.notify("Tanggal selesai harus setelah tanggal mulai", "error", 3000);
                grid.option("editing.formData.tanggal_akhir", null);
                grid.option("editing.formData.durasi", "0 hari");
            }
        }
    };
</script>

<style>
    .status-disetujui {
        color: #008000;
        background-color: #90EE90;
        padding: 4px 8px;
        border-radius: 4px;
        font-weight: bold;
    }

    .status-diproses {
        color: #FFA500;
        background-color: #FFFACD;
        padding: 4px 8px;
        border-radius: 4px;
        font-weight: bold;
    }

    .status-ditolak {
        color: #FF0000;
        background-color: #FFB6C1;
        padding: 4px 8px;
        border-radius: 4px;
        font-weight: bold;
    }

    .status-belum-terlaksana {
        color: #0056b3;
        background-color: #cce5ff;
        padding: 4px 8px;
        border-radius: 4px;
        font-weight: bold;
    }


    .cuti-toolbar {
        margin: 20px;
    }

    .cuti-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 20px;
        flex-wrap: wrap; /* biar responsif di layar kecil */
        padding: 10px 0;
    }

    .cuti-title {
        flex: 1 1 300px; /* biar fleksibel tapi tetap punya minimal width */
    }

        .cuti-title h1 {
            font-weight: bold; /* biar fleksibel tapi tetap punya minimal width */
        }


    .cuti-actions {
        display: flex;
        align-items: center;
        gap: 10px;
        flex-wrap: wrap;
    }

    .cuti-filters {
        display: flex;
        gap: 10px;
    }

    .search-input,
    .filter-select {
        padding: 8px 12px 8px 35px; /* left padding space for icon */
        border-radius: 10px; /* lebih curve */
        border: 1px solid #ccc;
        font-size: 14px;
        position: relative;
        background-repeat: no-repeat;
        background-position: 10px center;
        background-size: 16px;
    }

    .search-input,
    .filter-select,
    .btn-tambah {
        height: 38px; /* pastikan semua elemen punya tinggi yang sama */
        box-sizing: border-box; /* agar padding tidak menambah total height */
    }


    .btn-tambah {
        background-color: #007bff;
        color: white;
        border: none;
        padding: 8px 16px;
        border-radius: 4px;
        font-size: 14px;
        font-weight: 500;
        cursor: pointer;
        float: right;
        margin-bottom: 15px;
    }

        .btn-tambah:hover {
            background-color: #0069d9;
            text-decoration: none;
            color: white;
        }

    .search-input {
        background-image: url('https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/icons/search.svg');
    }

    .filter-select {
        background-image: url('https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/icons/funnel.svg');
    }

    .btn-tambah {
        background-color: #1B3D97;
        color: white;
        border: none;
        padding: 8px 14px;
        border-radius: 5px;
        cursor: pointer;
        font-size: 14px;
        white-space: nowrap;
    }
</style>

<div class="card p-5 mt-4">
    <div class="cuti-toolbar">
        <div class="cuti-header">
            <div class="cuti-title">
                <h1>Daftar Cuti</h1>
                <p>
                    Seluruh daftar pengajuan cuti Anda akan ditampilkan di sini, lengkap dengan informasi status
                    dan perkembangannya. Gunakan fitur pencarian atau filter untuk mempermudah menemukan data
                    cuti yang Anda butuhkan.
                </p>

            </div>

            <div class="cuti-actions">
                <div class="cuti-filters">
                    @*<input type="text" class="search-input" placeholder="Cari pengajuan cuti...">*@
                    @*<select class="filter-select">
                            <option value="">Semua Status</option>
                            <option value="pending">Menunggu</option>
                            <option value="approved">Disetujui</option>
                            <option value="rejected">Ditolak</option>
                        </select>*@
                    <a href="@Url.Action("ManageAddCuti", "Manage")" class="btn-tambah">+ Tambah Cuti</a>
                </div>


            </div>
        </div>
    </div>

    @{
        var pembatalanUrl = Url.Action("PembatalanCuti", "Cuti");
        var detailUrl = Url.Action("ManageDetailCuti", "Manage");
    }


    @(Html.DevExtreme().DataGrid<CutiModel>()
    .ID("gridListCuti")
    .ShowBorders(true)
    .AllowColumnReordering(true)
    .AllowColumnResizing(true)
    .ColumnAutoWidth(true)
    .ColumnFixing(c => c.Enabled(true))
    .Scrolling(scrolling => scrolling.ColumnRenderingMode(GridColumnRenderingMode.Virtual))
    .RowAlternationEnabled(true)
    .Height(550)
    .DataSource(d => d.WebApi()
        .Controller("CutiApi")
        .Key("cuti_id")
    )
    .Columns(columns =>
    {
    columns.Add().Caption("No")
   .Width(50)
   .AllowEditing(false)
   .CellTemplate(new JS(@"
        function(container, options) {
            var grid = $('#gridListCuti').dxDataGrid('instance');
            var pageIndex = grid.pageIndex();
            var pageSize = grid.pageSize();
            var rowIndex = options.rowIndex + 1 + (pageIndex * pageSize);
            $('<span>')
                .text(rowIndex)
                .appendTo(container);
        }
    "))
   .Alignment(HorizontalAlignment.Center);


    columns.AddFor(m => m.cuti_id)
            .Caption("ID Cuti")
            .Alignment(HorizontalAlignment.Center);

    columns.AddFor(m => m.kry_npk).Caption("NPK");
    columns.AddFor(m => m.tipe_cuti).Caption("Tipe Cuti");
    columns.AddFor(m => m.sub_tipe_cuti).Caption("Sub Tipe Cuti");

    columns.Add().Caption("Tanggal Cuti")
            .CalculateCellValue(@<text>
                    function(rowData) {
                        if (rowData.mulai_dari && rowData.sampai_dengan) {
                            var start = moment(rowData.mulai_dari).format("DD MMM YYYY");
                            var end = moment(rowData.sampai_dengan).format("DD MMM YYYY");
                            return start + " - " + end;
                        }
                        return "";
                    }
                </text>);

            columns.AddFor(m => m.durasi)
                        .Caption("Durasi")
                        .Alignment(HorizontalAlignment.Center);

            columns.AddFor(m => m.status)
                    .Caption("Status")
                    .CellTemplate(new JS(@"
        function(container, options) {
            var status = options.data.status;
            var className = '';
            if (status === 'Terlaksana') className = 'status-disetujui';
            else if (status === 'Menunggu Persetujuan') className = 'status-diproses';
            else if (status === 'Ditolak') className = 'status-ditolak';
            else if (status === 'Belum Terlaksana') className = 'status-belum-terlaksana';

            $('<span>')
                .addClass(className)
                .text(status)
                .appendTo(container);
        }
    "));



            columns.Add().Caption("Pembatalan")
           .CellTemplate(new JS(string.Format(@"
    function(container, options) {{
        $('<a>')
            .attr('href', '{0}?id=' + options.data.cuti_id)
            .attr('title', 'Batalkan Cuti')
            .html('<span style=""color:red; cursor:pointer;"">&#10006;</span>')
            .appendTo(container);
    }}
", pembatalanUrl)))
             .Alignment(HorizontalAlignment.Center);

            columns.Add().Caption("Lihat")
               .CellTemplate(new JS(string.Format(@"
    function(container, options) {{
        $('<a>')
            .attr('href', '{0}?id=' + options.data.cuti_id)
            .attr('title', 'Lihat Detail')
            .html('<i class=""fas fa-eye"" style=""color:blue; cursor:pointer;""></i>')
            .appendTo(container);
    }}
", detailUrl)))
                .Alignment(HorizontalAlignment.Center);

        })
        .Editing(editing => {
        editing.Mode(GridEditMode.Popup);
        editing.AllowAdding(true);
        editing.UseIcons(true);
        editing.Popup(p => p
            .Title("Tambah Cuti")
            .ShowTitle(true)
            .Width(600)
            .Height("auto")
        );
        editing.Form(f => f
            .ColCount(1)
            .Items(items => {
                // No. Pengajuan Cuti (readonly)
                items.AddSimpleFor(m => m.cuti_id)
                    .Label(l => l.Text("No. Pengajuan Cuti"))
                    .Editor(e => e
                        .TextBox()
                        .ReadOnly(true)
                    );

                items.AddSimpleFor(m => m.kry_npk)
                    .Label(l => l.Text("Permohonan Untuk *"))
                    .Editor(e => e
                        .TextArea()
                        .Height(80)
                        .Placeholder("Masukan Permohonan...")
                    )
                    .ColSpan(1)
                    .Name("Permohonan") // Pastikan name sesuai dengan property model
                    .Template(@<text>
                        @{

    var fullName = "";
    if (logSession != null && logSession.fullname != null)
    {
        fullName = logSession.fullname;
    }
                            <text>
                                <div id="permohonanField"></div>
                                <script>
                                    $(function() {
                                        // Set nilai default saat form dibuka
                                        $("#gridListCuti").dxDataGrid("instance").on("editorPreparing", function(e) {
                                            if (e.parentType === "dataRow" && e.dataField === "Permohonan") {
                                                e.editorOption("value", "@fullName");
                                            }
                                        });
                                    });
                                </script>
                            </text>
                        }
                    </text>);
                            // Tipe Cuti (dropdown)
                                               items.AddSimpleFor(m => m.tipe_cuti)
                                .Label(l => l.Text("Tipe Cuti *"))
                                .Editor(e => e
                                    .SelectBox()
                                    .DataSource(new[] { "Cuti Pribadi", "Cuti Besar" })
                                    .Placeholder("Pilih Tipe Cuti...")
                                );

                            // Tanggal Mulai dan Selesai (2 kolom)
                                               items.AddGroup()
                       .ColCount(2)
                       .Items(groupItems => {
                           groupItems.AddSimpleFor(m => m.tanggal_awal)
                                         .Editor(e => e
                                             .DateBox()
                                             .OnValueChanged("calculateDuration") // Panggil sebagai string
                                         );



                          groupItems.AddSimpleFor(m => m.tanggal_akhir)
                    .Editor(e => e
                        .DateBox()
                        .OnValueChanged("calculateDuration") // Panggil sebagai string
                    );
    });

                // Durasi (readonly)
                items.AddSimpleFor(m => m.durasi)
                    .Label(l => l.Text("Durasi"))
                    .Editor(e => e
                        .TextBox()
                        .ReadOnly(true)
                        .Placeholder("/hari")
                    );

                // Keterangan (text area)
                items.AddSimpleFor(m => m.alasan)
                    .Label(l => l.Text("Keterangan"))
                    .Editor(e => e
                        .TextArea()
                        .Height(80)
                        .Placeholder("Masukan Keterangan...")
                    );
            })
        );
    })

        .Paging(p => p.PageSize(10))
        .Pager(pager =>
        {
            pager.Visible(true);
            pager.DisplayMode(GridPagerDisplayMode.Full);
            pager.ShowPageSizeSelector(true);
            pager.AllowedPageSizes(new JS("[10, 20, 50, 'all']"));
            pager.ShowInfo(true);
        })
        .SearchPanel(f => f.Visible(true).Placeholder("Cari cuti..."))
        .FilterRow(f => f.Visible(false))
         .HeaderFilter(f => f.Visible(true).AllowSearch(false))
 .RemoteOperations(true)
    )
</div>

<script>
    function statusCellTemplate(container, options) {
        var status = options.data.status;
        var className = "";
        if (status === "Disetujui") className = "status-disetujui";
        else if (status === "Diproses") className = "status-diproses";
        else if (status === "Ditolak") className = "status-ditolak";

        $("<span>")
            .addClass(className)
            .text(status)
            .appendTo(container);
    }
</script>
