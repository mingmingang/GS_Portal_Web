                        $confirmBtn.text('Ya, Tolak').removeClass('btn-primary').addClass('btn-danger');
                        $reasonContainer.show();
                        $approvalFields.hide();
                    }

                    $modal.addClass('visible');

                    // Event handler untuk textarea penolakan
                    $textarea.off('input').on('input', function () {
                        const text = $(this).val();
                        const charCount = text.length;
                        $charCount.text(charCount);

                        if (charCount > 255) {
                            $(this).val(text.substring(0, 255));
                            $charCount.text('255');
                        }

                        $errorMsg.hide();
                        $textarea.removeClass('is-invalid');
                    });

                    // Event handlers untuk tombol
                    $('#confirmGABtn').off('click').on('click', function () {
                        if (action === 'reject') {
                            const alasan = $textarea.val().trim();
                            if (!alasan) {
                                $errorMsg.show();
                                $textarea.addClass('is-invalid');
                                $textarea.focus();
                                return;
                            }
                            rejectByGA(alasan);
                        } else {
                            const sopir = $sopirInput.val().trim();
                            const noPolisi = $noPolisiInput.val().trim();

                            if (!sopir) {
                                showAlert('Peringatan', 'Sopir harus diisi', 'warning');
                                $sopirInput.focus();
                                return;
                            }

                            if (!noPolisi) {
                                showAlert('Peringatan', 'No. Polisi harus diisi', 'warning');
                                $noPolisiInput.focus();
                                return;
                            }

                            approveByGA(sopir, noPolisi);
                        }
                    });

                    $('#cancelGABtn').off('click').on('click', function () {
                        $modal.removeClass('visible');
                    });

                    $('.btn-close-custom', $modal).off('click').on('click', function () {
                        $modal.removeClass('visible');
                    });
                }

                // ========== API FUNCTIONS ==========

                function approveByAtasan() {
                    const $button = $('#confirmAtasanBtn');
                    $button.prop('disabled', true).html('<i class="fas fa-spinner fa-spin"></i> Menyimpan...');

                    const requestData = {
                        idl_id: parseInt(idlId),
                        modified_by: "" // akan diisi di backend dari session
                    };

                    $.ajax({
                        url: `${API_BASE_URL}/approve-by-atasan`,
                        method: 'POST',
                        contentType: 'application/json',
                        data: JSON.stringify(requestData),
                        success: function (response) {
                            if (response.code === 200) {
                                $('#confirmAtasanModal').removeClass('visible');
                                showSuccess('Berhasil', 'IDL berhasil disetujui')
                                    .then(() => {
                                        location.reload();
                                    });
                            } else {
                                showAlert('Gagal', 'Gagal menyetujui IDL: ' + response.message, 'error');
                                $button.prop('disabled', false).text('Ya, Setujui');
                            }
                        },
                        error: function (xhr) {
                            console.error('Error:', xhr);
                            showAlert('Kesalahan', 'Terjadi kesalahan saat menyetujui IDL', 'error');
                            $button.prop('disabled', false).text('Ya, Setujui');
                        }
                    });
                }

