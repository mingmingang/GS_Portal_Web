                        dynamicButtons.push(`
                                <button type="button" class="btn btn-reject" id="rejectAtasanButton">
                                    <i class="fas fa-times me-2"></i> Tolak (Atasan)
                                </button>
                            `);
                    }

                    // Tombol GA (Approve/Reject)
                    if (data.bisa_disetujui_ga) {
                        dynamicButtons.push(`
                                <button type="button" class="btn btn-ga-approve" id="approveGAButton">
                                    <i class="fas fa-check me-2"></i> Setujui (GA)
                                </button>
                            `);
                        dynamicButtons.push(`
                                <button type="button" class="btn btn-reject" id="rejectGAButton">
                                    <i class="fas fa-times me-2"></i> Tolak (GA)
                                </button>
                            `);
