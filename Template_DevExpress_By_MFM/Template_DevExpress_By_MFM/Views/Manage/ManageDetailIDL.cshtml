                    // File links
                    setupFileLinks(data);

                    // Alasan Penolakan/Pembatalan
                    if (data.idl_status === 'Dibatalkan' && data.idl_alasan_pembatalan) {
                        $('#alasanJudul').text('Alasan Pembatalan');
                        $('#alasanIsi').text(data.idl_alasan_pembatalan);
                        $('#alasanContainer').show();
                    } else if ((data.idl_status === 'Ditolak Atasan' || data.idl_status === 'Ditolak GA') && data.idl_alasan_penolakan) {
                        $('#alasanJudul').text('Alasan Penolakan');
                        $('#alasanIsi').text(data.idl_alasan_penolakan);
                        $('#alasanContainer').show();
                    }

                    // DYNAMIC BUTTONS berdasarkan status dan peran
                    const dynamicButtons = [];

                    // Cancel button - hanya untuk status tertentu
                    if (data.bisa_dibatalkan) {
                        dynamicButtons.push(`
                                <button type="button" class="btn btn-cancel" id="cancelButton">
                                    <i class="fas fa-times me-2"></i> Batalkan IDL
                                </button>
                            `);
