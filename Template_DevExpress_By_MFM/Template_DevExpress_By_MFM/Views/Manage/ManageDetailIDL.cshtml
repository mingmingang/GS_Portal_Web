                    $('.btn-close-custom', $modal).off('click').on('click', function () {
                        $modal.removeClass('visible');
                    });
                }

                // Fungsi untuk menampilkan modal absensi
                function showAbsensiModal(data) {
                    const $modal = $('#absensiModal');
                    const $optionsContainer = $('#lokasiOptionsContainer');
                    const $lokasiAktualContainer = $('#lokasiAktualContainer');
                    const $lokasiAktualInput = $('#lokasiAktualInput');

                    $optionsContainer.empty();
                    $lokasiAktualInput.val('');
                    $lokasiAktualContainer.hide();

                    // Data lokasi yang belum tercatat
                    const lokasiOptions = [];

                    // Cek lokasi pertama
                    if (data.idl_lokasi_pertama && !data.idl_waktu_lokasi_pertama) {
                        lokasiOptions.push({
                            id: 1,
                            name: data.idl_lokasi_pertama,
                            status: 'Belum dicatat'
                        });
                    }

                    // Cek lokasi kedua
                    if (data.idl_lokasi_kedua && !data.idl_waktu_lokasi_kedua) {
                        lokasiOptions.push({
                            id: 2,
                            name: data.idl_lokasi_kedua,
                            status: 'Belum dicatat'
                        });
                    }

                    // Cek lokasi ketiga
                    if (data.idl_lokasi_ketiga && !data.idl_waktu_lokasi_ketiga) {
                        lokasiOptions.push({
                            id: 3,
                            name: data.idl_lokasi_ketiga,
                            status: 'Belum dicatat'
                        });
                    }

                    if (lokasiOptions.length === 0) {
                        showAlert('Informasi', 'Semua lokasi sudah tercatat', 'info');
                        return;
                    }

                    // Tambahkan opsi
                    lokasiOptions.forEach(option => {
                        const optionHtml = `
                                <div class="lokasi-option" data-lokasi-id="${option.id}">
                                    <div class="lokasi-radio">
                                        <input type="radio" name="lokasiOption" id="lokasi${option.id}" value="${option.id}">
                                    </div>
                                    <div class="lokasi-info">
                                        <div class="lokasi-name">Lokasi ${option.id}: ${option.name}</div>
                                        <div class="lokasi-status">${option.status}</div>
                                    </div>
                                </div>
                            `;
                        $optionsContainer.append(optionHtml);
                    });

                    $modal.addClass('visible');

                    // Event handler untuk pilihan lokasi
                    $optionsContainer.off('click').on('click', '.lokasi-option', function () {
                        const $option = $(this);
                        $('.lokasi-option').removeClass('selected');
                        $option.addClass('selected');
                        $option.find('input[type="radio"]').prop('checked', true);
                        $lokasiAktualContainer.show();
                    });

                    // Event handlers untuk tombol
                    $('#confirmAbsensiBtn').off('click').on('click', function () {
                        const selectedOption = $('input[name="lokasiOption"]:checked');
                        if (!selectedOption.length) {
                            showAlert('Peringatan', 'Pilih lokasi terlebih dahulu', 'warning');
                            return;
                        }

                        const lokasiId = parseInt(selectedOption.val());
                        const lokasiAktual = $lokasiAktualInput.val().trim();

                        recordAbsensi(lokasiId, lokasiAktual);
                    });

                    $('#cancelAbsensiBtn').off('click').on('click', function () {
                        $modal.removeClass('visible');
                    });

                    $('.btn-close-custom', $modal).off('click').on('click', function () {
                        $modal.removeClass('visible');
                    });
                }

                // Fungsi untuk menampilkan modal selesai
                function showSelesaiModal() {
                    const $modal = $('#selesaiModal');
                    const $lokasiAkhirInput = $('#lokasiAkhirInput');

                    $lokasiAkhirInput.val('');
