                // ========== FUNGSI PEMBATALAN IDL (SAMA DENGAN IMP) ==========
                function cancelIDL(alasan) {
                    const $button = $('#cancelButton');
                    $button.prop('disabled', true).html('<i class="fas fa-spinner fa-spin"></i> Menyimpan...');

                    const requestData = {
                        idl_id: parseInt(idlId),
                        alasan_pembatalan: alasan,
                        modified_by: "" // akan diisi di backend dari session
                    };

                    $.ajax({
                        url: `${API_BASE_URL}/cancel`,
                        method: 'POST',
                        contentType: 'application/json',
                        data: JSON.stringify(requestData),
                        success: function (response) {
                            if (response.code === 200) {
                                showAlert(
                                    'Berhasil',
                                    'IDL berhasil dibatalkan',
                                    'success'
                                );
                                setTimeout(() => {
                                    location.reload();
                                }, 1500);
                            } else {
                                showAlert(
                                    'Gagal',
                                    'Gagal membatalkan IDL: ' + response.message,
                                    'error'
                                );
                                $button.prop('disabled', false).html('<i class="fas fa-times"></i><span class="bottom-button-text">Batalkan IDL</span>');
                            }
                        },
                        error: function (xhr) {
                            showAlert(
                                'Kesalahan',
                                'Terjadi kesalahan saat membatalkan IDL',
                                'error'
                            );
                            $button.prop('disabled', false).html('<i class="fas fa-times"></i><span class="bottom-button-text">Batalkan IDL</span>');
                        }
                    });
                }

                // Close modal ketika klik di luar
                $('.modal-overlay, .btn-close-custom').on('click', function (e) {
                    if (e.target === this || $(this).hasClass('btn-close-custom')) {
                        const $modal = $(this).closest('.modal-overlay');
                        $modal.removeClass('visible');

                        // Hapus peta jika modal peta ditutup
                        if ($modal.attr('id') === 'mapModal') {
                            if (mapInstance) {
                                mapInstance.remove();
                                mapInstance = null;
                            }
                            if (currentMarker) {
                                currentMarker = null;
                            }
                        }
                    }
                });

                // Main execution
                if (!idlId) {
                    $('#loadingIndicator').hide();
                    $('#errorIndicator').show().find('.error-text').text('ID IDL tidak ditemukan di URL.');
                    return;
                }

                $.ajax({
                    url: `${API_BASE_URL}/detail/${idlId}`,
                    method: 'GET',
                    success: function (response) {
                        console.log('API Response:', response);
                        if (response && response.code === 200 && response.data) {
                            populateUI(response.data);
                        } else {
                            $('#loadingIndicator').hide();
                            $('#errorIndicator').show().find('.error-text').text(response.message || 'Gagal memuat data. Respons tidak valid.');
                        }
                    },
                    error: (xhr) => {
                        $('#loadingIndicator').hide();
                        let errorMessage = 'Gagal memuat data. Silakan coba lagi.';
                        try {
                            const errorResponse = JSON.parse(xhr.responseText);
                            errorMessage = errorResponse.message || errorResponse.Message || errorMessage;
                        } catch (e) {
                            errorMessage = xhr.responseText || errorMessage;
                        }
                        $('#errorIndicator').show().find('.error-text').text(errorMessage);
                    }
                });
            });
        })(jQuery);
    </script>
</body>
</html>