                    $('#cancelSelesaiBtn').off('click').on('click', function () {
                        $modal.removeClass('visible');
                    });

                    $('.btn-close-custom', $modal).off('click').on('click', function () {
                        $modal.removeClass('visible');
                    });
                }

                // API functions
                function approveByAtasan() {
                    const $button = $('#confirmAtasanBtn');
                    $button.prop('disabled', true).html('<i class="fas fa-spinner fa-spin"></i> Menyimpan...');

                    const requestData = {
                        idl_id: parseInt(idlId)
                    };

                    $.ajax({
                        url: `${API_BASE_URL}/approve-by-atasan`,
                        method: 'POST',
                        contentType: 'application/json',
                        data: JSON.stringify(requestData),
                        success: function (response) {
                            if (response.code === 200) {
                                $('#confirmAtasanModal').removeClass('visible');
                                showAlert(
                                    'Berhasil',
                                    'IDL berhasil disetujui',
                                    'success'
                                );
                                setTimeout(() => {
                                    location.reload();
                                }, 1500);
                            } else {
                                showAlert(
                                    'Gagal',
                                    'Gagal menyetujui IDL: ' + response.message,
                                    'error'
                                );
                                $button.prop('disabled', false).text('Ya, Setujui');
                            }
                        },
                        error: function (xhr) {
                            console.error('Error:', xhr);
                            showAlert(
                                'Kesalahan',
                                'Terjadi kesalahan saat menyetujui IDL',
                                'error'
                            );
                            $button.prop('disabled', false).text('Ya, Setujui');
                        }
                    });
                }

