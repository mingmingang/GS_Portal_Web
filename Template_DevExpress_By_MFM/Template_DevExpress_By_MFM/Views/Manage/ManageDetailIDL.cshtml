                                </button>
                            `);
                    }

                    // Tombol Selesai
                    if (data.bisa_selesai) {
                        dynamicButtons.push(`
                                <button type="button" class="btn btn-selesai" id="selesaiButton">
                                    <i class="fas fa-flag-checkered me-2"></i> Selesaikan IDL
                                </button>
                            `);
                    }

                    $('#dynamicButtonContainer').html(dynamicButtons.join(''));

                    // Button event handlers
                    $('#cancelButton').on('click', async function () {
                        const alasan = await showCancelModal();
                        if (alasan) {
                            cancelIDL(alasan);
                        }
                    });

                    // Event handlers untuk tombol atasan
                    $('#approveAtasanButton').on('click', function () {
                        showAtasanModal('approve');
                    });

                    $('#rejectAtasanButton').on('click', function () {
                        showAtasanModal('reject');
                    });

                    // Event handlers untuk tombol GA
