                function showGAModal(action) {
                    const $modal = $('#confirmGAModal');
                    const $title = $('#gaModalTitle');
                    const $message = $('#gaModalMessage');
                    const $reasonContainer = $('#gaRejectionReasonContainer');
                    const $approvalFields = $('#gaApprovalFields');
