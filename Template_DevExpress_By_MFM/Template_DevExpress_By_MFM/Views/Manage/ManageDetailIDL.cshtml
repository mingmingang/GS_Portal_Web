    <!-- Modal Konfirmasi Custom -->
    <div class="modal-overlay preview-modal alert-modal" id="confirmModal">
        <div class="modal-content">
            <button type="button" class="btn-close-custom" aria-label="Close"><i class="fas fa-times"></i></button>
            <div class="modal-body">
                <div id="confirmIcon" class="alert-icon">
                    <i class="fas fa-question-circle alert-info"></i>
                </div>
                <h4 id="confirmTitle" class="modal-title mb-3">Konfirmasi</h4>
                <p id="confirmMessage" class="mb-4">Pesan konfirmasi akan ditampilkan di sini.</p>
                <div class="d-flex gap-2 justify-content-center">
                    <button type="button" class="btn btn-secondary" id="confirmNoBtn">Tidak</button>
                    <button type="button" class="btn btn-primary" id="confirmYesBtn">Ya</button>
                </div>
            </div>
        </div>
    </div>
    <script>
        (function ($) {
            "use strict";
            $(document).ready(function () {
                const idlId = new URLSearchParams(window.location.search).get('id');
                const API_BASE_URL = "/api/IDLApi";

                // Fungsi untuk menampilkan modal pemberitahuan
                function showAlert(title, message, type = 'info') {
                    const $modal = $('#alertModal');
                    const $icon = $('#alertIcon');
                    const $title = $('#alertTitle');
                    const $message = $('#alertMessage');
                    // Set icon berdasarkan type
                    $icon.empty();
                    let iconClass = 'fas fa-info-circle alert-info';
                    switch (type) {
                        case 'success':
                            iconClass = 'fas fa-check-circle alert-success';
                            break;
                        case 'warning':
                            iconClass = 'fas fa-exclamation-triangle alert-warning';
                            break;
                        case 'error':
                            iconClass = 'fas fa-times-circle alert-error';
                            break;
                        case 'info':
                        default:
                            iconClass = 'fas fa-info-circle alert-info';
                            break;
                    }
                    $icon.append(`<i class="${iconClass}"></i>`);
                    $title.text(title);
                    $message.text(message);
                    $modal.addClass('visible');
                }

                // Fungsi untuk menampilkan modal konfirmasi custom
                function showConfirm(title, message) {
                    return new Promise((resolve) => {
                        const $modal = $('#confirmModal');
                        const $title = $('#confirmTitle');
                        const $message = $('#confirmMessage');
                        $title.text(title);
                        $message.text(message);
                        $modal.addClass('visible');
                        // Event handlers
                        $('#confirmYesBtn').off('click').on('click', function () {
                            $modal.removeClass('visible');
                            resolve(true);
                        });
                        $('#confirmNoBtn').off('click').on('click', function () {
                            $modal.removeClass('visible');
                            resolve(false);
                        });
                        $('.btn-close-custom', $modal).off('click').on('click', function () {
                            $modal.removeClass('visible');
                            resolve(false);
                        });
                    });
                }

                // Fungsi untuk menampilkan modal pembatalan
                function showCancelModal() {
                    return new Promise((resolve) => {
                        const $modal = $('#cancelModal');
                        const $textarea = $('#alasanPembatalan');
                        const $charCount = $('#charCount');
                        const $confirmBtn = $('#confirmCancelBtn');
                        const $errorMsg = $('#alasanError');

                        // Reset form
                        $textarea.val('');
                        $charCount.text('0');
                        $errorMsg.hide();
                        $textarea.removeClass('is-invalid');

                        // Tombol langsung enable
                        $confirmBtn.prop('disabled', false);

                        $modal.addClass('visible');

                        // Event handler untuk textarea
                        $textarea.off('input').on('input', function () {
                            const text = $(this).val();
                            const charCount = text.length;
                            $charCount.text(charCount);

                            // Validasi max length 255 karakter
                            if (charCount > 255) {
                                $(this).val(text.substring(0, 255));
                                $charCount.text('255');
                            }

                            // Sembunyikan error jika user mulai mengetik
                            $errorMsg.hide();
                            $textarea.removeClass('is-invalid');
                        });

                        // Event handlers untuk tombol
                        $('#confirmCancelBtn').off('click').on('click', function () {
                            const alasan = $textarea.val().trim();

                            // Validasi: alasan wajib diisi
                            if (!alasan) {
                                $errorMsg.show();
                                $textarea.addClass('is-invalid');
                                $textarea.focus();
                                return;
                            }

                            $modal.removeClass('visible');
                            resolve(alasan);
                        });

                        $('#cancelCancelBtn').off('click').on('click', function () {
                            $modal.removeClass('visible');
                            resolve(null);
                        });

                        $('.btn-close-custom', $modal).off('click').on('click', function () {
                            $modal.removeClass('visible');
                            resolve(null);
                        });
                    });
                }

                // Helper functions dengan error handling yang lebih baik
                const formatDate = val => {
                    if (!val) return "N/A";
                    try {
                        const date = new Date(val);
                        return isNaN(date.getTime()) ? "N/A" : date.toLocaleDateString('id-ID', {
                            day: 'numeric',
                            month: 'long',
                            year: 'numeric'
                        });
                    } catch (e) {
                        return "N/A";
                    }
                };

                const formatDateTime = val => {
                    if (!val) return "N/A";
                    try {
                        const date = new Date(val);
                        return isNaN(date.getTime()) ? "N/A" : date.toLocaleDateString('id-ID', {
                            day: 'numeric',
                            month: 'long',
                            year: 'numeric',
                            hour: '2-digit',
                            minute: '2-digit'
                        });
                    } catch (e) {
                        return "N/A";
                    }
                };

                const formatTime = val => {
                    if (!val) return "N/A";
                    try {
                        const date = new Date(val);
                        return isNaN(date.getTime()) ? "N/A" : date.toLocaleTimeString('id-ID', {
                            hour: '2-digit',
                            minute: '2-digit'
                        });
                    } catch (e) {
                        return "N/A";
                    }
                };

                const getStatusStyle = status => ({
                    "Selesai": { text: "Selesai", bg: "bg-success", icon: "fa-check-circle" },
                    "Disetujui Atasan": { text: "Disetujui Atasan", bg: "bg-success", icon: "fa-check-circle" },
                    "Disetujui GA": { text: "Disetujui GA", bg: "bg-success", icon: "fa-check-circle" },
                    "Menunggu Persetujuan Atasan": { text: "Menunggu Persetujuan Atasan", bg: "bg-menunggu", icon: "fa-hourglass-half" },
                    "Menunggu Persetujuan GA": { text: "Menunggu Persetujuan GA", bg: "bg-menunggu", icon: "fa-hourglass-half" },
                    "Ditolak Atasan": { text: "Ditolak Atasan", bg: "bg-danger", icon: "fa-times-circle" },
                    "Ditolak GA": { text: "Ditolak GA", bg: "bg-danger", icon: "fa-times-circle" },
                    "Dibatalkan": { text: "Dibatalkan", bg: "bg-danger", icon: "fa-ban" }
                })[status] || { text: status, bg: "bg-secondary", icon: "fa-question-circle" };

                // Modal handlers
                $('.modal-overlay, .btn-close-custom').on('click', function (e) {
                    if (e.target === this || $(this).hasClass('btn-close-custom')) {
                        $(this).closest('.modal-overlay').removeClass('visible');
                    }
                });

                // Handler untuk modal pemberitahuan
                $('#alertOkBtn').on('click', function () {
                    $('#alertModal').removeClass('visible');
                });

                // Fungsi baru untuk menampilkan preview file
                async function showFilePreview(fileKey, filePath, fileName, npk) {
                    if (!filePath) {
                        console.error("File path is not provided.");
                        showAlert('Error', 'Path file tidak tersedia', 'error');
                        return;
                    }

                    try {
                        // URL dengan parameter yang benar
                        const downloadUrl = `/api/IDLApi/file/${idlId}/${fileKey}?npk=${encodeURIComponent(npk)}`;
                        console.log('Requesting file from:', downloadUrl);

                        // Image Preview Logic
                        if (!filePath.toLowerCase().endsWith('.pdf')) {
                            const $modal = $('#imageModal');
                            $modal.find('#imageModalFileName').text(fileName);
                            $modal.find('#imageDownloadLink').attr('href', downloadUrl);

                            const timestamp = new Date().getTime();
                            $modal.find('#imagePreview').attr('src', downloadUrl + '&t=' + timestamp);
                            $modal.addClass('visible');
                            return;
                        }

                        // PDF Preview Logic - Gunakan approach sederhana dulu
                        const $modal = $('#pdfGalleryModal');
                        $modal.find('.modal-title').text('Pratinjau Dokumen');
                        $modal.find('#pdfModalFileName').text(fileName);
                        $modal.find('#pdfDownloadLink').attr('href', downloadUrl);

                        // Tampilkan embed PDF sebagai fallback
                        $modal.find('#pdfImageContainer').html(`
                                <div class="text-center">
                                    <embed src="${downloadUrl}#toolbar=0&navpanes=0&scrollbar=0"
                                           type="application/pdf"
                                           width="100%"
                                           height="500px"
                                           style="border: 1px solid #e5e7eb; border-radius: 8px;">
                                    <div class="mt-3">
                                        <small class="text-muted">
                                            Jika PDF tidak tampil,
                                            <a href="${downloadUrl}" target="_blank" class="text-primary">klik di sini untuk membuka di tab baru</a>
                                            atau
                                            <a href="${downloadUrl}" download class="text-primary">unduh file</a>.
                                        </small>
                                    </div>
                                </div>
                            `);

                        $modal.addClass('visible');

                    } catch (error) {
                        console.error("Error in showFilePreview:", error);
                        showAlert('Error', `Gagal memuat preview file: ${error.message}`, 'error');
                    }
                }

                function setupFileLinks(data) {
                    const $container = $('#fileLinksContainer').empty();
                    if (data.idl_berkas_lampiran) {
                        const fileName = data.idl_berkas_lampiran.split('/').pop();
                        const linkHtml = `
                                <div class="detail-row">
                                    <div class="detail-label">Berkas Lampiran</div>
                                    <a href="#" class="detail-value"
                                       data-key="lampiran"
                                       data-path="${data.idl_berkas_lampiran}"
                                       data-filename="${fileName}"
                                       data-npk="${data.idl_npk}">
                                       <i class="fas fa-file-alt me-2"></i> Lihat File
                                    </a>
                                </div>`;
                        $container.append(linkHtml);
                        $('#lampiranCard').show();
                    }

                    $container.off('click.preview').on('click.preview', 'a', function (e) {
                        e.preventDefault();
                        const $this = $(this);
                        showFilePreview(
                            $this.data('key'),
                            $this.data('path'),
                            $this.data('filename'),
                            $this.data('npk')
                        );
                    });
                }

                function updateLokasiDisplay(data) {
                    const $grid = $('#lokasiGrid');
                    $grid.empty();

                    // Data lokasi rencana dan aktual
                    const lokasiData = [
                        {
                            rencana: data.idl_lokasi_pertama,
                            aktual: data.idl_lokasi_aktual_pertama,
                            waktu: data.idl_waktu_lokasi_pertama
                        },
                        {
                            rencana: data.idl_lokasi_kedua,
                            aktual: data.idl_lokasi_aktual_kedua,
                            waktu: data.idl_waktu_lokasi_kedua
                        },
                        {
                            rencana: data.idl_lokasi_ketiga,
                            aktual: data.idl_lokasi_aktual_ketiga,
                            waktu: data.idl_waktu_lokasi_ketiga
                        }
                    ];

                    lokasiData.forEach((lokasi, index) => {
                        const lokasiNumber = index + 1;
                        let lokasiText = "Belum diisi";
                        let lokasiTime = "-";
                        let isRecorded = false;

                        if (lokasi.aktual) {
                            lokasiText = lokasi.aktual;
                            isRecorded = true;
                        }

                        if (lokasi.waktu) {
                            lokasiTime = formatDateTime(lokasi.waktu);
                        }

                        const lokasiHtml = `
                                <div class="lokasi-item ${isRecorded ? 'recorded' : ''}">
                                    <div class="lokasi-number">${lokasiNumber}</div>
                                    <div class="lokasi-label">Lokasi ${lokasiNumber}</div>
                                    <div class="lokasi-text">${lokasiText}</div>
                                    <div class="lokasi-time">${lokasiTime}</div>
                                </div>
                            `;

                        $grid.append(lokasiHtml);
                    });

                    // Tampilkan card lokasi
                    $('#lokasiCard').show();
                }

                function populateUI(data) {
                    console.log('Data from API:', data);
                    // Status
                    const status = getStatusStyle(data.idl_status);
                    $('#statusBadge').text(status.text).removeClass('bg-success bg-warning bg-danger bg-secondary').addClass(status.bg);

                    // Detail Pengajuan
                    $('#noRequest').text(data.idl_no_request || '-');
                    $('#npkKaryawan').text(data.idl_npk || 'N/A');
                    $('#jenisKegiatan').text(data.idl_jenis_kegiatan || 'N/A');
                    $('#kategoriKendaraan').text(data.idl_kategori_kendaraan || 'N/A');
                    $('#sopir').text(data.idl_sopir || 'Belum ditentukan');
                    $('#noPolisi').text(data.idl_no_polisi || 'Belum ditentukan');
                    $('#tanggalDibuat').text(formatDateTime(data.idl_created_date));
                    $('#dibuatOleh').text(data.idl_created_by || 'N/A');

                    // Jadwal Perjalanan
                    $('#waktuBerangkat').text(data.idl_waktu_berangkat ? formatDateTime(data.idl_waktu_berangkat) : 'N/A');
                    $('#waktuKembali').text(data.idl_waktu_kembali ? formatDateTime(data.idl_waktu_kembali) : 'N/A');

                    // Rencana Lokasi
                    $('#lokasiPertama').text(data.idl_lokasi_pertama || 'N/A');
                    $('#lokasiKedua').text(data.idl_lokasi_kedua || 'N/A');
                    $('#lokasiKetiga').text(data.idl_lokasi_ketiga || 'N/A');

                    // Tracking Lokasi Display
                    updateLokasiDisplay(data);

                    // Keterangan
                    if (data.idl_keterangan) {
                        $('#keterangan').text(data.idl_keterangan);
                        $('#keteranganCard').show();
