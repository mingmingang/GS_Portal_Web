                // ========== MODAL FUNCTIONS ==========

                // Modal konfirmasi absensi (React Native Style)
                function showAbsensiConfirmModal(data) {
                    const lokasiBerikutnya = getLokasiBerikutnya(data);
                    if (!lokasiBerikutnya) {
                        showAlert('Info', 'Semua lokasi sudah diabsen', 'info');
                        return;
                    }

                    const message = `Apakah Anda yakin ingin melakukan absensi di ${lokasiBerikutnya.name}?`;

                    showConfirm('Konfirmasi Absensi', message)
                        .then((confirmed) => {
                            if (confirmed) {
                                if (navigator.geolocation) {
                                    const $button = $('#absensiButton');
                                    $button.prop('disabled', true).html('<i class="fas fa-spinner fa-spin"></i> Mendapatkan lokasi...');

                                    navigator.geolocation.getCurrentPosition(
                                        (position) => {
                                            const lat = position.coords.latitude;
                                            const lon = position.coords.longitude;
                                            // Format koordinat sebagai string "lat,lng"
                                            const coordinateStr = `${lat},${lon}`;
                                            recordAbsensi(lokasiBerikutnya.lokasiKe, coordinateStr);
                                        },
                                        (error) => {
                                            let errorMsg = 'Gagal mendapatkan lokasi. ';
                                            if (error.code === error.PERMISSION_DENIED) errorMsg += 'Izin lokasi ditolak.';
                                            else if (error.code === error.POSITION_UNAVAILABLE) errorMsg += 'Informasi lokasi tidak tersedia.';
                                            else if (error.code === error.TIMEOUT) errorMsg += 'Waktu permintaan lokasi habis.';
                                            else errorMsg += 'Kesalahan tidak diketahui.';
                                            showAlert('Error', errorMsg, 'error');
                                            $button.prop('disabled', false).html(`<i class="fas fa-check-circle"></i><span class="bottom-button-text">${getAbsensiButtonText(data)}</span>`);
                                        }
                                    );
                                } else {
                                    showAlert('Error', 'Browser tidak mendukung geolokasi.', 'error');
                                }
                            }
                        });
                }

                // Modal konfirmasi selesai
                function showSelesaiConfirmModal() {
                    const $modal = $('#selesaiModal');
                    const $lokasiAkhirInput = $('#lokasiAkhirInput');

                    $lokasiAkhirInput.val('');
                    $modal.addClass('visible');

                    // Event handlers untuk tombol
                    $('#confirmSelesaiBtn').off('click').on('click', function () {
                        const lokasiAkhir = $lokasiAkhirInput.val().trim();

                        if (!lokasiAkhir) {
                            showAlert('Peringatan', 'Lokasi akhir harus diisi', 'warning');
                            $lokasiAkhirInput.focus();
                            return;
                        }

                        markAsSelesai(lokasiAkhir);
                        $modal.removeClass('visible');
                    });

                    $('#cancelSelesaiBtn').off('click').on('click', function () {
                        $modal.removeClass('visible');
                    });

                    $('.btn-close-custom', $modal).off('click').on('click', function () {
                        $modal.removeClass('visible');
                    });
                }

                // Fungsi untuk menampilkan modal atasan
                function showAtasanModal(action) {
                    const $modal = $('#confirmAtasanModal');
                    const $title = $('#atasanModalTitle');
                    const $message = $('#atasanModalMessage');
                    const $reasonContainer = $('#rejectionReasonContainer');
                    const $confirmBtn = $('#confirmAtasanBtn');
                    const $textarea = $('#alasanPenolakan');
                    const $charCount = $('#penolakanCharCount');
                    const $errorMsg = $('#alasanPenolakanError');

                    // Reset form
                    $textarea.val('');
                    $charCount.text('0');
                    $errorMsg.hide();
                    $textarea.removeClass('is-invalid');

                    if (action === 'approve') {
                        $title.text('Setujui IDL');
                        $message.text('Apakah Anda yakin ingin menyetujui IDL ini?');
                        $confirmBtn.text('Ya, Setujui').removeClass('btn-danger').addClass('btn-primary');
                        $reasonContainer.hide();
                    } else {
                        $title.text('Tolak IDL');
                        $message.text('Apakah Anda yakin ingin menolak IDL ini?');
                        $confirmBtn.text('Ya, Tolak').removeClass('btn-primary').addClass('btn-danger');
                        $reasonContainer.show();
                    }

                    $modal.addClass('visible');

                    // Event handler untuk textarea penolakan
                    $textarea.off('input').on('input', function () {
                        const text = $(this).val();
                        const charCount = text.length;
                        $charCount.text(charCount);

                        if (charCount > 255) {
                            $(this).val(text.substring(0, 255));
                            $charCount.text('255');
                        }

                        $errorMsg.hide();
                        $textarea.removeClass('is-invalid');
                    });

                    // Event handlers untuk tombol
                    $('#confirmAtasanBtn').off('click').on('click', function () {
                        if (action === 'reject') {
                            const alasan = $textarea.val().trim();
                            if (!alasan) {
                                $errorMsg.show();
                                $textarea.addClass('is-invalid');
                                $textarea.focus();
                                return;
                            }
                            rejectByAtasan(alasan);
                        } else {
                            approveByAtasan();
                        }
                    });

                    $('#cancelAtasanBtn').off('click').on('click', function () {
                        $modal.removeClass('visible');
                    });

                    $('.btn-close-custom', $modal).off('click').on('click', function () {
                        $modal.removeClass('visible');
                    });
                }

