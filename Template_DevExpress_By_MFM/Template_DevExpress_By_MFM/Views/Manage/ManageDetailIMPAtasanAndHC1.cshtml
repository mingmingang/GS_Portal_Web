@using Template_DevExpress_By_MFM.Models
@{
    ViewBag.Title = "Detail IMP Karyawan";
    var impId = Request.QueryString["id"];
    var userRole = ViewBag.UserRole as string;
    var userName = ViewBag.UserName as string; // Asumsikan controller mengirimkan nama pengguna
}

<style>
    body {
        padding-top: 70px;
        padding-bottom: 70px;
    }

    #alasanContainer .alasan-icon-wrapper {
        margin-right: 16px;
    }

    #alasanContainer i {
        min-width: 28px;
        text-align: center;
    }

    #statusBadge {
        padding: 0.6rem 1rem;
        font-size: 1rem;
        border-radius: 1rem;
    }

    #alasanJudul {
        font-weight: 700;
    }

    .imp-detail-container {
        margin: 10px;
        padding: 20px;
    }

    .time-display {
        background-color: #f8f9fa;
        padding: 8px 12px;
        border-radius: 4px;
        display: inline-block;
        font-weight: 500;
    }

    /* CSS untuk tombol aksi yang responsif */
    .action-buttons-container {
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 1rem;
        margin-top: 2rem;
    }

    .action-buttons-right {
        display: flex;
        justify-content: flex-end;
        gap: 0.5rem;
        flex-wrap: wrap;
        margin-left: auto;
    }

    /* Responsivitas untuk perangkat mobile */
    @@media (max-width: 576px) {
        .action-buttons-container {
            flex-direction: column;
            align-items: stretch;
        }

        .action-buttons-right {
            justify-content: stretch;
            margin-left: 0;
        }

            .action-buttons-right .btn {
                flex: 1;
                min-width: 120px;
            }
    }
</style>

<div class="imp-detail-container my-5 pt-4">
    <div class="d-flex align-items-center mb-4">
        <div>
            <h2 class="mb-0">Detail Izin Meninggalkan Perjalanan (IMP)</h2>
            <p class="text-muted mb-0">Rincian lengkap pengajuan izin meninggalkan pekerjaan.</p>
        </div>
    </div>

    @* Container utama untuk konten yang akan diisi oleh JS *@
    <div id="detailContainer" style="display:none;">

        <!-- ... Konten Detail (Tidak Ada Perubahan) ... -->
        <div class="card shadow-sm mb-4" style="background-color: #eef2ff;">
            <div class="card-body p-3">
                <div class="d-flex justify-content-between align-items-center">
                    <div> <i class="fas fa-info-circle text-primary me-2"></i> <strong class="text-dark">Status Pengajuan</strong> </div>
                    <span id="statusBadge" class="badge fs-6 py-2 px-3">Memuat...</span>
                </div>
            </div>
        </div>
        <div class="card shadow-sm mb-4">
            <div class="card-header bg-white py-3"><h5 class="mb-0">Detail Pengajuan</h5></div>
            <div class="card-body">
                <div class="row mb-2"><div class="col-md-3 text-muted">No. Request</div><div class="col-md-9 fw-bold" id="noRequest"></div></div><hr class="my-2">
                <div class="row mb-2"><div class="col-md-3 text-muted">NPK Karyawan</div><div class="col-md-9 fw-bold" id="npkKaryawan"></div></div><hr class="my-2">
                <div class="row mb-2"><div class="col-md-3 text-muted">Nama Karyawan</div><div class="col-md-9 fw-bold" id="namaKaryawan"></div></div><hr class="my-2">
                <div class="row mb-2"><div class="col-md-3 text-muted">Kegiatan</div><div class="col-md-9 fw-bold" id="kegiatan"></div></div><hr class="my-2">
                <div class="row mb-2"><div class="col-md-3 text-muted">Lokasi</div><div class="col-md-9 fw-bold" id="lokasi"></div></div><hr class="my-2">
                <div class="row mb-2"><div class="col-md-3 text-muted">Tanggal Berangkat</div><div class="col-md-9 fw-bold" id="tanggalBerangkat"></div></div><hr class="my-2">
                <div class="row mb-2"><div class="col-md-3 text-muted">Waktu Berangkat</div><div class="col-md-9 fw-bold" id="waktuBerangkat"></div></div><hr class="my-2">
                <div class="row mb-2"><div class="col-md-3 text-muted">Tanggal Kembali</div><div class="col-md-9 fw-bold" id="tanggalKembali"></div></div><hr class="my-2">
                <div class="row mb-2"><div class="col-md-3 text-muted">Waktu Kembali</div><div class="col-md-9 fw-bold" id="waktuKembali"></div></div><hr class="my-2">
                <div class="row mb-2"><div class="col-md-3 text-muted">Tanggal Dibuat</div><div class="col-md-9 fw-bold" id="tanggalDibuat"></div></div><hr class="my-2">
                <div class="row"><div class="col-md-3 text-muted">Dibuat Oleh</div><div class="col-md-9 fw-bold" id="dibuatOleh"></div></div>
            </div>
        </div>
        <div class="card shadow-sm mb-4">
            <div class="card-header bg-white py-3"><h5 class="mb-0">Keterangan & Lampiran</h5></div>
            <div class="card-body">
                <div class="row mb-2"><div class="col-md-3 text-muted">Keterangan</div><div class="col-md-9 fw-bold" id="keterangan"></div></div>
                <div id="fileLinksContainer" style="display:none;">
                    <hr class="my-3">
                    <div id="lampiranLinkRow" class="row mb-2" style="display:none;">
                        <div class="col-md-3 text-muted">Berkas Lampiran</div>
                        <div class="col-md-9"> <a id="lampiranLink" href="#" target="_blank" class="text-decoration-none fw-bold"> <i class="fas fa-file-alt me-2 text-primary"></i> Lihat Lampiran </a> </div>
                    </div>
                </div>
            </div>
        </div>
        <div id="alasanContainer" class="p-3 rounded mb-4" style="display: none;">
            <div class="d-flex align-items-center">
                <div class="me-4 alasan-icon-wrapper"> <i id="alasanIcon" class="fas fa-2x"></i> </div>
                <div> <h5 id="alasanJudul" class="mb-1 fw-bolder"></h5> <p id="alasanIsi" class="mb-0"></p> </div>
            </div>
        </div>

        <!-- Struktur Tombol Aksi yang Responsif -->
        <div class="action-buttons-container" id="actionButtonsContainer">
            <!-- Tombol Kembali di Kiri -->
            <a href="@Url.Action("ManageIMPAtasanAndHC1", "Manage")" class="btn btn-secondary btn-lg">
                Kembali
            </a>

            <!-- Grup Tombol Aksi di Kanan (ditampilkan oleh JS jika kondisi sesuai) -->
            <div id="dynamicButtonsWrapper" class="action-buttons-right" style="display: none;">
                <button class="btn btn-danger btn-lg" id="btnReject">Tolak</button>
                <button class="btn btn-success btn-lg" id="btnApprove">Setujui</button>
            </div>
        </div>
    </div>

    @* Indikator Loading & Error *@
    <div id="loadingIndicator" class="text-center py-5">
        <div class="spinner-border text-primary" role="status"><span class="visually-hidden">Loading...</span></div>
        <p class="mt-2">Mengambil data detail...</p>
    </div>
    <div id="errorIndicator" class="alert alert-warning" style="display:none;"></div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        $(document).ready(function () {
            // Variabel global untuk menyimpan data
            let currentIMPData = {};
            // Inject userRole ke JS dengan aman
            const userRole = @Html.Raw(Json.Encode(userRole ?? ""));
            const userName = @Html.Raw(Json.Encode(userName ?? ""));

            // --- Fungsi Helper ---
            const formatDate = (val) => val ? new Intl.DateTimeFormat('id-ID', { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' }).format(new Date(val)) : "N/A";
            const formatTime = (val) => val ? `<span class="time-display">${val.substring(0, 5)}</span>` : "N/A";
            const getStatusBadgeClass = (s) => {
                const statusMap = { "disetujui": "bg-success", "menunggu persetujuan": "bg-primary", "belum diverifikasi": "bg-warning", "ditolak": "bg-danger", "dibatalkan": "bg-danger" };
                return statusMap[(s || "").toLowerCase()] || "bg-secondary";
            };
            const getStatusText = (s) => s || "Unknown";

            // --- Logika Utama ---
            const urlParams = new URLSearchParams(window.location.search);
            const impId = urlParams.get('id');

            if (!impId) {
                $('#loadingIndicator').hide();
                $('#errorIndicator').text('ID IMP tidak ditemukan di URL.').show();
                return;
            }

            // Fungsi untuk memuat data IMP
            function loadIMPData() {
                $.ajax({
                    url: `/api/IMPApi/${impId}`,
                    method: 'GET',
                    dataType: 'json',
                    success: function (data) {
                        currentIMPData = data;
                        const statusNorm = (data.imp_status || "").toLowerCase();

                        // ====== MENGISI DATA KE TEMPLATE ======
                        $('#statusBadge').text(getStatusText(data.imp_status)).removeClass().addClass('badge fs-6 ' + getStatusBadgeClass(statusNorm));
                        $('#noRequest').text(data.imp_no_request || 'N/A');
                        $('#npkKaryawan').text(data.imp_npk || 'N/A');
                        $('#namaKaryawan').text(data.imp_nama_karyawan || 'N/A');
                        $('#kegiatan').text(data.imp_kegiatan || 'N/A');
                        $('#lokasi').text(data.imp_lokasi || 'N/A');
                        $('#tanggalBerangkat').text(formatDate(data.imp_tanggal_berangkat));
                        $('#waktuBerangkat').html(formatTime(data.imp_waktu_berangkat));
                        $('#tanggalKembali').text(formatDate(data.imp_tanggal_kembali));
                        $('#waktuKembali').html(formatTime(data.imp_waktu_kembali));
                        $('#tanggalDibuat').text(formatDate(data.imp_created_date));
                        $('#dibuatOleh').text(data.imp_created_by || 'N/A');
                        $('#keterangan').text(data.imp_keterangan || 'Tidak ada keterangan.');

                        // Tampilkan lampiran jika ada
                        if (data.imp_berkas_lampiran) {
                            $('#lampiranLink').attr('href', `/api/IMPApi/DownloadAttachment/${data.imp_id}`);
                            $('#lampiranLinkRow').show();
                            $('#fileLinksContainer').show();
                        }

                        // Tampilkan alasan penolakan jika status Ditolak
                        if (statusNorm === 'ditolak' && data.imp_alasan_penolakan) {
                            $('#alasanJudul').text('Alasan Penolakan').addClass('text-danger');
                            $('#alasanIsi').text(data.imp_alasan_penolakan);
                            $('#alasanIcon').addClass('fas fa-times-circle text-danger');
                            $('#alasanContainer').addClass('alert alert-danger').show();
                        }

                        // ====== KONTROL TOMBOL AKSI BERDASARKAN PERAN ======
                        const roleNorm = userRole.toLowerCase();
                        if ((roleNorm === "atasan" && statusNorm === "menunggu persetujuan") ||
                            (roleNorm === "hc1" && statusNorm === "belum diverifikasi")) {
                            $('#dynamicButtonsWrapper').show(); // Tampilkan tombol jika kondisi sesuai
                        }

                        // Tampilkan semua konten setelah diisi
                        $('#loadingIndicator').hide();
                        $('#detailContainer').show();
                    },
                    error: function (jqXHR) {
                        const msg = jqXHR.responseJSON ? jqXHR.responseJSON.Message : `Gagal memuat data (Error ${jqXHR.status}).`;
                        $('#loadingIndicator').hide();
                        $('#errorIndicator').text(msg).show();
                    }
                });
            }

            // Fungsi untuk menyetujui IMP
            function approveRequest() {
                const roleNorm = userRole.toLowerCase();
                let targetStatus = roleNorm === "atasan" ? "Belum Diverifikasi" : "Disetujui";
                let confirmMessage = roleNorm === "atasan"
                    ? "Menyetujui akan meneruskan pengajuan ke HC1. Lanjutkan?"
                    : "Menyetujui akan mengubah status menjadi 'Disetujui'. Lanjutkan?";

                Swal.fire({
                    title: 'Setujui Pengajuan?',
                    text: confirmMessage,
                    icon: 'question',
                    showCancelButton: true,
                    confirmButtonColor: '#28a745',
                    cancelButtonColor: '#6c757d',
                    confirmButtonText: 'Ya, Setujui!',
                    cancelButtonText: 'Batal'
                }).then((result) => {
                    if (result.isConfirmed) {
                        $.ajax({
                            url: `/api/IMPApi/ApproveIMP/${impId}`,
                            method: 'POST',
                            contentType: 'application/json',
                            data: JSON.stringify({ Status: targetStatus }),
                            success: function (response) {
                                Swal.fire('Berhasil!', 'Pengajuan IMP telah disetujui.', 'success')
                                    .then(() => location.reload());
                            },
                            error: function (jqXHR) {
                                Swal.fire('Error!', 'Gagal menyetujui pengajuan.', 'error');
                            }
                        });
                    }
                });
            }

            // Fungsi untuk menolak IMP
            function rejectRequest() {
                Swal.fire({
                    title: 'Tolak Pengajuan IMP?',
                    html: `
                        <p>Apakah Anda yakin ingin menolak pengajuan ini?</p>
                        <textarea id="alasanPenolakan" class="form-control mt-3" placeholder="Masukkan alasan penolakan (opsional)" rows="3"></textarea>
                    `,
                    icon: 'warning',
                    showCancelButton: true,
                    confirmButtonColor: '#dc3545',
                    cancelButtonColor: '#6c757d',
                    confirmButtonText: 'Ya, Tolak!',
                    cancelButtonText: 'Batal',
                    preConfirm: () => {
                        return {
                            alasan: document.getElementById('alasanPenolakan').value
                        }
                    }
                }).then((result) => {
                    if (result.isConfirmed) {
                        const alasan = result.value.alasan;

                        $.ajax({
                            url: `/api/IMPApi/RejectIMP/${impId}`,
                            method: 'POST',
                            contentType: 'application/json',
                            data: JSON.stringify({
                                RejectedBy: userName,
                                Alasan: alasan
                            }),
                            success: function (response) {
                                Swal.fire('Berhasil!', 'Pengajuan IMP telah ditolak.', 'success')
                                    .then(() => location.reload());
                            },
                            error: function (jqXHR) {
                                const errorMsg = jqXHR.responseJSON ? jqXHR.responseJSON.Message : 'Gagal menolak pengajuan.';
                                Swal.fire('Error!', errorMsg, 'error');
                            }
                        });
                    }
                });
            }

            // --- Inisialisasi ---
            // Binding event untuk tombol yang sudah ada di HTML
            $('#btnApprove').on('click', approveRequest);
            $('#btnReject').on('click', rejectRequest);
            // Memuat data IMP
            loadIMPData();
        });
    </script>
}