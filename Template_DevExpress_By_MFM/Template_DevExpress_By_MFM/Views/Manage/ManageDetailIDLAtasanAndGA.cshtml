    <script>
        (function ($) {
            "use strict";
            $(document).ready(function () {
                const idlId = new URLSearchParams(window.location.search).get('id');
                const API_BASE_URL = "/api/IDLApi";
                const userRole = '@userRole';
                const userName = '@userName';

                console.log('Initial Debug - UserRole:', userRole, 'UserName:', userName, 'IDL ID:', idlId);

                // Fungsi untuk menampilkan modal pemberitahuan
                function showAlert(title, message, type = 'info') {
                    const $modal = $('#alertModal');
                    const $icon = $('#alertIcon');
                    const $title = $('#alertTitle');
                    const $message = $('#alertMessage');

                    // Set icon berdasarkan type
                    $icon.empty();
                    let iconClass = 'fas fa-info-circle alert-info';

                    switch (type) {
                        case 'success':
                            iconClass = 'fas fa-check-circle alert-success';
                            break;
                        case 'warning':
                            iconClass = 'fas fa-exclamation-triangle alert-warning';
                            break;
                        case 'error':
                            iconClass = 'fas fa-times-circle alert-error';
                            break;
                        case 'info':
                        default:
                            iconClass = 'fas fa-info-circle alert-info';
                            break;
                    }

                    $icon.append(`<i class="${iconClass}"></i>`);
                    $title.text(title);
                    $message.text(message);
                    $modal.addClass('visible');
                }

                // Fungsi untuk menampilkan modal persetujuan GA
                function showApproveGAModal() {
                    return new Promise((resolve) => {
                        const $modal = $('#confirmApproveGAModal');
                        const $sopirInput = $('#sopirInput');
                        const $noPolisiInput = $('#noPolisiInput');
                        const $sopirError = $('#sopirError');
                        const $noPolisiError = $('#noPolisiError');
                        const $charCountSopir = $('#charCountSopir');
                        const $charCountNoPolisi = $('#charCountNoPolisi');
                        const $confirmBtn = $('#confirmApproveGABtn');

                        // Reset form
                        $sopirInput.val('');
                        $noPolisiInput.val('');
                        $sopirError.hide();
                        $noPolisiError.hide();
                        $sopirInput.removeClass('is-invalid');
                        $noPolisiInput.removeClass('is-invalid');
                        $charCountSopir.text('0');
                        $charCountNoPolisi.text('0');
                        $confirmBtn.prop('disabled', false);

                        $modal.addClass('visible');

                        // Event handler untuk input sopir
                        $sopirInput.off('input').on('input', function () {
                            const value = $(this).val();
                            const charCount = value.length;
                            $charCountSopir.text(charCount);

                            // Validasi max length
                            if (charCount > 50) {
                                $(this).val(value.substring(0, 50));
                                $charCountSopir.text('50');
                            }

                            // Sembunyikan error jika user mulai mengetik
                            if (value.trim()) {
                                $sopirError.hide();
                                $sopirInput.removeClass('is-invalid');
                            }
                        });

                        // Event handler untuk input no polisi
                        $noPolisiInput.off('input').on('input', function () {
                            const value = $(this).val();
                            const charCount = value.length;
                            $charCountNoPolisi.text(charCount);

                            // Validasi max length
                            if (charCount > 50) {
                                $(this).val(value.substring(0, 50));
                                $charCountNoPolisi.text('50');
                            }

                            // Sembunyikan error jika user mulai mengetik
                            if (value.trim()) {
                                $noPolisiError.hide();
                                $noPolisiInput.removeClass('is-invalid');
                            }
                        });

                        // Event handlers untuk tombol
                        $('#confirmApproveGABtn').off('click').on('click', function () {
                            const sopir = $sopirInput.val().trim();
                            const noPolisi = $noPolisiInput.val().trim();
                            let isValid = true;

                            // Validasi sopir
                            if (!sopir) {
                                $sopirError.show();
                                $sopirInput.addClass('is-invalid');
                                $sopirInput.focus();
                                isValid = false;
                            } else if (sopir.length > 50) {
                                $sopirError.show().text('Maksimal 50 karakter');
                                $sopirInput.addClass('is-invalid');
                                $sopirInput.focus();
                                isValid = false;
                            } else {
                                $sopirError.hide();
                                $sopirInput.removeClass('is-invalid');
                            }

                            // Validasi no polisi
                            if (!noPolisi) {
                                $noPolisiError.show();
                                $noPolisiInput.addClass('is-invalid');
                                if (isValid) $noPolisiInput.focus();
                                isValid = false;
                            } else if (noPolisi.length > 50) {
                                $noPolisiError.show().text('Maksimal 50 karakter');
                                $noPolisiInput.addClass('is-invalid');
                                if (isValid) $noPolisiInput.focus();
                                isValid = false;
                            } else {
                                $noPolisiError.hide();
                                $noPolisiInput.removeClass('is-invalid');
                            }

                            if (isValid) {
                                $modal.removeClass('visible');
                                resolve({ sopir, noPolisi });
                            }
                        });

                        $('#cancelApproveGABtn').off('click').on('click', function () {
                            $modal.removeClass('visible');
                            resolve(null);
                        });

                        $('.btn-close-custom', $modal).off('click').on('click', function () {
                            $modal.removeClass('visible');
                            resolve(null);
                        });

                        // Tambahkan event handler untuk close modal ketika klik di luar
                        $modal.off('click').on('click', function (e) {
                            if (e.target === this) {
                                $modal.removeClass('visible');
                                resolve(null);
                            }
                        });

                        // Fokus ke input pertama saat modal terbuka
                        setTimeout(() => {
                            $sopirInput.focus();
                        }, 300);
                    });
                }

                // Fungsi untuk menampilkan modal penolakan
                function showRejectModal() {
                    return new Promise((resolve) => {
                        const $modal = $('#rejectModal');
                        const $textarea = $('#alasanPenolakan');
                        const $charCount = $('#charCountReject');
                        const $confirmBtn = $('#confirmRejectBtn');
                        const $errorMsg = $('#alasanPenolakanError');

                        // Reset form
                        $textarea.val('');
                        $charCount.text('0');
                        $errorMsg.hide();
                        $textarea.removeClass('is-invalid');

                        // Tombol langsung enable
                        $confirmBtn.prop('disabled', false);

                        $modal.addClass('visible');

                        // Event handler untuk textarea
                        $textarea.off('input').on('input', function () {
                            const text = $(this).val();
                            const charCount = text.length;
                            $charCount.text(charCount);

                            // Validasi max length 50 karakter
                            if (charCount > 50) {
                                $(this).val(text.substring(0, 50));
                                $charCount.text('50');
                            }

                            // Sembunyikan error jika user mulai mengetik
                            $errorMsg.hide();
                            $textarea.removeClass('is-invalid');
                        });

                        // Event handlers untuk tombol
                        $('#confirmRejectBtn').off('click').on('click', function () {
                            const alasan = $textarea.val().trim();

                            // Validasi: alasan wajib diisi
                            if (!alasan) {
                                $errorMsg.show();
                                $textarea.addClass('is-invalid');
                                $textarea.focus();
                                return;
                            }

                            $modal.removeClass('visible');
                            resolve(alasan);
                        });

                        $('#cancelRejectBtn').off('click').on('click', function () {
                            $modal.removeClass('visible');
                            resolve(null);
                        });

                        $('.btn-close-custom', $modal).off('click').on('click', function () {
                            $modal.removeClass('visible');
                            resolve(null);
                        });
                    });
                }

                // Helper functions
                const formatDate = val => {
                    if (!val) return "-";
                    try {
                        const date = new Date(val);
                        return isNaN(date.getTime()) ? "-" : date.toLocaleDateString('id-ID', {
                            day: 'numeric',
                            month: 'long',
                            year: 'numeric'
                        });
                    } catch (e) {
                        return "-";
                    }
                };

                const formatDateTime = val => {
                    if (!val) return "-";
                    try {
                        const date = new Date(val);
                        return isNaN(date.getTime()) ? "-" : date.toLocaleDateString('id-ID', {
                            day: 'numeric',
                            month: 'long',
                            year: 'numeric',
                            hour: '2-digit',
                            minute: '2-digit'
                        });
                    } catch (e) {
                        return "-";
                    }
                };

                const getStatusStyle = status => ({
                    "Selesai": { text: "Selesai", bg: "bg-success", icon: "fa-check-circle" },
                    "Disetujui": { text: "Disetujui", bg: "bg-success", icon: "fa-check-circle" },
                    "Belum Diverifikasi GA": { text: "Belum Diverifikasi GA", bg: "bg-warning", icon: "fa-hourglass-half" },
                    "Menunggu Persetujuan Atasan": { text: "Menunggu Persetujuan Atasan", bg: "bg-menunggu", icon: "fa-hourglass-half" },
                    "Ditolak": { text: "Ditolak", bg: "bg-danger", icon: "fa-times-circle" },
                    "Dibatalkan": { text: "Dibatalkan", bg: "bg-danger", icon: "fa-ban" }
                })[status] || { text: status, bg: "bg-secondary", icon: "fa-question-circle" };

                // Setup tombol aksi berdasarkan role dan status - DIPERBAIKI
                function setupActionButtons(data) {
                    const dynamicButtons = [];
                    const statusNorm = (data.idl_status || "").trim();
                    const roleNorm = userRole.toLowerCase();
                    const kategoriKendaraan = data.idl_kategori_kendaraan || "";
                    const isMobilPool = kategoriKendaraan.toLowerCase().includes("mobil pool");

                    console.log('DEBUG - Setting up buttons:');
                    console.log('Role:', roleNorm);
                    console.log('Status:', statusNorm);
                    console.log('Kategori Kendaraan:', kategoriKendaraan);
                    console.log('Is Mobil Pool:', isMobilPool);

                    // Reset container
                    $('#dynamicButtonContainer').empty();

                    // ATURAN BERDASARKAN ROLE DAN STATUS
                    if (roleNorm === "atasan") {
                        // ATASAN: Hanya muncul jika status "Menunggu Persetujuan Atasan"
                        if (statusNorm === "Menunggu Persetujuan Atasan") {
                            dynamicButtons.push(`
                                <button type="button" class="btn btn-reject me-2" id="rejectButton">
                                    <i class="fas fa-times me-2"></i> Tolak
                                </button>
                                <button type="button" class="btn btn-approve" id="approveButton">
                                    <i class="fas fa-check me-2"></i> Setujui
                                </button>
                            `);
                            console.log('Showing ATASAN buttons for status: Menunggu Persetujuan Atasan');
                        } else {
                            console.log('ATASAN - No buttons (status:', statusNorm, ')');
                        }
                    }
                    else if (roleNorm === "ga") {
                        // GA: Hanya muncul jika status "Belum Diverifikasi GA"
                        if (statusNorm === "Belum Diverifikasi GA") {
                            if (isMobilPool) {
                                // GA untuk MOBIL POOL: Tampilkan tombol khusus GA dengan modal input
                                dynamicButtons.push(`
                                    <button type="button" class="btn btn-reject me-2" id="rejectButton">
                                        <i class="fas fa-times me-2"></i> Tolak
                                    </button>
                                    <button type="button" class="btn btn-ga-approve" id="approveButton">
                                        <i class="fas fa-check me-2"></i> Setujui (GA)
                                    </button>
                                `);
                                console.log('Showing GA buttons for MOBIL POOL');
                            } else {
                                // GA untuk NON-MOBIL POOL: Tombol biasa
                                dynamicButtons.push(`
                                    <button type="button" class="btn btn-reject me-2" id="rejectButton">
                                        <i class="fas fa-times me-2"></i> Tolak
                                    </button>
                                    <button type="button" class="btn btn-approve" id="approveButton">
                                        <i class="fas fa-check me-2"></i> Setujui
                                    </button>
                                `);
                                console.log('Showing GA buttons for NON-MOBIL POOL');
                            }
                        } else {
                            console.log('GA - No buttons (status:', statusNorm, ')');
                        }
                    }
                    else if (roleNorm === "hc") {
                        // HC: Tidak ada tombol approve/reject (hanya view)
                        console.log('HC role - No approval buttons (view only)');
                    }

                    // Masukkan tombol ke container jika ada
                    if (dynamicButtons.length > 0) {
                        $('#dynamicButtonContainer').html(dynamicButtons.join(''));

                        // Setup event handlers untuk tombol
                        $(document).off('click', '#approveButton').on('click', '#approveButton', async function () {
                            console.log('Approve button clicked - Role:', roleNorm);

                            if (roleNorm === "atasan") {
                                // Untuk ATASAN: Tampilkan modal konfirmasi sederhana
                                $('#confirmApproveAtasanModal').addClass('visible');
                            }
                            else if (roleNorm === "ga") {
                                if (isMobilPool) {
                                    // GA untuk MOBIL POOL: Tampilkan modal input sopir & no polisi
                                    const result = await showApproveGAModal();
                                    if (result) {
                                        approveRequestGA(result.sopir, result.noPolisi);
                                    }
                                } else {
                                    // GA untuk NON-MOBIL POOL: Tampilkan modal konfirmasi sederhana
                                    $('#confirmApproveAtasanModal').addClass('visible');
                                }
                            }
                        });

                        $(document).off('click', '#rejectButton').on('click', '#rejectButton', async function () {
                            console.log('Reject button clicked');
                            const alasan = await showRejectModal();
                            if (alasan) {
                                rejectRequest(alasan);
                            }
                        });
                    } else {
                        console.log('No action buttons to display');
                        $('#dynamicButtonContainer').html('<p class="text-muted">Tidak ada aksi yang tersedia</p>');
                    }
                }

                // Modal handlers
                $('.modal-overlay, .btn-close-custom').on('click', function (e) {
                    if (e.target === this || $(this).hasClass('btn-close-custom')) {
                        $(this).closest('.modal-overlay').removeClass('visible');
                    }
                });

                // Handler untuk modal pemberitahuan
                $('#alertOkBtn').on('click', function () {
                    $('#alertModal').removeClass('visible');
                });

                // Handler untuk modal konfirmasi atasan
                $('#cancelApproveAtasanBtn').on('click', function () {
                    $('#confirmApproveAtasanModal').removeClass('visible');
                });

                // Fungsi untuk menampilkan preview file (tanpa NPK) - untuk approval
                async function showFilePreview(fileKey, filePath, fileName) {
                    if (!filePath) {
                        console.error("File path is not provided.");
                        showAlert('Error', 'Path file tidak tersedia', 'error');
                        return;
                    }

                    try {
                        // URL tanpa parameter NPK - menggunakan route approval
                        const downloadUrl = `/api/IDLApi/file/approval/${idlId}/${fileKey}`;
                        console.log('Requesting file from:', downloadUrl);
                        console.log('File info:', { fileKey, filePath, fileName, idlId });

                        // Image Preview Logic
                        if (!filePath.toLowerCase().endsWith('.pdf')) {
                            const $modal = $('#imageModal');
                            $modal.find('#imageModalFileName').text(fileName);
                            $modal.find('#imageDownloadLink').attr('href', downloadUrl);

                            // Gunakan Image object untuk handle error loading
                            const img = new Image();
                            img.onload = function () {
                                $modal.find('#imagePreview').attr('src', downloadUrl + '?t=' + new Date().getTime());
                                $modal.addClass('visible');
                            };
                            img.onerror = function () {
                                console.error('Failed to load image:', downloadUrl);
                                showAlert('Error', 'Gagal memuat gambar. File mungkin tidak tersedia atau rusak.', 'error');
                                $modal.removeClass('visible');
                            };
                            img.src = downloadUrl;
                            return;
                        }

                        // PDF Preview Logic
                        const $modal = $('#pdfGalleryModal');
                        $modal.find('.modal-title').text('Pratinjau Dokumen');
                        $modal.find('#pdfModalFileName').text(fileName);
                        $modal.find('#pdfDownloadLink').attr('href', downloadUrl);

                        // Coba dulu menggunakan iframe
                        $modal.find('#pdfImageContainer').html(`
                            <div class="text-center">
                                <iframe src="${downloadUrl}#toolbar=0&navpanes=0&scrollbar=0"
                                        width="100%"
                                        height="500px"
                                        style="border: 1px solid #e5e7eb; border-radius: 8px;"
                                        onerror="this.onerror=null; this.src='about:blank';">
                                </iframe>
                                <div class="mt-3">
                                    <small class="text-muted">
                                        Jika PDF tidak tampil,
                                        <a href="${downloadUrl}" target="_blank" class="text-primary">klik di sini untuk membuka di tab baru</a>
                                        atau
                                        <a href="${downloadUrl}" download class="text-primary">unduh file</a>.
                                    </small>
                                </div>
                            </div>
                        `);

                        $modal.addClass('visible');

                    } catch (error) {
                        console.error("Error in showFilePreview:", error);
                        showAlert('Error', `Gagal memuat preview file: ${error.message}`, 'error');
                    }
                }

                function setupFileLinks(data) {
                    const $container = $('#fileLinksContainer').empty();

                    if (data.idl_berkas_lampiran) {
                        // Pastikan path relatif aman
                        const relativePath = data.idl_berkas_lampiran;
                        const fileName = relativePath.split('/').pop();
                        const fileKey = "lampiran";

                        console.log('Setting up file link:', {
                            relativePath,
                            fileName,
                            fileKey
                        });

                        const linkHtml = `
                        <div class="detail-row">
                            <div class="detail-label">Berkas Lampiran</div>
                            <a href="#" class="detail-value"
                               data-key="${fileKey}"
                               data-path="${relativePath}"
                               data-filename="${fileName}">
                               <i class="fas fa-file-alt me-2"></i> Lihat File
                            </a>
                        </div>`;
                        $container.append(linkHtml);
                        $('#lampiranCard').show();
                    }

                    // Event handler untuk preview file
                    $container.off('click.preview').on('click.preview', 'a', function (e) {
                        e.preventDefault();
                        const $this = $(this);
                        const fileKey = $this.data('key');
                        const filePath = $this.data('path');
                        const fileName = $this.data('filename');

                        console.log('File link clicked:', { fileKey, filePath, fileName });

                        showFilePreview(fileKey, filePath, fileName);
                    });
                }

                function populateUI(data) {
                    console.log('Full Data from API:', data);
                    console.log('User Role:', userRole);
                    console.log('User Name:', userName);

                    // Status
                    const status = getStatusStyle(data.idl_status);
                    $('#statusBadge').text(status.text).removeClass('bg-success bg-warning bg-danger bg-secondary').addClass(status.bg);

                    // Detail Pengajuan
                    $('#noRequest').text(data.idl_no_request || '-');
                    $('#npkKaryawan').text(data.idl_npk || '-');
                    $('#namaKaryawan').text(data.idl_created_by || '-');
                    $('#jenisKegiatan').text(data.idl_jenis_kegiatan || '-');
                    $('#kategoriKendaraan').text(data.idl_kategori_kendaraan || '-');
                    $('#sopir').text(data.idl_sopir || '-');
                    $('#noPolisi').text(data.idl_no_polisi || '-');
                    $('#tanggalDibuat').text(formatDateTime(data.idl_created_date));
                    $('#dibuatOleh').text(data.idl_created_by || '-');

                    // Jadwal Perjalanan
                    $('#waktuBerangkat').text(data.idl_waktu_berangkat || '-') ;
                    $('#waktuKembali').text(data.idl_waktu_kembali || '-');
                    $('#waktuKembaliAktual').text(data.idl_waktu_aktual || '-');

                    // Hitung durasi manual jika tidak tersedia
                    //let durasi = '-';
                    //if (data.idl_waktu_berangkat && data.idl_waktu_kembali) {
                    //    try {
                    //        const start = new Date(data.idl_waktu_berangkat);
                    //        const end = new Date(data.idl_waktu_kembali);
                    //        if (!isNaN(start.getTime()) && !isNaN(end.getTime())) {
                    //            const diffMs = end - start;
                    //            const diffHours = Math.floor(diffMs / (1000 * 60 * 60));
                    //            const diffMinutes = Math.floor((diffMs % (1000 * 60 * 60)) / (1000 * 60));
                    //            durasi = `${diffHours} jam ${diffMinutes} menit`;
                    //        }
                    //    } catch (e) {
                    //        console.error('Error calculating duration:', e);
                    //    }
                    //}
                    //$('#durasi').text(durasi);

                    // Lokasi
                    $('#lokasiPertama').text(formatDateTime(data.idl_lokasi_pertama || '-'));
                    $('#lokasiKedua').text(formatDateTime(data.idl_lokasi_kedua || '-'));
                    $('#lokasiKetiga').text(formatDateTime(data.idl_lokasi_ketiga || '-'));

                    // Keterangan
                    if (data.idl_keterangan) {
                        $('#keterangan').text(data.idl_keterangan);
                        $('#keteranganCard').show();
                    }

                    // File links
                    setupFileLinks(data);

                    // Alasan Penolakan/Pembatalan
                    if ((data.idl_status === 'Ditolak' || data.idl_status === 'Dibatalkan') && data.idl_alasan_penolakan) {
                        $('#alasanJudul').text(data.idl_status === 'Ditolak' ? 'Alasan Penolakan' : 'Alasan Pembatalan');
                        $('#alasanIsi').text(data.idl_alasan_penolakan);
                        $('#alasanContainer').show();
                    }

                    // Setup action buttons berdasarkan role dan status
                    setupActionButtons(data);

                    // Show content
                    $('#loadingIndicator').hide();
                    $('#stickyStatusContainer').show();
                    $('#detailContainer').show();
                }

                // Fungsi untuk menyetujui IDL oleh Atasan
                function approveRequestAtasan() {
                    const $button = $('#confirmApproveAtasanBtn');
                    $button.prop('disabled', true).html('<i class="fas fa-spinner fa-spin"></i> Menyimpan...');

                    const requestData = {
                        idl_id: parseInt(idlId),
                        modified_by: userName
                    };

                    console.log('Sending approve request (Atasan):', requestData);

                    $.ajax({
                        url: `${API_BASE_URL}/approve-by-atasan`,
                        method: 'POST',
                        contentType: 'application/json',
                        data: JSON.stringify(requestData),
                        success: function (response) {
                            console.log('Approve response:', response);
                            if (response.code === 200) {
                                $('#confirmApproveAtasanModal').removeClass('visible');
                                showAlert(
                                    'Berhasil',
                                    'Pengajuan IDL berhasil disetujui',
                                    'success'
                                );
                                setTimeout(() => {
                                    location.reload();
                                }, 1500);
                            } else {
                                showAlert(
                                    'Gagal',
                                    'Gagal menyetujui pengajuan: ' + (response.message || 'Unknown error'),
                                    'error'
                                );
                                $button.prop('disabled', false).text('Ya, Setujui');
                            }
                        },
                        error: function (xhr) {
                            console.error('Error:', xhr);
                            let errorMessage = 'Terjadi kesalahan saat menyetujui pengajuan';
                            try {
                                const errorResponse = JSON.parse(xhr.responseText);
                                errorMessage = errorResponse.message || errorResponse.Message || errorMessage;
                            } catch (e) {
                                // Ignore parsing error
                            }
                            showAlert('Kesalahan', errorMessage, 'error');
                            $button.prop('disabled', false).text('Ya, Setujui');
                        }
                    });
                }

                // Fungsi untuk menyetujui IDL oleh GA (dengan input sopir dan no polisi untuk Mobil Pool)
                function approveRequestGA(sopir, noPolisi) {
                    const $button = $('#confirmApproveGABtn');
                    $button.prop('disabled', true).html('<i class="fas fa-spinner fa-spin"></i> Menyimpan...');

                    const requestData = {
                        idl_id: parseInt(idlId),
                        idl_sopir: sopir,
                        idl_no_polisi: noPolisi,
                        modified_by: userName
                    };

                    console.log('Sending approve request (GA):', requestData);

                    $.ajax({
                        url: `${API_BASE_URL}/approve-by-ga`,
                        method: 'POST',
                        contentType: 'application/json',
                        data: JSON.stringify(requestData),
                        success: function (response) {
                            console.log('Approve response:', response);
                            if (response.code === 200) {
                                showAlert(
                                    'Berhasil',
                                    'Pengajuan IDL berhasil disetujui',
                                    'success'
                                );
                                setTimeout(() => {
                                    location.reload();
                                }, 1500);
                            } else {
                                showAlert(
                                    'Gagal',
                                    'Gagal menyetujui pengajuan: ' + (response.message || 'Unknown error'),
                                    'error'
                                );
                                $button.prop('disabled', false).text('Setujui');
                            }
                        },
                        error: function (xhr) {
                            console.error('Error:', xhr);
                            let errorMessage = 'Terjadi kesalahan saat menyetujui pengajuan';
                            try {
                                const errorResponse = JSON.parse(xhr.responseText);
                                errorMessage = errorResponse.message || errorResponse.Message || errorMessage;
                            } catch (e) {
                                // Ignore parsing error
                            }
                            showAlert('Kesalahan', errorMessage, 'error');
                            $button.prop('disabled', false).text('Setujui');
                        }
                    });
                }

                // Fungsi untuk menolak IDL
                function rejectRequest(alasan) {
                    const $button = $('#confirmRejectBtn');
                    $button.prop('disabled', true).html('<i class="fas fa-spinner fa-spin"></i> Menyimpan...');

                    const roleNorm = userRole.toLowerCase();
                    let apiUrl, requestData;

                    console.log('Reject request - Role:', roleNorm);

                    if (roleNorm === "atasan") {
                        apiUrl = `${API_BASE_URL}/reject-by-atasan`;
                        requestData = {
                            idl_id: parseInt(idlId),
                            alasan_penolakan: alasan,
                            modified_by: userName
                        };
                    } else if (roleNorm === "ga") {
                        apiUrl = `${API_BASE_URL}/reject-by-ga`;
                        requestData = {
                            idl_id: parseInt(idlId),
                            alasan_penolakan: alasan,
                            modified_by: userName
                        };
                    } else {
                        showAlert('Error', 'Role tidak valid untuk rejection', 'error');
                        $button.prop('disabled', false).text('Tolak Pengajuan');
                        return;
                    }

                    console.log('Sending reject request:', requestData);

                    $.ajax({
                        url: apiUrl,
                        method: 'POST',
                        contentType: 'application/json',
                        data: JSON.stringify(requestData),
                        success: function (response) {
                            console.log('Reject response:', response);
                            if (response.code === 200) {
                                showAlert(
                                    'Berhasil',
                                    'Pengajuan IDL berhasil ditolak',
                                    'success'
                                );
                                setTimeout(() => {
                                    location.reload();
                                }, 1500);
                            } else {
                                showAlert(
                                    'Gagal',
                                    'Gagal menolak pengajuan: ' + (response.message || 'Unknown error'),
                                    'error'
                                );
                                $button.prop('disabled', false).text('Tolak Pengajuan');
                            }
                        },
                        error: function (xhr) {
                            console.error('Error:', xhr);
                            let errorMessage = 'Terjadi kesalahan saat menolak pengajuan';
                            try {
                                const errorResponse = JSON.parse(xhr.responseText);
                                errorMessage = errorResponse.message || errorResponse.Message || errorMessage;
                            } catch (e) {
                                // Ignore parsing error
                            }
                            showAlert('Kesalahan', errorMessage, 'error');
                            $button.prop('disabled', false).text('Tolak Pengajuan');
                        }
                    });
                }

                // Event handlers untuk modal approval atasan
                $('#confirmApproveAtasanBtn').on('click', function() {
                    const roleNorm = userRole.toLowerCase();
                    const kategoriKendaraan = $('#kategoriKendaraan').text() || "";
                    const isMobilPool = kategoriKendaraan.toLowerCase().includes("mobil pool");

                    if (roleNorm === "atasan") {
                        // Untuk ATASAN: Panggil fungsi approve atasan
                        approveRequestAtasan();
                    }
                    else if (roleNorm === "ga" && !isMobilPool) {
                        // Untuk GA NON-MOBIL POOL: Panggil fungsi approve GA tanpa input
                        approveRequestGA('', '');
                    }
                });

                // Close modal ketika klik di luar
                $('#confirmApproveAtasanModal, #confirmApproveGAModal, #rejectModal, #alertModal').on('click', function (e) {
                    if ($(e.target).is('.modal-overlay')) {
                        $(this).removeClass('visible');
                    }
                });

                // Modal handlers untuk file preview
                $('#imageModal, #pdfGalleryModal').on('click', function (e) {
                    if (e.target === this || $(e.target).hasClass('btn-close-custom')) {
                        $(this).removeClass('visible');
                    }
                });

                // Main execution - Menggunakan endpoint detail/approval
                if (!idlId) {
                    $('#loadingIndicator').hide();
                    $('#errorIndicator').text('ID IDL tidak ditemukan di URL.').show();
                    return;
                }

                // Menggunakan endpoint detail/approval yang baru
                $.ajax({
                    url: `${API_BASE_URL}/detail/approval/${idlId}`,
                    method: 'GET',
                    success: function (response) {
                        console.log('API Response from detail/approval:', response);
                        if (response && response.code === 200 && response.data) {
                            populateUI(response.data);
                        } else {
                            $('#loadingIndicator').hide();
                            $('#errorIndicator').text(response.message || 'Gagal memuat data. Respons tidak valid.').show();
                        }
                    },
                    error: (xhr) => {
                        $('#loadingIndicator').hide();
                        let errorMessage = 'Gagal memuat data. Silakan coba lagi.';
                        try {
                            const errorResponse = JSON.parse(xhr.responseText);
                            errorMessage = errorResponse.message || errorResponse.Message || errorMessage;
                        } catch (e) {
                            errorMessage = xhr.responseText || errorMessage;
                        }
                        $('#errorIndicator').text(errorMessage).show();
                    }
                });
            });
        })(jQuery);
    </script>
</body>
</html>