@{
    ViewBag.Title = "Preview Surat Jaminan";
    Layout = null;

    var containerClass = "preview-page-container";
    var bodyClass = "";

    if (Layout != null)
    {
        containerClass += " content-wrapper-layout";
        bodyClass = "sidebar-open";
    }
}
<!DOCTYPE html>
<html>
<head>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewBag.Title</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css">
    <script src="https://ajax.googleapis.com/ajax/libs/jquery/3.6.0/jquery.min.js"></script>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">

    <style>
        body {
            margin: 0;
            font-family: 'Inter', sans-serif;
            -webkit-font-smoothing: antialiased;
            -moz-osx-font-smoothing: grayscale;
            background-color: #FFFFFF;
        }

            body.sidebar-open .preview-page-container {
                margin-left: 8px;
            }

        .preview-page-container {
            background-color: #fff;
            transition: margin-left 0.3s ease-in-out;
        }

        .content-wrapper-layout {
            padding-top: 75px;
        }

        .blue-section {
        }

        .page-header-standalone {
            background-color: #2A458A;
            background: linear-gradient(135deg, #1E2D56 0%, #2A4A7B 100%);
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 16px;
            position: sticky;
            top: 0;
            z-index: 10;
        }

            .page-header-standalone .back-button {
                color: #fff;
                font-size: 20px;
                text-decoration: none;
                position: absolute;
                left: 16px;
                top: 50%;
                transform: translateY(-50%);
                z-index: 2;
                cursor: pointer;
            }

        .page-header-title {
            color: #fff;
            font-size: 18px;
            font-weight: bold;
            margin: 0;
            text-align: center;
            width: 100%;
            z-index: 1;
        }

        .page-header-spacer {
            width: 24px;
            visibility: hidden;
        }

        .form-content-section {
            background-color: #FFFFFF;
            margin-top: 0;
            padding: 24px 16px;
            min-height: calc(100vh - 100px);
            padding-bottom: 120px;
        }

        .preview-container {
            background-color: #fff;
            border-radius: 12px;
            box-shadow: 0 2px 8px rgba(0,0,0,0.1);
            border: 1px solid #E5E7EB;
            margin-bottom: 20px;
            overflow: hidden;
            padding-top: 24px;
        }

        .preview-header {
            background-color: #F8FAFC;
            padding: 16px 20px;
            border-bottom: 1px solid #E5E7EB;
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin: -24px -20px 20px -20px;
        }

        .preview-title {
            font-size: 18px;
            font-weight: bold;
            color: #1F2937;
            margin: 0;
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .title-icon {
            color: #1B3D97;
            font-size: 20px;
            margin-left: 20px;
        }

        .preview-info {
            font-size: 11px;
            color: #6B7280;
            background: #E5E7EB;
            padding: 4px 8px;
            border-radius: 4px;
            display: flex;
            align-items: center;
            gap: 5px;
            margin-right: 20px;
        }

        .preview-content {
            background-color: #525659;
            padding: 20px;
            width: 100%;
            height: auto;
            max-height: calc(100vh - 200px);
            overflow: auto;
            -webkit-overflow-scrolling: touch;
            box-sizing: border-box;
            text-align: center;
        }

        .surat-preview {
            width: 1120px;
            min-height: 750px;
            background: #fff;
            margin: 0 auto;
            padding: 30px;
            box-sizing: border-box;
            box-shadow: 0 4px 15px rgba(0,0,0,0.3);
            text-align: left;
            display: inline-block;
            position: relative;
            font-family: Arial, sans-serif;
            font-size: 11px;
            line-height: 1.3;
        }

        .surat-header {
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            margin-bottom: 15px;
        }

        .surat-header-left {
            font-size: 10px;
            width: 30%;
        }

        .surat-header-right {
            font-size: 10px;
            width: 30%;
            flex-shrink: 0;
            line-height: 1.2;
        }

        .surat-header-center {
            text-align: center;
            width: 40%;
            flex-shrink: 0;
        }

        .surat-logo {
            width: 80px;
            height: auto;
            margin-bottom: 8px;
        }

        .surat-title {
            text-align: center;
            margin: 30px 0 15px 0;
        }

            .surat-title h2 {
                text-decoration: underline;
                font-weight: bold;
                margin: 0;
                font-size: 18px;
            }

        .surat-table {
            width: 100%;
            margin-bottom: 15px;
            font-size: 14px;
        }

            .surat-table td {
                padding: 2px 0;
                vertical-align: top;
            }

        .surat-content p {
            margin-bottom: 10px;
            text-align: justify;
            font-size: 14px;
        }

        .signature-section {
            margin-top: 50px;
            text-align: right;
        }

        .signature-box {
            display: inline-block;
            text-align: center;
            min-width: 200px;
            font-size: 12px;
        }

        .catatan-section {
            margin-top: 40px;
            font-size: 10px;
        }

        .footer-section {
            margin-top: 20px;
            font-weight: bold;
            font-size: 10px;
            color: #666;
        }

        .data-summary {
            background-color: #F0F9FF;
            border: 1px solid #0EA5E9;
            border-radius: 8px;
            padding: 16px;
            margin-bottom: 20px;
        }

        .data-summary-title {
            font-weight: bold;
            color: #0369A1;
            margin-bottom: 12px;
            font-size: 14px;
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .data-row {
            display: flex;
            justify-content: space-between;
            padding: 6px 0;
            border-bottom: 1px solid #E0F2FE;
        }

            .data-row:last-child {
                border-bottom: none;
            }

        .data-label {
            font-weight: 600;
            color: #374151;
            font-size: 13px;
        }

        .data-value {
            color: #1F2937;
            font-size: 13px;
            text-align: right;
            max-width: 60%;
        }

        .note-box {
            background-color: #EFF6FF;
            padding: 15px;
            border-radius: 8px;
            font-size: 14px;
            color: #1E40AF;
            border-left: 4px solid #3B82F6;
            margin-bottom: 20px;
        }

            .note-box strong {
                color: #1D4ED8;
            }

        .form-actions {
            display: flex;
            justify-content: space-between;
            gap: 12px;
            padding: 16px 0;
        }

        .btn {
            padding: 12px 24px;
            font-size: 14px;
            font-weight: 600;
            border-radius: 8px;
            border: 1px solid transparent;
            cursor: pointer;
            transition: all .2s;
            text-decoration: none;
            display: inline-flex;
            align-items: center;
            gap: 8px;
        }

        .btn-kembali {
            background-color: #F3F4F6;
            color: #374151;
            border-color: #D1D5DB;
        }

            .btn-kembali:hover {
                background-color: #E5E7EB;
                text-decoration: none;
                color: #374151;
            }

        .btn-edit {
            background-color: #F59E0B;
            color: white;
        }

            .btn-edit:hover {
                background-color: #D97706;
                text-decoration: none;
                color: white;
            }

        .btn-print {
            background-color: #2563EB;
            color: white;
        }

            .btn-print:hover {
                background-color: #1D4ED8;
                text-decoration: none;
                color: white;
            }

        @@media (max-width: 768px) {
            .form-actions {
                flex-direction: column;
            }

            .btn {
                width: 100%;
                justify-content: center;
            }

            .surat-header-left,
            .surat-header-right {
                font-size: 10px; /* Perkecil font */
            }

            .surat-header-center {
                /* HAPUS width: 100% */
            }
            /* Reset margin-left di Semarang Plant untuk mobile */
            .surat-header-right div {
                margin-left: 0 !important;
            }

            .surat-logo {
                width: 35px !important; /* Perkecil logo */
                height: auto;
            }

            .surat-header-center div {
                font-size: 10px !important; /* Perkecil teks PT. GS BATTERY */
            }

            .data-row {
                flex-direction: column;
                gap: 4px;
            }

            .data-value {
                text-align: left;
                max-width: 100%;
            }

            .preview-content {
                padding: 10px;
                max-height: 65vh;
            }

            .surat-preview {
                font-size: 9px; /* Dari 12px */
                padding: 10px;
            }

            .surat-title h2 {
                font-size: 11px; /* Dari 16px */
            }

            .surat-table {
                font-size: 8px;
                margin-bottom: 10px;
            }

            .surat-content p {
                font-size: 9px;
                margin-bottom: 8px;
            }

            .signature-section {
                margin-top: 30px;
                font-size: 9px;
            }

            .catatan-section {
                font-size: 7px;
                margin-top: 20px;
            }

            .footer-section {
                font-size: 8px;
            }
        }

        @@media (min-width: 769px) and (max-width: 1024px) {
            .surat-header-left,
            .surat-header-right {
                font-size: 10px;
            }

                .surat-header-right div {
                    margin-left: 20px !important; /* Setengah dari 40% */
                }

            .surat-logo {
                width: 80px;
                height: auto;
            }

            .surat-header-center div {
                font-size: 15px;
            }
            /* Perkecil konten surat untuk tablet */
            .surat-preview {
                font-size: 10px;
                padding: 15px;
            }

            .surat-title h2 {
                font-size: 13px;
            }

            .surat-table {
                font-size: 9px;
                margin-bottom: 15px;
            }

            .surat-content p {
                font-size: 10px;
                margin-bottom: 10px;
            }

            .signature-section {
                margin-top: 40px;
                font-size: 10px;
            }

            .catatan-section {
                font-size: 8px;
                margin-top: 30px;
            }

            .footer-section {
                font-size: 9px;
            }
        }

        @@media print {
            body {
                background: white !important;
            }

            .blue-section,
            .form-actions,
            .preview-header,
            .data-summary,
            .note-box,
            .back-button {
                display: none !important;
            }

            .form-content-section {
                margin-top: 0 !important;
                padding: 0 !important;
            }

            .preview-container {
                box-shadow: none !important;
                border: none !important;
                margin: 0 !important;
                padding: 0 !important;
            }

            .preview-content {
                padding: 0 !important;
                max-height: none !important;
                overflow: visible !important;
                border: none !important;
                background: white !important;
            }

            .surat-preview {
                border: none !important;
                padding: 0 !important;
            }

            @@page {
                margin: 1cm;
                size: A4 landscape;
            }
        }
    </style>
</head>
<body>
    <div class="preview-page-container">
        <div class="page-header-standalone">
            <a href="javascript:window.close()" class="back-button" aria-label="Tutup">
                <i class="fas fa-times"></i>
            </a>
            <h1 class="page-header-title">@ViewBag.Title</h1>
        </div>

        <div class="form-content-section">
            <div class="preview-container">
                <div class="preview-header">
                    <h3 class="preview-title">
                        <i class="fas fa-eye title-icon"></i>
                        Preview Surat Jaminan
                    </h3>
                    <div class="preview-info">
                        <i class="fas fa-info-circle"></i>
                        <span id="suratInfo">Draft Preview</span>
                    </div>
                </div>

                <div class="preview-content">
                    <div id="suratContent" class="surat-preview">
                    </div>
                </div>
            </div>

            <div class="note-box">
                <strong>Informasi:</strong> Ini adalah preview surat jaminan yang akan dicetak. Pastikan semua data sudah benar sebelum dikirim.
            </div>

            <div class="form-actions">
                <a href="javascript:window.close()" class="btn btn-kembali">
                    <i class="fas fa-arrow-left"></i>
                    Tutup Preview
                </a>
            </div>
        </div>
    </div>

    <script>
        function createSuratContent(data) {
            const logoGS = "data:image/png;base64,";
            const jenisJaminan = (data.PsjTipeJaminan || '').toLowerCase();
            let judulSurat = "SURAT JAMINAN RAWAT INAP / OPNAME";

            if (jenisJaminan === "rawat jalan") {
                judulSurat = "SURAT JAMINAN RAWAT JALAN";
            }

            const tanggal = data.PsjTanggalPeriksa ? new Date(data.PsjTanggalPeriksa).toLocaleDateString("id-ID", {
                day: "2-digit",
                month: "long",
                year: "numeric"
            }) : '';

            let isiSurat = '';
            if (jenisJaminan === "rawat jalan") {
                isiSurat = 'Sehubungan dengan sakitnya karyawan tersebut diatas memerlukan <u><strong>Rawat Jalan</strong></u>. Maka semua biaya tanggungan PT. GS Battery.';
            } else {
                isiSurat = 'Sehubungan dengan sakitnya karyawan tersebut diatas memerlukan <u><strong>Opname</strong></u>. Maka semua biaya tanggungan PT. GS Battery dengan catatan Kelas 2 (Dua).';
            }

            return `
                            <div>
                                <!-- HEADER -->
                                <div class="surat-header">
                                    <div class="surat-header-left">
                                        <strong>HEAD OFFICE & KARAWANG PLANT :</strong><br>
                                        Jl. Surya Utama Kav. 1-3<br>
                                        Suryacipta City of Industry<br>
                                        Ciampel – Karawang, 41363<br>
                                        Phones : (0267) 440961 – 64<br>
                                        Facsimile : (0267) 440965
                                    </div>
                                    <div class="surat-header-center">
                                        <img src="${logoGS}" alt="GS Logo" class="surat-logo">
                                        <div style="font-size: 20px; font-weight: bold;">PT. GS BATTERY</div>
                                        <div style="font-size: 14px; font-weight: bold;">STORAGE BATTERY MANUFACTURER</div>
                                    </div>
                                    <div class="surat-header-right">
                                        <div style="margin-left: 40%;">
                                            <strong>SEMARANG PLANT:</strong><br>
                                            Kawasan Industri Bukit Semarang Baru<br>
                                            Blok. B3, Kel. Jatibarang, Kec. Mijen<br>
                                            Kota Semarang, Jawa Tengah<br>
                                            Phones: (024) 76439560
                                        </div>
                                    </div>
                                </div>

                                <!-- JUDUL -->
                                <div class="surat-title">
                                    <h2>${judulSurat}</h2>
                                </div>

                                <!-- PENERIMA -->
                                <table class="surat-table">
                                    <tr>
                                        <td style="width: 50%;"></td>
                                        <td style="text-align: right;">
                                            Kepada YTH,<br>
                                            <strong>Rumah Sakit / Klinik ${data.RumahSakitNama || '-'}</strong>
                                        </td>
                                    </tr>
                                </table>

                                <!-- NOMOR -->
                                <table class="surat-table">
                                    <tr><td style="width: 120px;">No</td><td>: [Akan diisi otomatis saat disetujui]</td></tr>
                                    <tr><td>Tanggal</td><td>: ${tanggal}</td></tr>
                                </table>

                                <!-- ISI SURAT -->
                                <div class="surat-content">
                                    <p>Yang Bertandatangan di bawah ini menerangkan bahwa:</p>

                                    <table class="surat-table">
                                        <tr><td style="width: 160px;">Nama Karyawan</td><td>: ${data.NamaKaryawan || '-'}</td></tr>
                                        <tr><td>NPK</td><td>: ${data.PsjNpk || '-'}</td></tr>
                                        <tr><td>Seksi/Dept</td><td>: @ViewBag.EmployeeDept</td></tr>
                                        <tr><td>Nama Pasien</td><td>: ${data.NamaPasien || '-'}</td></tr>
                                        <tr><td>Hubungan Pasien</td><td>: ${data.HubunganPasien || '-'}</td></tr>
                                    </table>

                                    <p>Adalah karyawan PT GS Battery.</p>
                                    <p>${isiSurat}</p>

                                    <p>Demikian atas kerjasamanya kami ucapkan terima kasih.</p>
                                    <p style="margin-bottom: 300px;"><p>
                                </div>

                                <!-- TANDA TANGAN -->
                                <div class="signature-section">
                                    <div class="signature-box">
                                        Hormat Kami,<br><br><br><br>
                                        <div style="text-decoration: underline; font-weight: bold;">Domo Pranowo K</div>
                                        <div style="font-weight: bold;">Deputy Div. Head HC</div>
                                    </div>
                                </div>

                                <!-- CATATAN -->
                                <div class="catatan-section">
                                    <strong>Catatan:</strong><br>
                                    * Surat jaminan ini sudah disetujui melalui sistem<br>
                                    * Masa berlaku surat jaminan adalah 2x24 jam sejak tanggal diterbitkan<br>
                                    * Hanya berlaku di Rumah Sakit / Klinik Rayon yang Kerjasama dengan PT GS Battery
                                </div>

                                <!-- FOOTER -->
                                <div class="footer-section">
                                    PREVIEW - Draft Surat Jaminan
                                </div>
                            </div>
                        `;
        }


        $(document).ready(function () {
            const urlParams = new URLSearchParams(window.location.search);

            const data = {
                PsjNpk: urlParams.get('PsjNpk') || '-',
                NamaKaryawan: urlParams.get('NamaKaryawan') || '-',
                NamaPasien: urlParams.get('NamaPasien') || '-',
                HubunganPasien: urlParams.get('HubunganPasien') || '-',
                PsjTipeJaminan: urlParams.get('PsjTipeJaminan') || '-',
                RumahSakitNama: urlParams.get('RumahSakitNama') || '-',
                PsjTanggalPeriksa: urlParams.get('PsjTanggalPeriksa') || '-',
                PsjKeterangan: urlParams.get('PsjKeterangan') || ''
            };

            $('#summaryNpk').text(data.PsjNpk);
            $('#summaryNamaKaryawan').text(data.NamaKaryawan);
            $('#summaryNamaPasien').text(data.NamaPasien);
            $('#summaryHubunganPasien').text(data.HubunganPasien);
            $('#summaryTipeJaminan').text(data.PsjTipeJaminan);
            $('#summaryRumahSakit').text(data.RumahSakitNama);
            $('#summaryTanggalPeriksa').text(data.PsjTanggalPeriksa ? new Date(data.PsjTanggalPeriksa).toLocaleDateString("id-ID", {
                day: "2-digit",
                month: "long",
                year: "numeric"
            }) : '-');
            const suratContent = createSuratContent(data);
            $('#suratContent').html(suratContent);

            const jenisJaminan = (data.PsjTipeJaminan || '').toLowerCase();
            const jenisSurat = jenisJaminan === "rawat jalan" ? "Rawat Jalan" : "Rawat Inap";
            $('#suratInfo').text(`Preview ${jenisSurat}`);
        });
    </script>
</body>
</html>