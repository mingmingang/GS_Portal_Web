            // Fungsi untuk mengambil data lembur dari API
            function fetchOvertimeData() {
                return $.ajax({
                    url: API_ENDPOINT,
                    method: 'GET',
                    dataType: 'json',
                    timeout: 10000
                });
            }

            // Fungsi untuk mengambil dan merender data lembur
            function fetchAndRenderOvertime() {
                const container = $('#overtimeList');
                container.html(`
                        <div class="loading-message">
                            <i class="fas fa-spinner fa-spin"></i> Memuat data...
                        </div>
                    `);

                const range = getPeriodeRange();
                const startDate = range.start;
                const endDate = range.end;

                fetchOvertimeData()
                    .done(function (response) {
                        $('.loading-message').remove();

                        let allFilteredByDate = [];
                        if (response && response.data && response.data.length > 0) {
                            allFilteredByDate = response.data.filter(function (item) {
                                const itemDate = moment(item.LbrTanggal);
                                return itemDate.isBetween(startDate, endDate, null, '[]');
                            });
                        }

                        allOvertimeData = allFilteredByDate;
                        updateRingkasanStatus();

                        // Apply status filter globally for updateOvertimeListView to handle search correctly
                        if (currentStatus !== "Semua") {
                            allOvertimeData = allFilteredByDate.filter(function (item) {
                                return item.LbrStatus && item.LbrStatus.toLowerCase() === currentStatus.toLowerCase();
                            });
                        }

                        updateOvertimeListView();
                    })
                    .fail(function () {
                        $('.loading-message').remove();
                        allOvertimeData = [];
                        updateRingkasanStatus();
                        showNoDataMessage('Gagal memuat data dari server');
                    });
            }

            function showNoDataMessage(customMessage = null) {
                const container = $('#overtimeList');
                const periodeName = getDisplayPeriodeText();
                const statusName = currentStatus;
                let message = customMessage || `Tidak ada data lembur untuk periode "${periodeName}" dengan status "${statusName}"`;

                // Jika sedang mencari tetapi data tidak ada
                if (searchKeyword.trim() !== '' && !customMessage) {
                    message = `Tidak ada data yang cocok dengan NPK "${searchKeyword}" pada periode ini.`;
                }

                container.html(`
                        <div class="no-data-container" style="display: block;">
                            <h4 class="no-data-title">Tidak ada data</h4>
                            <p class="no-data-text">${message}</p>
                        </div>
                    `);
            }

            function updateOvertimeListView() {
                filteredOvertimeData = allOvertimeData;

                // Filter by search keyword
                if (searchKeyword.trim() !== '') {
                    filteredOvertimeData = filteredOvertimeData.filter(function (item) {
                        const npk = (item.KryNpk || '').toString().toLowerCase();
                        const keyword = searchKeyword.toLowerCase();

                        return npk.includes(keyword)
                    });
                }

                renderAllData();
            }

            function renderAllData() {
                const container = $('#overtimeList');

                if (!filteredOvertimeData || filteredOvertimeData.length === 0) {
                    showNoDataMessage();
                    return;
                }

                container.empty();

                filteredOvertimeData.forEach(item => {
                    moment.locale('id');
                    const dateMoment = moment(item.LbrTanggal);
                    const dayOfWeek = dateMoment.format('dddd');
                    const formattedDate = dateMoment.format('D MMM YYYY');

                    let statusText = item.LbrStatus ? item.LbrStatus.charAt(0).toUpperCase() + item.LbrStatus.slice(1).toLowerCase() : 'N/A';
                    const statusClass = statusText.toLowerCase();

                    const npk = item.KryNpk || 'N/A';

                    const card = `
                                    <div class="card" data-id="${item.LbrId}">
                                        <div class="card-content">
                                            <div class="card-left-section">
                                                <p class="card-npk">NPK : ${npk}</p>
                                                <p class="card-date-label-wrapper">Tanggal</p>
                                                <div class="card-date-info">
                                                    <p class="card-date"><i class="fas fa-clock"></i> ${dayOfWeek}, ${formattedDate}</p>
                                                </div>
                                            </div>
                                            <div class="card-right-section">
                                                <span class="card-status-badge status-${statusClass}">${statusText}</span>
                                                <a href="/Manage/ManageDetailOverTime/${item.LbrId}" class="card-action-link">
                                                    Lihat <i class="fas fa-arrow-right"></i>
                                                </a>
                                            </div>
                                        </div>
                                    </div>
                                `;
                    container.append(card);
                });
            }

            // Event handler untuk dropdown icon (buka month picker)
            $('#periodeDropdownIcon, #periodeSelectorCard').on('click', function (e) {
                e.stopPropagation();
                // Pastikan currentYear dan selectedMonth diset ke nilai aktif sebelum membuka modal
                if (currentPeriode !== 'periode-bulan' || selectedMonth === null) {
                    currentYear = new Date().getFullYear();
                    selectedMonth = new Date().getMonth();
                }

                renderMonthPicker();
            });

            // Event handler untuk filter icon (buka periode filter)
            //$('#periodeFilterIcon').on('click', function (e) {
            //    e.stopPropagation();
            //    renderPeriodeFilterModal();
            //});

            // Event handler untuk filter Status
            $('#statusFilterContainer .status-tab-btn').on('click', function () {
                $('#statusFilterContainer .status-tab-btn').removeClass('active');
                $(this).addClass('active');
                currentStatus = $(this).data('status');
                fetchAndRenderOvertime();
            });

            // Event handler untuk search input
            $('#searchInput').on('input', function () {
                searchKeyword = $(this).val();
                // Langsung update list view, tidak perlu fetch API lagi
                updateOvertimeListView();
            });

            // Modal controls
            $('#closeMonthPickerModal').on('click', function () {
                $('#monthPickerModal').removeClass('show');
            });

            $('#monthPickerModal').on('click', function (e) {
                if (e.target.id === 'monthPickerModal') {
                    $('#monthPickerModal').removeClass('show');
                }
            });

            $('#closePeriodeFilterModal').on('click', function () {
                $('#periodeFilterModal').removeClass('show');
            });

            $('#periodeFilterModal').on('click', function (e) {
                if (e.target.id === 'periodeFilterModal') {
                    $('#periodeFilterModal').removeClass('show');
                }
            });

            // Panduan Modal Handlers
            $('#closePanduanOvertimeModalX, #closePanduanOvertimeButton').on('click', function () {
                $('#panduanOvertimeModal').removeClass('show');
            });
            $('#panduanOvertimeModal').on('click', function (e) {
                if (e.target.id === 'panduanOvertimeModal') {
                    $('#panduanOvertimeModal').removeClass('show');
                }
            });

            // Initial load
            moment.locale('id');
            updatePeriodeSelectorDisplay();
            fetchAndRenderOvertime();
        });
    </script>
