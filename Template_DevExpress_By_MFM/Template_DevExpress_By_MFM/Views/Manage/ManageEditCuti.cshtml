@model Template_DevExpress_By_MFM.Models.CutiModel
@{
    ViewBag.Title = "Edit Pengajuan Cuti";
    var logSession = HttpContext.Current.Session["SHealth"] as Template_DevExpress_By_MFM.Models.SessionLogin;
    Layout = null;
}

<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css">
    <script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>
    <style>
        :root {
            --primary-color: #1E2D56;
            --secondary-color: #2A4A7B;
            --success-color: #10B981;
            --danger-color: #EF4444;
            --warning-color: #F59E0B;
            --text-color: #333;
            --bg-color: #F3F4F6;
            --input-border: #D1D5DB;
            --success-green: #198754;
        }

        body {
            font-family: 'Inter', sans-serif;
            margin: 0;
            padding: 0;
            color: var(--text-color);
        }

        /* --- Header --- */
        .form-header-title {
            background: linear-gradient(135deg, var(--primary-color) 0%, var(--secondary-color) 100%);
            height: 60px;
            padding: 0 20px;
            display: flex;
            align-items: center;
            justify-content: center;
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            z-index: 50;
            box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1);
        }

        .back-icon {
            position: absolute;
            left: 20px;
            color: white;
            font-size: 1.3rem;
            text-decoration: none;
            display: flex;
            align-items: center;
            height: 100%;
        }

        .lampiran-wrapper {
            display: flex;
        }

        .header-title-text {
            font-size: 1.1rem;
            font-weight: 600;
            color: white;
            margin: 0;
        }

        /* --- Main Container --- */
        .main-container {
            margin: 80px 0px; /* Center align */
            background: white;
            border-radius: 12px;
            padding: 25px;
        }

        /* --- Alert Box (Error) --- */
        .alert-box {
            display: none;
            position: relative;
            background-color: #FEF2F2;
            border: 1px solid #FECACA;
            border-left: 5px solid #DC2626;
            color: #991B1B;
            padding: 15px 40px 15px 20px;
            border-radius: 6px;
            margin-bottom: 20px;
            display: flex;
            align-items: flex-start;
            gap: 12px;
            box-shadow: 0 2px 5px rgba(0,0,0,0.05);
            animation: slideIn 0.3s ease-out;
        }

            .alert-box i.fa-triangle-exclamation {
                font-size: 1.3rem;
                color: #DC2626;
                margin-top: 2px;
            }

            .alert-box > div {
                flex: 1;
                font-size: 0.95rem;
            }

        .alert-title {
            font-weight: 700;
            display: block;
            margin-bottom: 4px;
            font-size: 1rem;
        }

        .close-alert {
            position: absolute;
            top: 10px;
            right: 10px;
            background: transparent;
            border: none;
            color: #991B1B;
            font-size: 1.2rem;
            line-height: 1;
            cursor: pointer;
            opacity: 0.6;
            transition: opacity 0.2s;
            padding: 5px;
        }

            .close-alert:hover {
                opacity: 1;
                background-color: rgba(220, 38, 38, 0.1);
                border-radius: 4px;
            }

        /* --- Form Elements --- */
        .form-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 20px;
            margin-bottom: 15px;
        }

        .form-group {
            margin-bottom: 20px;
            position: relative;
        }

            .form-group label {
                display: block;
                font-weight: 500;
                margin-bottom: 8px;
                font-size: 0.9rem;
                color: #374151;
            }

        .required-star {
            color: var(--danger-color);
            font-weight: bold;
            margin-left: 2px;
            display: inline-block;
        }

        .field-error-msg {
            color: var(--danger-color);
            font-size: 0.85em;
            margin-left: 10px;
            font-weight: normal;
            display: none;
        }

        .input-error {
            border-color: var(--danger-color) !important;
            background-color: #fff8f8;
        }

        .form-control, .form-select {
            width: 100%;
            padding: 10px 12px;
            border: 1px solid var(--input-border);
            border-radius: 6px;
            font-size: 0.95rem;
            font-family: inherit;
            box-sizing: border-box;
            transition: border-color 0.2s;
        }

            .form-control:focus {
                outline: none;
                border-color: var(--secondary-color);
                box-shadow: 0 0 0 3px rgba(42, 74, 123, 0.1);
            }

            .form-control[readonly] {
                background-color: #F9FAFB;
                cursor: default;
                border-color: #E5E7EB;
            }

        .input-group {
            display: flex;
            align-items: stretch;
        }

            .input-group .form-control {
                border-top-right-radius: 0;
                border-bottom-right-radius: 0;
            }

        .input-group-text {
            background: #F3F4F6;
            border: 1px solid var(--input-border);
            border-left: 0;
            border-radius: 0 6px 6px 0;
            padding: 0 15px;
            display: flex;
            align-items: center;
            font-size: 0.9rem;
            color: #666;
        }

        textarea.form-control {
            resize: vertical;
            min-height: 80px;
        }

        /* --- Buttons --- */
        .footer-actions {
            display: flex;
            justify-content: flex-end;
            gap: 15px;
            margin-top: 30px;
            border-top: 1px solid #EEE;
            padding-top: 20px;
        }

        .btn {
            padding: 10px 24px;
            border-radius: 6px;
            font-weight: 500;
            font-size: 0.95rem;
            cursor: pointer;
            border: none;
            transition: all 0.2s;
            align-items: center;
            gap: 8px;
        }

        .btn-cancel {
            background-color: #E5E7EB;
            color: #374151;
        }

        .btn-submit {
            background-color: var(--success-green);
            color: white;
        }

        .btn-browse-simple {
            background: white;
            border: 1px solid var(--input-border);
            padding: 8px 12px;
            border-radius: 6px;
            font-size: 0.85rem;
            cursor: pointer;
            display: flex;
            align-items: center;
            gap: 6px;
            color: #555;
        }

            .btn-browse-simple:hover {
                background-color: #F9FAFB;
                border-color: #999;
            }

        /* --- File List & Existing Files --- */
        .file-list-box {
            margin-top: 10px;
            display: flex;
            flex-direction: column;
            gap: 8px;
        }

        .file-item {
            display: flex;
            justify-content: space-between;
            align-items: center;
            background: #f8f9fa;
            border: 1px solid #e9ecef;
            padding: 8px 12px;
            border-radius: 6px;
            font-size: 0.9rem;
        }

        .file-info {
            display: flex;
            align-items: center;
            gap: 8px;
            overflow: hidden;
        }

        .file-name-text {
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
            max-width: 200px;
            font-weight: 500;
            color: #333;
        }

        .btn-remove-file {
            background: none;
            border: none;
            color: #dc3545;
            cursor: pointer;
            font-size: 1.1rem;
            padding: 0 5px;
            transition: color 0.2s;
        }

            .btn-remove-file:hover {
                color: #a71d2a;
            }

        .existing-files-wrapper {
            background-color: #F0F9FF;
            border: 1px dashed #BAE6FD;
            padding: 10px;
            border-radius: 6px;
            margin-bottom: 10px;
        }

        .existing-file-item {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 6px;
            padding-bottom: 6px;
            border-bottom: 1px solid #e0f2fe;
        }

            .existing-file-item:last-child {
                border-bottom: none;
                margin-bottom: 0;
                padding-bottom: 0;
            }

        /* --- Modals (Camera & Preview) --- */
        .file-modal, .camera-modal {
            display: none;
            position: fixed;
            z-index: 1000;
            left: 0;
            top: 0;
            width: 100%;
            height: 100%;
            overflow: auto;
            background-color: rgba(0,0,0,0.6);
            backdrop-filter: blur(2px);
        }

        .file-modal-content {
            background-color: #fefefe;
            margin: 5% auto;
            padding: 0;
            border: 1px solid #888;
            width: 80%;
            max-width: 800px;
            border-radius: 8px;
            box-shadow: 0 4px 20px rgba(0,0,0,0.2);
            animation: slideDown 0.3s ease-out;
        }

        .camera-content {
            background-color: #fff;
            margin: 10% auto;
            padding: 20px;
            border-radius: 12px;
            width: 90%;
            max-width: 500px;
            position: relative;
        }

        /* Overlay Modal */
        .camera-modern-modal {
            display: none;
            position: fixed;
            z-index: 9999;
            left: 0;
            top: 0;
            width: 100%;
            height: 100%;
            background-color: rgba(0, 0, 0, 0.85);
            backdrop-filter: blur(5px);
            align-items: center;
            justify-content: center;
        }

        /* Container Utama */
        .camera-modern-content {
            background-color: #2D2D2D;
            width: 90%;
            max-width: 500px;
            border-radius: 20px;
            overflow: hidden;
            padding: 15px;
            box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.3);
        }

        /* Area Frame Kamera */
        .camera-view-container {
            width: 100%;
            aspect-ratio: 4 / 3;
            background: #000;
            border-radius: 12px;
            overflow: hidden;
            margin-bottom: 15px;
            position: relative;
        }

            .camera-view-container video,
            .camera-view-container img {
                width: 100%;
                height: 100%;
                object-fit: cover; /* Agar video memenuhi frame */
            }

        /* Group Tombol */
        .camera-modern-footer {
            display: flex;
            gap: 12px;
            width: 100%;
        }

        /* Tombol Batal (Putih/Abu) */
        .btn-cam-secondary {
            flex: 1;
            background: #F3F4F6;
            color: #374151;
            border: none;
            padding: 12px;
            border-radius: 10px;
            font-weight: 600;
            font-size: 1rem;
            cursor: pointer;
            transition: background 0.2s;
        }

        /* Tombol Ambil Foto (Biru) */
        .btn-cam-primary {
            flex: 1;
            background: #2563EB;
            color: white;
            border: none;
            padding: 12px;
            border-radius: 10px;
            font-weight: 600;
            font-size: 1rem;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            transition: background 0.2s;
        }

            .btn-cam-primary:hover {
                background: #1D4ED8;
            }

        .btn-cam-secondary:hover {
            background: #E5E7EB;
        }

        .file-modal-header {
            padding: 15px 20px;
            background-color: var(--primary-color);
            color: white;
            border-top-left-radius: 8px;
            border-top-right-radius: 8px;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

            .file-modal-header h4 {
                margin: 0;
                font-size: 1.1rem;
            }

        .file-close {
            color: white;
            font-size: 24px;
            font-weight: bold;
            cursor: pointer;
        }

        .file-modal-body {
            padding: 20px;
            min-height: 200px;
            display: flex;
            justify-content: center;
            align-items: center;
            background-color: #F3F4F6;
        }

        .close-cam {
            position: absolute;
            right: 15px;
            top: 10px;
            font-size: 28px;
            cursor: pointer;
            color: #666;
            background: none;
            border: none;
        }

        .page-loader {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background-color: rgba(255, 255, 255, 0.9); /* Putih transparan */
            z-index: 99999;
            display: flex;
            align-items: center;
            justify-content: center;
            flex-direction: column;
        }

        .loader-content {
            text-align: center;
        }

        .spinner {
            width: 50px;
            height: 50px;
            border: 5px solid #f3f3f3;
            border-top: 5px solid #2563EB; /* Warna Biru sesuai tema */
            border-radius: 50%;
            animation: spin 1s linear infinite;
            margin: 0 auto 15px;
        }

        @@keyframes spin {
            0% { transform: rotate(0deg); }
            100% { transform: rotate(360deg); }
        }

        .page-loader p {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            color: #374151;
            font-weight: 600;
            margin: 0;
        }

        @@media (max-width: 600px) {
            .form-grid {
                grid-template-columns: 1fr;
                gap: 0;
            }

            .main-container {
                margin: 70px 20px 20px 20px;
                padding: 20px;
            }

            .file-modal-content {
                width: 95%;
                margin: 10% auto;
            }
        }

        @@keyframes slideIn {
            from {
                opacity: 0;
                transform: translateY(-10px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        @@keyframes slideDown {
            from {
                opacity: 0;
                transform: translateY(-20px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        .shake {
            animation: shake 0.5s;
        }

        @@keyframes shake {
            0%, 100% {
                transform: translateX(0);
            }

            25% {
                transform: translateX(-5px);
            }

            75% {
                transform: translateX(5px);
            }
        }
    </style>
</head>
<body>

    <header class="form-header-title">
        <a href="@Url.Action("ManageCutiKaryawan", "Manage")" class="back-icon"><i class="fa-solid fa-arrow-left"></i></a>
        <span class="header-title-text" id="pageTitle">Edit Pengajuan Cuti</span>
    </header>

    <div id="pageLoader" class="page-loader">
        <div class="loader-content">
            <div class="spinner"></div>
            <p>Memuat Data...</p>
        </div>
    </div>

    <div class="main-container">
        <div id="errorAlertBox" class="alert-box" style="display:none;">
            <i class="fa-solid fa-triangle-exclamation"></i>
            <div>
                <span class="alert-title">Mohon Periksa Kembali</span>
                <span id="errorMessageText">Terjadi kesalahan pada input data.</span>
            </div>
            <button type="button" class="close-alert" onclick="$('#errorAlertBox').fadeOut()">&times;</button>
        </div>

        <form id="cutiForm" novalidate>
            @Html.AntiForgeryToken()

            <div class="form-grid">
                <div class="form-group">
                    <label>No. Pengajuan</label>
                    <input type="text" id="cuti_id" class="form-control" readonly placeholder="Memuat..." />
                </div>
                <div class="form-group">
                    <label>NPK Karyawan</label>
                    <input type="text" id="npk_karyawan" class="form-control" value="@(logSession.npk)" readonly />
                </div>
            </div>

            <div class="form-group">
                <label>Nama Karyawan</label>
                <input type="text" id="permohonan_untuk" class="form-control" value="@(logSession.fullname)" readonly />
            </div>

            <div class="form-grid">
                <div class="form-group">
                    <label>Tipe Cuti</label>
                    <input type="text" id="tipe_cuti_display" class="form-control" readonly />
                    <input type="hidden" id="leave_code_hidden" />
                </div>

                <div class="form-group" id="sisaCutiSection" style="display: none;">
                    <label>Sisa Kuota</label>
                    <div class="input-group">
                        <input type="text" id="sisa_cuti" class="form-control" value="@ViewBag.SisaCuti" readonly />
                        <span class="input-group-text">Hari</span>
                    </div>
                </div>
            </div>

            <div class="form-group" id="cutiKhususSection" style="display: none;">
                <label>
                    Jenis Cuti Khusus <span class="required-star">*</span>
                    <span id="err_sub_tipe_cuti" class="field-error-msg">Wajib dipilih</span>
                </label>
                <select id="sub_tipe_cuti" name="sub_tipe_cuti" class="form-select"></select>
                <div id="cutiInfoText" style="font-size: 0.85rem; color: #0369A1; margin-top: 5px; background: #F0F9FF; padding: 8px; border-radius: 4px; display: none;">
                    <i class="fas fa-info-circle"></i> <span id="cutiInfoContent"></span>
                </div>
            </div>

            <div class="form-grid">
                <div class="form-group">
                    <label>Mulai Dari <span class="required-star">*</span> <span id="err_TanggalMulai" class="field-error-msg">Wajib diisi</span></label>
                    <input type="text" id="TanggalMulai" class="form-control" readonly placeholder="Pilih Tanggal" style="background:white;" />
                </div>

                <div class="form-group">
                    <label>Sampai Dengan <span class="required-star">*</span> <span id="err_TanggalSelesai" class="field-error-msg">Wajib diisi</span></label>
                    <input type="text" id="TanggalSelesai" class="form-control" readonly placeholder="Pilih Tanggal" style="background:white;" />
                </div>
            </div>

            <div class="form-group">
                <label>Durasi <span id="err_Durasi" class="field-error-msg">Tidak valid</span></label>
                <div class="input-group">
                    <input type="text" id="Durasi" class="form-control" readonly style="font-weight:600;" />
                    <span class="input-group-text">Hari</span>
                </div>
            </div>

            <div class="form-group">
                <label>Keterangan <span class="required-star">*</span> <span id="err_Keterangan" class="field-error-msg">Wajib diisi</span></label>
                <textarea id="Keterangan" class="form-control" placeholder="Tuliskan keterangan revisi/pengajuan..." rows="3"></textarea>
            </div>

            <div class="form-group" id="lampiranSection">
                <label>
                    <div>
                        Lampiran <span id="labelOptional" style="display:none; color:#777; font-weight:normal; font-size:0.85em;">(Opsional)</span>
                        <span id="lampiranRequired" class="required-star" style="display:none;">*</span>
                    </div>
                    <span id="err_lampiran" class="field-error-msg">Wajib upload file</span>
                </label>

                <div id="existingFileContainer" class="existing-files-wrapper" style="display:none;">
                    <div style="font-size:0.85rem; font-weight:600; color:#0369A1; margin-bottom:5px;">
                        <i class="fa-solid fa-database"></i> File Tersimpan:
                    </div>
                    <div id="existingFileList"></div>
                </div>

                <div class="lampiran-wrapper">
                    <button type="button" id="btnBrowseFile" class="btn-browse-simple">
                        <i class="fa-regular fa-file"></i> Ganti File
                    </button>
                    <button type="button" id="btnOpenCamera" class="btn-browse-simple ml-4">
                        <i class="fa-solid fa-camera"></i> Kamera
                    </button>
                </div>

                <div style="font-size:0.8rem; color:#888; margin-top:4px;">
                    *Format: .jpg, .pdf, .zip (Max 2MB/file). File baru akan ditambahkan.
                </div>

                <div id="fileListContainer" class="file-list-box"></div>
                <input type="file" id="lampiranFile" name="lampiranFile[]" multiple style="display: none;">
            </div>

            <div class="footer-actions">
                <button type="button" id="btnSaveDraft" class="btn btn-cancel">Simpan Draft</button>
                <button type="button" id="btnSubmit" class="btn btn-submit">Kirim Ulang</button>
            </div>
        </form>
    </div>

    <div id="cameraModal" class="camera-modern-modal">
        <div class="camera-modern-content">
            <div class="camera-view-container">
                <video id="videoPreview" autoplay playsinline></video>
                <img id="imagePreview" style="display:none;">
                <canvas id="canvasCapture" style="display:none;"></canvas>
            </div>
            <div class="camera-modern-footer">
                <button type="button" id="closeCamera" class="btn-cam-secondary">Batal</button>
                <div id="dynamicCameraBtn" style="flex: 1; display: flex;">
                    <button type="button" id="btnCapture" class="btn-cam-primary">
                        <i class="fa-solid fa-camera"></i> Ambil Foto
                    </button>
                </div>
            </div>
        </div>
    </div>

    <div id="previewModal" class="file-modal" style="display: none;">
        <div class="file-modal-content">
            <div class="file-modal-header">
                <h4 id="previewModalTitle">Lihat Lampiran</h4>
                <span class="file-close" style="cursor:pointer;">&times;</span>
            </div>
            <div class="file-modal-body" id="previewModalBody">
                <p>Memuat...</p>
            </div>
        </div>
    </div>

    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <script>
    (function ($) {
        'use strict';

        var EditCutiPage = {
            config: {
                cutiId: null, userNpk: '', redirectUrl: '', sisaCuti: 0
            },
            elements: {},
            allLeaveTypes: [],
            originalLeaveCode: null,
            originalDuration: 0,
            stream: null,
            capturedBlob: null,
            selectedFiles: [],
            fpMulai: null,
            fpSelesai: null,
            massiveDates: [],
            currentDayType: 'Hari Kerja',

            init: function (config) {
                this.config = $.extend(this.config, config);
                this.cacheElements();
                this.setInitialMinDate();
                this.initDatePickers();
                this.loadMassiveLeaves();
                $("#pageLoader").show();

                var self = this;
                $.when(
                    this.loadLeaveTypes(),
                    this.loadMassiveLeaves()
                ).done(function () {
                    self.loadData(self.config.cutiId);
                }).fail(function () {
                    $("#pageLoader").hide();
                    Swal.fire('Error', 'Gagal memuat konfigurasi awal.', 'error');
                });

                this.bindEvents();
                this.selectedFiles = [];
                this.loadLeaveTypes().then(() => {
                    this.loadData(this.config.cutiId);
                });
            },

            cacheElements: function () {
                this.elements = {
                    cutiIdInput: $("#cuti_id"),
                    tipeCutiDisplay: $("#tipe_cuti_display"),
                    sisaCutiSection: $("#sisaCutiSection"),
                    cutiKhususSection: $("#cutiKhususSection"),
                    subTipeCuti: $("#sub_tipe_cuti"),
                    tanggalMulai: $("#TanggalMulai"),
                    tanggalSelesai: $("#TanggalSelesai"),
                    durasiInput: $("#Durasi"),
                    durasiDisplay: $("#Durasi"),
                    keterangan: $("#Keterangan"),
                    lampiranSection: $("#lampiranSection"),
                    lampiranRequired: $("#lampiranRequired"),
                    lampiranFile: $("#lampiranFile"),
                    fileListContainer: $("#fileListContainer"),
                    existingFileContainer: $("#existingFileContainer"),
                    existingFileList: $("#existingFileList"),
                    previewModal: $("#previewModal"),
                    previewModalBody: $("#previewModalBody"),
                    previewModalTitle: $("#previewModalTitle"),
                    previewModalClose: $(".file-close"),
                    errorBox: $("#errorAlertBox"),
                    errorText: $("#errorMessageText"),
                    btnSubmit: $("#btnSubmit"),
                    btnSaveDraft: $("#btnSaveDraft"),
                    cameraModal: $("#cameraModal"),
                    videoPreview: $("#videoPreview"),
                    imagePreview: $("#imagePreview"),
                    canvasCapture: $("#canvasCapture")[0],
                    cameraFooter: $("#cameraFooter")
                };
            },

            setInitialMinDate: function() {
                const today = new Date().toISOString().split('T')[0];
                this.elements.tanggalMulai.attr('min', today);
                this.elements.tanggalSelesai.attr('min', today);
            },

            initDatePickers: function () {
                var self = this;
                var cfg = {
                    dateFormat: "Y-m-d",
                    minDate: "today",
                    disableMobile: true,
                    onChange: function () {
                        self.handleTanggalChange();
                    }
                };
                this.fpMulai = flatpickr("#TanggalMulai", cfg);
                this.fpSelesai = flatpickr("#TanggalSelesai", cfg);
            },

            loadMassiveLeaves: function () {
                var self = this;
                return $.ajax({
                    url: '/api/CutiApi/get_massive_leave',
                    type: 'GET',
                    data: { company_id: '13559' },
                    success: function (res) {
                        if (res && res.data) {
                            self.massiveDates = res.data.map(item => ({
                                from: item.from,
                                to: item.to
                            }));
                            self.updateWeekendStatus(self.currentDayType === 'Hari Kerja');
                        }
                    }
                });
            },

            handleTanggalChange: function () {
                const startVal = this.elements.tanggalMulai.val();
                if (startVal) {
                    this.fpSelesai.set('minDate', startVal);
                }
                this.hitungDurasi();
            },

            updateWeekendStatus: function (isHariKerja) {
                var disableRules = [];
                if (this.massiveDates.length > 0) disableRules = [...this.massiveDates];
                if (isHariKerja) {
                    disableRules.push(function (date) {
                        return (date.getDay() === 0 || date.getDay() === 6);
                    });
                }

                if (this.fpMulai && this.fpSelesai) {
                    this.fpMulai.set("disable", disableRules);
                    this.fpSelesai.set("disable", disableRules);
                }
            },

            bindEvents: function () {
                var self = this;
                this.elements.subTipeCuti.on('change', function () {
                    self.handleSubTipeChange();
                });

                this.elements.tanggalMulai.on('change', function () {
                    self.handleStartDateChange();
                    self.hitungDurasi();
                });

                this.elements.tanggalSelesai.on('change', function() {
                    self.hitungDurasi();
                });

                $("#btnBrowseFile").on("click", function() {
                    self.elements.lampiranFile.val('');
                    self.elements.lampiranFile.click();
                });

                this.elements.lampiranFile.on("change", this.handleFileSelect.bind(this));

                $(document).on("click", ".btn-remove-file", function () {
                    const index = $(this).data("index");
                    self.removeFile(index);
                });

                $(document).on("click", ".btn-view-existing", function(e) {
                    e.preventDefault();
                    var fileName = $(this).data('file');
                    self.viewLampiran(fileName);
                });

                this.elements.previewModalClose.on('click', function() {
                    self.elements.previewModal.fadeOut();
                    self.elements.previewModalBody.html('');
                });

                $(window).on('click', function(event) {
                    if ($(event.target).is(self.elements.previewModal)) {
                        self.elements.previewModal.fadeOut();
                        self.elements.previewModalBody.html('');
                    }
                });

                this.elements.btnSubmit.on("click", function () { self.handleSubmitForm(false); });
                this.elements.btnSaveDraft.on("click", function () { self.handleSubmitForm(true); });

                $("#btnOpenCamera").on("click", this.openCamera.bind(this));
                $("#closeCamera").on("click", this.closeCamera.bind(this));
                $(document).on("click", "#btnCapture", this.captureImage.bind(this));
                $(document).on("click", "#btnRetake", this.initializeCamera.bind(this));
                $(document).on("click", "#btnUsePhoto", this.useCapturedPhoto.bind(this));
            },

            handleSubTipeChange: function () {
                var self = this;
                const leaveCode = this.elements.subTipeCuti.val();
                const selectedText = this.elements.subTipeCuti.find("option:selected").text().toLowerCase();
                const $sec = this.elements.lampiranSection;
                const $req = this.elements.lampiranRequired;
                const $file = this.elements.lampiranFile;

                if (leaveCode) {
                    $('#cutiInfoContent').html('<em>Memuat aturan cuti...</em>');
                    $('#cutiInfoText').show();

                    $.ajax({
                        url: '/api/CutiApi/get_rule_cuti',
                        type: 'GET',
                        data: { leave_code: leaveCode },
                        success: function (res) {
                            if (res.meta && res.meta.code === 200 && res.data) {
                                const infoMsg = `Maksimal pengajuan: <strong>${res.data.jatah_cuti} Hari</strong> (${res.data.hitungan_hari})`;
                                $('#cutiInfoContent').html(infoMsg);
                                $('#cutiInfoText').slideDown();

                                self.currentDayType = res.data.hitungan_hari;
                                self.updateWeekendStatus(self.currentDayType === 'Hari Kerja');
                            }
                        }
                    });
                }

                if (selectedText.includes("haid")) {
                    $sec.slideUp(); $file.prop('required', false);
                } else {
                    $sec.slideDown(); $req.show(); $file.prop('required', true);
                }
                self.hitungDurasi();
            },


            viewLampiran: function(fileName) {
                var self = this;
                var fileUrl = '/Cuti/GetFileProxy?fileName=' + encodeURIComponent(fileName);
                var ext = fileName.split('.').pop().toLowerCase();
                var html = '';

                if (['jpg', 'jpeg', 'png'].includes(ext)) {
                    html = `<div style="text-align:center;"><img src="${fileUrl}" style="max-width:100%; max-height:500px; border-radius:4px;" alt="Preview" onerror="this.onerror=null; this.src=''; this.parentElement.innerHTML='<p style=\\'color:red\\'>Gagal memuat gambar.</p>';"></div>`;
                    self.elements.previewModalTitle.text("Foto Lampiran");
                    self.elements.previewModalBody.html(html);
                    self.elements.previewModal.fadeIn();
                } else if (ext === 'pdf') {
                    html = `<iframe src="${fileUrl}" style="width:100%; height:500px; border:none;"></iframe>`;
                    self.elements.previewModalTitle.text("Dokumen PDF");
                    self.elements.previewModalBody.html(html);
                    self.elements.previewModal.fadeIn();
                } else {
                    window.open(fileUrl, '_blank');
                }
            },

            handleFileSelect: function (e) {
                var newFiles = Array.from(e.target.files);
                var self = this;
                var validFiles = [];
                var invalidFiles = [];

                newFiles.forEach(function (file) {
                    var maxSize = 2 * 1024 * 1024;
                    var isValidSize = file.size <= maxSize;
                    var ext = file.name.split('.').pop().toLowerCase();
                    var isValidType = ['jpg', 'jpeg', 'png', 'pdf', 'zip'].indexOf(ext) !== -1;

                    if (!isValidSize) invalidFiles.push(`${file.name} (Max 2MB)`);
                    else if (!isValidType) invalidFiles.push(`${file.name} (Format salah)`);
                    else validFiles.push(file);
                });

                if (invalidFiles.length > 0) Swal.fire('File Gagal', invalidFiles.join('<br>'), 'warning');

                this.selectedFiles = this.selectedFiles.concat(validFiles);
                this.renderFileList();
            },

            removeFile: function (index) {
                this.selectedFiles.splice(index, 1);
                this.renderFileList();
            },

            renderFileList: function () {
                const $container = this.elements.fileListContainer;
                $container.empty();
                this.selectedFiles.forEach((file, index) => {
                    const html = `<div class="file-item"><div class="file-info"><i class="fa-regular fa-file"></i><span class="file-name-text" title="${file.name}">${file.name}</span><span style="font-size:0.8em; color:#999;">(${(file.size / 1024).toFixed(0)} KB)</span></div><button type="button" class="btn-remove-file" data-index="${index}" title="Hapus File"><i class="fa-solid fa-xmark"></i></button></div>`;
                    $container.append(html);
                });
            },

            loadLeaveTypes: function () {
                var self = this;
                return $.ajax({ url: '/api/CutiApi/listTipeCuti', type: 'GET', data: { company_id: '13559' } })
                    .done(function (res) { if (res && res.data) self.allLeaveTypes = res.data; });
            },

            loadData: function (id) {
                var self = this;
                $.ajax({
                    url: `/api/CutiApi/detailCuti/${id}`,
                    type: 'GET'
                })
                    .done(function (res) {
                        if (res && res.data && res.data.length > 0) {
                            self.populateForm(res.data[0]);
                        } else {
                            Swal.fire('Error', 'Data tidak ditemukan.', 'error');
                        }
                    })
                    .fail(() => {
                        Swal.fire('Error', 'Gagal memuat data pengajuan.', 'error');
                    })
                    .always(() => {
                        setTimeout(function () {
                            $("#pageLoader").fadeOut();
                        }, 500);
                    });
            },


            populateForm: function (data) {
                var self = this;
                this.elements.cutiIdInput.val(data.request_no);

                const lt = this.allLeaveTypes.find(t => t.leave_code === data.leave_code);
                this.elements.tipeCutiDisplay.val(lt ? lt.leavename_id : data.leave_code);
                $("#leave_code_hidden").val(data.leave_code);

                if (data.leave_code === 'CB' || data.leave_code === 'Cuti Besar') {
                    self.currentDayType = 'Hari Kalender';
                    self.updateWeekendStatus(false);
                } else if (data.leave_code === 'CP' || data.leave_code === 'Cuti Pribadi') {
                    self.currentDayType = 'Hari Kerja';
                    self.updateWeekendStatus(true);
                }

                if (data.leave_code.startsWith('CP') || data.leave_code === 'CB') {
                    this.elements.sisaCutiSection.show();
                } else {
                    this.elements.cutiKhususSection.show();
                    this.elements.subTipeCuti.empty().append('<option value="">-- Pilih --</option>');
                    const ck = this.allLeaveTypes.filter(t => t.leave_code !== 'CP' && t.leave_code !== 'CB');
                    ck.forEach(i => {
                        this.elements.subTipeCuti.append(`<option value="${i.leave_code}">${i.leavename_id}</option>`);
                    });
                    this.elements.subTipeCuti.val(data.leave_code);
                    self.handleSubTipeChange();
                }

                const fmtDate = (d) => d ? d.split('T')[0] : '';
                this.fpMulai.setDate(fmtDate(data.startdate));
                this.fpSelesai.setDate(fmtDate(data.enddate));

                this.elements.keterangan.val(data.remark);

                if (data.refdoc) {
                    this.elements.existingFileContainer.show();
                    var files = data.refdoc.split('|');
                    var html = '';
                    files.forEach(fileName => {
                        html += `<div class="existing-file-item"><div style="display:flex; align-items:center; gap:8px;"><i class="fa-solid fa-paperclip" style="color:#0369A1;"></i><span style="font-size:0.85rem; color:#333;">${fileName}</span></div><button type="button" class="btn-browse-simple btn-view-existing" data-file="${fileName}" style="padding:2px 8px; font-size:0.8rem;"><i class="fas fa-eye"></i> Lihat</button></div>`;
                    });
                    this.elements.existingFileList.html(html);
                }

                this.hitungDurasi();
            },

            handleStartDateChange: function() {
                const startVal = this.elements.tanggalMulai.val();
                if (startVal) {
                    this.elements.tanggalSelesai.attr('min', startVal);
                    const endVal = this.elements.tanggalSelesai.val();
                    if (endVal && endVal < startVal) {
                        this.elements.tanggalSelesai.val('');
                        this.elements.durasiInput.val('');
                    }
                }
                this.hitungDurasi();
            },

            hitungDurasi: function () {
                var self = this;
                const tglAwal = this.elements.tanggalMulai.val();
                const tglAkhir = this.elements.tanggalSelesai.val();

                let rawCode = $("#leave_code_hidden").val() || self.elements.tipeCutiDisplay.val();
                let leaveCode = "";

                if (rawCode) {
                    leaveCode = rawCode.split('-')[0].trim();
                }

                if (self.elements.cutiKhususSection.is(':visible')) {
                    leaveCode = self.elements.subTipeCuti.val();
                }

                if (tglAwal && tglAkhir && leaveCode) {
                    if (new Date(tglAkhir) < new Date(tglAwal)) {
                        console.warn("Tanggal akhir lebih kecil dari awal");
                        this.elements.durasiInput.val('');
                        this.elements.durasiDisplay.val('-');
                        return;
                    }

                    self.elements.durasiDisplay.val("...");

                    $.ajax({
                        url: '/api/CutiApi/calculateDuration',
                        type: 'GET',
                        data: { start: tglAwal, end: tglAkhir, code: leaveCode },
                        success: function (res) {
                            console.log("Respon API Hitung:", res);

                            if (res && res.meta && res.meta.code === 200) {
                                const days = res.data.total_days;
                                self.elements.durasiInput.val(days);
                                self.elements.durasiDisplay.val(days);
                                if (self.elements.cutiKhususSection.is(':visible')) {
                                    $.ajax({
                                        url: '/api/CutiApi/get_rule_cuti',
                                        type: 'GET',
                                        data: { leave_code: leaveCode },
                                        success: function (ruleRes) {
                                            if (ruleRes.meta && ruleRes.meta.code === 200 && ruleRes.data) {
                                                const maxJatah = ruleRes.data.jatah_cuti;
                                                if (days > maxJatah) {
                                                    Swal.fire({ icon: 'warning', title: 'Melebihi Batas', text: `Jenis cuti ini maksimal ${maxJatah} hari. Anda mengajukan ${days} hari.`, confirmButtonColor: '#F59E0B' });
                                                    self.elements.durasiInput.val('');
                                                    self.elements.durasiDisplay.val('-');
                                                    self.elements.tanggalSelesai.val('');
                                                }
                                            }
                                        }
                                    });
                                } else {
                                    // Validasi Cuti Pribadi (Sisa)
                                    // Logic validasi sisa cuti saat edit sedikit kompleks karena melibatkan pengembalian kuota lama.
                                    // Untuk saat ini biarkan backend yang handle final validation, atau tampilkan warning lunak.
                                    /*
                                    if (days > self.config.sisaCuti) {
                                         Swal.fire(...)
                                    }
                                    */
                                }

                            } else {
                                console.error("API Gagal/Meta bukan 200:", res);
                                self.elements.durasiDisplay.val("-");
                            }
                        },
                        error: function (xhr, status, error) {
                            console.error("AJAX Error:", error);
                            self.elements.durasiDisplay.val("Error");
                        }
                    });
                } else {
                    console.log("Data belum lengkap, tidak hitung.");
                    this.elements.durasiInput.val('');
                    this.elements.durasiDisplay.val('-');
                }
            },

            handleSubmitForm: function (isDraft) {
                var self = this;
                self.resetAllErrors();
                var isValid = true;

                if (!self.elements.tanggalMulai.val()) { self.setFieldError('TanggalMulai', 'Wajib'); isValid = false; }
                if (!self.elements.tanggalSelesai.val()) { self.setFieldError('TanggalSelesai', 'Wajib'); isValid = false; }
                if (!self.elements.keterangan.val()) { self.setFieldError('Keterangan', 'Wajib'); isValid = false; }

                var durVal = parseInt(self.elements.durasiInput.val());
                if (!durVal || durVal <= 0) { self.setFieldError('Durasi', 'Cek tanggal'); isValid = false; }

                let finalLeaveCode = $("#leave_code_hidden").val();
                if (self.elements.cutiKhususSection.is(':visible')) {
                    finalLeaveCode = self.elements.subTipeCuti.val();
                    if (!finalLeaveCode) { self.setFieldError('sub_tipe_cuti', 'Wajib'); isValid = false; }

                    const selectedText = self.elements.subTipeCuti.find("option:selected").text().toLowerCase();
                    if (!selectedText.includes("haid") && self.selectedFiles.length === 0 && $('#existingFileList').children().length === 0) {
                        self.setFieldError('lampiran', 'Wajib upload file'); isValid = false;
                    }
                }

                if (!isValid) return;

                Swal.fire({
                    title: isDraft ? 'Simpan Draft?' : 'Kirim Revisi?',
                    text: 'Pastikan data valid.',
                    icon: 'question', showCancelButton: true, confirmButtonText: 'Ya', confirmButtonColor: '#10B981'
                }).then((result) => {
                    if (result.isConfirmed) {
                        Swal.fire({
                            title: 'Sedang memproses...',
                            allowOutsideClick: false,
                            didOpen: () => { Swal.showLoading(); }
                        });

                        const btn = isDraft ? self.elements.btnSaveDraft : self.elements.btnSubmit;
                        btn.prop("disabled", true);

                        const fd = new FormData();
                        fd.append('request_no', self.config.cutiId);

                        var statusVal = isDraft ? 'Draft' : 'Unverified';
                        fd.append('request_status', statusVal);
                        fd.append('status', statusVal);

                        fd.append('requestedby', self.config.userNpk);
                        fd.append('requestfor', self.config.userNpk);
                        fd.append('leave_code', finalLeaveCode);
                        fd.append('startdate', self.elements.tanggalMulai.val());
                        fd.append('enddate', self.elements.tanggalSelesai.val());
                        fd.append('totaldays', durVal);
                        fd.append('remark', self.elements.keterangan.val());

                        var existingFiles = [];
                        $('#existingFileList .existing-file-item span').each(function () {
                            existingFiles.push($(this).text().trim());
                        });
                        fd.append('existing_refdoc', existingFiles.join('|'));

                        if (self.selectedFiles.length > 0) {
                            self.selectedFiles.forEach(file => fd.append('lampiranFile', file));
                        }
                        $.ajax({
                            url: '/api/CutiApi/editCuti',
                            type: 'POST',
                            data: fd,
                            processData: false,
                            contentType: false,
                            success: function (res) {
                                const reqNo = self.config.cutiId;
                                const isEntitlementType = (finalLeaveCode === 'CP' || finalLeaveCode === 'CB' || finalLeaveCode.startsWith('CP'));

                                if (!isDraft && isEntitlementType) {
                                    self.processEntitlement(finalLeaveCode, durVal, reqNo);
                                } else {
                                    Swal.fire('Sukses', isDraft ? 'Draft tersimpan.' : 'Perubahan berhasil dikirim.', 'success')
                                        .then(() => window.location.href = self.config.redirectUrl);
                                }
                            },
                            error: function (xhr) {
                                self.showError('Gagal koneksi server.');
                                btn.prop("disabled", false);
                            }
                        });
                    }
                });
            },

            processEntitlement: function (leaveCode, amount, requestNo) {
                var self = this;
                let cleanCode = leaveCode.split('-')[0].trim();
                if (cleanCode === 'Cuti Pribadi') cleanCode = 'CP';
                if (cleanCode === 'Cuti Besar') cleanCode = 'CB';

                const payload = {
                    emp_id: self.config.userNpk,
                    leave_code: cleanCode,
                    amount: amount,
                    request_no: requestNo,
                    type: "DEDUCT", 
                    user_nik: self.config.userNpk
                };

                $.ajax({
                    url: '/api/CutiApi/processTransactionCuti',
                    type: 'POST',
                    contentType: 'application/json',
                    data: JSON.stringify(payload),
                    success: function (res) {
                        Swal.fire('Sukses', 'Perubahan telah disimpan dan jatah cuti berhasil disesuaikan.', 'success')
                            .then(() => {
                                window.location.href = self.config.redirectUrl;
                            });
                    },
                    error: function (err) {
                        console.error("Gagal update saldo", err);
                        Swal.fire('Perhatian', 'Perubahan disimpan, namun sistem gagal menyesuaikan saldo secara otomatis. Mohon hubungi HC.', 'warning')
                            .then(() => {
                                window.location.href = self.config.redirectUrl;
                            });
                    }
                });
            },

            showError: function (msg) {
                this.elements.errorText.text(msg);
                this.elements.errorBox.fadeIn();
                $('html, body').animate({ scrollTop: 0 }, 'slow');
            },

            hideError: function () { this.elements.errorBox.hide(); },
            setFieldError: function (elementId, message) {
                var $input = $("#" + elementId);
                var $errSpan = $("#err_" + elementId);
                $input.addClass("input-error shake");
                $errSpan.text(message).fadeIn();
                setTimeout(() => $input.removeClass("shake"), 500);
                $input.off('input change').on('input change', function () {
                    $(this).removeClass("input-error");
                    $errSpan.fadeOut();
                });
            },
            resetAllErrors: function () {
                $(".field-error-msg").hide();
                $(".form-control").removeClass("input-error");
                this.hideError();
            },

            showCaptureButton: function () { this.elements.cameraFooter.html(`<button type="button" id="btnCapture" class="btn btn-submit" style="width:100%;margin-bottom:10px;"><i class="fa fa-camera"></i> Ambil Foto</button>`); },
            showConfirmButtons: function () { this.elements.cameraFooter.html(`<button type="button" id="btnRetake" class="btn btn-cancel" style="margin-right:10px;">Ulang</button><button type="button" id="btnUsePhoto" class="btn btn-submit">Pakai</button>`); },
            openCamera: function () {
                $("#cameraModal").css("display", "flex");
                this.initializeCamera();
            },

            closeCamera: function () {
                if (this.stream) {
                    this.stream.getTracks().forEach(track => track.stop());
                }
                $("#cameraModal").hide();
            },

            initializeCamera: async function () {
                try {
                    this.stream = await navigator.mediaDevices.getUserMedia({
                        video: { facingMode: 'environment' }
                    });
                    const video = document.getElementById('videoPreview');
                    video.srcObject = this.stream;

                    // Reset View
                    $("#videoPreview").show();
                    $("#imagePreview").hide();

                    // Reset Button ke "Ambil Foto"
                    $("#dynamicCameraBtn").html(`
            <button type="button" id="btnCapture" class="btn-cam-primary">
                <i class="fa-solid fa-camera"></i> Ambil Foto
            </button>
        `);
                } catch (err) {
                    Swal.fire("Error", "Kamera tidak dapat diakses", "error");
                    this.closeCamera();
                }
            },

            captureImage: function () {
                const video = document.getElementById('videoPreview');
                const canvas = document.getElementById('canvasCapture');
                const context = canvas.getContext('2d');

                canvas.width = video.videoWidth;
                canvas.height = video.videoHeight;
                context.drawImage(video, 0, 0, canvas.width, canvas.height);

                canvas.toBlob((blob) => {
                    this.capturedBlob = blob;
                    $("#videoPreview").hide();
                    $("#imagePreview").attr("src", URL.createObjectURL(blob)).show();

                    // Ganti tombol menjadi Ulang & Gunakan Foto
                    $("#dynamicCameraBtn").html(`
            <button type="button" id="btnRetake" class="btn-cam-secondary" style="background:#6B7280; color:white; margin-right:8px;">Ulang</button>
            <button type="button" id="btnUsePhoto" class="btn-cam-primary">Gunakan Foto</button>
        `);

                    // Stop stream kamera untuk hemat baterai
                    if (this.stream) this.stream.getTracks().forEach(t => t.stop());
                }, 'image/jpeg', 0.8);
            },



            useCapturedPhoto: function () {
                if (!this.capturedBlob) return;
                const f = new File([this.capturedBlob], "cam_" + Date.now() + ".jpg", { type: "image/jpeg" });
                this.selectedFiles.push(f);
                this.renderFileList();
                this.closeCamera();
            }
        };

        $(document).ready(function() {
            EditCutiPage.init({
                cutiId: '@ViewBag.CutiId',
                userNpk: '@(logSession.empid)',
                redirectUrl: '@Url.Action("ManageCutiKaryawan", "Manage")',
                sisaCuti: parseInt('@(ViewBag.SisaCuti ?? 0)')
            });
        });

    })(jQuery);
    </script>
</body>
</html>