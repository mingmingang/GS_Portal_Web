@model Template_DevExpress_By_MFM.Models.CutiModel
@{
    ViewBag.Title = "Edit Pengajuan Cuti";
    var logSession = HttpContext.Current.Session["SHealth"] as Template_DevExpress_By_MFM.Models.SessionLogin;
    Layout = null;
}

<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600&display=swap" rel="stylesheet">

    <style>
        :root {
            --primary-color: #1E2D56;
            --secondary-color: #2A4A7B;
            --success-color: #10B981;
            --danger-color: #EF4444;
            --warning-color: #F59E0B;
            --text-color: #333;
            --bg-color: #F3F4F6;
            --input-border: #D1D5DB;
        }

        body {
            font-family: 'Inter', sans-serif;
            margin: 0;
            padding: 0;
            color: var(--text-color);
        }

        /* --- Header --- */
        .form-header-title {
            background: linear-gradient(135deg, var(--primary-color) 0%, var(--secondary-color) 100%);
            padding: 15px 20px;
            display: flex;
            align-items: center;
            color: white;
            box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1);
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            z-index: 50;
        }

        .back-icon {
            color: white;
            font-size: 1.2rem;
            margin-right: 15px;
            text-decoration: none;
            transition: transform 0.2s;
        }

            .back-icon:hover {
                transform: translateX(-3px);
            }

        .header-title-text {
            font-size: 1.1rem;
            font-weight: 600;
        }

        /* --- Main Container --- */
        .main-container {
            margin: 80px 40px;
            background: white;
            border-radius: 12px;
        }

        /* --- Alert Box (Error) --- */
        .alert-box {
            display: none;
            background-color: #FEF2F2;
            border: 1px solid #FECACA;
            color: #991B1B;
            padding: 16px;
            border-radius: 8px;
            margin-bottom: 20px;
            display: flex;
            align-items: flex-start;
            gap: 12px;
            animation: slideIn 0.3s ease-out;
        }

            /* Tambahkan rule display:none lewat inline style atau JS saat inisialisasi */

            .alert-box i {
                font-size: 1.2rem;
                color: var(--danger-color);
                margin-top: 2px;
            }

        .alert-title {
            font-weight: 700;
            display: block;
            font-size: 0.95rem;
            margin-bottom: 2px;
        }

        .close-alert {
            background: none;
            border: none;
            font-size: 1.5rem;
            cursor: pointer;
            color: #991B1B;
            opacity: 0.6;
        }

        /* --- Form Elements --- */
        .form-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 20px;
            margin-bottom: 15px;
        }

        .form-group {
            margin-bottom: 20px;
            position: relative;
        }

            .form-group label {
                display: block;
                font-weight: 500;
                margin-bottom: 8px;
                font-size: 0.9rem;
                color: #374151;
            }

        .required-star {
            color: var(--danger-color);
            margin-left: 2px;
        }

        .form-control, .form-select {
            width: 100%;
            padding: 10px 12px;
            border: 1px solid var(--input-border);
            border-radius: 6px;
            font-size: 0.95rem;
            font-family: inherit;
            box-sizing: border-box;
            transition: border-color 0.2s;
        }

            .form-control:focus {
                outline: none;
                border-color: var(--secondary-color);
                box-shadow: 0 0 0 3px rgba(42, 74, 123, 0.1);
            }

            .form-control[readonly] {
                background-color: #F9FAFB;
                cursor: default;
                border-color: #E5E7EB;
            }

        .input-group {
            display: flex;
            align-items: stretch;
        }

            .input-group .form-control {
                border-top-right-radius: 0;
                border-bottom-right-radius: 0;
            }

        .input-group-text {
            background: #F3F4F6;
            border: 1px solid var(--input-border);
            border-left: 0;
            border-radius: 0 6px 6px 0;
            padding: 0 15px;
            display: flex;
            align-items: center;
            font-size: 0.9rem;
            color: #666;
        }

        textarea.form-control {
            resize: vertical;
            min-height: 80px;
        }

        /* --- Validation Error --- */
        .field-error-msg {
            color: var(--danger-color);
            font-size: 0.8rem;
            margin-left: 8px;
            display: none; /* Hidden by default */
        }

        .input-error {
            border-color: var(--danger-color) !important;
            background-color: #FEF2F2;
        }

        /* --- Buttons --- */
        .footer-actions {
            margin-top: 30px;
            display: flex;
            justify-content: flex-end;
            gap: 12px;
            border-top: 1px solid #EEE;
            padding-top: 20px;
        }

        .btn {
            padding: 10px 24px;
            border-radius: 6px;
            font-weight: 500;
            font-size: 0.95rem;
            cursor: pointer;
            border: none;
            transition: all 0.2s;
            display: inline-flex;
            align-items: center;
            gap: 8px;
        }

        .btn-cancel {
            background-color: #E5E7EB;
            color: #374151;
        }

            .btn-cancel:hover {
                background-color: #D1D5DB;
            }

        .btn-submit {
            background-color: var(--success-color);
            color: white;
        }

            .btn-submit:hover {
                background-color: #059669;
                box-shadow: 0 2px 5px rgba(16, 185, 129, 0.3);
            }

        /* --- Lampiran & Camera --- */
        .lampiran-wrapper {
            display: flex;
            gap: 10px;
            margin-top: 5px;
        }

        .btn-browse-simple {
            background: white;
            border: 1px solid var(--input-border);
            padding: 8px 12px;
            border-radius: 6px;
            font-size: 0.85rem;
            cursor: pointer;
            display: flex;
            align-items: center;
            gap: 6px;
            color: #555;
        }

            .btn-browse-simple:hover {
                background-color: #F9FAFB;
                border-color: #999;
            }

        .file-display-box {
            margin-top: 8px;
            padding: 8px;
            border: 1px dashed #DDD;
            border-radius: 4px;
            background: #FAFAFA;
            font-size: 0.85rem;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        /* --- Modal Camera --- */
        .camera-modal {
            display: none;
            position: fixed;
            z-index: 1000;
            left: 0;
            top: 0;
            width: 100%;
            height: 100%;
            background-color: rgba(0,0,0,0.8);
            backdrop-filter: blur(5px);
        }

        .camera-content {
            background-color: #fff;
            margin: 2% auto;
            padding: 20px;
            border-radius: 12px;
            width: 90%;
            max-width: 500px;
            position: relative;
            box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.25);
        }

        .close-cam {
            position: absolute;
            right: 15px;
            top: 10px;
            font-size: 28px;
            cursor: pointer;
            color: #666;
            background: none;
            border: none;
        }

        @@media (max-width: 600px) {
            .form-grid {
                grid-template-columns: 1fr;
                gap: 0;
            }

            .main-container {
                margin-top: 70px;
                padding: 20px;
                width: 90%;
            }
        }

        @@keyframes slideIn {
            from {
                opacity: 0;
                transform: translateY(-10px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        .shake {
            animation: shake 0.5s;
        }

        @@keyframes shake {
            0%, 100% {
                transform: translateX(0);
            }

            25% {
                transform: translateX(-5px);
            }

            75% {
                transform: translateX(5px);
            }
        }
    </style>
</head>
<body>

    <header class="form-header-title">
        <a href="@Url.Action("ManageCutiKaryawan", "Manage")" class="back-icon"><i class="fa-solid fa-arrow-left"></i></a>
        <span class="header-title-text" id="pageTitle">Edit Pengajuan Cuti</span>
    </header>

    <div class="main-container">
        <!-- Error Alert -->
        <div id="errorAlertBox" class="alert-box" style="display:none;">
            <i class="fa-solid fa-triangle-exclamation"></i>
            <div>
                <span class="alert-title">Mohon Periksa Kembali</span>
                <span id="errorMessageText">Terjadi kesalahan pada input data.</span>
            </div>
            <button type="button" class="close-alert" onclick="$('#errorAlertBox').fadeOut()">&times;</button>
        </div>

        <form id="cutiForm" novalidate>
            @Html.AntiForgeryToken()

            <!-- Readonly Section -->
            <div class="form-grid">
                <div class="form-group">
                    <label>No. Pengajuan</label>
                    <input type="text" id="cuti_id" class="form-control" readonly placeholder="Memuat..." />
                </div>
                <div class="form-group">
                    <label>NPK Karyawan</label>
                    <input type="text" id="npk_karyawan" class="form-control" value="@(logSession.npk)" readonly />
                </div>
            </div>

            <div class="form-group">
                <label>Nama Karyawan</label>
                <input type="text" id="permohonan_untuk" class="form-control" value="@(logSession.fullname)" readonly />
            </div>

            <div class="form-grid">
                <div class="form-group">
                    <label>Tipe Cuti</label>
                    <input type="text" id="tipe_cuti_display" class="form-control" readonly />
                    <!-- Hidden fields to store original data -->
                    <input type="hidden" id="leave_code_hidden" />
                </div>

                <!-- Sisa Cuti (Visible only for CP/CB) -->
                <div class="form-group" id="sisaCutiSection" style="display: none;">
                    <label>Sisa Kuota</label>
                    <div class="input-group">
                        <input type="text" id="sisa_cuti" class="form-control" value="@ViewBag.SisaCuti" readonly />
                        <span class="input-group-text">Hari</span>
                    </div>
                </div>
            </div>

            <!-- Date Section -->
            <div class="form-grid">
                <div class="form-group">
                    <label>Mulai Dari <span class="required-star">*</span> <span id="err_TanggalMulai" class="field-error-msg">Wajib diisi</span></label>
                    <input type="date" id="TanggalMulai" class="form-control" />
                </div>

                <div class="form-group">
                    <label>Sampai Dengan <span class="required-star">*</span> <span id="err_TanggalSelesai" class="field-error-msg">Wajib diisi</span></label>
                    <input type="date" id="TanggalSelesai" class="form-control" />
                </div>
            </div>

            <div class="form-group">
                <label>Durasi <span id="err_Durasi" class="field-error-msg">Tidak valid</span></label>
                <div class="input-group">
                    <input type="text" id="Durasi" class="form-control" readonly style="font-weight:600;" />
                    <span class="input-group-text">Hari</span>
                </div>
            </div>

            <div class="form-group">
                <label>Keterangan</label>
                <textarea id="Keterangan" class="form-control" placeholder="Tuliskan keterangan revisi/pengajuan..." rows="3"></textarea>
            </div>

            <!-- Lampiran Section -->
            <div class="form-group" id="lampiranSection">
                <label>Lampiran (Dokumen Pendukung)</label>

                <!-- Info File Lama -->
                <div id="existingFileBox" class="file-display-box" style="display:none; margin-bottom:10px;">
                    <div>
                        <i class="fa-solid fa-paperclip" style="color:#555;"></i>
                        <span style="font-weight:600; font-size:0.9rem;">File Saat Ini:</span>
                        <a href="#" id="linkFileLama" target="_blank" style="color:var(--secondary-color);">Lihat File</a>
                    </div>
                </div>

                <div class="lampiran-wrapper">
                    <button type="button" id="btnBrowseFile" class="btn-browse-simple"><i class="fa-regular fa-file"></i> Ganti File</button>
                    <button type="button" id="btnOpenCamera" class="btn-browse-simple"><i class="fa-solid fa-camera"></i> Kamera</button>
                </div>
                <div style="font-size:0.8rem; color:#888; margin-top:4px;">*Biarkan kosong jika tidak ingin mengubah file. Max 2MB.</div>

                <!-- Preview Nama File Baru -->
                <div id="newFileDisplay" class="file-display-box" style="display:none; background:#F0FDF4; border-color:#86EFAC;">
                    <span><i class="fa-solid fa-file-circle-check" style="color:#10B981;"></i> <span id="fileNameText"></span></span>
                    <button type="button" id="btnCancelFile" style="background:none; border:none; color:#EF4444; cursor:pointer;" title="Batal Ganti"><i class="fa-solid fa-times"></i></button>
                </div>

                <input type="file" id="lampiranFile" name="lampiranFile" style="display: none;">
            </div>

            <div class="footer-actions">
                <button type="button" id="btnSaveDraft" class="btn btn-cancel">Simpan Draft</button>
                <button type="button" id="btnSubmit" class="btn btn-submit">Kirim Ulang</button>
            </div>
        </form>
    </div>

    <!-- Camera Modal -->
    <div id="cameraModal" class="camera-modal">
        <div class="camera-content">
            <button type="button" id="closeCamera" class="close-cam">&times;</button>
            <h3>Ambil Foto</h3>
            <div style="display:flex; flex-direction:column; align-items:center;">
                <video id="videoPreview" autoplay playsinline style="width:100%; max-height:400px; background:#000; border-radius:4px;"></video>
                <img id="imagePreview" style="display:none; width:100%; max-height:400px; border-radius:4px;">
                <canvas id="canvasCapture" style="display:none;"></canvas>
                <div id="cameraFooter" style="margin-top:15px; width:100%;"></div>
            </div>
        </div>
    </div>

    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <script>
        (function ($) {
            'use strict';

            var EditCutiPage = {
                config: {
                    cutiId: null, userNpk: '', redirectUrl: '', sisaCuti: 0
                },
                elements: {}, allLeaveTypes: [], originalLeaveCode: null, originalDuration: 0,
                stream: null, capturedBlob: null,

                init: function (config) {
                    this.config = $.extend(this.config, config);
                    this.cacheElements();
                    this.setInitialMinDate(); // 1. Set Tanggal Mulai minimal hari ini
                    this.bindEvents();
                    this.loadLeaveTypes().then(() => {
                        this.loadData(this.config.cutiId);
                    });
                },

                cacheElements: function () {
                    this.elements = {
                        cutiIdInput: $("#cuti_id"),
                        tipeCutiDisplay: $("#tipe_cuti_display"),
                        sisaCutiSection: $("#sisaCutiSection"),
                        tanggalMulai: $("#TanggalMulai"),
                        tanggalSelesai: $("#TanggalSelesai"),
                        durasiInput: $("#Durasi"),
                        keterangan: $("#Keterangan"),
                        lampiranFile: $("#lampiranFile"),
                        errorBox: $("#errorAlertBox"),
                        errorText: $("#errorMessageText"),
                        btnSubmit: $("#btnSubmit"),
                        btnSaveDraft: $("#btnSaveDraft"),
                        cameraModal: $("#cameraModal"),
                        videoPreview: $("#videoPreview"),
                        imagePreview: $("#imagePreview"),
                        canvasCapture: $("#canvasCapture")[0],
                        cameraFooter: $("#cameraFooter")
                    };
                },

                // --- 1. LOGIC TANGGAL (BARU) ---
                setInitialMinDate: function() {
                    // Ambil tanggal hari ini format YYYY-MM-DD
                    const today = new Date().toISOString().split('T')[0];

                    // Set minimal tanggal mulai = hari ini
                    this.elements.tanggalMulai.attr('min', today);

                    // Default tanggal selesai juga minimal hari ini
                    this.elements.tanggalSelesai.attr('min', today);
                },

                handleStartDateChange: function() {
                    const startVal = this.elements.tanggalMulai.val();

                    if (startVal) {
                        // 2. Set minimal tanggal selesai = tanggal mulai yang dipilih
                        this.elements.tanggalSelesai.attr('min', startVal);

                        // Jika tanggal selesai yang sekarang lebih kecil dari tanggal mulai baru, hapus
                        const endVal = this.elements.tanggalSelesai.val();
                        if (endVal && endVal < startVal) {
                            this.elements.tanggalSelesai.val('');
                            this.elements.durasiInput.val('');
                        }
                    }
                    // Panggil hitung durasi
                    this.hitungDurasi();
                },
                // -------------------------------

                // --- Helper UI ---
                showError: function (msg) {
                    this.elements.errorText.text(msg);
                    this.elements.errorBox.fadeIn();
                    $('html, body').animate({ scrollTop: 0 }, 'slow');
                },
                hideError: function () { this.elements.errorBox.hide(); },
                setFieldError: function (elementId, message) {
                    var $input = $("#" + elementId);
                    var $errSpan = $("#err_" + elementId);
                    $input.addClass("input-error shake");
                    $errSpan.text(message).fadeIn();
                    setTimeout(() => $input.removeClass("shake"), 500);
                    $input.off('input change').on('input change', function () {
                        $(this).removeClass("input-error");
                        $errSpan.fadeOut();
                    });
                },
                resetAllErrors: function () {
                    $(".field-error-msg").hide();
                    $(".form-control").removeClass("input-error");
                    this.hideError();
                },

                bindEvents: function () {
                    var self = this;

                    // Ubah event listener tanggal mulai ke fungsi baru handleStartDateChange
                    this.elements.tanggalMulai.on('change', this.handleStartDateChange.bind(this));

                    this.elements.tanggalSelesai.on('change', this.hitungDurasi.bind(this));

                    // File Handling
                    $("#btnBrowseFile").on("click", function() { self.elements.lampiranFile.click(); });
                    this.elements.lampiranFile.on("change", this.handleFileChange.bind(this));
                    $("#btnCancelFile").on("click", this.resetFile.bind(this));

                    // Buttons
                    this.elements.btnSubmit.on("click", function () { self.handleSubmitForm(false); });
                    this.elements.btnSaveDraft.on("click", function () { self.handleSubmitForm(true); });

                    // Camera
                    $("#btnOpenCamera").on("click", this.openCamera.bind(this));
                    $("#closeCamera").on("click", this.closeCamera.bind(this));
                    $(document).on("click", "#btnCapture", this.captureImage.bind(this));
                    $(document).on("click", "#btnRetake", this.initializeCamera.bind(this));
                    $(document).on("click", "#btnUsePhoto", this.useCapturedPhoto.bind(this));
                },

                // --- Data Loading ---
                loadLeaveTypes: function () {
                    var self = this;
                    return $.ajax({ url: '/api/CutiApi/listTipeCuti', type: 'GET', data: { company_id: '13559' } })
                        .done(function (res) { if (res && res.data) self.allLeaveTypes = res.data; });
                },

                loadData: function (id) {
                    var self = this;
                    this.elements.cutiIdInput.val("Memuat...");

                    $.ajax({
                        url: `/api/CutiApi/detailCuti/${id}`, type: 'GET'
                    }).done(function (res) {
                        if (res && res.data && res.data.length > 0) {
                            self.populateForm(res.data[0]);
                        } else {
                            Swal.fire('Error', 'Data cuti tidak ditemukan.', 'error');
                        }
                    }).fail(() => Swal.fire('Error', 'Gagal memuat data.', 'error'));
                },

                populateForm: function (data) {
                    this.originalLeaveCode = data.leave_code;
                    this.originalDuration = parseInt(data.totaldays) || 0;
                    this.elements.cutiIdInput.val(data.request_no);

                    // Tipe Cuti
                    const lt = this.allLeaveTypes.find(t => t.leave_code === data.leave_code);
                    this.elements.tipeCutiDisplay.val(lt ? lt.leavename_id : data.leave_code);
                    $("#leave_code_hidden").val(data.leave_code);

                    // Show Sisa Cuti if CP/CB
                    if (data.leave_code.startsWith('CP') || data.leave_code === 'CB' || data.leave_code === 'Cuti Besar') {
                        this.elements.sisaCutiSection.show();
                    }

                    // Dates & Remark
                    const fmtDate = (d) => d ? d.split('T')[0] : '';
                    const startDateVal = fmtDate(data.startdate);
                    const endDateVal = fmtDate(data.enddate);

                    this.elements.tanggalMulai.val(startDateVal);
                    this.elements.tanggalSelesai.val(endDateVal);

                    // Saat load data, pastikan min date tanggal selesai disesuaikan dengan tanggal mulai yg ada
                    if (startDateVal) {
                        this.elements.tanggalSelesai.attr('min', startDateVal);
                    }

                    this.elements.durasiInput.val(data.totaldays);
                    this.elements.keterangan.val(data.remark);

                    // --- PERBAIKAN LOGIC MULTIPLE FILES ---
                    if (data.refdoc) {
                        $("#existingFileBox").show();

                        // 1. Pecah string berdasarkan karakter pemisah '|'
                        // Jika cuma 1 file, split tetap menghasilkan array length 1.
                        var files = data.refdoc.split('|');

                        var fileHtml = '<div style="font-weight:600; font-size:0.9rem; margin-bottom:5px; color:#333;">File Saat Ini:</div>';

                        // 2. Loop array files untuk membuat link download masing-masing
                        files.forEach(function (fileName, index) {
                            // Pastikan path ini sesuai folder upload di server Anda (misal: /Uploads/Cuti/)
                            var fileUrl = "/Uploads/Cuti/" + fileName;

                            fileHtml += `
                <div style="margin-bottom: 6px; display: flex; align-items: center; gap: 6px; font-size: 0.85rem;">
                    <i class="fa-solid fa-paperclip" style="color:#666;"></i>
                    <a href="${fileUrl}" target="_blank" style="color:#2A4A7B; text-decoration:none; font-weight:500;">
                        Lampiran ${index + 1}
                    </a>
                    <span style="color:#999; font-size:0.8em;">(${fileName})</span>
                </div>`;
                        });

                        // 3. Masukkan HTML list file ke dalam box
                        $("#existingFileBox").html(fileHtml);

                    } else {
                        $("#existingFileBox").hide();
                    }
                },

                hitungDurasi: function () {
                    const s = this.elements.tanggalMulai.val();
                    const e = this.elements.tanggalSelesai.val();
                    if (s && e) {
                        const start = new Date(s); const end = new Date(e);
                        // Validasi backdate manual (backup logic)
                        if (end < start) {
                            this.elements.durasiInput.val('');
                            // Reset tanggal selesai jika tidak valid
                            this.elements.tanggalSelesai.val('');
                            return;
                        }
                        const diffDays = Math.ceil(Math.abs(end - start) / (1000 * 60 * 60 * 24)) + 1;

                        // Validasi Sisa Cuti (Khusus Edit: Sisa Dashboard + Durasi Lama)
                        if (this.elements.sisaCutiSection.is(':visible')) {
                            const maxAllowed = this.config.sisaCuti + this.originalDuration;
                            if (diffDays > maxAllowed) {
                                Swal.fire({
                                    icon: 'warning', title: 'Kuota Tidak Cukup',
                                    text: `Sisa Dashboard: ${this.config.sisaCuti} + Pengajuan Ini: ${this.originalDuration}. Total Max: ${maxAllowed}. Anda minta: ${diffDays}.`
                                });
                                this.elements.durasiInput.val('');
                                this.elements.tanggalSelesai.val('');
                                return;
                            }
                        }
                        this.elements.durasiInput.val(diffDays);
                    }
                },

                // --- File Logic ---
                handleFileChange: function (e) {
                    const file = e.target.files[0];
                    if (file) {
                        if (file.size > 2 * 1024 * 1024) {
                            Swal.fire('Error', 'File max 2MB', 'error');
                            this.resetFile();
                            return;
                        }
                        $("#fileNameText").text(file.name);
                        $("#newFileDisplay").show();
                        $("#existingFileBox").hide();
                    }
                },
                resetFile: function() {
                    this.elements.lampiranFile.val('');
                    $("#newFileDisplay").hide();
                    $("#existingFileBox").show();
                },

                // --- Submit Logic ---
                handleSubmitForm: function (isDraft) {
                    var self = this;
                    self.resetAllErrors();
                    var isValid = true;

                    if (!self.elements.tanggalMulai.val()) { self.setFieldError('TanggalMulai', 'Wajib'); isValid = false; }
                    if (!self.elements.tanggalSelesai.val()) { self.setFieldError('TanggalSelesai', 'Wajib'); isValid = false; }

                    var durVal = parseInt(self.elements.durasiInput.val());
                    if (!durVal || durVal <= 0) { self.setFieldError('Durasi', 'Cek tanggal'); isValid = false; }

                    if (!isValid) return;

                    Swal.fire({
                        title: isDraft ? 'Simpan Draft?' : 'Kirim Revisi?',
                        text: 'Pastikan data valid.',
                        icon: 'question', showCancelButton: true, confirmButtonText: 'Ya', confirmButtonColor: '#10B981'
                    }).then((result) => {
                        if (result.isConfirmed) {
                            const btn = isDraft ? self.elements.btnSaveDraft : self.elements.btnSubmit;
                            const txt = btn.text();
                            btn.prop("disabled", true).text("Memproses...");

                            const fd = new FormData();
                            fd.append('request_no', self.config.cutiId);
                            fd.append('request_status', isDraft ? 'Draft' : 'Unverified');
                            fd.append('requestedby', self.config.userNpk);
                            fd.append('requestfor', self.config.userNpk);
                            fd.append('leave_code', self.originalLeaveCode);
                            fd.append('startdate', self.elements.tanggalMulai.val());
                            fd.append('enddate', self.elements.tanggalSelesai.val());
                            fd.append('totaldays', durVal);
                            fd.append('remark', self.elements.keterangan.val());

                            const fileInput = self.elements.lampiranFile[0];
                            if (fileInput.files.length > 0) {
                                fd.append('lampiranFile', fileInput.files[0]);
                            }

                            $.ajax({
                                url: '/api/CutiApi/editCuti', type: 'POST', data: fd, processData: false, contentType: false,
                                success: function (res) {
                                    if (res && res.meta && res.meta[0].code !== 200) {
                                        self.showError(res.meta[0].message || 'Gagal update.');
                                    } else {
                                        Swal.fire('Sukses', 'Data berhasil diperbarui!', 'success')
                                            .then(() => window.location.href = self.config.redirectUrl);
                                    }
                                },
                                error: () => self.showError('Gagal koneksi server.'),
                                complete: () => btn.prop("disabled", false).text(txt)
                            });
                        }
                    });
                },

                // --- Camera Helpers ---
                showCaptureButton: function () { this.elements.cameraFooter.html(`<button type="button" id="btnCapture" class="btn btn-submit" style="width:100%;margin-bottom:10px;"><i class="fa fa-camera"></i> Jepret</button>`); },
                showConfirmButtons: function () { this.elements.cameraFooter.html(`<button type="button" id="btnRetake" class="btn btn-cancel" style="margin-right:10px;">Ulang</button><button type="button" id="btnUsePhoto" class="btn btn-submit">Pakai</button>`); },
                initializeCamera: async function () { try { if (this.stream) this.stream.getTracks().forEach(t => t.stop()); this.stream = await navigator.mediaDevices.getUserMedia({ video: { facingMode: 'environment' } }); this.elements.videoPreview[0].srcObject = this.stream; this.elements.imagePreview.hide(); this.elements.videoPreview.show(); this.showCaptureButton(); } catch { this.elements.cameraModal.fadeOut(); Swal.fire('Error', 'Kamera Error', 'error'); } },
                openCamera: function () { this.elements.cameraModal.fadeIn(); this.initializeCamera(); },
                closeCamera: function () { if (this.stream) this.stream.getTracks().forEach(t => t.stop()); this.elements.cameraModal.fadeOut(); },
                captureImage: function () { const ctx = this.elements.canvasCapture.getContext('2d'); const vid = this.elements.videoPreview[0]; this.elements.canvasCapture.width = vid.videoWidth; this.elements.canvasCapture.height = vid.videoHeight; ctx.drawImage(vid, 0, 0); if(this.stream) this.stream.getTracks().forEach(t => t.stop()); var self = this; this.elements.canvasCapture.toBlob(b => { self.capturedBlob = b; self.elements.videoPreview.hide(); self.elements.imagePreview.attr('src', URL.createObjectURL(b)).show(); self.showConfirmButtons(); }, 'image/jpeg', 0.8); },
                useCapturedPhoto: function () { if (!this.capturedBlob) return; const f = new File([this.capturedBlob], "cam.jpg", { type: "image/jpeg" }); const dt = new DataTransfer(); dt.items.add(f); this.elements.lampiranFile[0].files = dt.files; this.elements.lampiranFile.trigger('change'); this.closeCamera(); }
            };

            $(document).ready(function() {
                EditCutiPage.init({
                    cutiId: '@ViewBag.CutiId',
                    userNpk: '@(logSession.empid)',
                    redirectUrl: '@Url.Action("ManageCutiKaryawan", "Manage")',
                    sisaCuti: parseInt('@(ViewBag.SisaCuti ?? 0)')
                });
            });

        })(jQuery);
    </script>
</body>
</html>