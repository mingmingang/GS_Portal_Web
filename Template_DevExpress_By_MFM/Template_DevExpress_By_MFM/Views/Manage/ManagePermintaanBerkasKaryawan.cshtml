                    </div>
                </li>
                <li class="icon-ditolak">
                    <span class="icon icon-ditolak"><i class="fas fa-times-circle"></i></span>
                    <div>
                        <strong>Ditolak</strong><br>
                        Keterangan: Permintaan ID Card yang diajukan ditolak oleh HC.
                    </div>
                </li>
            </ul>
        </div>
        <div class="modal-footer">
            <button class="modal-button" onclick="closePanduanPopupPic()">Mengerti</button>
        </div>
    </div>
</div>

