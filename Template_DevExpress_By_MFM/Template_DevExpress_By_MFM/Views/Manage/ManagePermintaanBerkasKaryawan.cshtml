</div>

<!-- GANTI HTML Filter Popup SKP dengan ini -->
<div id="filterPopupPsk" style="display: none;">
    <div style="padding: 20px;">
        <!-- Date Range -->
        <div class="dx-field">
            <div class="dx-field-label">Rentang Tanggal</div>
            <div class="dx-field-value" style="display: flex; gap: 10px;">
                <div style="flex: 1;">
                    <div id="startDatePsk"></div>
                </div>
                <div style="flex: 1;">
                    <div id="endDatePsk"></div>
                </div>
            </div>
        </div>

        <!-- Status Filter -->
        <div class="dx-field" style="margin-top: 15px;">
            <div class="dx-field-label">Status</div>
            <div class="dx-field-value">
                <div id="statusListPsk"></div>
            </div>
        </div>

        <!-- Alasan Permintaan Filter (SKP) - Text Input -->
        <div class="dx-field" style="margin-top: 15px;">
            <div class="dx-field-label">Alasan Permintaan</div>
            <div class="dx-field-value">
                <div id="alasanInputPsk"></div>
            </div>
        </div>

        <!-- Action Buttons -->
        <div style="display: flex; justify-content: space-between; margin-top: 20px; gap: 10px;">
            <div id="resetButtonPsk"></div>
            <div id="applyButtonPsk"></div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
// COMPLETE FIXED JAVASCRIPT - ManagePermintaanKaryawan.cshtml

// Global Variables
const CURRENT_NPK = '@Html.Raw(npk)';
const CURRENT_PLANT = '@Html.Raw(plant)';
const statusDataSource = ['Selesai', 'Belum Diverifikasi', 'Ditolak'];
const alasanPicDataSource = ['Hilang', 'Rusak', 'Mutasi'];
let currentTab = 'pic';

// State untuk filter PIC
let filterStatePic = {
    startDate: null,
    endDate: null,
    statuses: [...statusDataSource],
    alasanHilang: [...alasanPicDataSource]
};

// State untuk filter SKP
let filterStateSkp = {
    startDate: null,
    endDate: null,
    statuses: [...statusDataSource],
    alasanPermintaan: null
};

// DevExtreme component instances
let filterPopupPicInstance, filterPopupPskInstance;

// Flag untuk mencegah duplicate loading
let isLoadingPic = false;
let isLoadingSkp = false;

// Initialize page
document.addEventListener('DOMContentLoaded', function() {
    if (!document.querySelector('link[href*="fontawesome"]')) {
        const link = document.createElement('link');
        link.rel = 'stylesheet';
        link.href = 'https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css';
        document.head.appendChild(link);
    }
    updateTabUnderline();
});

// Tab switching
function switchTab(tab) {
    if (currentTab === tab) return;
    currentTab = tab;

    document.querySelectorAll('.tab-button').forEach(btn => btn.classList.remove('active'));
    document.querySelector(`.tab-button[data-tab="${tab}"]`).classList.add('active');

    document.getElementById('picContent').classList.toggle('active', tab === 'pic');
    document.getElementById('skpContent').classList.toggle('active', tab === 'skp');

    const fabButton = document.getElementById('fabButton');
    fabButton.href = tab === 'pic'
        ? '@Url.Action("ManageAddPermintaanBerkasPICKaryawan", "Manage")'
        : '@Url.Action("ManageAddPermintaanBerkasPSKKaryawan", "Manage")';

    updateTabUnderline();
}

function updateTabUnderline() {
    const underline = document.getElementById('tabUnderline');
    const activeButton = document.querySelector('.tab-button.active');
    if (!activeButton) return;

    const rect = activeButton.getBoundingClientRect();
    const containerRect = document.querySelector('.tab-buttons').getBoundingClientRect();
    const position = rect.left - containerRect.left;
    const width = rect.width;

    underline.style.transform = `translateX(${position}px)`;
    underline.style.width = `${width}px`;
}

// Main data loading function
function loadCards(type) {
    if ((type === 'pic' && isLoadingPic) || (type === 'skp' && isLoadingSkp)) {
        console.log(`${type.toUpperCase()} already loading, skipping...`);
        return;
    }

    if (!CURRENT_NPK || !CURRENT_PLANT) {
        console.error("NPK atau Plant tidak tersedia");
        const noDataId = type === 'pic' ? '#picNoData' : '#pskNoData';
        $(noDataId).show().find('.empty-text').text("Data sesi tidak lengkap.");
        return;
    }

    if (type === 'pic') isLoadingPic = true;
    else isLoadingSkp = true;

    const baseUrl = type === 'pic'
        ? `/api/PermintaanApi/pic/${CURRENT_NPK}/${CURRENT_PLANT}`
        : `/api/PermintaanApi/skp/${CURRENT_NPK}/${CURRENT_PLANT}`;

    const containerId = type === 'pic' ? '#picCardList' : '#pskCardList';
    const loadingId = type === 'pic' ? '#picLoading' : '#pskLoading';
    const noDataId = type === 'pic' ? '#picNoData' : '#pskNoData';
    const dateRangeId = type === 'pic' ? '#dateRangeTextPic' : '#dateRangeTextPsk';

    $(containerId).empty();
    $(loadingId).show();
    $(noDataId).hide();

    const params = new URLSearchParams();
    const filterState = type === 'pic' ? filterStatePic : filterStateSkp;

    if (filterState.startDate) {
        params.append('startDate', filterState.startDate.toISOString().split('T')[0]);
    }
    if (filterState.endDate) {
        params.append('endDate', filterState.endDate.toISOString().split('T')[0]);
    }

    if (filterState.statuses.length > 0 && filterState.statuses.length < statusDataSource.length) {
        filterState.statuses.forEach(status => {
            let apiStatus = status;
            if (status === 'Selesai') apiStatus = 'Disetujui';
            else if (status === 'Belum Diverifikasi') apiStatus = 'Belum diverifikasi HC';
            params.append('status', apiStatus);
        });
    }

    if (type === 'pic') {
        if (filterState.alasanHilang.length > 0 && filterState.alasanHilang.length < alasanPicDataSource.length) {
            filterState.alasanHilang.forEach(ah => params.append('ah', ah));
        }
    } else {
        if (filterState.alasanPermintaan && filterState.alasanPermintaan.trim() !== '') {
            params.append('ap', filterState.alasanPermintaan.trim());
        }
    }

    const fullUrl = params.toString() ? `${baseUrl}?${params.toString()}` : baseUrl;
    console.log(`Loading ${type.toUpperCase()} from:`, fullUrl);

    $.ajax({
        url: fullUrl,
        method: "GET",
        dataType: "json",
        timeout: 30000
    })
    .done(response => {
        console.log(`${type.toUpperCase()} Response:`, response);
        $(loadingId).hide();

        if (!response || response.code !== 200 || !response.data || !Array.isArray(response.data) || response.data.length === 0) {
            $(noDataId).show();
            $(dateRangeId).text('Tidak ada data');
            return;
        }

        const apiData = response.data[0];
        if (!apiData || !apiData.data) {
            $(noDataId).show();
            $(dateRangeId).text('Tidak ada data');
            return;
        }

        const items = apiData.data;
        const summary = apiData.summary || {};
        console.log(`${type.toUpperCase()} Items:`, items.length);

        if (items.length === 0) {
            $(noDataId).show();
            $(dateRangeId).text('Tidak ada data');
            return;
        }

        $(containerId).empty();
        items.forEach((item, index) => renderCard(item, containerId, type, index));
        updateDashboardCounts(type, summary);
        updateDateRangeText(items, dateRangeId);
    })
    .fail(xhr => {
        console.error(`Error loading ${type}:`, xhr);
        $(loadingId).hide();
        $(noDataId).show();
        const errorMsg = xhr.status === 404 ? 'Data tidak ditemukan' :
                        xhr.status === 500 ? 'Server error' : 'Gagal memuat data';
        $(noDataId).find('.empty-text').text(errorMsg);
    })
    .always(() => {
        if (type === 'pic') isLoadingPic = false;
        else isLoadingSkp = false;
    });
}

function renderCard(item, containerId, type, index) {
    let statusClass = '';
    let displayStatus = '';
    const status = item.pic_status || item.skp_status;

    if (status === 'Disetujui') {
        statusClass = 'status-selesai';
        displayStatus = 'Selesai';
    } else if (status === 'Belum diverifikasi HC') {
        statusClass = 'status-belum-diverifikasi';
        displayStatus = 'Belum Diverifikasi';
    } else if (status === 'Ditolak') {
        statusClass = 'status-ditolak';
        displayStatus = 'Ditolak';
    }

    const dateField = item.pic_crea_date || item.skp_crea_date;
    const date = new Date(dateField);
    const formattedDate = date.toLocaleDateString('id-ID', {
        day: '2-digit',
        month: 'long',
        year: 'numeric'
    });

    const alasan = item.pic_ah || item.skp_ap || '—';
    const detailUrl = type === 'pic'
        ? `/Manage/DetailPermintaanPic?id=${item.pic_id}`
        : `/Manage/DetailPermintaanPsk?id=${item.skp_id}`;

    const cardHtml = `
        <div class="mobile-card" style="animation-delay: ${index * 0.1}s">
            <div class="mobile-card-header">
                <div>
                    <div class="npk-text">NPK: ${item.kry_npk}</div>
                    <div class="mobile-card-title">${item.kry_nama_karyawan}</div>
                </div>
                <span class="mobile-card-status ${statusClass}">${displayStatus}</span>
            </div>
            <div class="mobile-card-body">
                Alasan: ${alasan}
            </div>
            <div class="mobile-card-footer">
                <div class="date-section">
                    <i class="far fa-clock"></i>
                    ${formattedDate}
                </div>
                <a href="${detailUrl}" class="action-link">Lihat →</a>
            </div>
        </div>
    `;

    $(containerId).append(cardHtml);
}

function updateDashboardCounts(type, summary) {
    if (type === 'pic') {
        $('#idCardApprovedCount').text(summary.Selesai || 0);
        $('#idCardRejectedCount').text(summary.Ditolak || 0);
    } else {
        $('#suratApprovedCount').text(summary.Selesai || 0);
        $('#suratRejectedCount').text(summary.Ditolak || 0);
    }
}

function updateDateRangeText(items, dateRangeId) {
    if (items.length === 0) {
        $(dateRangeId).text('Tidak ada data');
        return;
    }

    const dates = items
        .map(item => new Date(item.pic_crea_date || item.skp_crea_date))
        .filter(date => !isNaN(date.getTime()));

    if (dates.length === 0) {
        $(dateRangeId).text('Tidak ada tanggal valid');
        return;
    }

    const minDate = new Date(Math.min(...dates));
    const maxDate = new Date(Math.max(...dates));

    const formatDate = (date) => {
        return date.toLocaleDateString('id-ID', {
            day: '2-digit',
            month: 'long',
            year: 'numeric'
        });
    };

    $(dateRangeId).text(minDate.getTime() === maxDate.getTime()
        ? formatDate(minDate)
        : `${formatDate(minDate)} - ${formatDate(maxDate)}`);
}

// Show/hide popups
function showFilterPopupPic() {
    if (filterPopupPicInstance) filterPopupPicInstance.show();
}

function showFilterPopupPsk() {
    if (filterPopupPskInstance) filterPopupPskInstance.show();
}

function showPanduanPopupPic() {
    document.getElementById('panduanPopupPic').classList.add('visible');
}

function showPanduanPopupPsk() {
    document.getElementById('panduanPopupPsk').classList.add('visible');
}

function closePanduanPopupPic() {
    document.getElementById('panduanPopupPic').classList.remove('visible');
}

function closePanduanPopupPsk() {
    document.getElementById('panduanPopupPsk').classList.remove('visible');
}

// DevExtreme initialization
$(document).ready(function () {
    if (typeof DevExpress === 'undefined') {
        console.error('DevExpress not loaded!');
        return;
    }

    initializeDevExtremeComponents();
    initializePage();
});

function initializeDevExtremeComponents() {
    // ===== FILTER PIC =====
    filterPopupPicInstance = $("#filterPopupPic").dxPopup({
        title: "Filter Pengajuan ID Card",
        width: 400,
        maxHeight: "90vh",
        showTitle: true,
        dragEnabled: false,
        closeOnOutsideClick: true,
        shading: true,
        showCloseButton: true,
        contentTemplate: function(contentElement) {
            const container = $('<div>').css('padding', '20px');

            // Date Range
            const dateRangeDiv = $('<div>').addClass('dx-field');
            dateRangeDiv.append($('<div>').addClass('dx-field-label').text('Rentang Tanggal'));
            const dateValueDiv = $('<div>').addClass('dx-field-value').css({
                'display': 'flex',
                'gap': '10px'
            });

            const startDateDiv = $('<div>').css('flex', '1');
            const startDateBox = $('<div>').appendTo(startDateDiv);
            startDateBox.dxDateBox({
                placeholder: "Dari Tanggal",
                displayFormat: "dd MMM yyyy",
                type: "date",
                showClearButton: true,
                value: filterStatePic.startDate,
                onValueChanged: function(e) {
                    filterStatePic.startDate = e.value;
                }
            });

            const endDateDiv = $('<div>').css('flex', '1');
            const endDateBox = $('<div>').appendTo(endDateDiv);
            endDateBox.dxDateBox({
                placeholder: "Sampai Tanggal",
                displayFormat: "dd MMM yyyy",
                type: "date",
                showClearButton: true,
                value: filterStatePic.endDate,
                onValueChanged: function(e) {
                    filterStatePic.endDate = e.value;
                }
            });

            dateValueDiv.append(startDateDiv, endDateDiv);
            dateRangeDiv.append(dateValueDiv);

            // Status List
            const statusDiv = $('<div>').addClass('dx-field').css('margin-top', '15px');
            statusDiv.append($('<div>').addClass('dx-field-label').text('Status'));
            const statusValueDiv = $('<div>').addClass('dx-field-value');
            const statusList = $('<div>').appendTo(statusValueDiv);
            statusList.dxList({
                dataSource: statusDataSource,
                showSelectionControls: true,
                selectionMode: "all",
                selectAllText: "Semua Status",
                height: 150,
                selectedItems: filterStatePic.statuses,
                onSelectionChanged: function(e) {
                    filterStatePic.statuses = e.component.option("selectedItems");
                }
            });
            statusDiv.append(statusValueDiv);

            // Alasan List
            const alasanDiv = $('<div>').addClass('dx-field').css('margin-top', '15px');
            alasanDiv.append($('<div>').addClass('dx-field-label').text('Alasan'));
            const alasanValueDiv = $('<div>').addClass('dx-field-value');
            const alasanList = $('<div>').appendTo(alasanValueDiv);
            alasanList.dxList({
                dataSource: alasanPicDataSource,
                showSelectionControls: true,
                selectionMode: "all",
                selectAllText: "Semua Alasan",
                height: 130,
                selectedItems: filterStatePic.alasanHilang,
                onSelectionChanged: function(e) {
                    filterStatePic.alasanHilang = e.component.option("selectedItems");
                }
            });
            alasanDiv.append(alasanValueDiv);

            // Buttons
            const buttonsDiv = $('<div>').css({
                'display': 'flex',
                'justify-content': 'space-between',
                'margin-top': '20px',
                'gap': '10px'
            });

            const resetBtn = $('<div>').appendTo(buttonsDiv);
            resetBtn.dxButton({
                text: "Reset",
                type: "normal",
                stylingMode: "outlined",
                width: "48%",
                onClick: function() {
                    filterStatePic = {
                        startDate: null,
                        endDate: null,
                        statuses: [...statusDataSource],
                        alasanHilang: [...alasanPicDataSource]
                    };
                    loadCards('pic');
                    filterPopupPicInstance.hide();
                }
            });

            const applyBtn = $('<div>').appendTo(buttonsDiv);
            applyBtn.dxButton({
                text: "Terapkan",
                type: "default",
                stylingMode: "contained",
                width: "48%",
                onClick: function() {
                    loadCards('pic');
                    filterPopupPicInstance.hide();
                }
            });

            container.append(dateRangeDiv, statusDiv, alasanDiv, buttonsDiv);
            contentElement.append(container);
        }
    }).dxPopup("instance");

    // ===== FILTER SKP =====
    filterPopupPskInstance = $("#filterPopupPsk").dxPopup({
        title: "Filter Pengajuan Surat Keterangan",
        width: 400,
        maxHeight: "90vh",
        showTitle: true,
        dragEnabled: false,
        closeOnOutsideClick: true,
        shading: true,
        showCloseButton: true,
        contentTemplate: function(contentElement) {
            const container = $('<div>').css('padding', '20px');

            // Date Range
            const dateRangeDiv = $('<div>').addClass('dx-field');
            dateRangeDiv.append($('<div>').addClass('dx-field-label').text('Rentang Tanggal'));
            const dateValueDiv = $('<div>').addClass('dx-field-value').css({
                'display': 'flex',
                'gap': '10px'
            });

            const startDateDiv = $('<div>').css('flex', '1');
            const startDateBox = $('<div>').appendTo(startDateDiv);
            startDateBox.dxDateBox({
                placeholder: "Dari Tanggal",
                displayFormat: "dd MMM yyyy",
                type: "date",
                showClearButton: true,
                value: filterStateSkp.startDate,
                onValueChanged: function(e) {
                    filterStateSkp.startDate = e.value;
                }
            });

            const endDateDiv = $('<div>').css('flex', '1');
            const endDateBox = $('<div>').appendTo(endDateDiv);
            endDateBox.dxDateBox({
                placeholder: "Sampai Tanggal",
                displayFormat: "dd MMM yyyy",
                type: "date",
                showClearButton: true,
                value: filterStateSkp.endDate,
                onValueChanged: function(e) {
                    filterStateSkp.endDate = e.value;
                }
            });

            dateValueDiv.append(startDateDiv, endDateDiv);
            dateRangeDiv.append(dateValueDiv);

            // Status List
            const statusDiv = $('<div>').addClass('dx-field').css('margin-top', '15px');
            statusDiv.append($('<div>').addClass('dx-field-label').text('Status'));
            const statusValueDiv = $('<div>').addClass('dx-field-value');
            const statusList = $('<div>').appendTo(statusValueDiv);
            statusList.dxList({
                dataSource: statusDataSource,
                showSelectionControls: true,
                selectionMode: "all",
                selectAllText: "Semua Status",
                height: 150,
                selectedItems: filterStateSkp.statuses,
                onSelectionChanged: function(e) {
                    filterStateSkp.statuses = e.component.option("selectedItems");
                }
            });
            statusDiv.append(statusValueDiv);

            // Alasan Input (Text)
            const alasanDiv = $('<div>').addClass('dx-field').css('margin-top', '15px');
            alasanDiv.append($('<div>').addClass('dx-field-label').text('Alasan Permintaan'));
            const alasanValueDiv = $('<div>').addClass('dx-field-value');
            const alasanInput = $('<div>').appendTo(alasanValueDiv);
            alasanInput.dxTextBox({
                placeholder: "Cari alasan permintaan...",
                showClearButton: true,
                value: filterStateSkp.alasanPermintaan,
                onValueChanged: function(e) {
                    filterStateSkp.alasanPermintaan = e.value;
                }
            });
            alasanDiv.append(alasanValueDiv);

            // Buttons
            const buttonsDiv = $('<div>').css({
                'display': 'flex',
                'justify-content': 'space-between',
                'margin-top': '20px',
                'gap': '10px'
            });

            const resetBtn = $('<div>').appendTo(buttonsDiv);
            resetBtn.dxButton({
                text: "Reset",
                type: "normal",
                stylingMode: "outlined",
                width: "48%",
                onClick: function() {
                    filterStateSkp = {
                        startDate: null,
                        endDate: null,
                        statuses: [...statusDataSource],
                        alasanPermintaan: null
                    };
                    loadCards('skp');
                    filterPopupPskInstance.hide();
                }
            });

            const applyBtn = $('<div>').appendTo(buttonsDiv);
            applyBtn.dxButton({
                text: "Terapkan",
                type: "default",
                stylingMode: "contained",
                width: "48%",
                onClick: function() {
                    loadCards('skp');
                    filterPopupPskInstance.hide();
                }
            });

            container.append(dateRangeDiv, statusDiv, alasanDiv, buttonsDiv);
            contentElement.append(container);
        }
    }).dxPopup("instance");
}

function initializePage() {
    updateTabUnderline();
    setTimeout(() => {
        loadCards('pic');
        loadCards('skp');
    }, 500);
}    </script>
}