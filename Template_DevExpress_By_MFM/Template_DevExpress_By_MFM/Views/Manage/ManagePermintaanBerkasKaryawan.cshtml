@section Scripts {
    <script>
        // Global Variables
        const CURRENT_NPK = '@Html.Raw(npk)';
        const CURRENT_PLANT = '@Html.Raw(plant)';
        const statusDataSource = ['Selesai', 'Belum Diverifikasi', 'Ditolak'];
        let currentTab = 'pic';

        // State untuk filter
        let currentYearPic = new Date().getFullYear();
        let selectedStatusesPic = [...statusDataSource];
        let currentYearPsk = new Date().getFullYear();
        let selectedStatusesPsk = [...statusDataSource];

        // DevExtreme component instances
        let filterPopupPicInstance, panduanPopupPicInstance, yearSelectPicInstance, statusListPicInstance;
        let filterPopupPskInstance, panduanPopupPskInstance, yearSelectPskInstance, statusListPskInstance;

        // Utility function to generate year data source
        function getYearDataSource() {
            const currentYear = new Date().getFullYear();
            const years = [];
            for (let i = currentYear; i >= currentYear - 10; i--) {
                years.push(i);
            }
            return years;
        }

        // Initialize popup instances
        function filterPopupPic_onInit(e) { filterPopupPicInstance = e.component; }
        function panduanPopupPic_onInit(e) { panduanPopupPicInstance = e.component; }
        function filterPopupPsk_onInit(e) { filterPopupPskInstance = e.component; }
        function panduanPopupPsk_onInit(e) { panduanPopupPskInstance = e.component; }

        // Initialize page
        document.addEventListener('DOMContentLoaded', function() {
            // Load Font Awesome if not already loaded
            if (!document.querySelector('link[href*="fontawesome"]')) {
                const link = document.createElement('link');
                link.rel = 'stylesheet';
                link.href = 'https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css';
                document.head.appendChild(link);
            }

            // Set initial tab underline position
            updateTabUnderline();

            // Load initial data
            setTimeout(() => {
                loadCards('pic');
                loadCards('skp');
            }, 100);
        });

        // Tab switching functionality
// Ganti fungsi switchTab dengan yang baru
function switchTab(tab) {
    if (currentTab === tab) return;

    currentTab = tab;

    // Update active tab buttons
    document.querySelectorAll('.tab-button').forEach(btn => {
        btn.classList.remove('active');
    });
    document.querySelector(`.tab-button[data-tab="${tab}"]`).classList.add('active');

    // Show/hide content
    document.getElementById('picContent').classList.toggle('active', tab === 'pic');
    document.getElementById('skpContent').classList.toggle('active', tab === 'skp');

    // Update FAB button href
    const fabButton = document.getElementById('fabButton');
    const fabHref = tab === 'pic'
        ? '@Url.Action("ManageAddPermintaanBerkasPICKaryawan", "Manage")'
        : '@Url.Action("ManageAddPermintaanBerkasPSKKaryawan", "Manage")';
    fabButton.href = fabHref;

    // Animate underline
    updateTabUnderline();
}

function updateTabUnderline() {
    const underline = document.getElementById('tabUnderline');
    const tabButtons = document.querySelectorAll('.tab-button');
    const activeButton = document.querySelector('.tab-button.active');

    if (!activeButton) return;

    // Hitung posisi dan lebar tombol aktif
    const rect = activeButton.getBoundingClientRect();
    const containerRect = document.querySelector('.tab-buttons').getBoundingClientRect();

    // Hitung transform X berdasarkan posisi tombol aktif
    const position = rect.left - containerRect.left;
    const width = rect.width;

    // Set posisi dan lebar garis bawah
    underline.style.transform = `translateX(${position}px)`;
    underline.style.width = `${width}px`;
}

        // Main data loading function
        function loadCards(type) {
            // Validation
            if (!CURRENT_NPK || !CURRENT_PLANT) {
                console.error("NPK atau Plant tidak tersedia di session");
                const noDataId = type === 'pic' ? '#picNoData' : '#pskNoData';
                $(noDataId).show().find('.empty-text').text("Data sesi tidak lengkap. Silakan login ulang.");
                return;
            }

            const baseUrl = type === 'pic'
                ? `/api/PermintaanApi/pic/${CURRENT_NPK}/${CURRENT_PLANT}`
                : `/api/PermintaanApi/skp/${CURRENT_NPK}/${CURRENT_PLANT}`;

            const containerId = type === 'pic' ? '#picCardList' : '#pskCardList';
            const loadingId = type === 'pic' ? '#picLoading' : '#pskLoading';
            const noDataId = type === 'pic' ? '#picNoData' : '#pskNoData';
            const dateRangeId = type === 'pic' ? '#dateRangeTextPic' : '#dateRangeTextPsk';

            // Show loading state
            $(containerId).empty();
            $(loadingId).show();
            $(noDataId).hide();

            // Build filter parameters
            const params = new URLSearchParams();

            // Status filter
            const statusesToUse = type === 'pic' ? selectedStatusesPic : selectedStatusesPsk;
            if (statusesToUse && statusesToUse.length > 0 && statusesToUse.length < statusDataSource.length) {
                statusesToUse.forEach(status => {
                    let apiStatus = status;
                    if (status === 'Selesai') apiStatus = 'Disetujui';
                    else if (status === 'Belum Diverifikasi') apiStatus = 'Belum diverifikasi HC';
                    params.append('status', apiStatus);
                });
            }

            // Year filter
            const yearToUse = type === 'pic' ? currentYearPic : currentYearPsk;
            if (yearToUse) {
                params.append('startDate', `${yearToUse}-01-01`);
                params.append('endDate', `${yearToUse}-12-31`);
            }

            const fullUrl = params.toString() ? `${baseUrl}?${params.toString()}` : baseUrl;

            // Make API request
            $.ajax({
                url: fullUrl,
                method: "GET",
                dataType: "json",
                timeout: 30000
            })
            .done(response => {
                $(loadingId).hide();

                if (response.code !== 200 || !response.data || response.data.length === 0) {
                    $(noDataId).show();
                    $(dateRangeId).text('Tidak ada data');
                    return;
                }

                const apiData = response.data[0];
                const items = apiData.data || [];
                const summary = apiData.summary || {};

                if (items.length === 0) {
                    $(noDataId).show();
                    $(dateRangeId).text('Tidak ada data');
                    return;
                }

                // Render cards with animation
                items.forEach((item, index) => {
                    setTimeout(() => {
                        renderCard(item, containerId, type, index);
                    }, index * 100); // Staggered animation
                });

                // Update dashboard counts
                updateDashboardCounts(type, summary);

                // Update date range display
                updateDateRangeText(items, dateRangeId);
            })
            .fail(xhr => {
                $(loadingId).hide();
                $(noDataId).show();
                console.error("Error loading data:", xhr);

                // Show user-friendly error message
                const errorMsg = xhr.status === 404 ? 'Data tidak ditemukan' :
                                xhr.status === 500 ? 'Server error' : 'Gagal memuat data';
                $(noDataId).find('.empty-text').text(errorMsg);
            });
        }

        // Render individual card
        function renderCard(item, containerId, type, index) {
            let statusClass = '';
            let displayStatus = '';
            const status = item.pic_status || item.skp_status;

            if (status === 'Disetujui') {
                statusClass = 'status-selesai';
                displayStatus = 'Selesai';
            } else if (status === 'Belum diverifikasi HC') {
                statusClass = 'status-belum-diverifikasi';
                displayStatus = 'Belum Diverifikasi';
            } else if (status === 'Ditolak') {
                statusClass = 'status-ditolak';
                displayStatus = 'Ditolak';
            }

            const dateField = item.pic_crea_date || item.skp_crea_date;
            const date = new Date(dateField);
            const formattedDate = date.toLocaleDateString('id-ID', {
                day: '2-digit',
                month: 'long',
                year: 'numeric'
            });

            const alasan = item.pic_ah || item.skp_ap || '—';
            const detailUrl = type === 'pic'
                ? `/Manage/DetailPermintaanPic?id=${item.pic_id}`
                : `/Manage/DetailPermintaanPsk?id=${item.skp_id}`;

            const cardHtml = `
                <div class="mobile-card" style="animation-delay: ${index * 0.1}s">
                    <div class="mobile-card-header">
                        <div>
                            <div class="npk-text">NPK: ${item.kry_npk}</div>
                            <div class="mobile-card-title">${item.kry_nama_karyawan}</div>
                        </div>
                        <span class="mobile-card-status ${statusClass}">${displayStatus}</span>
                    </div>
                    <div class="mobile-card-body">
                        Alasan: ${alasan}
                    </div>
                    <div class="mobile-card-footer">
                        <div class="date-section">
                            <i class="far fa-clock"></i>
                            ${formattedDate}
                        </div>
                        <a href="${detailUrl}" class="action-link">Lihat →</a>
                    </div>
                </div>
            `;

            $(containerId).append(cardHtml);
        }

        // Update dashboard counts
        function updateDashboardCounts(type, summary) {
            if (type === 'pic') {
                $('#idCardApprovedCount').text(summary.Selesai || 0);
                $('#idCardRejectedCount').text(summary.Ditolak || 0);
            } else {
                $('#suratApprovedCount').text(summary.Selesai || 0);
                $('#suratRejectedCount').text(summary.Ditolak || 0);
            }
        }

        // Update date range text
        function updateDateRangeText(items, dateRangeId) {
            if (items.length === 0) {
                $(dateRangeId).text('Tidak ada data');
                return;
            }

            const dates = items
                .map(item => new Date(item.pic_crea_date || item.skp_crea_date))
                .filter(date => !isNaN(date.getTime()));

            if (dates.length === 0) {
                $(dateRangeId).text('Tidak ada tanggal valid');
                return;
            }

            const minDate = new Date(Math.min(...dates));
            const maxDate = new Date(Math.max(...dates));

            const formatDate = (date) => {
                return date.toLocaleDateString('id-ID', {
                    day: '2-digit',
                    month: 'long',
                    year: 'numeric'
                });
            };

            if (minDate.getTime() === maxDate.getTime()) {
                $(dateRangeId).text(formatDate(minDate));
            } else {
                $(dateRangeId).text(`${formatDate(minDate)} - ${formatDate(maxDate)}`);
            }
        }

        // Filter functionality
        function applyFilters(type) {
            const yearSelect = type === 'pic' ? yearSelectPicInstance : yearSelectPskInstance;
            const statusList = type === 'pic' ? statusListPicInstance : statusListPskInstance;
            const filterPopup = type === 'pic' ? filterPopupPicInstance : filterPopupPskInstance;

            if (!yearSelect || !statusList) return;

            // Update filter state
            if (type === 'pic') {
                currentYearPic = yearSelect.option("value");
                selectedStatusesPic = statusList.option("selectedItems");
            } else {
                currentYearPsk = yearSelect.option("value");
                selectedStatusesPsk = statusList.option("selectedItems");
            }

            // Reload data with new filters
            loadCards(type);

            // Hide popup
            if (filterPopup) filterPopup.hide();
        }

        function applyFiltersPic() { applyFilters('pic'); }
        function applyFiltersPsk() { applyFilters('skp'); }

        // Show popup functions
        function showFilterPopupPic() {
            if (filterPopupPicInstance) filterPopupPicInstance.show();
        }
        function showFilterPopupPsk() {
            if (filterPopupPskInstance) filterPopupPskInstance.show();
        }
        function showPanduanPopupPic() {
            document.getElementById('panduanPopupPic').classList.add('visible');
        }
        function showPanduanPopupPsk() {
            document.getElementById('panduanPopupPsk').classList.add('visible');
        }

        // Close popup functions
        function closePanduanPopupPic() {
            document.getElementById('panduanPopupPic').classList.remove('visible');
        }
        function closePanduanPopupPsk() {
            document.getElementById('panduanPopupPsk').classList.remove('visible');
        }

        // Filter popup showing events
        function filterPopupPic_onShowing() {
            if (yearSelectPicInstance) yearSelectPicInstance.option("value", currentYearPic);
            if (statusListPicInstance) statusListPicInstance.option("selectedItems", selectedStatusesPic);
        }
        function filterPopupPsk_onShowing() {
            if (yearSelectPskInstance) yearSelectPskInstance.option("value", currentYearPsk);
            if (statusListPskInstance) statusListPskInstance.option("selectedItems", selectedStatusesPsk);
        }
    </script>
}