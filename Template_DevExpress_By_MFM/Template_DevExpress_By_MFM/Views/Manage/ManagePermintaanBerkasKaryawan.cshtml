@(Html.DevExtreme().Popup().ID("filterPopupPsk").Title("Filter Pengajuan Surat Keterangan").Width(350).Height("auto").ShowTitle(true).DragEnabled(false).HideOnOutsideClick(true).Shading(true)
    .OnInitialized("filterPopupPsk_onInit")
    .OnShowing("filterPopupPsk_onShowing")
    .ContentTemplate(@<div style="padding: 20px;">
        <div class="dx-field">
            <div class="dx-field-label">Tahun</div>
