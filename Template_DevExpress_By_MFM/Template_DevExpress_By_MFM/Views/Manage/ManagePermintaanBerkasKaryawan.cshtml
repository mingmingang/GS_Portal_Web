@(Html.DevExtreme().Popup().ID("filterPopupPic").Title("Filter Pengajuan ID Card").Width(350).Height("auto").ShowTitle(true).DragEnabled(false).HideOnOutsideClick(true).Shading(true)
    .OnInitialized("filterPopupPic_onInit")
    .OnShowing("filterPopupPic_onShowing")
    .ContentTemplate(@<div style="padding: 20px;">
        <div class="dx-field">
