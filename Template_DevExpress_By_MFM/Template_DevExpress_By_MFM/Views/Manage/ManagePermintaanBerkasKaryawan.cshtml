@{
    ViewBag.Title = "Permintaan Berkas Karyawan";
    var sessionLogin = Session["SHealth"] as Template_DevExpress_By_MFM.Models.SessionLogin;

    if (sessionLogin == null)
    {
        Response.Redirect("~/Login/Index");
        return;
    }

    var npk = sessionLogin.npk ?? "000299";
    var plant = sessionLogin.plant ?? "K";
}

