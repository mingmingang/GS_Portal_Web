        <!-- Status Filter -->
        <div class="dx-field" style="margin-top: 15px;">
            <div class="dx-field-label">Status</div>
            <div class="dx-field-value">
                <div id="statusListPic"></div>
            </div>
        </div>

        <!-- Alasan Hilang Filter (PIC) -->
        <div class="dx-field" style="margin-top: 15px;">
            <div class="dx-field-label">Alasan</div>
            <div class="dx-field-value">
                <div id="alasanListPic"></div>
            </div>
        </div>

        <!-- Action Buttons -->
        <div style="display: flex; justify-content: space-between; margin-top: 20px; gap: 10px;">
            <div id="resetButtonPic"></div>
            <div id="applyButtonPic"></div>
        </div>
