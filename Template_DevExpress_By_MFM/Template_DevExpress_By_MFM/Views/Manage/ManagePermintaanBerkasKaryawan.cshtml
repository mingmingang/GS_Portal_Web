<!-- GANTI HTML Filter Popup PIC dengan ini -->
<div id="filterPopupPic" style="display: none;">
    <div style="padding: 20px;">
        <!-- Date Range -->
        <div class="dx-field">
            <div class="dx-field-label">Rentang Tanggal</div>
            <div class="dx-field-value" style="display: flex; gap: 10px;">
                <div style="flex: 1;">
                    <div id="startDatePic"></div>
                </div>
                <div style="flex: 1;">
                    <div id="endDatePic"></div>
                </div>
            </div>
