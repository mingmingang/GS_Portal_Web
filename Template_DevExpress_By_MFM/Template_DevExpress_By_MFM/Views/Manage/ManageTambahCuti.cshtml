@model Template_DevExpress_By_MFM.Models.CutiModel
@{
    ViewBag.Title = "Tambah Pengajuan Cuti";
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700&display=swap" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css">
    <script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>

    <style>
        :root {
            --primary-blue: #1E2D56;
            --light-blue: #e8f0fe;
            --input-border: #d1d5db;
            --text-dark: #333;
            --text-gray: #6b7280;
            --success-green: #10B981;
        }

        body {
            background-color: #f3f4f6;
            font-family: 'Inter', sans-serif;
            margin: 0;
            padding: 0;
            color: var(--text-dark);
        }

        .form-header-title {
            background: linear-gradient(135deg, #1E2D56 0%, #2A4A7B 100%);
            display: flex;
            justify-content: center;
            align-items: center;
            padding: 15px;
            border-bottom: 1px solid #eee;
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            z-index: 1000;
            box-sizing: border-box;
            color: white;
        }

        .back-icon {
            color: white;
            font-size: 1.5rem;
            margin-right: 15px;
            cursor: pointer;
            text-decoration: none;
        }

        .header-title-text {
            font-size: 1.1rem;
            font-weight: 600;
            margin: 0 auto 0 0;
            flex-grow: 1;
            text-align: center;
        }

        /* CONTAINER */
        .main-container {
            margin-top: 50px;
            padding: 25px;
            background-color: white;
            min-height: calc(100vh - 70px);
            max-width: 100%; /* Batasi lebar agar enak dilihat di layar besar */
            margin-left: auto;
            margin-right: auto;
        }

        /* GRID SYSTEM - INTELIJEN LAYOUT */
        .form-grid {
            display: grid;
            grid-template-columns: repeat(3, 1fr); /* Default 3 Kolom Rata */
            gap: 20px;
            margin-bottom: 20px;
            align-items: start; /* Supaya alignment vertical bagus */
        }

        /* Group form items */
        .form-group {
            display: flex;
            flex-direction: column;
            margin-bottom: 0; /* Margin dihandle oleh Grid Gap */
            margin-top: 10px;
        }

            .form-group label {
                font-weight: 600;
                font-size: 0.85rem;
                color: #1f2937;
                margin-bottom: 6px;
            }

        .required-star {
            color: red;
            margin-left: 2px;
        }

        /* Styles Input */
        .form-control, .form-select {
            padding: 10px 12px;
            border: 1px solid var(--input-border);
            border-radius: 6px;
            font-size: 0.95rem;
            width: 100%;
            box-sizing: border-box;
            height: 45px; /* Tinggi seragam agar layout rata */
            background-color: #fff;
        }

            .form-control:focus, .form-select:focus {
                outline: none;
                border-color: var(--primary-blue);
                box-shadow: 0 0 0 3px rgba(30, 45, 86, 0.1);
            }

            .form-control[readonly] {
                background-color: #f9fafb;
                color: #6b7280;
            }

        /* Suffix (Hari) di dalam Input */
        .input-group {
            position: relative;
            display: flex;
            align-items: center;
        }

        .input-group-text {
            position: absolute;
            right: 12px;
            color: #6b7280;
            font-size: 0.85rem;
            font-weight: 500;
        }

        textarea.form-control {
            height: auto;
            min-height: 80px;
            resize: vertical;
        }

        /* LAMPIRAN & BUTTONS */
        .lampiran-wrapper {
            display: flex;
            gap: 10px;
            margin-top: 5px;
        }

        .btn-browse-simple {
            height: 45px;
            background-color: #fff;
            border: 1px solid #d1d5db;
            border-radius: 6px;
            padding: 0 16px;
            font-weight: 500;
            cursor: pointer;
            color: #374151;
            display: inline-flex;
            align-items: center;
            gap: 8px;
            font-size: 0.9rem;
            transition: all 0.2s;
        }

            .btn-browse-simple:hover {
                background-color: #f3f4f6;
                border-color: #9ca3af;
            }

        .file-name-box {
            margin-top: 5px;
            font-size: 0.9rem;
            color: var(--primary-blue);
            font-weight: 500;
        }

        /* Note & Footer */
        .note-box {
            background-color: var(--light-blue);
            color: #1e40af;
            border-radius: 6px;
            padding: 15px;
            margin-top: 30px;
            font-size: 0.9rem;
            display: flex;
            align-items: flex-start;
            gap: 10px;
        }

        .footer-actions {
            display: flex;
            justify-content: flex-end;
            gap: 15px;
            margin-top: 30px;
        }

        .btn {
            padding: 12px 30px;
            border-radius: 8px;
            font-weight: 600;
            cursor: pointer;
            border: none;
            font-size: 1rem;
        }

        .btn-cancel {
            background-color: #e5e7eb;
            color: #374151;
        }

        .btn-submit {
            background-color: var(--success-green);
            color: white;
        }

        /* Modal Camera */
        .camera-modal {
            display: none;
            position: fixed;
            z-index: 9999;
            left: 0;
            top: 0;
            width: 100%;
            height: 100%;
            background: rgba(0,0,0,0.8);
        }

        .camera-content {
            background: #fff;
            margin: 5% auto;
            padding: 20px;
            width: 90%;
            max-width: 600px;
            border-radius: 8px;
            position: relative;
        }

        /* Overlay Modal */
        .camera-modern-modal {
            display: none;
            position: fixed;
            z-index: 9999;
            left: 0;
            top: 0;
            width: 100%;
            height: 100%;
            background-color: rgba(0, 0, 0, 0.85);
            backdrop-filter: blur(5px);
            align-items: center;
            justify-content: center;
        }

        /* Container Utama */
        .camera-modern-content {
            background-color: #2D2D2D;
            width: 90%;
            max-width: 500px;
            border-radius: 20px;
            overflow: hidden;
            padding: 15px;
            box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.3);
        }

        /* Area Frame Kamera */
        .camera-view-container {
            width: 100%;
            aspect-ratio: 4 / 3;
            background: #000;
            border-radius: 12px;
            overflow: hidden;
            margin-bottom: 15px;
            position: relative;
        }

            .camera-view-container video,
            .camera-view-container img {
                width: 100%;
                height: 100%;
                object-fit: cover; /* Agar video memenuhi frame */
            }

        /* Group Tombol */
        .camera-modern-footer {
            display: flex;
            gap: 12px;
            width: 100%;
        }

        /* Tombol Batal (Putih/Abu) */
        .btn-cam-secondary {
            flex: 1;
            background: #F3F4F6;
            color: #374151;
            border: none;
            padding: 12px;
            border-radius: 10px;
            font-weight: 600;
            font-size: 1rem;
            cursor: pointer;
            transition: background 0.2s;
        }

        /* Tombol Ambil Foto (Biru) */
        .btn-cam-primary {
            flex: 1;
            background: #2563EB;
            color: white;
            border: none;
            padding: 12px;
            border-radius: 10px;
            font-weight: 600;
            font-size: 1rem;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            transition: background 0.2s;
        }

            .btn-cam-primary:hover {
                background: #1D4ED8;
            }

        .btn-cam-secondary:hover {
            background: #E5E7EB;
        }

        .close-cam {
            position: absolute;
            right: 15px;
            top: 10px;
            font-size: 24px;
            cursor: pointer;
            background: none;
            border: none;
        }

        /* STYLE FILE LIST ITEM */
        .file-list-box {
            margin-top: 10px;
            display: flex;
            flex-direction: column;
            gap: 8px;
        }

        .file-item {
            display: flex;
            justify-content: space-between;
            align-items: center;
            background-color: #f8fafc;
            border: 1px solid #e2e8f0;
            padding: 8px 12px;
            border-radius: 6px;
            font-size: 0.9rem;
        }

        .file-info {
            display: flex;
            align-items: center;
            gap: 8px;
            color: #334155;
            font-weight: 500;
            overflow: hidden; /* Mencegah teks panjang overflow */
        }

        .file-name-text {
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
            max-width: 200px;
        }

        .btn-remove-file {
            background: none;
            border: none;
            color: #ef4444; /* Merah */
            cursor: pointer;
            font-size: 1.1rem;
            padding: 0 5px;
            transition: color 0.2s;
        }

            .btn-remove-file:hover {
                color: #b91c1c;
            }

        .alert-box {
            display: none; /* Default hidden */
            position: relative; /* Penting agar tombol close bisa diatur posisinya relatif terhadap box ini */
            background-color: #FEF2F2;
            border: 1px solid #FECACA;
            border-left: 5px solid #DC2626; /* Garis tebal merah di kiri */
            color: #991B1B;
            padding: 15px 40px 15px 20px; /* Padding-right 40px memberi ruang agar teks tidak menabrak tombol X */
            border-radius: 6px;
            margin-bottom: 20px;
            display: flex;
            align-items: flex-start; /* Icon dan teks sejajar di atas */
            gap: 12px;
            box-shadow: 0 2px 5px rgba(0,0,0,0.05);
            animation: slideIn 0.3s ease-out;
        }

            .alert-box i.fa-triangle-exclamation {
                font-size: 1.3rem;
                color: #DC2626;
                margin-top: 2px; /* Penyesuaian agar sejajar dengan judul */
            }

            .alert-box > div {
                flex: 1; /* Mengisi ruang sisa */
                font-size: 0.95rem;
            }

        .alert-title {
            font-weight: 700;
            display: block;
            margin-bottom: 4px;
            font-size: 1rem;
        }

        /* POSISI TOMBOL X */
        .close-alert {
            position: absolute; /* Kunci posisi */
            top: 10px; /* Jarak dari atas */
            right: 10px; /* Jarak dari kanan */
            background: transparent;
            border: none;
            color: #991B1B;
            font-size: 1.2rem;
            line-height: 1;
            cursor: pointer;
            opacity: 0.6;
            transition: opacity 0.2s;
            padding: 5px; /* Memperbesar area klik */
        }

            .close-alert:hover {
                opacity: 1;
                background-color: rgba(220, 38, 38, 0.1); /* Efek hover halus */
                border-radius: 4px;
            }

        @@keyframes slideIn {
            from {
                opacity: 0;
                transform: translateY(-10px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }
        }
        /* STYLE VALIDASI ERROR */
        .form-group label {
            /* Bikin label jadi flexbox agar bisa taruh error di kanan */
            display: flex;
            align-items: center;
            width: 100%;
        }

        .field-error-msg {
            color: #DC2626; /* Merah */
            font-weight: 400; /* Regular, jangan bold */
            font-size: 0.8rem;
            font-style: italic;
            margin-left: 10px;
            display: none; /* Default hidden */
            text-align: right;
        }

        .required-star {
            color: #dc3545; /* Warna Merah */
            font-weight: bold;
            margin-left: 2px; /* Jarak sedikit dari teks */
            display: inline-block; /* Agar tetap satu baris */
        }

        /* Mengatur Pesan Error */
        .field-error-msg {
            color: #dc3545;
            font-size: 0.85em;
            margin-left: 10px;
            font-weight: normal;
            display: none; /* Default hide */
        }

        .input-error {
            border-color: #dc3545 !important;
            background-color: #fff8f8;
        }

        /* Animasi getar dikit kalau error (Opsional) */
        .shake {
            animation: shake 0.3s;
        }

        @@keyframes shake {
            0% {
                transform: translateX(0);
            }

            25% {
                transform: translateX(-5px);
            }

            50% {
                transform: translateX(5px);
            }

            75% {
                transform: translateX(-5px);
            }

            100% {
                transform: translateX(0);
            }
        }

        /* RESPONSIVE: Di HP jadi 1 kolom semua */
        @@media (max-width: 768px) {
            .form-grid {
                grid-template-columns: 1fr;
                gap: 15px;
            }

            .header-title-text {
                text-align: left;
            }
        }
    </style>
</head>
<body>

    <header class="form-header-title">
        <a href="@Url.Action("ManageCutiKaryawan", "Manage")" class="back-icon"><i class="fa-solid fa-arrow-left"></i></a>
        <span class="header-title-text" id="pageTitle">Tambah Cuti</span>
    </header>

    <div class="main-container">
        <div id="errorAlertBox" class="alert-box" style="display: none;">
            <i class="fa-solid fa-triangle-exclamation"></i>
            <div>
                <span class="alert-title">Mohon Periksa Kembali</span>
                <span id="errorMessageText">Terjadi kesalahan pada input data.</span>
            </div>
            <button type="button" class="close-alert" onclick="$('#errorAlertBox').fadeOut()">&times;</button>
        </div>

        <form id="cutiForm" novalidate>
            @Html.AntiForgeryToken()

            <div class="form-grid">
                <div class="form-group">
                    <label>No. Pengajuan</label>
                    <input type="text" name="cuti_id" id="cuti_id" class="form-control" value="LVRYYYYMMDDXXXXX" readonly />
                </div>
                <div class="form-group">
                    <label>NPK</label>
                    <input type="text" id="npk_karyawan" class="form-control" value="@ViewBag.Npk" readonly />
                </div>
                <div class="form-group">
                    <label>Nama Karyawan</label>
                    <input type="text" id="permohonan_untuk" class="form-control" value="@ViewBag.Fullname" readonly />
                </div>
            </div>

            <div class="form-grid">
                <div class="form-group">
                    <label>
                        Tipe Cuti
                        <span id="err_tipe_cuti" class="field-error-msg">Wajib dipilih</span>
                    </label>
                    <select id="tipe_cuti" class="form-select" disabled>
                        <option value="">-- Pilih Jenis --</option>
                        <option value="Cuti Pribadi">Cuti Pribadi</option>
                        <option value="Cuti Besar">Cuti Besar</option>
                        <option value="Cuti Khusus">Cuti Khusus</option>
                    </select>
                    <input type="hidden" name="tipe_cuti" id="tipe_cuti_hidden" />
                </div>

                <div class="form-group" id="cutiKhususSection" style="display: none;">
                    <label>
                        Jenis Cuti Khusus<span class="required-star">*</span>
                        <span id="err_sub_tipe_cuti" class="field-error-msg">Wajib dipilih</span>
                    </label>
                    <select id="sub_tipe_cuti" name="sub_tipe_cuti" class="form-select"></select>
                    <div id="cutiInfoText" style="font-size: 0.85rem; color: #0369A1; margin-top: 5px; background: #F0F9FF; padding: 8px; border-radius: 4px; display: none;">
                        <i class="fas fa-info-circle"></i> <span id="cutiInfoContent"></span>
                    </div>
                </div>

                <div class="form-group" id="sisaCutiSection" style="display: none;">
                    <label>Sisa Kuota</label>
                    <div class="input-group">
                        <input type="text" id="sisa_cuti" class="form-control" value="@ViewBag.SisaCuti" readonly />
                        <span class="input-group-text">Hari</span>
                    </div>
                </div>
            </div>

            <div class="form-grid">
                <div class="form-group">
                    <label>
                        Tanggal Mulai<span class="required-star">*</span>
                        <span id="err_TanggalMulai" class="field-error-msg">Wajib diisi</span>
                    </label>
                    <input type="text" id="TanggalMulai" name="tanggal_awal" class="form-control" readonly placeholder="Pilih Tanggal" style="background:white;"/>
                </div>

                <div class="form-group">
                    <label>
                        Sampai Dengan<span class="required-star">*</span>
                        <span id="err_TanggalSelesai" class="field-error-msg">Wajib diisi</span>
                    </label>
                    <input type="text" id="TanggalSelesai" name="tanggal_akhir" class="form-control" readonly placeholder="Pilih Tanggal" style="background:white;"/>
                </div>

                <div class="form-group">
                    <label>
                        Durasi
                        <span id="err_Durasi" class="field-error-msg">Tidak valid</span>
                    </label>
                    <div class="input-group">
                        <input type="text" id="durasiDisplay" class="form-control" value="-" readonly style="font-weight:600;" />
                        <input type="hidden" id="Durasi" name="durasi" />
                        <span class="input-group-text">Hari</span>
                    </div>
                </div>
            </div>

            <div class="form-group">
                <label>
                    Keterangan<span class="required-star">*</span>
                    <span id="err_Keterangan" class="field-error-msg">Wajib diisi</span>
                </label>
                <textarea name="alasan" id="Keterangan" class="form-control" placeholder="Tuliskan keterangan pengajuan..." rows="3"></textarea>
            </div>

            <div class="form-group" id="lampiranSection" style="display: none;">
                <label>
                    <div>
                        Lampiran
                        <span id="labelOptional" style="display:none; color:#777; font-weight:normal; font-size:0.85em;">(Opsional)</span>
                        <span id="lampiranRequired" class="required-star" style="display:none;">*</span>
                    </div>
                    <span id="err_lampiran" class="field-error-msg">Wajib upload file</span>
                </label>

                <div class="lampiran-wrapper">
                    <button type="button" id="btnBrowseFile" class="btn-browse-simple"><i class="fa-regular fa-file"></i> Tambah File</button>
                    <button type="button" id="btnOpenCamera" class="btn-browse-simple"><i class="fa-solid fa-camera"></i> Kamera</button>
                </div>

                <div style="font-size:0.8rem; color:#888; margin-top:4px;">*Format: .jpg, .pdf, .zip (Max 2MB/file). Bisa pilih >1 file.</div>

                <div id="fileListContainer" class="file-list-box"></div>
                <input type="file" id="lampiranFile" name="lampiranFile[]" multiple style="display: none;">
            </div>

            <div class="footer-actions">
                <button type="button" id="btnSaveDraft" class="btn btn-cancel">Simpan Draft</button>
                <button type="button" id="btnSubmit" class="btn btn-submit">Kirim Pengajuan</button>
            </div>
        </form>
    </div>
    <div id="cameraModal" class="camera-modern-modal">
        <div class="camera-modern-content">
            <div class="camera-view-container">
                <video id="videoPreview" autoplay playsinline></video>
                <img id="imagePreview" style="display:none;">
                <canvas id="canvasCapture" style="display:none;"></canvas>
            </div>
            <div class="camera-modern-footer">
                <button type="button" id="closeCamera" class="btn-cam-secondary">Batal</button>
                <div id="dynamicCameraBtn" style="flex: 1; display: flex;">
                    <button type="button" id="btnCapture" class="btn-cam-primary">
                        <i class="fa-solid fa-camera"></i> Ambil Foto
                    </button>
                </div>
            </div>
        </div>
    </div>

    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script>
        (function ($) {
            'use strict';

            var TambahCutiPage = {
                config: {
                    userNpk: '', requestForName: '', redirectUrl: '', sisaCuti: 0
                },
                elements: {}, allLeaveTypes: [], stream: null, capturedBlob: null,
                selectedFiles: [],
                fpMulai: null, 
                fpSelesai: null,
                ccurrentDayType: 'Hari Kerja',
                massiveDates: [],

                init: function (config) {
                    this.config = $.extend(this.config, config);
                    this.cacheElements();
                    this.setMinDate();
                    this.bindEvents();
                    this.initDatePickers();
                    this.loadLeaveTypes();
                    this.generateNewCutiId();
                    this.loadMassiveLeaves();
                    this.selectedFiles = [];

                    const defaultTipe = '@(ViewBag.SelectedTipeCuti ?? "")';
                    if (defaultTipe) {
                        $('#pageTitle').text('Pengajuan ' + defaultTipe);
                    }
                },

                initDatePickers: function () {
                    var self = this;
                    var commonCfg = {
                        dateFormat: "Y-m-d",
                        minDate: "today",
                        disableMobile: "true",
                        onChange: function () {
                            self.handleTanggalChange();
                        }
                    };

                    this.fpMulai = flatpickr("#TanggalMulai", commonCfg);
                    this.fpSelesai = flatpickr("#TanggalSelesai", commonCfg);
                },

                updateWeekendStatus: function (isHariKerja) {
                    var self = this;
                    var disableRules = [];

                    if (this.massiveDates && this.massiveDates.length > 0) {
                        disableRules = [...this.massiveDates];
                    }

                    if (isHariKerja) {
                        disableRules.push(function (date) {
                            return (date.getDay() === 0 || date.getDay() === 6);
                        });
                    }

                    if (this.fpMulai && this.fpSelesai) {
                        this.fpMulai.set("disable", disableRules);
                        this.fpSelesai.set("disable", disableRules);
                        const currentVal = this.elements.tanggalMulai.val();
                        if (currentVal) {
                            // Validasi apakah tanggal yang sudah diinput masuk dalam daftar dilarang
                            // (Ini langkah extra agar user tidak bisa 'curang' ganti tipe cuti setelah pilih tanggal)
                        }
                    }
                },

                loadMassiveLeaves: function () {
                    var self = this;
                    $.ajax({
                        url: '/api/CutiApi/get_massive_leave',
                        type: 'GET',
                        data: { company_id: '13559' },
                        success: function (res) {
                            console.log("Data dari API:", res);

                            if (res && res.data && res.data.length > 0) {
                                self.massiveDates = res.data.map(item => {
                                    return {
                                        from: item.from, 
                                        to: item.to     
                                    };
                                });

                                console.log("Massive Dates Tersimpan:", self.massiveDates);
                                const isKerja = (self.currentDayType === 'Hari Kerja');
                                self.updateWeekendStatus(isKerja);
                            }
                        },
                        error: function (err) {
                            console.error("Gagal load cuti bersama", err);
                        }
                    });
                },

                cacheElements: function () {
                    this.elements = {
                        cutiForm: $("#cutiForm"),
                        cutiIdInput: $("#cuti_id"),
                        tipeCuti: $("#tipe_cuti"),
                        cutiKhususSection: $("#cutiKhususSection"),
                        subTipeCuti: $("#sub_tipe_cuti"),
                        lampiranSection: $("#lampiranSection"),
                        lampiranFile: $("#lampiranFile"),
                        lampiranRequired: $("#lampiranRequired"),
                        tanggalMulai: $("#TanggalMulai"),
                        tanggalSelesai: $("#TanggalSelesai"),
                        durasiValue: $("#Durasi"),
                        durasiDisplay: $("#durasiDisplay"),
                        keterangan: $("#Keterangan"),
                        fileNameDisplay: $("#fileNameDisplay"),
                        btnSubmit: $("#btnSubmit"),
                        btnSaveDraft: $("#btnSaveDraft"),
                        cameraModal: $("#cameraModal"),
                        videoPreview: $("#videoPreview"),
                        imagePreview: $("#imagePreview"),
                        canvasCapture: $("#canvasCapture")[0],
                        cameraFooter: $("#cameraFooter"),
                        btnOpenCamera: $("#btnOpenCamera"),
                        btnCloseCamera: $("#closeCamera"),
                        btnBrowseFile: $("#btnBrowseFile"),
                        sisaCutiSection: $("#sisaCutiSection"),
                        fileListContainer: $("#fileListContainer"),
                        errorText: $("#errorMessageText"),
                        errorBox: $("#errorAlertBox")
                    };
                },

                showError: function (message) {
                    this.elements.errorText.text(message);
                    this.elements.errorBox.fadeIn();
                    $('html, body').animate({ scrollTop: 0 }, 'slow');
                },

                hideError: function () {
                    this.elements.errorBox.hide();
                },

                bindEvents: function () {
                    var self = this;
                    self.elements.tipeCuti.on("change", self.handleTipeCutiChange.bind(self));
                    self.elements.tanggalMulai.on('change', function () {
                        self.handleTanggalChange();
                        self.validateWeekendSelection();
                    });

                    self.elements.tanggalSelesai.on('change', function () {
                        self.handleTanggalChange();
                        self.validateWeekendSelection();
                    });
                    self.elements.lampiranFile.on("change", self.handleFileChange.bind(self));
                    self.elements.btnSubmit.on("click", function () { self.handleSubmitForm(false); });
                    self.elements.btnSaveDraft.on("click", function () { self.handleSubmitForm(true); });
                    self.elements.lampiranFile.on("change", self.handleFileSelect.bind(self));

                    self.elements.btnBrowseFile.on("click", function () {
                        self.elements.lampiranFile.attr('accept', '.jpg,.jpeg,.png,.pdf,.zip').removeAttr('capture');
                        self.elements.lampiranFile.click();
                    });

                    self.elements.btnOpenCamera.on("click", self.openCamera.bind(self));
                    self.elements.btnCloseCamera.on("click", self.closeCamera.bind(self));
                    $(document).on("click", "#btnCapture", self.captureImage.bind(self));
                    $(document).on("click", "#btnRetake", self.initializeCamera.bind(self));
                    $(document).on("click", "#btnUsePhoto", self.useCapturedPhoto.bind(self));
                    $(document).on("click", ".btn-remove-file", function () {
                        const index = $(this).data("index");
                        self.removeFile(index);
                    });
                    this.elements.subTipeCuti.on('change', this.hitungDurasi.bind(this));
                },

                removeFile: function (index) {
                    this.selectedFiles.splice(index, 1);
                    if (this.selectedFiles.length === 0) {
                        this.elements.lampiranFile.val('');
                    }
                    this.renderFileList();
                },

                setFieldError: function (elementId, message) {
                    var $input = $("#" + elementId);
                    var $errSpan = $("#err_" + elementId);
                    $input.addClass("input-error shake");
                    $errSpan.text(message).fadeIn();
                    setTimeout(function () { $input.removeClass("shake"); }, 500);
                    $input.off('input change').on('input change', function () {
                        $(this).removeClass("input-error");
                        $errSpan.fadeOut();
                    });
                },

                resetAllErrors: function () {
                    $(".field-error-msg").hide();
                    $(".form-control, .form-select").removeClass("input-error");
                },

                handleFileSelect: function (e) {
                    var newFiles = Array.prototype.slice.call(e.target.files);
                    var self = this;
                    $("#err_lampiran").hide();

                    var validFiles = newFiles.filter(function (file) {
                        var maxSize = 2 * 1024 * 1024;
                        var isValidSize = file.size <= maxSize;
                        var ext = file.name.split('.').pop().toLowerCase();
                        var isValidType = ['jpg', 'jpeg', 'png', 'pdf', 'zip'].indexOf(ext) !== -1;

                        if (!isValidSize) {
                            self.setFieldError('lampiran', `File '${file.name}' > 2MB`);
                        } else if (!isValidType) {
                            self.setFieldError('lampiran', `Format '${file.name}' salah`);
                        }
                        return isValidSize && isValidType;
                    });

                    this.selectedFiles = this.selectedFiles.concat(validFiles);
                    this.elements.lampiranFile.val('');
                    this.renderFileList();
                },

                renderFileList: function () {
                    const $container = this.elements.fileListContainer;
                    $container.empty();
                    this.selectedFiles.forEach((file, index) => {
                        const html = `
                            <div class="file-item">
                                <div class="file-info">
                                    <i class="fa-regular fa-file"></i>
                                    <span class="file-name-text" title="${file.name}">${file.name}</span>
                                    <span style="font-size:0.8em; color:#999;">(${(file.size / 1024).toFixed(0)} KB)</span>
                                </div>
                                <button type="button" class="btn-remove-file" data-index="${index}" title="Hapus File">
                                    <i class="fa-solid fa-xmark"></i>
                                </button>
                            </div>
                        `;
                        $container.append(html);
                    });
                },

                hitungDurasi: function () {
                    var self = this;
                    const tglAwal = this.elements.tanggalMulai.val();
                    const tglAkhir = this.elements.tanggalSelesai.val();

                    let leaveCode = this.elements.tipeCuti.val();
                    if (leaveCode === "Cuti Khusus") {
                        leaveCode = this.elements.subTipeCuti.val();
                    } else if (leaveCode === "Cuti Pribadi") {
                        leaveCode = "CP";
                    } else if (leaveCode === "Cuti Besar") {
                        leaveCode = "CB";
                    }

                    if (tglAwal && tglAkhir && leaveCode) {
                        self.elements.durasiDisplay.val("...");
                        $.ajax({
                            url: '/api/CutiApi/calculateDuration',
                            type: 'GET',
                            data: { start: tglAwal, end: tglAkhir, code: leaveCode },
                            success: function (res) {
                                if (res.meta.code === 200) {
                                    const durationDays = res.data.total_days;
                                    self.elements.durasiValue.val(durationDays);
                                    self.elements.durasiDisplay.val(durationDays);
                                    if (self.elements.tipeCuti.val() === "Cuti Khusus") {
                                        $.ajax({
                                            url: '/api/CutiApi/get_rule_cuti',
                                            type: 'GET',
                                            data: { leave_code: leaveCode },
                                            success: function (ruleRes) {
                                                if (ruleRes.meta && ruleRes.meta.code === 200 && ruleRes.data) {
                                                    const maxJatah = ruleRes.data.jatah_cuti;

                                                    if (durationDays > maxJatah) {
                                                        Swal.fire({
                                                            icon: 'warning',
                                                            title: 'Melebihi Batas',
                                                            text: `Jenis cuti ini maksimal ${maxJatah} hari. Anda mengajukan ${durationDays} hari.`,
                                                            confirmButtonColor: '#F59E0B'
                                                        });
                                                        self.elements.durasiValue.val('');
                                                        self.elements.durasiDisplay.val('-');
                                                        self.elements.tanggalSelesai.val('');
                                                    }
                                                }
                                            }
                                        });

                                    } else {
                                        if (durationDays > self.config.sisaCuti) {
                                            Swal.fire({
                                                icon: 'warning',
                                                title: 'Sisa Cuti Tidak Cukup',
                                                text: `Sisa cuti Anda: ${self.config.sisaCuti} hari. Permintaan: ${durationDays} hari.`,
                                                confirmButtonColor: '#F59E0B'
                                            });
                                            self.elements.durasiValue.val('');
                                            self.elements.durasiDisplay.val('-');
                                            self.elements.tanggalSelesai.val('');
                                        }
                                    }

                                } else {
                                    self.elements.durasiDisplay.val("-");
                                }
                            },
                            error: function () {
                                self.elements.durasiDisplay.val("Error");
                            }
                        });

                    } else {
                        this.elements.durasiValue.val('');
                        this.elements.durasiDisplay.val('-');
                    }
                },

                setMinDate: function () {
                    var dtToday = new Date();
                    var m = (dtToday.getMonth() + 1).toString().padStart(2,'0');
                    var d = dtToday.getDate().toString().padStart(2,'0');
                    var y = dtToday.getFullYear();
                    this.elements.tanggalMulai.attr('min', `${y}-${m}-${d}`);
                    this.elements.tanggalSelesai.attr('min', `${y}-${m}-${d}`);
                },

                loadLeaveTypes: function () {
                    var self = this;
                    $.ajax({
                        url: '/api/CutiApi/listTipeCuti', type: 'GET', data: { company_id: '13559' }, success: function (res) {
                            if (res && res.data) {
                                self.allLeaveTypes = res.data;
                                const defaultTipe = '@(ViewBag.SelectedTipeCuti ?? "")';
                                if (defaultTipe) {
                                    self.elements.tipeCuti.val(defaultTipe);
                                    $('#tipe_cuti_hidden').val(defaultTipe);
                                    self.elements.tipeCuti.trigger('change');
                                }
                            }
                        }
                    });
                },

                handleTipeCutiChange: function () {
                    const selectedType = this.elements.tipeCuti.val();
                    var self = this;

                    this.elements.cutiKhususSection.slideUp();
                    this.elements.sisaCutiSection.slideUp();
                    this.elements.subTipeCuti.prop('required', false).val('');
                    $('#cutiInfoText').hide();

                    const $sec = this.elements.lampiranSection;
                    const $req = this.elements.lampiranRequired;
                    const $opt = $('#labelOptional');
                    const $file = this.elements.lampiranFile;

                    $sec.hide(); $opt.hide(); $req.hide(); $file.prop('required', false);

                    this.elements.subTipeCuti.off('change');

                    if (selectedType === "Cuti Khusus") {
                        this.elements.subTipeCuti.empty().append('<option value="">-- Pilih Jenis Cuti Khusus --</option>');

                        const ck = this.allLeaveTypes.filter(t =>
                            t.leave_code !== 'CP' &&
                            t.leave_code !== 'CB' &&
                            !/izin|ijin|imp/i.test(t.leavename_id) && t.leave_code !== 'CPS'
                        );

                        ck.forEach(i => {
                            this.elements.subTipeCuti.append(`<option value="${i.leave_code}">${i.leavename_id}</option>`);
                        });

                        this.elements.cutiKhususSection.show();
                        this.elements.subTipeCuti.prop('required', true);
                        this.elements.subTipeCuti.on('change', function () {
                            const leaveCode = $(this).val();
                            const selectedText = $(this).find("option:selected").text().toLowerCase();

                            if (leaveCode) {
                                $('#cutiInfoContent').html('<em>Memuat aturan cuti...</em>');
                                $('#cutiInfoText').show();

                                $.ajax({
                                    url: '/api/CutiApi/get_rule_cuti',
                                    type: 'GET',
                                    data: { leave_code: leaveCode },
                                    success: function (res) {
                                        if (res.meta && res.meta.code === 200 && res.data) {
                                            const infoMsg = `Maksimal pengajuan: <strong>${res.data.jatah_cuti} Hari</strong> (${res.data.hitungan_hari})`;
                                            $('#cutiInfoContent').html(infoMsg);
                                            $('#cutiInfoText').slideDown();

                                            self.currentDayType = res.data.hitungan_hari;
                                            const matikanWeekend = (self.currentDayType === 'Hari Kerja');
                                            self.updateWeekendStatus(matikanWeekend);
                                        }
                                    }
                                });
                            } else {
                                $('#cutiInfoText').hide();
                            }

                            self.hitungDurasi();

                            if (selectedText.includes("haid")) {
                                $sec.slideUp();
                                $file.prop('required', false);
                            } else {
                                $sec.slideDown();
                                $req.show();
                                $file.prop('required', true);
                            }
                        });

                    } else if (selectedType === "Cuti Pribadi" || selectedType === "Cuti Besar") {
                        if (selectedType === "Cuti Besar") {
                            self.currentDayType = 'Hari Kalender';
                            self.updateWeekendStatus(false); 
                        } else {
                            self.currentDayType = 'Hari Kerja';
                            self.updateWeekendStatus(true);  
                        }

                        this.elements.sisaCutiSection.show();

                        $sec.slideDown();
                        $opt.show();
                        $req.hide();
                        $file.prop('required', false);

                        self.hitungDurasi();
                    }
                },

                validateWeekendSelection: function () {
                    if (this.currentDayType !== 'Hari Kerja') return;

                    const tglMulai = this.elements.tanggalMulai.val();
                    const tglSelesai = this.elements.tanggalSelesai.val();

                    const isWeekend = (dateString) => {
                        if (!dateString) return false;
                        const day = new Date(dateString).getDay();
                        return day === 0 || day === 6;
                    };

                    let hasError = false;

                    if (isWeekend(tglMulai)) {
                        Swal.fire('Peringatan', 'Jenis cuti ini menggunakan perhitungan <b>Hari Kerja</b>.<br>Anda tidak dapat memilih hari Sabtu/Minggu.', 'warning');
                        this.elements.tanggalMulai.val('');
                        hasError = true;
                    }

                    if (isWeekend(tglSelesai)) {
                        if (!hasError) {
                            Swal.fire('Peringatan', 'Jenis cuti ini menggunakan perhitungan <b>Hari Kerja</b>.<br>Anda tidak dapat memilih hari Sabtu/Minggu.', 'warning');
                        }
                        this.elements.tanggalSelesai.val('');
                        hasError = true;
                    }
                    if (hasError) {
                        this.elements.durasiValue.val('');
                        this.elements.durasiDisplay.val('-');
                    }
                },

                handleTanggalChange: function () {
                    const s = this.elements.tanggalMulai.val();
                    if (s) {
                        this.fpSelesai.set('minDate', s);
                    }
                    this.hitungDurasi();
                },

                handleFileChange: function (e) {
                    const f = e.target.files[0];
                    if (!f) { this.elements.fileNameDisplay.text(""); return; }
                    if (f.size > 2*1024*1024) { Swal.fire('Error', 'File max 2MB', 'error'); e.target.value = ""; return; }
                    this.elements.fileNameDisplay.text(f.name);
                },

                showCaptureButton: function () { this.elements.cameraFooter.html(`<button type="button" id="btnCapture" class="btn btn-submit" style="width:100%;margin-bottom:10px;"><i class="fa fa-camera"></i> Ambil Foto</button>`); },
                showConfirmButtons: function () { this.elements.cameraFooter.html(`<button type="button" id="btnRetake" class="btn btn-cancel" style="margin-right:10px;">Ulang</button><button type="button" id="btnUsePhoto" class="btn btn-submit">Pakai Foto</button>`); },
                openCamera: function () {
                    $("#cameraModal").css("display", "flex");
                    this.initializeCamera();
                },

                closeCamera: function () {
                    if (this.stream) {
                        this.stream.getTracks().forEach(track => track.stop());
                    }
                    $("#cameraModal").hide();
                },

                initializeCamera: async function () {
                    try {
                        this.stream = await navigator.mediaDevices.getUserMedia({
                            video: { facingMode: 'environment' }
                        });
                        const video = document.getElementById('videoPreview');
                        video.srcObject = this.stream;

                        $("#videoPreview").show();
                        $("#imagePreview").hide();
                        $("#dynamicCameraBtn").html(`
                            <button type="button" id="btnCapture" class="btn-cam-primary">
                                <i class="fa-solid fa-camera"></i> Ambil Foto
                            </button>
                        `);
                    } catch (err) {
                        Swal.fire("Error", "Kamera tidak dapat diakses", "error");
                        this.closeCamera();
                    }
                },

                captureImage: function () {
                    const video = document.getElementById('videoPreview');
                    const canvas = document.getElementById('canvasCapture');
                    const context = canvas.getContext('2d');

                    canvas.width = video.videoWidth;
                    canvas.height = video.videoHeight;
                    context.drawImage(video, 0, 0, canvas.width, canvas.height);

                    canvas.toBlob((blob) => {
                        this.capturedBlob = blob;
                        $("#videoPreview").hide();
                        $("#imagePreview").attr("src", URL.createObjectURL(blob)).show();

                        $("#dynamicCameraBtn").html(`
                            <button type="button" id="btnRetake" class="btn-cam-secondary" style="background:#6B7280; color:white; margin-right:8px;">Ulang</button>
                            <button type="button" id="btnUsePhoto" class="btn-cam-primary">Gunakan Foto</button>
                        `);
                        if (this.stream) this.stream.getTracks().forEach(t => t.stop());
                    }, 'image/jpeg', 0.8);
                },
                useCapturedPhoto: function () {
                    if (!this.capturedBlob) return;
                    const file = new File([this.capturedBlob], "foto.jpg", { type: "image/jpeg" });
                    const dt = new DataTransfer(); dt.items.add(file);
                    this.elements.lampiranFile[0].files = dt.files;
                    this.elements.lampiranFile.trigger('change');
                    this.closeCamera();
                },
                generateNewCutiId: function () { this.elements.cutiIdInput.val("LVRYYYYMMDDXXXXX"); },
                buildLampiranFiles: function () {
                    if (this.selectedFiles.length === 0) return [];

                    return this.selectedFiles.map((file) => {
                        const ext = file.name.split('.').pop();
                        const uuidName = `${this.generateUUID()}.${ext}`;

                        console.log(`📎 Rename: ${file.name} → ${uuidName}`);

                        return new File(
                            [file],
                            uuidName,
                            { type: file.type }
                        );
                    });
                },


                generateUUID: function () {
                    return 'xxxxxxxx-xxxx-4xxx-yxxx-xxxxxxxxxxxx'.replace(/[xy]/g, function (c) {
                        const r = Math.random() * 16 | 0;
                        const v = c === 'x' ? r : (r & 0x3 | 0x8);
                        return v.toString(16);
                    });
                },



                handleSubmitForm: function (isDraft) {
                    var self = this;
                    self.resetAllErrors();
                    var isValid = true;
                        if (self.elements.tipeCuti.val() === 'Cuti Khusus' && !self.elements.subTipeCuti.val()) {
                            self.setFieldError('sub_tipe_cuti', 'Wajib dipilih');
                            isValid = false;
                        }
                        if (!self.elements.tanggalMulai.val()) {
                            self.setFieldError('TanggalMulai', 'Wajib diisi');
                            isValid = false;
                        }
                        if (!self.elements.tanggalSelesai.val()) {
                            self.setFieldError('TanggalSelesai', 'Wajib diisi');
                            isValid = false;
                        }

                        var durVal = self.elements.durasiValue.val();
                        if (!durVal || parseInt(durVal) <= 0) {
                            self.setFieldError('Durasi', 'Cek tanggal');
                            isValid = false;
                        }

                        var tipe = self.elements.tipeCuti.val();
                        if (tipe !== 'Cuti Khusus' && parseInt(durVal) > self.config.sisaCuti) {
                            self.setFieldError('Durasi', 'Kuota habis');
                            isValid = false;
                        }

                        if (tipe === 'Cuti Khusus' && self.selectedFiles.length === 0) {
                            self.setFieldError('lampiran', 'Wajib file');
                            isValid = false;
                        }

                        if (!self.elements.keterangan.val() || !self.elements.keterangan.val().trim()) {
                            self.setFieldError('Keterangan', 'Wajib diisi');
                            isValid = false;
                        }


                    if (!isValid) return;

                    Swal.fire({
                        title: isDraft ? 'Simpan Draft?' : 'Kirim Pengajuan?',
                        text: 'Pastikan data sudah benar.',
                        icon: 'question',
                        showCancelButton: true,
                        confirmButtonText: 'Ya',
                        confirmButtonColor: '#10B981'
                    }).then((result) => {
                        if (!result.isConfirmed) return;
                        Swal.fire({
                            title: 'Memproses data...',
                            allowOutsideClick: false,
                            didOpen: () => { Swal.showLoading(); }
                        });

                        const btn = isDraft ? self.elements.btnSaveDraft : self.elements.btnSubmit;
                        btn.prop("disabled", true);
                        const fd = new FormData();

                        let code = (tipe === "Cuti Khusus") ? self.elements.subTipeCuti.val() : (tipe === "Cuti Besar" ? "CB" : "CP");
                        const statusVal = isDraft ? 'Draft' : 'Unverified';

                        fd.append('request_status', statusVal);
                        fd.append('status', statusVal);
                        fd.append('requestedby', self.config.userNpk);
                        fd.append('requestfor', self.config.userNpk);
                        fd.append('leave_code', code);
                        fd.append('startdate', self.elements.tanggalMulai.val());
                        fd.append('enddate', self.elements.tanggalSelesai.val());
                        fd.append('totaldays', durVal);
                        fd.append('remark', self.elements.keterangan.val());

                        const renamedFiles = self.buildLampiranFiles();
                        renamedFiles.forEach(file => { fd.append('lampiranFile', file); });

                        $.ajax({
                            url: '/api/CutiApi/createCuti',
                            type: 'POST',
                            data: fd,
                            processData: false,
                            contentType: false,
                            success: function (res) {
                                const reqNoFromApi = (res.data && res.data.length > 0) ? res.data[0].request_no : null;


                                if (!isDraft && (tipe === "Cuti Pribadi" || tipe === "Cuti Besar") && reqNoFromApi) {
                                    self.processEntitlement(code, durVal, reqNoFromApi);
                                } else {
                                    Swal.fire('Sukses', isDraft ? 'Draft tersimpan.' : 'Pengajuan terkirim.', 'success').then(() => {
                                        window.location.href = self.config.redirectUrl;
                                    });
                                }
                            },
                            error: function (xhr) {
                                Swal.fire('Gagal', 'Terjadi kesalahan sistem pengajuan.', 'error');
                                btn.prop("disabled", false);
                            }
                        });
                    });
                },

                processEntitlement: function (leaveCode, amount, requestNo) {
                    var self = this;
                    const payload = {
                        emp_id: self.config.userNpk,
                        leave_code: leaveCode,
                        amount: amount,
                        request_no: requestNo,
                        type: "DEDUCT", 
                        user_nik: self.config.userNpk 
                    };

                    $.ajax({
                        url: '/api/CutiApi/processTransactionCuti', 
                        type: 'POST',
                        contentType: 'application/json',
                        data: JSON.stringify(payload),
                        success: function (res) {
                            Swal.fire('Sukses', 'Pengajuan berhasil dikirim dan jatah cuti telah terpotong.', 'success').then(() => {
                                window.location.href = self.config.redirectUrl;
                            });
                        },
                        error: function (err) {
                            console.error("Entitlement Update Error", err);
                            Swal.fire('Perhatian', 'Pengajuan tersimpan, namun terjadi kegagalan sinkronisasi saldo. Mohon hubungi admin.', 'warning').then(() => {
                                window.location.href = self.config.redirectUrl;
                            });
                        }
                    });
                },


            };

            $(document).ready(function () {
                var pageConfig = {
                    userNpk: '@(ViewBag.EmpId ?? "")',
                    requestForName: '@(ViewBag.Fullname ?? "")',
                    redirectUrl: '@Url.Action("ManageCutiKaryawan", "Manage")',
                    sisaCuti: parseInt('@(ViewBag.SisaCuti ?? 0)')
                };
                TambahCutiPage.init(pageConfig);
            });

        })(jQuery);
    </script>
    </body>
</html>