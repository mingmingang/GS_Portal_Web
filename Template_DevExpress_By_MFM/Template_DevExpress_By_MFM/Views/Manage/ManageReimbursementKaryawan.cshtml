        }

    /*    .dx-datagrid-headers {
        background-color: #1B3D97;
        color: white;
        font-weight: bold;
    }

        .dx-datagrid-headers .dx-header-filter {
            color: white;
        }

        .dx-datagrid-headers .dx-sort {
            color: white;
        }*/

    .filter-reset-container {
        display: flex;
        align-items: center;
        margin-left: 20px;
    }

    .btn-reset-filter {
        background-color: #eef2ff; /* Warna lavender lembut */
        color: #4338ca; /* Warna indigo */
        border: 1px solid #c7d2fe;
        padding: 6px 12px;
        border-radius: 20px; /* Membuatnya seperti pil */
