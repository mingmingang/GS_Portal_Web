@using Template_DevExpress_By_MFM.Models
@using DevExtreme.AspNet.Mvc

<style>
    .clickable-filter {
        cursor: pointer;
        text-decoration: underline;
        text-decoration-style: dotted;
        text-decoration-thickness: 1px;
        transition: color 0.2s;
    }

        .clickable-filter:hover {
            color: #1B3D97; /* Warna biru saat hover */
        }

    .panduan-list {
        list-style: none;
        padding: 0;
        margin-top: 10px;
    }

        .panduan-list li {
            margin-bottom: 12px;
            display: flex;
            align-items: flex-start;
            line-height: 1.5;
        }

        .panduan-list .status-label {
            margin-right: 15px;
            flex-shrink: 0;
            width: 170px;
            text-align: center;
        }

    .status-disetujui {
        color: #008000;
        background-color: #e6f7e6;
        padding: 4px 8px;
        border-radius: 4px;
        font-weight: bold;
        border: 1px solid #90EE90;
    }

/*    .belum-diverifikasi {
        color: #FFA500;
        background-color: #fffacd;
        padding: 4px 8px;
        border-radius: 4px;
        font-weight: bold;
        border: 1px solid #ffd700;
    }*/

    .status-ditolak {
        color: #FF0000;
        background-color: #ffe6e6;
        padding: 4px 8px;
        border-radius: 4px;
        font-weight: bold;
        border: 1px solid #ffb6c1;
    }

    .status-dibatalkan {
        color: #FF0000;
        background-color: #ffe6e6;
        padding: 4px 8px;
        border-radius: 4px;
        font-weight: bold;
        border: 1px solid #dcdcdc;
