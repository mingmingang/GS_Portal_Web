</style>

<div class="reimbursement-page-container">
    <h2 class="page-title">Ringkasan Plafon Reimbursement</h2>

    <!-- [PERBAIKAN UTAMA] Struktur HTML disederhanakan -->
    <!-- Kartu Ringkasan (Tampil di awal) -->
    <div id="summaryCardToggle" class="plafon-card summary-card-toggle">
        <div class="header">
            <div class="title">Ringkasan Plafon (Klik untuk detail)</div>
            <div class="note">Total gabungan dari rawat jalan, kb, dan kacamata.</div>
        </div>
        <div class="details-grid">
            <div class="detail-item">
                <div class="label">Total Plafon</div>
                <div id="summaryPlafon" class="value plafon">Rp 0</div>
            </div>
            <div class="detail-item">
                <div class="label">Total Digunakan</div>
                <div id="summaryDigunakan" class="value digunakan clickable-filter" data-claim-type="All">Rp 0</div>
            </div>
            <div class="detail-item">
                <div class="label">Total Sisa</div>
                <div id="summarySisa" class="value sisa">Rp 0</div>
            </div>
        </div>
        <div class="unrealize-box">
            <span class="unrealize-label">Belum Direalisasi</span>
            <span id="summaryUnrealize" class="unrealize-value">Rp 0</span>
        </div>
    </div>

    <!-- Container untuk 5 kartu detail yang ditampilkan secara vertikal (awalnya disembunyikan) -->
    <div id="detailCardsContainer" class="plafon-container-vertical" style="display: none;">
        <div id="cardRawatJalan" class="plafon-card"></div>
        <div id="cardRawatInap" class="plafon-card"></div>
        <div id="cardMaternity" class="plafon-card"></div>
        <div id="cardKB" class="plafon-card"></div>
        <div id="cardKacamata" class="plafon-card"></div>

        <!-- Tombol untuk kembali ke ringkasan, dibuat seperti card agar seragam -->
        <div class="plafon-card" style="display:flex; justify-content:center; align-items:center; padding: 12px;">
            @(Html.DevExtreme().Button()
                 .Text("Tutup Detail")
                 .Icon("chevronup")
                 .Type(ButtonType.Normal)
                 .StylingMode(ButtonStylingMode.Contained)
                 .OnClick("toggleDetailCards"))
        </div>
    </div>

    <div class="grid-container-card">
        <div class="datagrid-toolbar">
            <div class="title-section">
                <h3 class="title">Daftar Reimbursement</h3>
                <span id="displayTahun" class="year-display"></span>
            </div>
        </div>

        <div id="filterResetContainer" class="filter-reset-container"></div>

        @{
            var detailUrl = Url.Action("ManageDetailReimbursement", "Manage");
            var pembatalanUrl = Url.Action("ManageCancelReimbursement", "Manage");
        }

        @(Html.DevExtreme().DataGrid<ReimbursementModel>()
            .ID("gridListCuti")
            .OnInitialized("onGridInit")
            .DataSource(new JS("createGridDataSource()"))
            .OnContentReady("onGridContentReady")
            .RemoteOperations(true)
            .NoDataText("Tidak ada data untuk ditampilkan")
            .SearchPanel(s => s
                .Visible(true)
                .Width(250)
                .Placeholder("Cari di tabel...")
                .HighlightSearchText(false)
            )
            .Toolbar(toolbar => {
                toolbar.Items(items => {
                    items.Add().Name("searchPanel").Location(ToolbarItemLocation.After);
                    items.Add().Location(ToolbarItemLocation.After).Widget(w => w.Button()
                        .Template("<i class='fas fa-filter' style='font-size: 19px; color: #555;'></i>")
                        .Hint("Filter data")
                        .OnClick("showFilterPopup")
                    );
                    items.Add().Location(ToolbarItemLocation.After).Widget(w => w.Button()
                        .ID("tombolPanduanStatus")
                        .Hint("Panduan Status")
                        .Template("<i class='fas fa-book' style='font-size: 19px; color: #555;'></i>")
                        .OnClick("showPanduanStatusPopup")
                    );
                    items.Add().Location(ToolbarItemLocation.After).Widget(w => w.Button()
                        .Icon("add")
                        .Text("Tambah Reimbursement")
                        .Type(ButtonType.Default)
                        .StylingMode(ButtonStylingMode.Contained)
                        .OnClick("navigateToAddReimbursement")
                    ).CssClass("btn-tambah-dx");
                });
            })
            .ShowBorders(true)
            .AllowColumnReordering(true)
            .AllowColumnResizing(true)
            .ColumnAutoWidth(true)
            .ColumnFixing(c => c.Enabled(true))
            .Scrolling(scrolling => scrolling.ColumnRenderingMode(GridColumnRenderingMode.Virtual))
            .RowAlternationEnabled(true)
            .HeaderFilter(f => f.Visible(true))
            .Paging(p => p.PageSize(10))
            .Pager(pager => {
                pager.Visible(true);
                pager.DisplayMode(GridPagerDisplayMode.Full);
                pager.ShowPageSizeSelector(true);
                pager.AllowedPageSizes(new JS("[10, 20, 50, 'all']"));
                pager.ShowInfo(true);
            })
            .Columns(columns =>
            {
                columns.Add().Caption("No").Width(50).AllowFiltering(false).AllowSorting(false).CellTemplate(new JS("grid_cell_rowIndex"));
                columns.AddFor(m => m.RmbNoRequest).DataField("rmbNoRequest").Caption("No Pengajuan").Alignment(HorizontalAlignment.Right);
                columns.AddFor(m => m.NamaKaryawan).DataField("namaKaryawan").Caption("Nama Karyawan");
                columns.AddFor(m => m.NamaPasien).DataField("namaPasien").Caption("Nama Pasien");
                columns.AddFor(m => m.RmbJenisClaim).DataField("rmbJenisClaim").Caption("Jenis Reimbursement");
                columns.AddFor(m => m.NamaDiagnosa).DataField("namaDiagnosa").Caption("Diagnosa");
                columns.AddFor(m => m.RmbBiayaPeriksa).DataField("rmbBiayaPeriksa").Caption("Biaya Periksa")
                    .Alignment(HorizontalAlignment.Right)
                    .AllowSearch(false)
                    .CellTemplate(new JS(@"
                        function(container, options) {
                            if(options.value == null) {
                                return;
                            }
                            var formattedCurrency = new Intl.NumberFormat('id-ID', {
                                style: 'currency',
                                currency: 'IDR',
                                minimumFractionDigits: 0,
                                maximumFractionDigits: 0
                            }).format(options.value);
                            container.text(formattedCurrency);
                        }
                    "));
                columns.AddFor(m => m.durasi).Caption("Durasi").Alignment(HorizontalAlignment.Center).AllowSearch(false);
                columns.AddFor(m => m.RmbStatus).Caption("Status").Alignment(HorizontalAlignment.Center)
                    .CellTemplate(new JS(@"
                            function(container, options) {
                                var status = options.data.rmbStatus;
                                var className = '';
                                if (status === 'Disetujui') className = 'status-disetujui';
                                else if (status === 'Ditolak') className = 'status-ditolak';
                                else if (status === 'Menunggu Persetujuan HC') className = 'menunggu-persetujuan';
                                else if (status === 'Dibatalkan') className = 'status-dibatalkan';
                                else { className = ''; }
                                $('<span>').addClass(className).text(status).appendTo(container);
                            }
                        "));
                columns.Add().Caption("Pembatalan").Width(150)
                    .CellTemplate(new JS(string.Format(@"
                        function(container, options) {{
                            var status = options.data.rmbStatus;
                            var actualCurrentYear = new Date().getFullYear();

                            if ((status === 'Menunggu Persetujuan HC')
                                && currentYear === actualCurrentYear) {{
                                $('<a>')
                                    .attr('href', '{0}?id=' + options.data.rmbId)
                                    .attr('title', 'Batalkan Pengajuan')
                                    .html('<span style=""color:red; cursor:pointer;"">&#10006;</span>')
                                    .appendTo(container);
                            }}
                        }}
                    ", pembatalanUrl)))
                    .Alignment(HorizontalAlignment.Center);

                columns.Add().Caption("Lihat").Width(100).Alignment(HorizontalAlignment.Center)
                    .CellTemplate(new JS(string.Format(@"
                                function(container, options) {{
                                    $('<a>')
                                        .attr('href', '{0}?id=' + options.data.rmbId)
                                        .attr('href', '{0}?id=' + options.data.rmbId)
                                        .attr('title', 'Lihat Detail')
                                        .html('<i class=""fas fa-eye"" style=""color:blue; cursor:pointer;""></i>')
                                        .appendTo(container);
                                }}
                            ", detailUrl)));
            })
        )
    </div>

    <!-- Popup dan Javascript tidak ada perubahan -->
    @(Html.DevExtreme().Popup()
    .ID("filterPopup")
    .Title("Filter Data")
    .Width(350)
    .Height("auto")
    .ShowTitle(true)
    .DragEnabled(false)
    .HideOnOutsideClick(true)
    .Shading(true)
    .OnInitialized("filterPopup_onInit")
    .OnShowing("filterPopup_onShowing")

.ContentTemplate(@<div class="filter-popup-content">
    <div class="dx-field">
        <div class="dx-field-label">Tahun</div>
        <div class="dx-field-value">
            @(Html.DevExtreme().SelectBox()
                .ID("yearSelectBox")
                .DataSource(new JS("getYearDataSource()"))
                .Value(new JS("currentYear"))
                .SearchEnabled(true)
                .Placeholder("Pilih Tahun")
                // [FIX 1] Tambahkan event OnInitialized
                .OnInitialized("yearSelect_onInit")
            )
        </div>
    </div>
    <div class="dx-field" style="margin-top: 15px;">
        <div class="dx-field-label">Status</div>
        <div class="dx-field-value">
            @(Html.DevExtreme().List()
                .ID("statusList")
                .DataSource(new JS("statusDataSource"))
                .ShowSelectionControls(true)
                .SelectionMode(ListSelectionMode.All)
                .SelectAllText("Semua Status")
                .Height(220)
                .SelectedItems(new JS("selectedStatuses"))
                // [FIX 2] Tambahkan event OnInitialized
                .OnInitialized("statusList_onInit")
            )
        </div>
    </div>
    @(Html.DevExtreme().Button()
        .ID("applyFilterButton")
        // ... sisa tombol tidak berubah
        .Text("Terapkan Filter")
        .Type(ButtonType.Default)
        .StylingMode(ButtonStylingMode.Contained)
        .Width("100%")
        .OnClick("applyFilters") // Bisa disederhanakan tanpa function(e)
    )
</div>)
    )
    @(Html.DevExtreme().Popup()
    .ID("panduanStatusPopup")
    .Title("Panduan Status Reimbursement")
    .Width(500)
    .Height("auto")
    .ShowTitle(true)
    .DragEnabled(false)
    .HideOnOutsideClick(true)
    .Shading(true)
    .OnInitialized("panduanStatusPopup_onInit")
    .ContentTemplate(
        @<div style="padding: 15px;">
            <p>Berikut adalah penjelasan untuk setiap status pengajuan reimbursement:</p>
            <ul class="panduan-list">
                <li>
                    <span class="status-label menunggu-persetujuan">Menunggu Persetujuan HC</span>
                    <span>Pengajuan sudah dibuat oleh karyawan, dan menunggu persetujuan dari Atasan.</span>
                </li>
                <li>
                    <span class="status-label status-disetujui">Disetujui</span>
                    <span>Pengajuan reimbursement obat karyawan telah disetujui.</span>
                </li>
                <li>
                    <span class="status-label status-ditolak">Ditolak</span>
                    <span>Pengajuan ditolak, baik oleh atasan maupun oleh HC.</span>
                </li>
                <li>
                    <span class="status-label status-dibatalkan">Dibatalkan</span>
                    <span>Pengajuan dibatalkan oleh karyawan yang mengajukan sebelum diproses lebih lanjut.</span>
                </li>
            </ul>
        </div>)
    )
</div>

@section Scripts {
    <script>
    // ------------------ DATA KARYAWAN (DIISI DARI SERVER) ------------------
    const employeeData = {
        @*golongan: parseInt('@(ViewBag.EmployeeGolongan ?? 0)'),
        statusKawin: '@(ViewBag.EmployeeStatusKawin ?? "Lajang")',*@
        createdDate: new Date('@(ViewBag.EmployeeCreatedDate ?? DateTime.Now.ToString("o"))')
    };

    // ------------------ STATE & INSTANCE MANAGEMENT ------------------
    let currentYear = new Date().getFullYear();
    const statusDataSource = ['Disetujui', 'Menunggu Persetujuan HC', 'Ditolak', 'Dibatalkan'];
    let selectedStatuses = [...statusDataSource];

    // Variabel untuk menyimpan instance komponen DevExtreme
    let filterPopupInstance = null;
    let panduanStatusPopupInstance = null;
    let yearSelectInstance = null;
    let statusListInstance = null;
    let dataGridInstance = null;
    let isProgrammaticFilterActive = false;

    // ------------------ FUNGSI UTAMA & DATA SOURCE ------------------

    // Panggil saat halaman dimuat
    $(function () {
        setupCardToggle();
        setupDigunakanFilterClick();
        updateDisplayTahun(currentYear, selectedStatuses);
    });

    function setupCardToggle() {
        $("#summaryCardToggle").on("click", toggleDetailCards);
        }

    function setupDigunakanFilterClick() {
        $('.reimbursement-page-container').on('click', '.clickable-filter', function () {
            if (!dataGridInstance) {
                DevExpress.ui.notify("Tabel belum siap.", "warning", 2000);
                return;
            }

            const claimType = $(this).data('claim-type');
            let filterCriteria;
            
            // [PERBAIKAN #2.1] Deklarasikan dan isi variabel yang hilang
            let filterDisplayName; 

            if (claimType === 'All') {
                filterDisplayName = "Ringkasan Digunakan";
                filterCriteria = [
                    ["rmbStatus", "=", "Disetujui"],
                    "and",
                    [
                        ["rmbJenisClaim", "=", "Rawat Jalan"], "or",
                        ["rmbJenisClaim", "=", "KB"], "or",
                        ["rmbJenisClaim", "=", "Kacamata"]
                    ]
                ];
            } else if (claimType) {
                filterDisplayName = claimType;
                filterCriteria = [
                    ["rmbStatus", "=", "Disetujui"], "and",
                    ["rmbJenisClaim", "=", claimType]
                ];
            } else {
                return;
            }
            
            selectedStatuses = ['Disetujui'];

            dataGridInstance.clearFilter();
            dataGridInstance.filter(filterCriteria);
            
            isProgrammaticFilterActive = true;
            // Sekarang `filterDisplayName` memiliki nilai yang benar
            showResetFilterButton(filterDisplayName); 
            
            updateDisplayTahun(currentYear, selectedStatuses);
            
            $('html, body').animate({
                scrollTop: $("#gridListCuti").offset().top - 20
            }, 500);

            DevExpress.ui.notify(`Menampilkan data untuk: ${filterDisplayName}`, 'info', 3000);
        });
    }

    function toggleDetailCards(event) {
        // Mencegah trigger toggle jika yang diklik adalah link filter
        if ($(event.target).hasClass('clickable-filter')) {
            return;
        }
        $("#summaryCardToggle").toggle(); 
        $("#detailCardsContainer").toggle(); 
    }

    // [PERBAIKAN] Fungsi untuk mendapatkan instance grid saat pertama kali dibuat
    function onGridInit(e) {
        dataGridInstance = e.component;
    }

    function showResetFilterButton(filterText) {
        const buttonHtml = `
            <button class="btn-reset-filter" onclick="resetProgrammaticFilter()">
                Filter Aktif: "${filterText}"
                <span class="reset-icon">&times;</span>
            </button>`;
        $("#filterResetContainer").html(buttonHtml);
    }

    function hideResetFilterButton() {
        $("#filterResetContainer").empty();
    }

    function resetProgrammaticFilter() {
        if (!dataGridInstance) return;

        isProgrammaticFilterActive = false;
        selectedStatuses = [...statusDataSource]; // Kembalikan ke semua status

        dataGridInstance.clearFilter();
        dataGridInstance.refresh(); // Ini akan memicu createGridDataSource dengan selectedStatuses yang sudah direset
        
        hideResetFilterButton();
        updateDisplayTahun(currentYear, selectedStatuses);
        DevExpress.ui.notify("Filter 'Digunakan' telah direset.", "success", 2000);
    }

    function createGridDataSource() {
        return new DevExpress.data.CustomStore({
            key: "rmbId",
            load: function (loadOptions) {
                const d = $.Deferred();

                // Siapkan parameter dasar
                const params = {
                    year: currentYear,
                    statuses: JSON.stringify(selectedStatuses)
                };

                // Tambahkan filter dari grid (misalnya filter row, header filter, dll)
                if (loadOptions.filter) {
                    params.filter = JSON.stringify(loadOptions.filter);
                }

                // Tambahkan search dari SearchPanel
                if (loadOptions.searchValue) {
                    params.searchValue = loadOptions.searchValue;
                    params.searchExpr = loadOptions.searchExpr;
                    params.searchOperation = loadOptions.searchOperation;
                }

                // Tambahkan paging & sorting (biar RemoteOperations jalan)
                if (loadOptions.skip !== undefined) {
                    params.skip = loadOptions.skip;
                }
                if (loadOptions.take !== undefined) {
                    params.take = loadOptions.take;
                }
                if (loadOptions.sort) {
                    params.sort = JSON.stringify(loadOptions.sort);
                }

                $.ajax({
                    url: '/api/ReimbursementApi',
                    method: "GET",
                    data: params,
                    dataType: "json",
                    success: function (response) {
                        if (response && response.data) {
                            d.resolve(response.data, {
                                totalCount: response.totalCount
                            });
                            if (response.summary) {
                                updateAllSummaryCards(response.summary);
                            }
                        } else {
                            d.resolve([], { totalCount: 0 });
                            console.error("Format data dari API tidak valid.");
                        }
                    },
                    error: function () {
                        d.reject("Gagal memuat data.");
                        DevExpress.ui.notify("Terjadi kesalahan saat mengambil data dari server.", "error", 3000);
                    }
                });

                return d.promise();
            }
        });
    }

    function applyFilters() {
        if (!yearSelectInstance || !statusListInstance || !dataGridInstance) {
            DevExpress.ui.notify("Komponen filter belum siap, silakan coba lagi.", "warning", 2000);
            console.log("yearSelectInstance: " + yearSelectInstance + ", statusListInstance: " + statusListInstance + ", dataGridInstance: " + dataGridInstance)
            return;
        }

        const newYear = yearSelectInstance.option("value");
        const newStatuses = statusListInstance.option("selectedItems");

        currentYear = newYear;
        selectedStatuses = newStatuses;
        
        console.log("Menerapkan Filter:", { year: currentYear, statuses: selectedStatuses });

        isProgrammaticFilterActive = false;
        hideResetFilterButton();

        dataGridInstance.clearFilter();
        dataGridInstance.refresh();
        updateDisplayTahun(currentYear, selectedStatuses);

        if (filterPopupInstance) {
            filterPopupInstance.hide();
        }
    }

    function updateSummaryCards(summary) {
        // Jika tidak ada data summary (misal saat error API), reset ke default.
        if (!summary) {
            // Gunakan id 'cardTitle' yang baru untuk judul
            $("#cardTitle").text("Ringkasan Plafon");

            // Gunakan id '#summary...' yang baru untuk nilai
            $("#summaryPlafon").text("Rp 0");
            $("#summaryDigunakan").text("Rp 0");
            $("#summarySisa").text("Rp 0");
            $("#summaryUnrealize").text("Rp 0");
            return;
        }

        // 1. Mengatur Judul Dinamis
        // Data 'notePlafon' dari API (e.g., "Keluarga - Golongan 4") dijadikan judul.
        $("#cardTitle").text(summary.notePlafon || "Ringkasan Plafon");

        // 2. Mengisi nilai Plafon, Digunakan, dan Sisa
        // Menggunakan ID baru dari HTML yang diperbaiki.
        $("#summaryPlafon").text(formatCurrency(summary.plafon));
        $("#summaryDigunakan").text(formatCurrency(summary.digunakan));
        $("#summarySisa").text(formatCurrency(summary.sisa));
        $("#summaryUnrealize").text(formatCurrency(summary.unrealize));
    }

    function updateAllSummaryCards(summaryData) {
        if (!summaryData) { return; }

        // BAGIAN 1: Ringkasan Utama (logika tidak berubah)
        const rawatJalan = summaryData.rawatJalan || { plafon: 0, digunakan: 0, sisa: 0, unrealize: 0 };
        const kb = summaryData.kb || { plafon: 0, digunakan: 0, sisa: 0, unrealize: 0 };
        const kacamata = summaryData.kacamata || { plafon: 0, digunakan: 0, sisa: 0, unrealize: 0 };
        const totalPlafon = rawatJalan.plafon;
        const totalDigunakan = rawatJalan.digunakan + kb.digunakan + kacamata.digunakan;
        const totalSisa = totalPlafon - totalDigunakan;
        const totalUnrealize = rawatJalan.unrealize + kb.unrealize + kacamata.unrealize;
        $("#summaryPlafon").text(formatCurrency(totalPlafon));
        $("#summaryDigunakan").text(formatCurrency(totalDigunakan));
        $("#summarySisa").text(formatCurrency(totalSisa));
        $("#summaryUnrealize").text(formatCurrency(totalUnrealize));

        // BAGIAN 2: Detail Card
        const cardMapping = {
            'Rawat Jalan': { key: 'rawatJalan', target: '#cardRawatJalan' },
            'Rawat Inap': { key: 'rawatInap', target: '#cardRawatInap' },
            'Maternity': { key: 'maternity', target: '#cardMaternity' },
            'KB': { key: 'kb', target: '#cardKB' },
            'Kacamata': { key: 'kacamata', target: '#cardKacamata' }
        };
        const jenisSesuaiHak = ['Rawat Inap', 'Maternity', 'Kacamata'];

        for (const [title, map] of Object.entries(cardMapping)) {
            const data = summaryData[map.key] || { plafon: 0, digunakan: 0, sisa: 0, unrealize: 0, note: '' };
            let plafonText, sisaText;

            if (data.plafon === 0 && jenisSesuaiHak.includes(title)) {
                plafonText = "Sesuai Hak Gol.";
                sisaText = "Sesuai Hak Gol.";
            } else {
                plafonText = formatCurrency(data.plafon);
                sisaText = formatCurrency(data.sisa);
            }
            
            // >> PERBAIKAN DI SINI <<
            // Menambahkan `class="... clickable-filter"` dan `data-claim-type="${title}"`
            // pada elemen div yang menampilkan nilai "Digunakan".
            const cardHtml = `
                <div class="header">
                    <div class="title">${title}</div>
                    <div class="note">${data.note || 'Plafon per tahun'}</div>
                </div>
                <div class="details-grid">
                    <div class="detail-item">
                        <div class="label">Plafon</div>
                        <div class="value plafon">${plafonText}</div>
                    </div>
                    <div class="detail-item">
                        <div class="label">Digunakan</div>
                        <div class="value digunakan clickable-filter" data-claim-type="${title}">${formatCurrency(data.digunakan)}</div>
                    </div>
                    <div class="detail-item">
                        <div class="label">Sisa</div>
                        <div class="value sisa">${sisaText}</div>
                    </div>
                </div>
                <div class="unrealize-box">
                    <span class="unrealize-label">Belum Direalisasi</span>
                    <span class="unrealize-value">${formatCurrency(data.unrealize)}</span>
                </div>
            `;
            $(map.target).html(cardHtml);
        }
    }

    function onGridContentReady(e) {
        updateDisplayTahun(currentYear, selectedStatuses);
        const grid = e.component;
        const visibleRowCount = grid.getVisibleRows().length;
        if (visibleRowCount === 0) {
            grid.option('height', 150);
        } else if (visibleRowCount < 10) {
            grid.option('height', 'auto');
        } else {
            grid.option('height', 480);
        }
    }

    // Fungsi untuk inisialisasi instance komponen
    function yearSelect_onInit(e) { yearSelectInstance = e.component; }
    function statusList_onInit(e) { statusListInstance = e.component; }
    function filterPopup_onInit(e) { filterPopupInstance = e.component; }
    function panduanStatusPopup_onInit(e) { panduanStatusPopupInstance = e.component; }

    function filterPopup_onShowing(e) {
        // Cek jika instance belum ada, lalu ambil dari ID elemennya
        if (!yearSelectInstance) {
            yearSelectInstance = $("#yearSelectBox").dxSelectBox("instance");
        }
        if (!statusListInstance) {
            statusListInstance = $("#statusList").dxList("instance");
        }
    }

    function showFilterPopup() {
        if (filterPopupInstance) {
            filterPopupInstance.show();
            // Pastikan nilai di popup sesuai dengan state terakhir
            if (yearSelectInstance) { yearSelectInstance.option("value", currentYear); }
            if (statusListInstance) { statusListInstance.option("selectedItems", selectedStatuses); }
        }
    }

    function showPanduanStatusPopup() {
        if (panduanStatusPopupInstance) panduanStatusPopupInstance.show();
    }

    function updateDisplayTahun(year, statuses) {
        let statusText;
        if (!statuses || statuses.length === 0) statusText = "(Tidak ada status)";
        else if (statuses.length === statusDataSource.length) statusText = "(Semua status)";
        else statusText = `(${statuses.length} status terpilih)`;
        $("#displayTahun").text(`Tahun ${year} ${statusText}`);
    }

    function formatCurrency(value) {
        if (typeof value !== 'number') return "Rp 0";
        return new Intl.NumberFormat('id-ID', {
            style: 'currency', currency: 'IDR', minimumFractionDigits: 0, maximumFractionDigits: 0
        }).format(value);
    }

        function getYearDataSource() {
        const creationYear = employeeData.createdDate.getFullYear();
        const currentYearNow = new Date().getFullYear();
        const years = [];

        for (let y = currentYearNow; y >= creationYear; y--) {
            years.push(y);
        }

        return years;
    }

    function grid_cell_rowIndex(container, options) {
        container.text(options.component.pageIndex() * options.component.pageSize() + options.rowIndex + 1);
    }

    function navigateToAddReimbursement() {
        window.location.href = '@Url.Action("ManageAddReimbursement", "Manage")';
    }
    </script>
}