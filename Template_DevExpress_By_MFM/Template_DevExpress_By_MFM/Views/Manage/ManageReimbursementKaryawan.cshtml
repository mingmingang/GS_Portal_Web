@section Scripts {
    <script>
    // ------------------ DATA KARYAWAN (DIISI DARI SERVER) ------------------
    const employeeData = {
        golongan: parseInt('@(ViewBag.EmployeeGolongan ?? 0)'),
        statusKawin: '@(ViewBag.EmployeeStatusKawin ?? "Lajang")',
        createdDate: new Date('@(ViewBag.EmployeeCreatedDate ?? DateTime.Now.ToString("o"))')
    };

    // ------------------ STATE & INSTANCE MANAGEMENT ------------------
    let currentYear = new Date().getFullYear();
    const statusDataSource = ['Disetujui', 'Menunggu Persetujuan', 'Belum Diverifikasi', 'Ditolak', 'Dibatalkan'];
    let selectedStatuses = [...statusDataSource]; // Default: pilih semua status

    // Variabel untuk menyimpan instance komponen DevExtreme
    let filterPopupInstance = null;
    let panduanStatusPopupInstance = null;
    let yearSelectInstance = null;
    let statusListInstance = null;
    let dataGridInstance = null; // Instance grid SANGAT PENTING

    // ------------------ FUNGSI UTAMA & DATA SOURCE ------------------

    // Panggil saat halaman dimuat
    $(function() {
        // Inisialisasi awal, panggil fungsi update judul
        updateDisplayTahun(currentYear, selectedStatuses);
    });

    // [PERBAIKAN] Fungsi untuk mendapatkan instance grid saat pertama kali dibuat
    function onGridInit(e) {
        dataGridInstance = e.component;
    }

        function createGridDataSource() {
        return new DevExpress.data.CustomStore({
            key: "RbmId",
            load: function (loadOptions) {
                const d = $.Deferred();

                // Siapkan parameter dasar
                const params = {
                    year: currentYear,
                    statuses: JSON.stringify(selectedStatuses)
                };

                // Tambahkan filter dari grid (misalnya filter row, header filter, dll)
                if (loadOptions.filter) {
                    params.filter = JSON.stringify(loadOptions.filter);
                }

                // Tambahkan search dari SearchPanel
                if (loadOptions.searchValue) {
                    params.searchValue = loadOptions.searchValue;
                    params.searchExpr = loadOptions.searchExpr;
                    params.searchOperation = loadOptions.searchOperation;
                }

                // Tambahkan paging & sorting (biar RemoteOperations jalan)
                if (loadOptions.skip !== undefined) {
                    params.skip = loadOptions.skip;
                }
                if (loadOptions.take !== undefined) {
                    params.take = loadOptions.take;
                }
                if (loadOptions.sort) {
                    params.sort = JSON.stringify(loadOptions.sort);
                }

                $.ajax({
                    url: '/api/ReimbursementApi',
                    method: "GET",
                    data: params,
                    dataType: "json",
                    success: function (response) {
                        if (response && response.data) {
                            d.resolve(response.data, {
                                totalCount: response.totalCount
                            });
                            if (response.summary) {
                                updateSummaryCards(response.summary);
                            }
                        } else {
                            d.resolve([], { totalCount: 0 });
                            console.error("Format data dari API tidak valid.");
                        }
                    },
                    error: function () {
                        d.reject("Gagal memuat data.");
                        DevExpress.ui.notify("Terjadi kesalahan saat mengambil data dari server.", "error", 3000);
                    }
                });

                return d.promise();
            }
        });
    }

    // [FUNGSI FILTER UTAMA YANG DIPERBAIKI]
    function applyFilters() {
        if (!yearSelectInstance || !statusListInstance || !dataGridInstance) {
            DevExpress.ui.notify("Komponen filter belum siap, silakan coba lagi.", "warning", 2000);
            console.log("yearSelectInstance: " + yearSelectInstance + ", statusListInstance: " + statusListInstance + ", dataGridInstance: " + dataGridInstance)
            return;
        }

        const newYear = yearSelectInstance.option("value");
        const newStatuses = statusListInstance.option("selectedItems");

        currentYear = newYear;
        selectedStatuses = newStatuses;
        
        console.log("Menerapkan Filter:", { year: currentYear, statuses: selectedStatuses });
        dataGridInstance.refresh();
        updateDisplayTahun(currentYear, selectedStatuses);

        if (filterPopupInstance) {
            filterPopupInstance.hide();
        }
    }

    // ------------------ FUNGSI UPDATE UI (Tidak ada perubahan) ------------------

    function updateSummaryCards(summary) {
        if (!summary) return;
        const plafonKb = 830000;
        const sisaKb = plafonKb - summary.KbDigunakan;
        const creationYear = employeeData.createdDate.getFullYear();
        const startCycleYear = creationYear + Math.floor((currentYear - creationYear) / 3) * 3;
        const endCycleYear = startCycleYear + 2;
        $("#kbNote").text(`Plafon per 3 tahun (${startCycleYear} - ${endCycleYear})`);

        let plafonRawatJalan = 0;
        let noteRawatJalan = "Status Kawin - Golongan Karyawan";
        if (employeeData.golongan >= 1 && employeeData.golongan <= 3) {
            plafonRawatJalan = (employeeData.statusKawin === 'Kawin') ? 10000000 : 5800000;
            noteRawatJalan = `${(employeeData.statusKawin === 'Kawin') ? "Keluarga" : "Lajang"} - Golongan ${employeeData.golongan}`;
        } else if (employeeData.golongan >= 4) {
            plafonRawatJalan = (employeeData.statusKawin === 'Kawin') ? 11000000 : 7000000;
            noteRawatJalan = `${(employeeData.statusKawin === 'Kawin') ? "Keluarga" : "Lajang"} - Golongan ${employeeData.golongan}`;
        }
        const sisaRawatJalan = plafonRawatJalan - summary.RawatJalanDigunakan;
        $("#rawatJalanNote").text(noteRawatJalan);

        $("#rawatJalanPlafon").text(formatCurrency(plafonRawatJalan));
        $("#rawatJalanDigunakan").text(formatCurrency(summary.RawatJalanDigunakan));
        $("#rawatJalanSisa").text(formatCurrency(sisaRawatJalan));
        $("#rawatJalanUnrealize").text(formatCurrency(summary.RawatJalanUnrealize));
        $("#rawatInapDigunakan").text(formatCurrency(summary.RawatInapDigunakan));
        $("#rawatInapUnrealize").text(formatCurrency(summary.RawatInapUnrealize));
        $("#maternityDigunakan").text(formatCurrency(summary.MaternityDigunakan));
        $("#maternityUnrealize").text(formatCurrency(summary.MaternityUnrealize));
        $("#kbPlafon").text(formatCurrency(plafonKb));
        $("#kbDigunakan").text(formatCurrency(summary.KbDigunakan));
        $("#kbSisa").text(formatCurrency(sisaKb));
        $("#kbUnrealize").text(formatCurrency(summary.KbUnrealize));
    }

    // ------------------ EVENT HANDLERS & HELPERS (Tidak ada perubahan) ------------------

    function onGridContentReady(e) {
        updateDisplayTahun(currentYear, selectedStatuses);
        const grid = e.component;
        const visibleRowCount = grid.getVisibleRows().length;
        if (visibleRowCount === 0) {
            grid.option('height', 150);
        } else if (visibleRowCount < 10) {
            grid.option('height', 'auto');
        } else {
            grid.option('height', 480);
        }
    }

    // Fungsi untuk inisialisasi instance komponen
    function yearSelect_onInit(e) { yearSelectInstance = e.component; }
    function statusList_onInit(e) { statusListInstance = e.component; }
    function filterPopup_onInit(e) { filterPopupInstance = e.component; }
    function panduanStatusPopup_onInit(e) { panduanStatusPopupInstance = e.component; }

    function filterPopup_onShowing(e) {
        // Cek jika instance belum ada, lalu ambil dari ID elemennya
        if (!yearSelectInstance) {
            yearSelectInstance = $("#yearSelectBox").dxSelectBox("instance");
        }
        if (!statusListInstance) {
            statusListInstance = $("#statusList").dxList("instance");
        }
    }

    function showFilterPopup() {
        if (filterPopupInstance) {
            filterPopupInstance.show();
            // Pastikan nilai di popup sesuai dengan state terakhir
            if (yearSelectInstance) { yearSelectInstance.option("value", currentYear); }
            if (statusListInstance) { statusListInstance.option("selectedItems", selectedStatuses); }
        }
    }

    function showPanduanStatusPopup() {
        if (panduanStatusPopupInstance) panduanStatusPopupInstance.show();
    }

    function updateDisplayTahun(year, statuses) {
        let statusText;
        if (!statuses || statuses.length === 0) statusText = "(Tidak ada status)";
        else if (statuses.length === statusDataSource.length) statusText = "(Semua status)";
        else statusText = `(${statuses.length} status terpilih)`;
        $("#displayTahun").text(`Tahun ${year} ${statusText}`);
    }

    function formatCurrency(value) {
        if (typeof value !== 'number') return "Rp 0";
        return new Intl.NumberFormat('id-ID', {
            style: 'currency', currency: 'IDR', minimumFractionDigits: 0, maximumFractionDigits: 0
        }).format(value);
    }

        function getYearDataSource() {
        const creationYear = employeeData.createdDate.getFullYear(); // tahun mulai = tahun karyawan dibuat
        const currentYearNow = new Date().getFullYear();             // tahun akhir = tahun sekarang
        const years = [];

        for (let y = currentYearNow; y >= creationYear; y--) {
            years.push(y);
        }

        return years;
    }

    function grid_cell_rowIndex(container, options) {
        container.text(options.component.pageIndex() * options.component.pageSize() + options.rowIndex + 1);
    }

    function navigateToAddReimbursement() {
        window.location.href = '@Url.Action("ManageAddReimbursement", "Manage")';
    }
    </script>
}