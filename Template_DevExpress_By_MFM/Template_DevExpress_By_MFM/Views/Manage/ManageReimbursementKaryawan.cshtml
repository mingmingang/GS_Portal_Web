                    color: #16A34A; /* Hijau */
                }

                .plafon-card .detail-item .value.digunakan {
                    color: #DC2626; /* Merah */
                }

                .plafon-card .detail-item .value.sisa {
                    color: #1F2937; /* Hitam */
                }

    .unrealize-box {
        border: 1px solid #E5E7EB; /* Border abu-abu tipis */
        border-radius: 8px;
        padding: 12px 16px;
        margin-top: 16px; /* Memberi jarak dari grid detail di atasnya */
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

        .unrealize-box .unrealize-label {
            font-weight: 600;
            font-size: 14px;
            color: #111827;
        }

        .unrealize-box .unrealize-value {
            font-size: 14px;
            color: #1F2937;
        }

    /* ... Style lainnya tidak ada perubahan ... */
    .grid-container-card {
        background-color: #ffffff;
        padding: 24px;
        border-radius: 12px;
/*        box-shadow: 0 4px 8px rgba(0,0,0,0.05);*/
    }

    .dx-toolbar-before .title-container {
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        justify-content: center;
        height: 100%;
    }

    .dx-toolbar-before .title {
        font-size: 20px;
        font-weight: 600;
        margin: 0;
        line-height: 1.2;
    }

    .dx-toolbar-before .year-display {
        font-size: 14px;
        color: #6c757d;
        margin-top: 4px;
    }

    .btn-tambah-dx.dx-button {
        background-color: #1B3D97;
        color: white;
    }

        .btn-tambah-dx.dx-button.dx-state-hover {
            background-color: #16327a;
        }

    .datagrid-toolbar {
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 15px;
        margin-bottom: 20px;
    }

        .datagrid-toolbar .title-section {
            display: flex;
            flex-direction: column;
        }

        .datagrid-toolbar .title {
            font-size: 30px;
            font-weight: 600;
        }

        .datagrid-toolbar .year-display {
            font-size: 14px;
            color: #6c757d;
            margin-top: 4px;
        }

        .datagrid-toolbar .actions-section {
            display: flex;
