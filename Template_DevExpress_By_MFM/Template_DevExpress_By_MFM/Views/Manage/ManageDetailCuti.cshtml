@{
    ViewBag.Title = "Detail Cuti Karyawan";
}

<div class="container">
    <h2 style="margin-top:100px;">Detail Cuti Karyawan</h2>
    <p>Keterangan lebih lenjut cuti yang diojukan oleh anda.</p>

    <div class="row">
        <div class="col-md-12">
            <h4>Status Cuti</h4>

            <div class="d-flex justify-content-between align-items-center bg-light p-3 mb-3 rounded">
                <div>
                    <i class="fas fa-info-circle text-primary me-2"></i>
                    <strong>Status Cuti</strong><br>   
                </div>
                <span class="badge bg-success">Terlaksana</span>
            </div>

            <h4 class="mt-4">Detail Cuti</h4>
            <div class="detail-section bg-light p-3 mb-3 border-start border-primary border-4 rounded">
                <div class="row mb-2">
                    <div class="col-md-2 fw-bold">No. Pengajuan</div>
                    <div class="col-md-10">LVR202503013458</div>
                </div>
                <div class="row mb-2">
                    <div class="col-md-2 fw-bold">Plant</div>
                    <div class="col-md-10">Karawang</div>
                </div>
                <div class="row mb-2">
                    <div class="col-md-2 fw-bold">Tipe Cuti</div>
                    <div class="col-md-10">CP - Cuti Pribadi</div>
                </div>
                <div class="row mb-2">
                    <div class="col-md-2 fw-bold">Tanggal Pengajuan</div>
                    <div class="col-md-10">Kamis, 06 Mei 2025</div>
                </div>
                <div class="row mb-2">
                    <div class="col-md-2 fw-bold">Tanggal Cuti</div>
                    <div class="col-md-10">27 Mei 2025 - 28 Mei 2025</div>
                </div>
            </div>

            <hr class="my-4">

            <h4>Keterangan Tambahan</h4>
            <div class="detail-section bg-light p-3 rounded">
                Antar kapak operasi katarak di kampung
            </div>

            <div class="mt-4">
                <a href="@Url.Action("Index")" class="btn btn-secondary">
                    <i class="fas fa-arrow-left"></i> Kembali ke Daftar
                </a>
            </div>
        </div>
    </div>
</div>

@section scripts {
    <script>
        // You can add any JavaScript functionality here if needed
        $(document).ready(function() {
            console.log("Detail cuti page loaded");
        });
    </script>
}