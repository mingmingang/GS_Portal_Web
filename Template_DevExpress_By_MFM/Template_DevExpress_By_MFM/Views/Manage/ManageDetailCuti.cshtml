@model Template_DevExpress_By_MFM.Models.CutiModel
@{
    ViewBag.Title = "Detail Cuti";
    var logSession = HttpContext.Current.Session["SHealth"] as Template_DevExpress_By_MFM.Models.SessionLogin;
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title</title>

    <!-- Link ke file CSS eksternal -->
    <link href="~/Content/CutiStyle/DetailCuti.css" rel="stylesheet" />

    <!-- Library CSS & Fonts -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700&display=swap" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <style>
        .form-actions {
            margin-top: 30px;
            display: flex;
            flex-direction: row;
            justify-content: flex-end; /* Tombol akan berada di kanan */
            gap: 15px;
        }

        .btn-action {
            /* Jika Anda ingin tombol berukuran sesuai konten, hapus 'width' dan 'flex' */
            /* Sebaliknya, jika ingin tombol sama besar, gunakan flex: 1; */
            padding: 12px 25px;
            border: none;
            border-radius: 12px;
            font-size: 16px;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.2s ease-in-out;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 10px; /* Jarak ikon dan teks */
        }

            .btn-action:hover {
                transform: translateY(-2px);
                box-shadow: 0 4px 10px rgba(0,0,0,0.15);
            }

        /* Kelas untuk Tombol Tolak */
        .btn-reject {
            background-color: #e74c3c; /* Merah */
            color: white;
        }

            .btn-reject:hover {
                background-color: #c0392b;
            }

        /* Kelas untuk Tombol Setuju */
        .btn-approve {
            background-color: #2ecc71; /* Hijau */
            color: white;
        }

            .btn-approve:hover {
                background-color: #27ae60;
            }

        .cuti-header-section {
            background-color: #2A458A;
            display: flex;
            justify-content: center;
            align-items: center;
            padding: 15px;
            border-bottom: 1px solid #eee; /* Mungkin tidak akan terlihat, tapi tidak apa-apa */
            /* === Perubahan Utama Dimulai di Sini === */
            position: fixed; /* Membuatnya tetap di layar */
            top: 0; /* Menempel di bagian paling atas */
            left: 0; /* Menempel di bagian paling kiri */
            width: 100%; /* Memastikan lebarnya penuh */
            z-index: 1000; /* Memastikan header selalu di atas konten lain */
            box-sizing: border-box; /* Opsional, tapi praktek yang baik agar padding tidak menambah lebar total */
        }

            .cuti-header-section .back-button {
                position: absolute;
                left: 15px;
                font-size: 1.5rem;
                color: white;
                text-decoration: none;
            }

            .cuti-header-section h1 {
                margin: 0;
                font-size: 1.2rem;
                font-weight: 600;
                color: white; /* Tambahan agar teks judul terlihat jelas */
            }
    </style>
</head>
<body>

    <div class="detail-page-container">


        <div class="cuti-header">
            <div class="cuti-header-section">
                <a href="javascript:history.back()" class="back-button">
                    <i class="fas fa-arrow-left"></i>
                </a>
                <h1>Detail Cuti</h1>
            </div>
        </div>


        <div class="detail-main-content" style="margin-top:50px;">
            <div class="status-info-bar">
                <span class="status-info-label"><i class="fas fa-info-circle"></i> Status Cuti</span>
                <span id="detail-status" class="status-badge badge-secondary">Memuat...</span>
            </div>

            <div class="detail-card">
                <h3 class="detail-card-title">Detail Cuti</h3>
                <div class="detail-row"><span class="detail-label">No. Pengajuan</span><span class="detail-value" id="detail-no-pengajuan">...</span></div>
                <div class="detail-row"><span class="detail-label">Plant</span><span class="detail-value" id="detail-plant">...</span></div>
                <div class="detail-row"><span class="detail-label">Tipe Cuti</span><span class="detail-value" id="detail-tipe-cuti">...</span></div>
                <div class="detail-row"><span class="detail-label">Tanggal Pengajuan</span><span class="detail-value" id="detail-tgl-pengajuan">...</span></div>
                <div class="detail-row"><span class="detail-label">Tanggal Cuti</span><span class="detail-value" id="detail-tgl-cuti">...</span></div>
                <div class="detail-row"><span class="detail-label">Durasi</span><span class="detail-value" id="detail-durasi">...</span></div>
            </div>

            <div class="detail-card">
                <h3 class="detail-card-title">Keterangan</h3>
                <div class="detail-row">
                    <span class="detail-label">Keterangan Pengajuan</span>
                    <span class="detail-value" id="detail-keterangan">...</span>
                </div>

                <div class="detail-row" id="detail-split-from-row" style="display: none;">
                    <span class="detail-label">Pembatalan Dari</span>
                    <span class="detail-value" id="detail-split-from-value"></span>
                </div>

                <div class="detail-row cancellation-reason-row" id="detail-cancellation-row" style="display: none;">
                    <span class="detail-label">Alasan Pembatalan</span>
                    <span class="detail-value" id="detail-cancellation-reason"></span>
                </div>


            </div>

            <div class="detail-card">
                <h3 class="detail-card-title">Lampiran</h3>
                <div id="detail-lampiran-container">
                    <p class="text-muted" style="margin:0;">...</p>
                </div>
            </div>
            @{
                if (logSession != null && logSession.userjabatan == "Atasan" || logSession.userjabatan == "HC")
                {
                    <div id="action-buttons-container" class="form-actions">
                        <button type="button" id="btn-tolak" class="btn-action btn-reject">
                            <i class="fas fa-times-circle"></i> Tolak
                        </button>
                        <button type="button" id="btn-setuju" class="btn-action btn-approve">
                            <i class="fas fa-check-circle"></i> Setuju
                        </button>
                    </div>
                }
            }

        </div>


    </div>

    <!-- ======================================================= -->
    <!-- ================= BAGIAN JAVASCRIPT =================== -->
    <!-- ======================================================= -->
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    @*<script src="~/Scripts/CutiScript/DetailCuti.js"></script>*@

    <!-- Script inisialisasi untuk mengirim data dari server ke JS -->
<script>
        $(document).ready(function() {
            var pageConfig = {
                cutiId: '@ViewBag.CutiId',
                backUrl: '@ViewBag.BackUrl',
                userPlant: @Html.Raw(Json.Encode(logSession.userplant ?? "")),
                   userJabatan: '@(logSession.userjabatan ?? "")',
            userNik: '@(logSession.npk ?? "")'
            };

            DetailCutiPage.init(pageConfig);
        });
</script>

    <script>
        (function ($) {
            'use strict';

            var DetailCutiPage = {
                config: {
                    cutiId: null,
                    userPlant: '',
                    backUrl: '',
                    userJabatan: '',
                    userNik: ''  
                },

                elements: {},
                currentCutiStatus: null,

                init: function (config) {
                    this.config = $.extend(this.config, config);
                    this.cacheElements();
                    this.bindEvents();
                    this.loadCutiDetail(this.config.cutiId);
                },

                cacheElements: function () {
                    this.elements = {
                        mainContent: $('.detail-main-content'),
                        status: $('#detail-status'),
                        noPengajuan: $('#detail-no-pengajuan'),
                        plant: $('#detail-plant'),
                        tipeCuti: $('#detail-tipe-cuti'),
                        tglPengajuan: $('#detail-tgl-pengajuan'),
                        tglCuti: $('#detail-tgl-cuti'),
                        durasi: $('#detail-durasi'),
                        keterangan: $('#detail-keterangan'),
                        splitFromRow: $('#detail-split-from-row'),
                        splitFromValue: $('#detail-split-from-value'),
                        lampiranContainer: $('#detail-lampiran-container'),
                        cancellationRow: $('#detail-cancellation-row'),
                        cancellationReason: $('#detail-cancellation-reason'),
                        reasonRow: $('#detail-cancellation-row'),
                        reasonLabel: $('#detail-cancellation-row .detail-label'),
                        reasonText: $('#detail-cancellation-reason'),
                        btnTolak: $('#btn-tolak'),
                        btnSetuju: $('#btn-setuju'),
                        actionButtonsContainer: $('#action-buttons-container')
                    };
                },

                mapPlantCode: function (plantCode) {
                    switch (plantCode) {
                        case 'K':
                            return 'Karawang';
                        case 'J':
                            return 'Jakarta';
                        case 'S':
                            return 'Semarang';
                        default:
                            return plantCode || '-';
                    }
                },

                bindEvents: function () {
                    var self = this;

                    this.elements.btnTolak.on('click', function () {
                        self.handleAction('Reject');
                    });

                    this.elements.btnSetuju.on('click', function () {
                        self.handleAction('Approve');
                    });
                },

                mapStatus: function (apiStatus) {
                    const statusMap = {
                        "Unverified": "Menunggu Persetujuan",
                        "Partially Approved": "Disetujui Sebagian",
                        "Fully Approved": "Disetujui",
                        "Rejected": "Ditolak",
                        "Cancelled": "Dibatalkan",
                        "Closed": "Terlaksana",
                        "Revised": "Direvisi",
                        "Draft": "Draft"
                    };
                    return statusMap[apiStatus] || apiStatus;
                },

                handleAction: function (action) {
                    var self = this;
                    var swalConfig = {
                        title: action === 'Approve' ? 'Anda yakin?' : 'Alasan Penolakan',
                        icon: action === 'Approve' ? 'question' : 'warning',
                        showCancelButton: true,
                        confirmButtonText: action === 'Approve' ? 'Ya, Setujui!' : 'Tolak Pengajuan',
                        cancelButtonText: 'Batal',
                        confirmButtonColor: action === 'Approve' ? '#2ecc71' : '#e74c3c',
                    };

                    if (action === 'Reject') {
                        swalConfig.input = 'textarea';
                        swalConfig.inputLabel = 'Mohon masukkan alasan mengapa pengajuan cuti ini ditolak:';
                        swalConfig.inputPlaceholder = 'Ketik alasan Anda di sini...';
                        swalConfig.inputValidator = (value) => {
                            if (!value) {
                                return 'Anda harus mengisi alasan penolakan!';
                            }
                        };
                    } else {
                        swalConfig.text = "Apakah Anda yakin ingin menyetujui pengajuan cuti ini?";
                    }

                    Swal.fire(swalConfig).then((result) => {
                        if (result.isConfirmed) {
                            const reason = action === 'Approve' ? '' : (result.value || '');

                            self.submitApproval(action, reason);
                        }
                    });
                },

                submitApproval: function (action, reason) {
                    var self = this;
                    var apiUrl = self.determineApiEndpoint();

                    if (!apiUrl) {
                        Swal.fire('Error', 'Aksi tidak diizinkan untuk status cuti saat ini atau peran Anda.', 'error');
                        return;
                    }

                    Swal.fire({
                        title: 'Memproses...',
                        text: 'Mohon tunggu sebentar.',
                        allowOutsideClick: false,
                        didOpen: () => { Swal.showLoading(); }
                    });

                    // Payload data
                    var postData = {
                        request_no: self.config.cutiId,
                        action: action,
                        reason: reason,
                        modified_by: self.config.userNik
                    };

                    $.ajax({
                        url: apiUrl,
                        type: 'POST',
                        contentType: 'application/json',
                        data: JSON.stringify(postData),
                        success: function (response) {
                            Swal.fire({
                                title: 'Berhasil!',
                                text: 'Status pengajuan cuti telah diperbarui.',
                                icon: 'success',
                                confirmButtonText: 'OK',
                                allowOutsideClick: false
                            }).then((result) => {
                                if (result.isConfirmed) {
                                    // --- SOLUSI BACK + RELOAD ---

                                    // Cek apakah browser mencatat halaman sebelumnya
                                    if (document.referrer && document.referrer !== "") {
                                        // Ini akan kembali ke URL sebelumnya TAPI membacanya sebagai kunjungan baru
                                        // Efeknya: Halaman terbuka kembali dan data di-refresh
                                        window.location.href = document.referrer;
                                    }
                                    else {
                                        // Fallback jika tidak ada referrer, gunakan backUrl dari config atau history biasa
                                        if (self.config.backUrl) {
                                            window.location.href = self.config.backUrl;
                                        } else {
                                            window.history.back(); // Terpaksa back biasa tanpa reload
                                        }
                                    }
                                }
                            });
                        },
                        error: function (xhr) {
                            const errorMsg = xhr.responseJSON && xhr.responseJSON.message
                                ? xhr.responseJSON.message
                                : 'Terjadi kesalahan saat memperbarui status.';
                            Swal.fire('Gagal!', errorMsg, 'error');
                        }
                    });
                },

                determineApiEndpoint: function () {
                    const role = this.config.userJabatan;
                    const status = this.currentCutiStatus;

                    if (role === 'HC' && status === 'Partially Approved') {
                        return '/api/CutiApi/fullyApproveCuti'; // Endpoint Verifikasi HC
                    }

                    if (role === 'Atasan') {
                        if (status === 'Unverified') { // Status API: Waiting Approval (1)
                            return '/api/CutiApi/approveCuti'; // Endpoint Approval Tingkat 1
                        }
                    }

                    return null; // Tidak ada aksi yang valid untuk kombinasi role dan status ini
                },


                handleReject: function () {
                    var self = this;

                    Swal.fire({
                        title: 'Alasan Penolakan',
                        input: 'textarea', // Tipe input adalah textarea
                        inputLabel: 'Mohon masukkan alasan mengapa pengajuan cuti ini ditolak:',
                        inputPlaceholder: 'Ketik alasan Anda di sini...',
                        inputAttributes: {
                            'aria-label': 'Ketik alasan Anda di sini'
                        },
                        showCancelButton: true,
                        confirmButtonText: 'Tolak Pengajuan',
                        cancelButtonText: 'Batal',
                        confirmButtonColor: '#e74c3c', // Merah
                        // Validasi input: alasan tidak boleh kosong
                        inputValidator: (value) => {
                            if (!value) {
                                return 'Anda harus mengisi alasan penolakan!'
                            }
                        }
                    }).then((result) => {
                        if (result.isConfirmed) {
                            const reason = result.value;
                            // Kirim data ke API dengan status "Rejected"
                            self.updateCutiStatus('Rejected', reason);
                        }
                    });
                },

                handleApprove: function () {
                    var self = this;

                    Swal.fire({
                        title: 'Anda yakin?',
                        text: "Apakah Anda yakin ingin menyetujui pengajuan cuti ini?",
                        icon: 'question',
                        showCancelButton: true,
                        confirmButtonColor: '#2ecc71', // Hijau
                        cancelButtonColor: '#3085d6',
                        confirmButtonText: 'Ya, Setujui!',
                        cancelButtonText: 'Batal'
                    }).then((result) => {
                        if (result.isConfirmed) {
                            // Kirim data ke API dengan status "Fully Approved"
                            self.updateCutiStatus('Fully Approved', ''); // Alasan bisa kosong untuk approval
                        }
                    });
                },

                updateCutiStatus: function (newStatus, reason) {
                    var self = this;

                    Swal.fire({
                        title: 'Memproses...',
                        text: 'Mohon tunggu sebentar.',
                        allowOutsideClick: false,
                        didOpen: () => {
                            Swal.showLoading();
                        }
                    });

                    // Sesuaikan payload data sesuai kebutuhan API Anda
                    var postData = {
                        request_no: self.config.cutiId,
                        request_status: newStatus,
                        remark: reason // API mungkin perlu menggabungkan ini dengan remark yang sudah ada
                    };

                    $.ajax({
                        url: `/api/CutiApi/updateStatusCuti`,
                        type: 'POST', // Gunakan POST atau PUT sesuai desain API Anda
                        contentType: 'application/json',
                        data: JSON.stringify(postData),
                        success: function (response) {
                            Swal.fire({
                                title: 'Berhasil!',
                                text: 'Status pengajuan cuti telah diperbarui.',
                                icon: 'success'
                            }).then(() => {
                                // Muat ulang detail untuk menampilkan status terbaru
                                self.loadCutiDetail(self.config.cutiId);
                            });
                        },
                        error: function (xhr) {
                            const errorMsg = xhr.responseJSON && xhr.responseJSON.message
                                ? xhr.responseJSON.message
                                : 'Terjadi kesalahan saat memperbarui status.';
                            Swal.fire({
                                title: 'Gagal!',
                                text: errorMsg,
                                icon: 'error'
                            });
                        }
                    });
                },


                getStatusBadgeClass: function (apiStatus) {
                    const statusText = this.mapStatus(apiStatus);
                    switch (statusText) {
                        case 'Disetujui':
                        case 'Terlaksana':
                            return 'badge-success';
                        case 'Menunggu Persetujuan':
                            return 'badge-warning';
                        case 'Ditolak':
                        case 'Dibatalkan':
                            return 'badge-danger';
                        default:
                            return 'badge-secondary';
                    }
                },

                loadCutiDetail: function (id) {
                    var self = this;
                    if (!id) {
                        self.elements.mainContent.html('<p style="text-align:center;">ID Pengajuan Cuti tidak valid.</p>');
                        return;
                    }

                    $.ajax({
                        url: `/api/CutiApi/detailCuti/${id}`,
                        type: 'GET',
                        success: function (response) {
                            if (response && response.data && response.data.length > 0) {
                                const cuti = response.data[0];
                                self.currentCutiStatus = cuti.request_status; 
                                const statusText = self.mapStatus(cuti.request_status);

                                $('.placeholder-glow').removeClass('placeholder-glow');

                                self.elements.status.text(statusText).attr('class', 'status-badge').addClass(self.getStatusBadgeClass(cuti.request_status));
                                self.elements.noPengajuan.text(cuti.request_no);

                                // --- BARIS YANG DIPERBARUI ---
                                // Panggil fungsi pemetaan untuk mendapatkan nama lengkap plant
                                const fullPlantName = self.mapPlantCode(self.config.userPlant);
                                self.elements.plant.text(fullPlantName);
                                // -----------------------------

                                self.elements.tipeCuti.text(cuti.leave_code || '-');

                                const tglPengajuan = new Date(cuti.requestdate);
                                self.elements.tglPengajuan.text(tglPengajuan.toLocaleDateString('id-ID', { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' }));

                                const tglMulai = new Date(cuti.startdate);
                                const tglSelesai = new Date(cuti.enddate);
                                self.elements.tglCuti.text(`${tglMulai.toLocaleDateString('id-ID', { day: '2-digit', month: 'short', year: 'numeric' })} - ${tglSelesai.toLocaleDateString('id-ID', { day: '2-digit', month: 'short', year: 'numeric' })}`);

                                self.elements.durasi.text(`${cuti.totaldays} hari`);
                                let originalRemark = cuti.remark || '-';
                                let splitFromId = null;
                                let extraReason = null;
                                let reasonLabel = '';

                                const splitPattern = /Pembatalan Dari:\s+(\w+)/;
                                const splitMatch = originalRemark.match(splitPattern);

                                if (splitMatch) {
                                    splitFromId = splitMatch[1]; 
                                    originalRemark = originalRemark.replace(splitPattern, '').trim();
                                }

                                const reasonSeparators = [
                                    { status: 'Cancelled', separator: 'Cancellation Reason:', label: 'Alasan Pembatalan' },
                                    { status: 'Rejected', separator: 'Rejection Reason:', label: 'Alasan Penolakan' }
                                ];

                                const matchedSeparator = reasonSeparators.find(s => s.status === cuti.request_status);

                                if (matchedSeparator && originalRemark.includes(matchedSeparator.separator)) {
                                    const parts = originalRemark.split(matchedSeparator.separator);
                                    originalRemark = parts[0].trim() || '-';
                                    extraReason = parts[1].trim();
                                    reasonLabel = matchedSeparator.label;
                                }

                                self.elements.keterangan.text(originalRemark);
                                if (splitFromId) {
                                    self.elements.splitFromValue.text(splitFromId);
                                    self.elements.splitFromRow.css('display', 'flex'); // Tampilkan baris
                                } else {
                                    self.elements.splitFromRow.hide();
                                }

                                self.elements.reasonRow.hide();
                                if (extraReason) {
                                    self.elements.reasonLabel.text(reasonLabel);
                                    self.elements.reasonText.text(extraReason);
                                    self.elements.reasonRow.css('display', 'flex');
                                }

                                const fileName = cuti.refdoc;
                                if (fileName) {
                                    const fileUrl = `/api/CutiApi/getLampiran/${encodeURIComponent(fileName)}`;
                                    const linkHtml = `<a href="${fileUrl}" target="_blank" class="attachment-link"><i class="fas fa-paperclip"></i> Lihat Lampiran</a>`;
                                    self.elements.lampiranContainer.html(linkHtml);
                                } else {
                                    self.elements.lampiranContainer.html('<p class="text-muted" style="margin:0;">Tidak ada lampiran.</p>');
                                }

                                if (cuti.request_status === 'Unverified' || cuti.request_status === 'Partially Approved') {
                                    self.elements.actionButtonsContainer.show();
                                } else {
                                    self.elements.actionButtonsContainer.hide();
                                }

                                const validEndpoint = self.determineApiEndpoint();
                                if (validEndpoint) {
                                    self.elements.actionButtonsContainer.show();
                                } else {
                                    self.elements.actionButtonsContainer.hide();
                                }

                            } else {
                                self.elements.mainContent.html('<p style="text-align:center;">Detail cuti tidak ditemukan.</p>');
                            }
                        },
                        error: function () {
                            self.elements.mainContent.html('<p style="text-align:center;">Gagal memuat detail cuti.</p>');
                        }
                    });
                }
            };

            window.DetailCutiPage = DetailCutiPage;

        })(jQuery);
    </script>


</body>
</html>