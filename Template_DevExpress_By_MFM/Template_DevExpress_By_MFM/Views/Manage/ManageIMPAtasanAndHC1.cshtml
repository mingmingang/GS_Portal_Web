    </style>
</head>

<body>
    <div class="imp-page-container">

        <!-- SECTION 1: Blue Header dengan Info IMP -->
        <div class="blue-section">
            <div class="page-header-standalone">
                <a href="@Url.Action("Index", "Home")" class="back-button" aria-label="Kembali ke Dashboard">
                    <i class="fas fa-arrow-left"></i>
                </a>
                <h1 class="page-header-title">Izin Meninggalkan Pekerjaan - Approval</h1>
            </div>
        </div>

        <!-- SECTION 2: White Main Content Area -->
        <div class="white-section">
            <!-- Header untuk rentang waktu dan ikon panduan/filter -->
            <div class="time-range-header">
                <div class="time-range-text" id="timeRangeText">1 Januari 2025 - Sekarang</div>
                <div class="header-icons">
