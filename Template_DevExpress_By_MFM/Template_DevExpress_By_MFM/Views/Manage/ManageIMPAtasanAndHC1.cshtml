            color: #2A458A;
            font-size: 16px;
            margin-bottom: 12px;
            font-weight: 600;
        }

        #selectedEmployeeDisplay {
            margin-top: 12px;
            display: none;
        }

        .selected-employee-info {
            background-color: #E7EFFD;
            padding: 8px 12px;
            border-radius: 6px;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .selected-employee-label {
            font-size: 12px;
            color: #6B7280;
        }

        .selected-employee-text {
            font-size: 14px;
            font-weight: 500;
            color: #2A458A;
        }

        .clear-employee-btn {
