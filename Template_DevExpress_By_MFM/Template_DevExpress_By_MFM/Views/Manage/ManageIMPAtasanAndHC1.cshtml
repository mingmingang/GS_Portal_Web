            padding: 24px;
        }

        .info-modal-content {
            width: 90%;
            max-width: 400px;
            padding: 24px;
            align-items: center;
            text-align: center;
        }

        .panduan-modal-header {
            display: flex;
            align-items: center;
            margin-bottom: 16px;
        }

        .panduan-modal-icon {
            font-size: 36px;
            color: #2A458A;
            margin-right: 12px;
            margin-bottom: 0;
        }

        .panduan-modal-title {
            font-size: 20px;
            font-weight: bold;
            color: #1F2937;
            margin: 0;
        }

        .panduan-modal-message {
