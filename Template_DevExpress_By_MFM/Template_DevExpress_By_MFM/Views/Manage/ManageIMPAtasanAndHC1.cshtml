            align-items: flex-start;
            margin-bottom: 8px;
            width: 100%;
            gap: 12px;
        }

        .card-left-section {
            flex: 1;
            min-width: 0;
        }

        .card-npk {
            font-size: 12px;
            color: #9AA0A6;
            margin: 0 0 4px 0;
        }

        .card-title {
            font-size: 17px;
