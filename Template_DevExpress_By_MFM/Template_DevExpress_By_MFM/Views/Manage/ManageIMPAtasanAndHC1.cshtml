        }

        .no-data-icon {
            font-size: 48px;
            color: #999;
        }

        .no-data-title {
            font-weight: bold;
            font-size: 16px;
            margin-top: 8px;
        }

        .no-data-text {
            color: #666;
            font-size: 14px;
            margin-top: 4px;
        }

        .modal-overlay {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background-color: rgba(0,0,0,0.6);
            display: none;
            justify-content: center;
            align-items: center;
            z-index: 1000;
            opacity: 0;
            transition: opacity 0.2s ease-in-out;
            padding: 20px;
        }

            .modal-overlay.visible {
                display: flex;
                opacity: 1;
            }

        .modal-content, .panduan-modal-content, .info-modal-content {
            background-color: white;
            border-radius: 16px;
            box-shadow: 0 10px 25px rgba(0,0,0,0.1);
            pointer-events: auto;
            max-height: 90vh;
            overflow-y: auto;
        }

        .modal-content {
            padding: 20px;
            max-width: 400px;
            width: 90%;
        }

        .modal-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin-bottom: 20px;
        }

        .modal-back-icon {
            margin-right: 12px;
            cursor: pointer;
