            color: #D1D5DB;
            font-weight: 500;
        }

        .year-text-active {
            font-size: 36px;
            font-weight: bold;
            color: #2A458A;
            margin: 8px 0;
        }

        .year-picker-container .chevron {
            font-size: 32px;
            color: #2A458A;
            cursor: pointer;
        }

        .apply-button {
            background-color: #2A458A;
            border: none;
            border-radius: 8px;
            padding: 14px;
            margin-top: 24px;
            text-align: center;
            width: 100%;
            cursor: pointer;
        }

        .apply-button-text {
            color: #fff;
            font-size: 16px;
            font-weight: bold;
        }

        .panduan-modal-content {
            width: 90%;
