                    <i id="tombolFilterTahun" class="fas fa-filter icon-btn" title="Filter"></i>
                </div>
            </div>

            <div id="mainContent">
                <!-- List Header -->
                <div class="list-header-container">
                    <div class="title-container">
                        <h2 class="list-title">Daftar IMP</h2>
                        <p id="listSubtitle" class="list-subtitle">Semua status</p>
                    </div>
                    <div id="resetFilterButton" class="reset-button" style="display: none;">
                        <i class="fas fa-times"></i>
                        <span class="reset-button-text">Reset Filter</span>
                    </div>
                </div>

                <!-- Tab Navigation -->
                <div class="tab-scroll-container" id="tabContainer">
                    <div class="tab-item active" data-status="all">
                        <p class="tab-text">Semua</p>
                        <div class="tab-underline"></div>
