                        <div class="tab-underline"></div>
                    </div>
                    <div class="tab-item" data-status="Belum Diverifikasi HC">
                        <p class="tab-text">Belum Diverifikasi HC</p>
                        <div class="tab-underline"></div>
                    </div>
                    <div class="tab-item" data-status="Disetujui">
                        <p class="tab-text">Disetujui</p>
                        <div class="tab-underline"></div>
                    </div>
                    <div class="tab-item" data-status="Ditolak">
                        <p class="tab-text">Ditolak</p>
                        <div class="tab-underline"></div>
                    </div>
                </div>

                <!-- List Container dengan Data Dinamis dari API -->
                <div id="reimbursementList">
                    <!-- Data akan diisi oleh JavaScript -->
                    <div id="loadingContainer" class="centered-container">
                        <div class="spinner"></div>
                        <p class="loading-text">Memuat data IMP...</p>
                    </div>
                </div>

                <!-- Paging Controls -->
                <div id="pagingContainer" class="paging-container" style="display: none;">
                    <div class="paging-left">
                        <span class="paging-label">Tampilkan:</span>
                        <div class="paging-dropdown">
                            <select id="pageSizeSelect" class="paging-select">
                                <option value="10">10 per halaman</option>
                                <option value="20">20 per halaman</option>
                                <option value="0">Semua</option>
                            </select>
                        </div>
                        <span id="pagingInfo" class="paging-info">Menampilkan 0-0 dari 0 data</span>
                    </div>
                    <div class="paging-right">
                        <button id="firstPageBtn" class="paging-btn" disabled>
                            <i class="fas fa-angle-double-left"></i>
                        </button>
                        <button id="prevPageBtn" class="paging-btn" disabled>
                            <i class="fas fa-chevron-left"></i>
                        </button>

                        <!-- Page numbers akan di-generate oleh JavaScript -->
                        <div id="pageNumbers"></div>

                        <button id="nextPageBtn" class="paging-btn" disabled>
                            <i class="fas fa-chevron-right"></i>
                        </button>
                        <button id="lastPageBtn" class="paging-btn" disabled>
                            <i class="fas fa-angle-double-right"></i>
                        </button>
                    </div>
                </div>
            </div>
        </div>

        <!-- MODAL - Filter Tahun & Karyawan -->
        <div id="yearFilterModal" class="modal-overlay">
            <div class="modal-content">
                <div class="modal-header">
                    <i id="modalBackIcon" class="fas fa-chevron-left modal-back-icon"></i>
                    <span class="modal-title">Filter</span>
                    <i id="modalHelpIcon" class="fas fa-question-circle" style="font-size: 22px; color:#2A458A; cursor: pointer;"></i>
                </div>

                <!-- Bagian Filter Tahun -->
                <div style="margin-bottom: 24px;">
                    <h3 class="section-title">Pilih Tahun</h3>
                    <div class="year-picker-container">
                        <i class="fas fa-chevron-up chevron" data-direction="up"></i>
                        <div class="year-display">
                            <p id="prevYear" class="year-text-inactive">2023</p>
                            <p id="activeYear" class="year-text-active">2024</p>
                            <p id="nextYear" class="year-text-inactive">2025</p>
                        </div>
                        <i class="fas fa-chevron-down chevron" data-direction="down"></i>
                    </div>
                </div>

                <!-- Bagian Filter Karyawan -->
                <div style="margin-bottom: 24px;">
                    <h3 class="section-title">Filter Karyawan</h3>
                    <div class="search-container">
                        <i class="fas fa-search search-icon"></i>
                        <input type="text"
                               id="searchInputModal"
                               placeholder="Cari berdasarkan NPK atau nama karyawan..."
                               autocomplete="off">
                        <div class="dropdown-content" id="searchDropdownModal">
                            <!-- Hasil pencarian akan muncul di sini -->
                        </div>
                    </div>

                    <!-- Tampilkan karyawan yang dipilih -->
                    <div id="selectedEmployeeDisplay">
                        <div class="selected-employee-info">
                            <div>
                                <div class="selected-employee-label">Karyawan terpilih:</div>
                                <div id="selectedEmployeeInfo" class="selected-employee-text"></div>
                            </div>
                            <button id="clearEmployeeFilter" class="clear-employee-btn">
                                <i class="fas fa-times"></i> Hapus
                            </button>
                        </div>
                    </div>
                </div>

                <button id="applyYearButton" class="apply-button">
                    <span class="apply-button-text">Terapkan Filter</span>
                </button>
            </div>
        </div>

        <!-- MODAL - Panduan IMP -->
        <div id="panduanModal" class="modal-overlay">
            <div class="panduan-modal-content">
                <div class="panduan-modal-header">
                    <i class="fas fa-book panduan-modal-icon"></i>
                    <h2 class="panduan-modal-title">Panduan Status IMP</h2>
                </div>
                <div class="panduan-modal-message">
                    <p>Berikut penjelasan untuk setiap status pengajuan Izin Meninggalkan Pekerjaan:</p>
                    <ul class="panduan-list">
                        <li>
                            <span class="panduan-status-label status-menunggu">Menunggu Persetujuan Atasan</span>
                            <span>Pengajuan izin menunggu verifikasi dan persetujuan atasan.</span>
                        </li>
                        <li>
                            <span class="panduan-status-label status-disetujui">Disetujui</span>
                            <span>Izin telah disetujui dan dapat digunakan.</span>
                        </li>
                        <li>
                            <span class="panduan-status-label status-ditolak">Ditolak</span>
                            <span>Pengajuan izin ditolak karena tidak memenuhi syarat.</span>
                        </li>
                        <li>
                            <span class="panduan-status-label status-belum">Belum Diverifikasi HC</span>
                            <span>Pengajuan sudah dibuat oleh karyawan, dan menunggu verifikasi.</span>
                        </li>
                    </ul>
                </div>
                <button id="closePanduanButton" class="apply-button"><span class="apply-button-text">Mengerti</span></button>
            </div>
        </div>

        <!-- MODAL INFO - Info untuk Filter Tahun -->
        <div id="infoModal" class="modal-overlay" style="z-index: 1010;">
            <div class="info-modal-content">
                <i class="fas fa-info-circle panduan-modal-icon"></i>
                <h2 class="panduan-modal-title">Informasi</h2>
                <p style="font-size: 15px; color: #6B7280; line-height: 22px; margin-bottom: 24px;">
                    Tahun yang dapat dipilih adalah sejak Anda masuk bekerja hingga sekarang.
                </p>
                <button id="closeInfoModalButton" class="apply-button"><span class="apply-button-text">Mengerti</span></button>
            </div>
        </div>
    </div>

    <script>
        // --- KONFIGURASI VARIABEL ---
        const userRole = '@userRole'; // Role dari session
        const sessionNpk = '@userNPK'; // NPK dari session
        const ALL_TABS = [
            { text: "Semua", status: "all" },
            { text: "Menunggu Persetujuan Atasan", status: "Menunggu Persetujuan Atasan" },
            { text: "Belum Diverifikasi HC", status: "Belum Diverifikasi HC" },
            { text: "Disetujui", status: "Disetujui" },
            { text: "Ditolak", status: "Ditolak" }
        ];

        // Variabel untuk paging
        let currentPage = 1;
        let itemsPerPage = 10;
        let totalPages = 1;
        let paginatedData = [];

        // Variabel untuk search functionality
        let allEmployees = []; // Untuk menyimpan daftar semua karyawan
        let selectedNPK = ''; // Untuk menyimpan NPK yang dipilih

        // Filter tabs berdasarkan role
        const getFilteredTabs = () => {
            if (userRole === "HC") {
                return ALL_TABS.filter(tab =>
                    tab.status === "all" ||
                    tab.status === "Belum Diverifikasi HC" ||
                    tab.status === "Disetujui" ||
                    tab.status === "Ditolak"
                );
            } else if (userRole === "Atasan") {
                return ALL_TABS.filter(tab =>
                    tab.status === "all" ||
                    tab.status === "Menunggu Persetujuan Atasan" ||
                    tab.status === "Belum Diverifikasi HC" ||
                    tab.status === "Disetujui" ||
                    tab.status === "Ditolak"
                );
            }
            return ALL_TABS;
        };

        let activeTab = "all";
        let appliedYear = new Date().getFullYear();
        let allIMPData = [];

        // --- FUNGSI UTILITAS ---
        // Fungsi untuk menormalisasi data karyawan
        function normalizeEmployeeData(data) {
            if (!data || !Array.isArray(data)) return [];

            return data.map(employee => {
                // Cari properti NPK dari berbagai kemungkinan
                const npk = employee.emp_no || employee.npk || employee.imp_npk || '';

                // Cari properti nama dari berbagai kemungkinan
                const nama = employee.Full_Name ||
                           employee.full_name ||
                           employee.nama ||
                           employee.name ||
                           employee.imp_created_by ||
                           '';

                // Buat objek normalisasi dengan properti standar
                const normalized = {
                    npk: npk,
                    emp_no: npk,
                    nama: nama,
                    Full_Name: nama,
                    ...employee // Tetap simpan properti asli
                };

                return normalized;
            });
        }

        // --- FUNGSI UTAMA ---
        function initializePage() {
            updateTimeRange();
            renderTabs();
            setupUIEventListeners();
            setupModalSearchFunctionality();

            // Untuk HC, load data karyawan terpisah
            if (userRole === "HC") {
                loadEmployeeData();
            }

            loadIMPData();

            // Set default tab berdasarkan role
            if (userRole === "HC") {
                handleTabClick("Belum Diverifikasi HC", "Belum Diverifikasi HC");
            } else if (userRole === "Atasan") {
                handleTabClick("Menunggu Persetujuan Atasan", "Menunggu Persetujuan Atasan");
            }
        }

        // --- FUNGSI LOAD DATA DARI API (DIPERBAIKI) ---
        function loadIMPData() {
            showLoading();
            $('#pagingContainer').hide(); // Sembunyikan paging saat loading

            let url = '';
            let params = [];

            // Tentukan endpoint berdasarkan role
            if (userRole === "Atasan") {
                // Untuk Atasan: gunakan endpoint listbawahan dengan supervisor_npk dari session
                url = '/api/IMPApi/listbawahan';
                params.push(`supervisor_npk=${encodeURIComponent(sessionNpk)}`);
            } else if (userRole === "HC") {
                // Untuk HC: gunakan endpoint all-applicants
                url = '/api/IMPApi/all-applicants';
            }

            // Tambahkan parameter status jika bukan "all"
            if (activeTab !== "all") {
                params.push(`status=${encodeURIComponent(activeTab)}`);
            }

            // Tambahkan parameter tahun
            if (appliedYear) {
                params.push(`tahun=${appliedYear}`);
            }

            // Untuk HC, tambahkan parameter npk jika ada yang dipilih
            if (userRole === "HC" && selectedNPK) {
                params.push(`npk=${encodeURIComponent(selectedNPK)}`);
            }

            // Untuk Atasan, selectedNPK adalah bawahan yang dipilih
            if (userRole === "Atasan" && selectedNPK && selectedNPK !== 'all') {
                // Filter akan dilakukan di frontend karena backend sudah mengembalikan semua bawahan
                // Tidak perlu parameter tambahan ke API
            }

            if (params.length > 0) {
                url += '?' + params.join('&');
            }

            console.log('Request URL:', url);
            console.log('User Role:', userRole);
            console.log('Session NPK:', sessionNpk);

            $.ajax({
                url: url,
                method: 'GET',
                success: function (response) {
                    console.log('Response dari API:', response);

                    if (response && response.code === 200) {
                        // Struktur response berbeda untuk Atasan dan HC
                        if (userRole === "Atasan") {
                            // Untuk Atasan: response.data[0] berisi object dengan properti supervisor, subordinates, data
                            if (response.data && response.data.length > 0) {
                                const result = response.data[0];
                                allIMPData = result.data || [];

                                // Simpan daftar bawahan untuk search functionality
                                allEmployees = normalizeEmployeeData(result.subordinates || []);

                                console.log('Data IMP Atasan berhasil dimuat:', allIMPData.length, 'records');
                                console.log('Jumlah bawahan:', allEmployees.length, 'karyawan');
                                console.log('Contoh data karyawan:', allEmployees[0]);

                                // Filter data berdasarkan NPK jika ada yang dipilih
                                if (selectedNPK && selectedNPK !== 'all') {
                                    allIMPData = allIMPData.filter(item =>
                                        item.karyawan && item.karyawan.emp_no === selectedNPK
                                    );
                                }
                            } else {
                                allIMPData = [];
                                allEmployees = [];
                            }
                        } else if (userRole === "HC") {
                            // Untuk HC: response.data berisi array langsung
                            if (response.data && Array.isArray(response.data)) {
                                allIMPData = response.data;
                                console.log('Data IMP HC berhasil dimuat:', allIMPData.length, 'records');

                                // Update daftar karyawan dari data yang baru (untuk HC)
                                updateEmployeesFromCurrentData();
                            } else if (response.data && response.data.data && Array.isArray(response.data.data)) {
                                // Fallback untuk struktur lama
                                allIMPData = response.data.data;
                                console.log('Data IMP HC berhasil dimuat (fallback):', allIMPData.length, 'records');
                                updateEmployeesFromCurrentData();
                            } else {
                                allIMPData = [];
                                console.warn('Struktur data tidak dikenali untuk HC:', response);
                            }
                        }

                        // Filter data berdasarkan role untuk memastikan hanya data yang sesuai yang ditampilkan
                        allIMPData = filterDataByRole(allIMPData);
                        console.log('Data IMP setelah filter role:', allIMPData.length, 'records');

                    } else {
                        allIMPData = [];
                        allEmployees = [];
                        console.error('Error response dari API:', response);
                        showError(response.message || 'Gagal memuat data IMP');
                    }

                    renderIMPList();
                    hideLoading();
                    updateListSubtitle(); // Update subtitle setelah data dimuat
                    updateResetButton(); // Update tombol reset filter
                },
                error: function (xhr, status, error) {
                    console.error('Error loading IMP data:', error);
                    console.error('XHR status:', xhr.status);
                    console.error('XHR response:', xhr.responseText);

                    let errorMessage = 'Gagal memuat data IMP';
                    if (xhr.status === 404) {
                        errorMessage = 'Endpoint API tidak ditemukan. Pastikan backend berjalan dengan benar.';
                    } else if (xhr.status === 500) {
                        errorMessage = 'Error server. Periksa log backend.';
                    } else if (xhr.status === 401) {
                        errorMessage = 'Session tidak valid. Silakan login ulang.';
                    } else if (xhr.status === 0) {
                        errorMessage = 'Tidak dapat terhubung ke server. Periksa koneksi jaringan.';
                    }

                    showError(errorMessage);
                    hideLoading();
                    $('#pagingContainer').hide();
                    updateResetButton();
                }
            });
        }

        // --- FUNGSI UNTUK LOAD DATA KARYAWAN (HANYA UNTUK HC) ---
        function loadEmployeeData() {
            // Hanya untuk HC, load data karyawan dari API
            if (userRole === "HC") {
                $.ajax({
                    url: '/api/IMPApi/employees', // Asumsi ada endpoint untuk mendapatkan daftar karyawan
                    method: 'GET',
                    success: function(response) {
                        if (response && response.code === 200 && response.data) {
                            allEmployees = normalizeEmployeeData(response.data);
                            console.log('Daftar karyawan berhasil dimuat dari API (HC):', allEmployees.length, 'karyawan');
                            console.log('Contoh data karyawan dari API:', allEmployees[0]);
                        } else {
                            console.warn('Gagal memuat daftar karyawan dari API, menggunakan fallback:', response);
                            // Fallback: ekstrak karyawan dari data IMP yang sudah ada
                            extractEmployeesFromIMPData();
                        }
                    },
                    error: function() {
                        console.error('Error loading employee data from API, using fallback');
                        // Fallback: ekstrak karyawan dari data IMP yang sudah ada
                        extractEmployeesFromIMPData();
                    }
                });
            }
        }

        // Fallback function jika tidak ada API employees
        function extractEmployeesFromIMPData() {
            if (allIMPData && allIMPData.length > 0) {
                const employeeMap = new Map();

                allIMPData.forEach(imp => {
                    const npk = imp.imp_npk;
                    const name = imp.imp_created_by || '';

                    if (npk && !employeeMap.has(npk)) {
                        employeeMap.set(npk, {
                            npk: npk,
                            nama: name
                        });
                    }
                });

                allEmployees = normalizeEmployeeData(Array.from(employeeMap.values()));
                console.log('Karyawan diekstrak dari data IMP:', allEmployees.length, 'karyawan');
            }
        }

        // Fungsi untuk update daftar karyawan dari data IMP saat ini (hanya untuk HC)
        function updateEmployeesFromCurrentData() {
            if (userRole === "HC" && allIMPData && allIMPData.length > 0) {
                const employeeMap = new Map();

                allIMPData.forEach(imp => {
                    const npk = imp.imp_npk;
                    const name = imp.imp_created_by || '';

                    if (npk && !employeeMap.has(npk)) {
                        employeeMap.set(npk, {
                            npk: npk,
                            nama: name
                        });
                    }
                });

                // Tambahkan karyawan baru ke allEmployees
                const newEmployees = normalizeEmployeeData(Array.from(employeeMap.values()));
                newEmployees.forEach(newEmp => {
                    if (!allEmployees.some(emp => emp.npk === newEmp.npk)) {
                        allEmployees.push(newEmp);
                    }
                });

                // Normalisasi semua karyawan
                allEmployees = normalizeEmployeeData(allEmployees);

                console.log('Karyawan diekstrak dari data IMP (HC):', allEmployees.length, 'karyawan');
                console.log('Contoh data karyawan setelah ekstraksi:', allEmployees[0]);
            }
        }

        // --- FUNGSI SEARCH FUNCTIONALITY DI MODAL ---
        function setupModalSearchFunctionality() {
            const searchInputModal = $('#searchInputModal');
            const searchDropdownModal = $('#searchDropdownModal');

            // Event untuk input search di modal
            searchInputModal.on('input', function() {
                const query = $(this).val();
                if (query.length >= 1) {
                    const results = searchEmployees(query);
                    renderModalSearchDropdown(results);
                } else if (query.length === 0) {
                    searchDropdownModal.removeClass('visible');
                }
            });

            // Event untuk focus pada input modal
            searchInputModal.on('focus', function() {
                if ($(this).val().length >= 1) {
                    const results = searchEmployees($(this).val());
                    renderModalSearchDropdown(results);
                }
            });

            // Event untuk klik di luar dropdown modal
            $(document).on('click', function(e) {
                if (!$(e.target).closest('.search-container').length) {
                    searchDropdownModal.removeClass('visible');
                }
            });

            // Event untuk keyboard navigation di modal
            searchInputModal.on('keydown', function(e) {
                const dropdownItems = $('#searchDropdownModal .dropdown-item:visible');

                if (e.key === 'ArrowDown') {
                    e.preventDefault();
                    if (dropdownItems.length > 0) {
                        const firstItem = dropdownItems.first();
                        dropdownItems.removeClass('active');
                        firstItem.addClass('active');
                        firstItem[0].scrollIntoView({ block: 'nearest' });
                    }
                } else if (e.key === 'Enter') {
                    e.preventDefault();
                    const activeItem = $('#searchDropdownModal .dropdown-item.active');
                    if (activeItem.length > 0) {
                        const npk = activeItem.data('npk');
                        const name = activeItem.find('.dropdown-name').text();
                        selectEmployeeInModal(npk, name);
                    }
                }
            });

            // Event untuk tombol hapus filter karyawan
            $('#clearEmployeeFilter').on('click', function() {
                clearEmployeeFilter();
            });
        }

        // Fungsi untuk mencari karyawan berdasarkan query
        function searchEmployees(query) {
            if (!query || query.trim() === '') {
                return allEmployees;
            }

            const searchTerm = query.toLowerCase().trim();

            return allEmployees.filter(employee => {
                // Gunakan properti yang sudah dinormalisasi
                const npk = employee.npk || employee.emp_no || '';
                const name = employee.nama || employee.Full_Name || '';

                return (
                    (npk && npk.toLowerCase().includes(searchTerm)) ||
                    (name && name.toLowerCase().includes(searchTerm))
                );
            });
        }

        // Fungsi untuk merender dropdown search di modal
        function renderModalSearchDropdown(results) {
            const dropdown = $('#searchDropdownModal');
            dropdown.empty();

            if (results.length === 0) {
                dropdown.append('<div class="no-results">Tidak ditemukan karyawan</div>');
                dropdown.addClass('visible');
                return;
            }

            // Tambahkan opsi "Semua Karyawan"
            dropdown.append(`
                <div class="dropdown-item" data-npk="all">
                    <div class="dropdown-npk">SEMUA</div>
                    <div class="dropdown-name">Tampilkan semua karyawan</div>
                </div>
            `);

            // Tambahkan hasil pencarian
            results.forEach(employee => {
                const npk = employee.npk || employee.emp_no || '';
                const name = employee.nama || employee.Full_Name || 'Tidak ada nama';

                if (!npk) return;

                const item = $(`
                    <div class="dropdown-item" data-npk="${npk}">
                        <div class="dropdown-npk">${npk}</div>
                        <div class="dropdown-name">${name}</div>
                    </div>
                `);

                // Highlight jika ini adalah karyawan yang sedang dipilih
                if (npk === selectedNPK) {
                    item.addClass('active');
                }

                dropdown.append(item);
            });

            dropdown.addClass('visible');

            // Attach click event untuk dropdown items di modal
            $('#searchDropdownModal .dropdown-item').on('click', function() {
                const npk = $(this).data('npk');
                const name = $(this).find('.dropdown-name').text();
                selectEmployeeInModal(npk, name);
            });
        }

        // Fungsi untuk memilih karyawan di modal
        function selectEmployeeInModal(npk, displayName) {
            selectedNPK = npk === 'all' ? '' : npk;

            const selectedEmployeeDisplay = $('#selectedEmployeeDisplay');
            const selectedEmployeeInfo = $('#selectedEmployeeInfo');

            if (npk === 'all') {
                $('#searchInputModal').val('');
                selectedEmployeeDisplay.hide();
            } else {
                // Cari karyawan di allEmployees
                const selectedEmployee = allEmployees.find(e =>
                    e.npk === npk || e.emp_no === npk
                );

                let displayText = '';

                if (selectedEmployee) {
                    const name = selectedEmployee.nama || selectedEmployee.Full_Name || displayName;
                    displayText = `${npk} - ${name}`;
                } else {
                    displayText = `${npk} - ${displayName}`;
                }

                $('#searchInputModal').val(displayText);
                selectedEmployeeInfo.text(displayText);
                selectedEmployeeDisplay.show();
            }

            // Sembunyikan dropdown
            $('#searchDropdownModal').removeClass('visible');
        }

        // Fungsi untuk menghapus filter karyawan
        function clearEmployeeFilter() {
            selectedNPK = '';
            $('#searchInputModal').val('');
            $('#selectedEmployeeDisplay').hide();
        }

        // --- FUNGSI PAGING ---
        function setupPaging(data) {
            const totalItems = data.length;

            // Reset ke halaman 1 jika data berubah
            if (totalItems > 0 && currentPage > Math.ceil(totalItems / itemsPerPage)) {
                currentPage = 1;
            }

            // Hitung total halaman (jika itemsPerPage = 0 berarti tampilkan semua)
            totalPages = itemsPerPage === 0 ? 1 : Math.ceil(totalItems / itemsPerPage);

            // Generate data untuk halaman saat ini
            if (itemsPerPage === 0) {
                paginatedData = data;
            } else {
                const startIndex = (currentPage - 1) * itemsPerPage;
                const endIndex = startIndex + itemsPerPage;
                paginatedData = data.slice(startIndex, endIndex);
            }

            return paginatedData;
        }

        function renderPagingControls(totalItems) {
            const pagingContainer = $('#pagingContainer');
            const pageSizeSelect = $('#pageSizeSelect');
            const pagingInfo = $('#pagingInfo');

            // Tampilkan/hide paging berdasarkan jumlah data
            if (totalItems > 10) {
                pagingContainer.show();
            } else {
                pagingContainer.hide();
            }

            // Update info paging
            if (itemsPerPage === 0) {
                pagingInfo.text(`Menampilkan semua ${totalItems} data`);
            } else {
                const startItem = totalItems > 0 ? ((currentPage - 1) * itemsPerPage) + 1 : 0;
                const endItem = Math.min(currentPage * itemsPerPage, totalItems);
                pagingInfo.text(`Menampilkan ${startItem}-${endItem} dari ${totalItems} data`);
            }

            // Set nilai dropdown
            pageSizeSelect.val(itemsPerPage.toString());

            // Render tombol halaman
            renderPageNumbers();

            // Update status tombol navigasi
            updatePagingButtons(totalItems);
        }

        function renderPageNumbers() {
            const pageNumbersContainer = $('#pageNumbers');
            pageNumbersContainer.empty();

            // Jika tidak ada halaman
            if (totalPages <= 1) return;

            // Logika untuk menampilkan halaman
            const maxVisiblePages = 5;
            let startPage, endPage;

            if (totalPages <= maxVisiblePages) {
                startPage = 1;
                endPage = totalPages;
            } else {
                const maxVisibleBeforeCurrent = Math.floor(maxVisiblePages / 2);
                startPage = Math.max(currentPage - maxVisibleBeforeCurrent, 1);
                endPage = startPage + maxVisiblePages - 1;

                if (endPage > totalPages) {
                    endPage = totalPages;
                    startPage = Math.max(endPage - maxVisiblePages + 1, 1);
                }
            }

            // Tambahkan tombol untuk halaman pertama jika perlu
            if (startPage > 1) {
                const btn = $(`<button class="paging-btn" data-page="1" title="Halaman 1">1</button>`);
                if (currentPage === 1) btn.addClass('paging-btn-active');
                btn.on('click', () => goToPage(1));
                pageNumbersContainer.append(btn);

                if (startPage > 2) {
                    pageNumbersContainer.append('<span class="paging-dots" title="Halaman lain">...</span>');
                }
            }

            // Tambahkan tombol untuk halaman-halaman
            for (let i = startPage; i <= endPage; i++) {
                const btn = $(`<button class="paging-btn" data-page="${i}" title="Halaman ${i}">${i}</button>`);
                if (i === currentPage) btn.addClass('paging-btn-active');
                btn.on('click', () => goToPage(i));
                pageNumbersContainer.append(btn);
            }

            // Tambahkan tombol untuk halaman terakhir jika perlu
            if (endPage < totalPages) {
                if (endPage < totalPages - 1) {
                    pageNumbersContainer.append('<span class="paging-dots" title="Halaman lain">...</span>');
                }

                const btn = $(`<button class="paging-btn" data-page="${totalPages}" title="Halaman terakhir">${totalPages}</button>`);
                if (currentPage === totalPages) btn.addClass('paging-btn-active');
                btn.on('click', () => goToPage(totalPages));
                pageNumbersContainer.append(btn);
            }
        }

        function updatePagingButtons(totalItems) {
            const firstPageBtn = $('#firstPageBtn');
            const prevPageBtn = $('#prevPageBtn');
            const nextPageBtn = $('#nextPageBtn');
            const lastPageBtn = $('#lastPageBtn');

            // Tambahkan title untuk aksesibilitas
            firstPageBtn.attr('title', 'Halaman pertama');
            prevPageBtn.attr('title', 'Halaman sebelumnya');
            nextPageBtn.attr('title', 'Halaman berikutnya');
            lastPageBtn.attr('title', 'Halaman terakhir');

            // Nonaktifkan tombol jika hanya ada 1 halaman atau itemsPerPage = 0
            if (totalPages <= 1 || itemsPerPage === 0) {
                firstPageBtn.prop('disabled', true);
                prevPageBtn.prop('disabled', true);
                nextPageBtn.prop('disabled', true);
                lastPageBtn.prop('disabled', true);
                return;
            }

            // Update status tombol navigasi
            firstPageBtn.prop('disabled', currentPage === 1);
            prevPageBtn.prop('disabled', currentPage === 1);
            nextPageBtn.prop('disabled', currentPage === totalPages);
            lastPageBtn.prop('disabled', currentPage === totalPages);
        }

        function goToPage(page) {
            if (page < 1 || page > totalPages || page === currentPage) return;

            currentPage = page;
            renderIMPList();
            $('html, body').animate({
                scrollTop: $("#reimbursementList").offset().top - 100
            }, 300);
        }

        // --- FUNGSI FILTER DATA BERDASARKAN ROLE ---
        function filterDataByRole(data) {
            if (!data || !Array.isArray(data)) return [];

            // Jika role HC, tampilkan semua data yang statusnya sesuai dengan workflow HC
            if (userRole === "HC") {
                return data.filter(item => {
                    const status = item.imp_status || '';
                    return status === "Belum Diverifikasi HC" ||
                           status === "Disetujui" ||
                           status === "Ditolak";
                });
            }
            // Jika role Atasan, tampilkan semua data yang statusnya sesuai dengan workflow Atasan
            else if (userRole === "Atasan") {
                return data.filter(item => {
                    const status = item.imp_status || '';
                    return status === "Menunggu Persetujuan Atasan" ||
                           status === "Belum Diverifikasi HC" ||
                           status === "Disetujui" ||
                           status === "Ditolak";
                });
            }

            return data;
        }

        // --- FUNGSI RENDER DATA ---
        function renderIMPList() {
            const container = $('#reimbursementList');
            container.empty();

            // Filter data berdasarkan tab aktif DAN NPK yang dipilih
            let filteredData = allIMPData;

            // Filter berdasarkan tab
            if (activeTab !== 'all') {
                filteredData = filteredData.filter(item =>
                    (item.imp_status || '') === activeTab
                );
            }

            // Filter berdasarkan NPK jika ada yang dipilih (untuk Atasan sudah di-filter di loadIMPData)
            if (userRole === "HC" && selectedNPK && selectedNPK !== 'all') {
                filteredData = filteredData.filter(item =>
                    (item.imp_npk || '') === selectedNPK
                );
            }

            if (!filteredData || filteredData.length === 0) {
                container.append(`
                    <div class="no-data-container">
                        <i class="fas fa-inbox no-data-icon"></i>
                        <p class="no-data-title">Tidak ada data IMP</p>
                        <p class="no-data-text">
                            ${selectedNPK ?
                                'Tidak ditemukan pengajuan IMP untuk karyawan yang dipilih' :
                                'Tidak ditemukan pengajuan IMP untuk filter yang dipilih'}
                        </p>
                    </div>
                `);

                $('#pagingContainer').hide();
                return;
            }

            // Setup paging
            const paginatedData = setupPaging(filteredData);

            // Render data yang sudah dipaging
            paginatedData.forEach(imp => {
                const card = createIMPCard(imp);
                container.append(card);
            });

            // Render paging controls
            renderPagingControls(filteredData.length);

            // Attach click event to cards - selalu arahkan ke ManageDetailIMPAtasanAndHC1
            $('.card').on('click', function() {
                const impId = $(this).data('imp-id');
                if (impId) {
                    window.location.href = '@Url.Action("ManageDetailIMPAtasanAndHC1", "Manage")?id=' + impId;
                }
            });
        }

        function createIMPCard(imp) {
            // Untuk Atasan dan HC, struktur data sedikit berbeda
            let impId, noRequest, jenisKegiatan, keterangan, status, npk, createdBy, startDate, endDate;

            if (userRole === "Atasan") {
                // Untuk Atasan: data ada di properti imp_ langsung
                impId = imp.imp_id || 0;
                noRequest = imp.imp_no_request || '-';
                jenisKegiatan = imp.imp_jenis_kegiatan || 'Tidak ada judul';
                keterangan = imp.imp_keterangan || 'Tidak ada keterangan';
                status = imp.imp_status || '';
                npk = imp.imp_npk || '';
                createdBy = imp.imp_created_by || '';

                // Format tanggal
                startDate = imp.imp_waktu_berangkat ?
                    moment(imp.imp_waktu_berangkat).format('DD MMM YYYY HH:mm') : 'Tanggal tidak tersedia';
                endDate = imp.imp_waktu_kembali ?
                    moment(imp.imp_waktu_kembali).format('DD MMM YYYY HH:mm') : 'Tanggal tidak tersedia';

                // Tambahkan info karyawan jika tersedia
                const karyawanInfo = imp.karyawan ?
                    ` | ${imp.karyawan.Full_Name} (${imp.karyawan.dept_code})` : '';
                jenisKegiatan += karyawanInfo;

            } else if (userRole === "HC") {
                // Untuk HC: struktur data standar
                impId = imp.imp_id || 0;
                noRequest = imp.imp_no_request || '-';
                jenisKegiatan = imp.imp_jenis_kegiatan || 'Tidak ada judul';
                keterangan = imp.imp_keterangan || 'Tidak ada keterangan';
                status = imp.imp_status || '';
                npk = imp.imp_npk || '';
                createdBy = imp.imp_created_by || '';

                // Format tanggal
                startDate = imp.imp_waktu_berangkat ?
                    moment(imp.imp_waktu_berangkat).format('DD MMM YYYY HH:mm') : 'Tanggal tidak tersedia';
                endDate = imp.imp_waktu_kembali ?
                    moment(imp.imp_waktu_kembali).format('DD MMM YYYY HH:mm') : 'Tanggal tidak tersedia';
            }

            // Calculate duration
            let duration = 'Tidak diketahui';
            if (imp.imp_waktu_berangkat && imp.imp_waktu_kembali) {
                try {
                    const startDateObj = new Date(imp.imp_waktu_berangkat);
                    const endDateObj = new Date(imp.imp_waktu_kembali);

                    const diffMs = endDateObj - startDateObj;
                    const diffHours = Math.floor(diffMs / (1000 * 60 * 60));
                    const diffMinutes = Math.floor((diffMs % (1000 * 60 * 60)) / (1000 * 60));

                    if (diffHours > 0) {
                        duration = `${diffHours} jam ${diffMinutes > 0 ? diffMinutes + ' menit' : ''}`;
                    } else if (diffMinutes > 0) {
                        duration = `${diffMinutes} menit`;
                    } else {
                        duration = 'Kurang dari 1 menit';
                    }
                } catch (e) {
                    console.error('Error calculating duration:', e);
                    duration = 'Error menghitung durasi';
                }
            }

            const statusClass = getStatusClass(status);
            const statusText = getStatusText(status);

            return `
                <div class="card" data-imp-id="${impId}">
                    <div class="card-header">
                        <div class="card-left-section">
                            <p class="card-npk">No: ${noRequest} | NPK: ${npk}</p>
                            <h3 class="card-title">${jenisKegiatan}</h3>
                            <p class="card-reason">${keterangan}</p>
                            <div class="card-date-container">
                                <i class="fas fa-user card-date-icon"></i>
                                <span class="card-date">Dibuat oleh: ${createdBy}</span>
                            </div>
                            <div class="card-date-container">
                                <i class="fas fa-clock card-date-icon"></i>
                                <span class="card-date">${startDate} - ${endDate}</span>
                            </div>
                            <div class="card-date-container">
                                <i class="fas fa-hourglass-half card-date-icon"></i>
                                <span class="card-date">Durasi: ${duration}</span>
                            </div>
                        </div>
                        <div class="card-right-section">
                            <span class="card-status-badge ${statusClass}">${statusText}</span>
                        </div>
                    </div>
                    <div class="view-button">
                        <div class="view-text">Lihat →</div>
                    </div>
                </div>
            `;
        }

        function getStatusClass(status) {
            if (!status) return 'status-pending';

            const statusStr = status.toString().toLowerCase();
            if (statusStr.includes('selesai') || statusStr.includes('disetujui')) {
                return 'status-approved-badge';
            } else if (statusStr.includes('belum') || statusStr.includes('verifikasi')) {
                return 'status-verified';
            } else if (statusStr.includes('menunggu')) {
                return 'status-pending';
            } else if (statusStr.includes('ditolak') || statusStr.includes('dibatalkan')) {
                return 'status-rejected-badge';
            }
            return 'status-pending';
        }

        function getStatusText(status) {
            if (!status) return 'Unknown';
            return status;
        }

        // --- FUNGSI UI HELPER ---
        function showLoading() {
            $('#reimbursementList').html(`
                <div class="centered-container">
                    <div class="spinner"></div>
                    <p class="loading-text">Memuat data IMP...</p>
                </div>
            `);
        }

        function hideLoading() {
            // Loading akan diganti oleh renderIMPList
        }

        function showError(message) {
            $('#reimbursementList').html(`
                <div class="centered-container">
                    <i class="fas fa-exclamation-triangle" style="font-size: 48px; color: #D32F2F;"></i>
                    <p class="error-text">${message}</p>
                    <p class="error-subtext">Silakan coba lagi beberapa saat</p>
                    <button id="retryButton" style="margin-top: 16px; padding: 8px 16px; background: #2A458A; color: white; border: none; border-radius: 4px; cursor: pointer;">
                        Coba Lagi
                    </button>
                </div>
            `);

            $('#retryButton').on('click', function() {
                loadIMPData();
            });
        }

        function updateTimeRange() {
            const now = new Date();
            const currentYear = now.getFullYear();

            let endDateText;

            if (appliedYear === currentYear) {
                endDateText = now.toLocaleDateString('id-ID', {
                    day: 'numeric',
                    month: 'long',
                    year: 'numeric'
                });
            } else {
                endDateText = `31 Desember ${appliedYear}`;
            }

            $('#timeRangeText').text(`1 Januari ${appliedYear} - ${endDateText}`);
        }

        // --- FUNGSI TAB MANAGEMENT ---
        function renderTabs() {
            const container = $('#tabContainer');
            container.empty();

            const filteredTabs = getFilteredTabs();

            filteredTabs.forEach(tab => {
                const isActive = activeTab === tab.status;
                const tabEl = $(`
                    <div class="tab-item ${isActive ? 'active' : ''}" data-status="${tab.status}">
                        <p class="tab-text">${tab.text}</p>
                        <div class="tab-underline"></div>
                    </div>
                `);
                tabEl.on('click', () => handleTabClick(tab.status, tab.text));
                container.append(tabEl);
            });
        }

        function handleTabClick(status, text) {
            if (activeTab === status) return;

            activeTab = status;
            currentPage = 1; // Reset ke halaman 1 saat ganti tab
            $('#listSubtitle').text(status === 'all' ? 'Semua status' : text);

            renderTabs();
            loadIMPData();
            updateListSubtitle(); // Update subtitle
        }

        // --- FUNGSI UPDATE LIST SUBTITLE ---
        function updateListSubtitle() {
            const subtitle = $('#listSubtitle');
            let text = '';

            if (activeTab !== 'all') {
                text = getStatusText(activeTab);
            } else {
                text = 'Semua status';
            }

            if (selectedNPK && selectedNPK !== 'all') {
                let employeeInfo = '';

                // Cari karyawan dengan NPK yang dipilih
                const selectedEmployee = allEmployees.find(e =>
                    e.npk === selectedNPK || e.emp_no === selectedNPK
                );

                if (selectedEmployee) {
                    const name = selectedEmployee.nama || selectedEmployee.Full_Name || '';
                    employeeInfo = `${selectedNPK} - ${name}`;
                } else {
                    employeeInfo = selectedNPK;
                }

                if (employeeInfo) {
                    text += ` - ${employeeInfo}`;
                }
            }

            if (appliedYear !== new Date().getFullYear()) {
                text += ` • Tahun: ${appliedYear}`;
            }

            subtitle.text(text);
        }

        // --- FUNGSI UNTUK RESET BUTTON ---
        function updateResetButton() {
            const resetButton = $('#resetFilterButton');
            const hasActiveFilter = selectedNPK || appliedYear !== new Date().getFullYear();

            if (hasActiveFilter) {
                resetButton.show();
            } else {
                resetButton.hide();
            }
        }

        // --- FUNGSI UNTUK BUKA MODAL ---
        function openFilterModal() {
            // Set tahun aktif
            $('#activeYear').text(appliedYear);
            $('#prevYear').text(appliedYear - 1);
            $('#nextYear').text(appliedYear + 1);

            // Set input search dan tampilkan karyawan yang dipilih
            const selectedEmployeeDisplay = $('#selectedEmployeeDisplay');
            const selectedEmployeeInfo = $('#selectedEmployeeInfo');

            if (selectedNPK && selectedNPK !== 'all') {
                const selectedEmployee = allEmployees.find(e =>
                    e.npk === selectedNPK || e.emp_no === selectedNPK
                );

                if (selectedEmployee) {
                    const name = selectedEmployee.nama || selectedEmployee.Full_Name || '';
                    const displayText = `${selectedNPK} - ${name}`;
                    $('#searchInputModal').val(displayText);
                    selectedEmployeeInfo.text(displayText);
                    selectedEmployeeDisplay.show();
                } else {
                    $('#searchInputModal').val(`${selectedNPK}`);
                    selectedEmployeeInfo.text(`${selectedNPK}`);
                    selectedEmployeeDisplay.show();
                }
            } else {
                $('#searchInputModal').val('');
                selectedEmployeeDisplay.hide();
            }

            $('#yearFilterModal').addClass('visible');
        }

        // --- SETUP EVENT LISTENERS ---
        function setupUIEventListeners() {
            // Paging Event Listeners
            $('#pageSizeSelect').on('change', function() {
                itemsPerPage = parseInt($(this).val()) || 0;
                currentPage = 1; // Reset ke halaman 1 saat ganti page size
                renderIMPList();
            });

            $('#firstPageBtn').on('click', function() {
                goToPage(1);
            });

            $('#prevPageBtn').on('click', function() {
                goToPage(currentPage - 1);
            });

            $('#nextPageBtn').on('click', function() {
                goToPage(currentPage + 1);
            });

            $('#lastPageBtn').on('click', function() {
                goToPage(totalPages);
            });

            // Reset Filter Button
            $('#resetFilterButton').on('click', function() {
                // Reset semua filter
                selectedNPK = '';
                appliedYear = new Date().getFullYear();
                currentPage = 1;

                // Update UI
                updateTimeRange();
                loadIMPData();
                updateListSubtitle();
                updateResetButton();
            });

            // Panduan Modal
            $('#tombolPanduan').on('click', () => $('#panduanModal').addClass('visible'));
            $('#closePanduanButton').on('click', () => $('#panduanModal').removeClass('visible'));

            // Filter Modal - Buka modal dengan state yang benar
            $('#tombolFilterTahun').on('click', openFilterModal);

            $('#modalBackIcon').on('click', () => $('#yearFilterModal').removeClass('visible'));

            $('#applyYearButton').on('click', () => {
                appliedYear = parseInt($('#activeYear').text());
                currentPage = 1;
                $('#yearFilterModal').removeClass('visible');
                updateTimeRange();
                loadIMPData();
                updateListSubtitle();
                updateResetButton();
            });

            // Tahun Picker
            $('.year-picker-container .chevron').on('click', function () {
                const direction = $(this).data('direction');
                const currentYear = parseInt($('#activeYear').text());
                let newYear = currentYear;

                if (direction === 'up' && currentYear > 2020) newYear = currentYear - 1;
                if (direction === 'down' && currentYear < new Date().getFullYear()) newYear = currentYear + 1;

                $('#activeYear').text(newYear);
                $('#prevYear').text(newYear - 1);
                $('#nextYear').text(newYear + 1);
            });

            // Info Modal
            $('#modalHelpIcon').on('click', (e) => {
                e.stopPropagation();
                $('#infoModal').addClass('visible');
            });
            $('#closeInfoModalButton').on('click', () => $('#infoModal').removeClass('visible'));

            // Close modals on outside click
            $('.modal-overlay').on('click', function (e) {
                if (e.target === this) $(this).removeClass('visible');
            });
        }

        // --- INISIALISASI HALAMAN ---
        $(function () {
            initializePage();
        });
    </script>
</body>
</html>