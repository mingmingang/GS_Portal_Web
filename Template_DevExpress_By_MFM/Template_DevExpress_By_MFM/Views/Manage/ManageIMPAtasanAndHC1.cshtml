            .page-header-title {
                font-size: 16px;
            }

            .time-range-header {
                padding: 10px 12px;
            }

            .time-range-text {
                font-size: 13px;
            }

            .white-section {
                padding: 20px 12px;
            }

            .card {
                padding: 14px;
            }

            .card-header {
                gap: 8px;
            }

            .card-title {
                font-size: 15px;
            }

            .card-reason {
                font-size: 13px;
            }

            .panduan-status-label {
                width: 160px;
                font-size: 11px;
            }
            /* Responsive paging */
            .paging-container {
                flex-direction: column;
                align-items: stretch;
                gap: 16px;
            }

            .paging-left {
                justify-content: center;
                width: 100%;
                gap: 16px;
            }

            .paging-right {
                justify-content: center;
                width: 100%;
                margin-top: 0;
            }

            .paging-dropdown {
                min-width: 80px;
            }

            .paging-left {
                flex-wrap: wrap;
                justify-content: center;
                text-align: center;
            }

            .paging-label, .paging-info {
                width: 100%;
                text-align: center;
                justify-content: center;
            }

            #reimbursementList {
                grid-template-columns: 1fr;
            }

            .summary-cards-container {
                grid-template-columns: 1fr;
            }

            .modal-content {
                max-width: 350px;
            }
        }

        @@media (max-width: 480px) {
            .page-header-title {
                font-size: 15px;
            }

            .time-range-text {
                font-size: 12px;
            }

            .white-section {
