        }

        .card-date-container {
            display: flex;
            align-items: center;
            gap: 8px;
            margin-bottom: 6px;
        }

        .card-date-icon {
            font-size: 14px;
            color: #9AA0A6;
        }

        .card-date {
            font-size: 13px;
            color: #5F6368;
        }

        .card-right-section {
            display: flex;
            flex-direction: column;
            align-items: flex-end;
            gap: 8px;
            flex-shrink: 0;
        }

        .card-status-badge {
            padding: 6px 12px;
            border-radius: 20px;
            font-size: 12px;
            font-weight: 500;
            white-space: nowrap;
        }

        /* TAMBAHKAN CSS UNTUK TOMBOL LIHAT */
        .view-button {
            align-self: flex-end;
            text-align: right;
            margin-top: 12px;
        }

        .view-text {
            display: inline-block;
            color: #1E2D56;
            font-weight: bold;
            cursor: pointer;
            font-size: 14px;
        }

        .status-pending {
            background-color: #648DF0 !important;
            color: white;
            font-weight: bold;
        }

        .status-approved-badge {
            background-color: #16a34a;
            color: white;
            font-weight: bold;
        }

        .status-rejected-badge {
            background-color: #ef4444 !important;
            color: white;
            font-weight: bold;
        }

        .status-verified {
            background-color: #f59e0b !important;
            color: white;
            font-weight: bold;
        }

        .status-belum {
            background-color: #fff3cd !important;
            color: #e59400;
            font-weight: bold;
        }

        .centered-container {
            flex: 1;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            background-color: #F4F7FC;
            padding: 20px;
        }

        .loading-text {
            margin-top: 10px;
            font-size: 16px;
            color: #1F2937;
        }

        .error-text {
            margin-top: 10px;
            font-size: 18px;
            font-weight: bold;
            color: #D32F2F;
            text-align: center;
        }

        .error-subtext {
            margin-top: 4px;
            font-size: 14px;
            color: #6B7280;
            text-align: center;
        }

        .no-data-container {
