            }

            .card-reason {
                font-size: 12px;
            }

            .panduan-status-label {
                width: 140px;
                font-size: 10px;
            }

            .panduan-list li {
                flex-direction: column;
                align-items: flex-start;
            }

            .panduan-status-label {
                margin-bottom: 8px;
                margin-right: 0;
                width: 100%;
            }
            /* Responsive search dropdown mobile */
            #searchInputModal {
                padding: 8px 12px 8px 35px;
                font-size: 12px;
            }

            .search-icon {
                left: 10px;
                font-size: 13px;
            }

            .dropdown-item {
                padding: 8px 12px;
                gap: 8px;
            }
            /* Responsive paging mobile */
            .paging-left {
                flex-direction: column;
                align-items: center;
                gap: 12px;
            }

            .paging-label, .paging-info {
