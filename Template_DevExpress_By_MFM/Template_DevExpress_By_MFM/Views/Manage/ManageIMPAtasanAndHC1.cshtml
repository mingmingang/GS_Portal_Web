@using Template_DevExpress_By_MFM.Models
@using DevExtreme.AspNet.Mvc
@{
    var logSession = HttpContext.Current.Session["SHealth"] as Template_DevExpress_By_MFM.Models.SessionLogin;
    var userRole = logSession != null ? logSession.userjabatan : null;
    var userNPK = logSession != null ? logSession.npk : null;
    var isAtasanOrHC1 = userRole == "Atasan" || userRole == "HC";
    Layout = null;
}

