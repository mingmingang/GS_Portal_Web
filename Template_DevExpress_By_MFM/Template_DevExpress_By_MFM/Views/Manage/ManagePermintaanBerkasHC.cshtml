    <!-- Loading Overlay -->
    <div class="loading-overlay" id="loadingOverlay">
        <div class="loading-spinner"></div>
    </div>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.5.1/jquery.min.js"></script>
    <script>
        function goBack() {
            window.location.href = '/Home/Index';
        }

        $(document).ready(function () {
            const npk = '@npk';
            const plant = '@plant';
            let pendingAction = null;

            const monthNames = [
                'Januari', 'Februari', 'Maret', 'April', 'Mei', 'Juni',
                'Juli', 'Agustus', 'September', 'Oktober', 'November', 'Desember'
            ];

            // FILTER STATE YANG DIPERLUAS SEPERTI DI V2
            let picFilterState = {
                month: null,
                year: null,
                status: null,
                ah: null,
                dept: null
            };

            let skFilterState = {
                month: null,
                year: null,
                status: null,
                ap: null,
                dept: null
            };

            // FUNGSI BARU DARI V2: Populate month options
            function populateMonthOptions(selectElement) {
                selectElement.empty();
                selectElement.append('<option value="">Semua Bulan</option>');
                monthNames.forEach((month, index) => {
                    const monthValue = index + 1;
                    selectElement.append(`<option value="${monthValue}">${month}</option>`);
                });
            }

            // FUNGSI BARU DARI V2: Populate year dropdowns
            function populateYearDropdowns() {
                const picYearSelect = $('#pic-filter-year');
                const skYearSelect = $('#sk-filter-year');
                const currentYear = new Date().getFullYear();
                const startYear = 2020;
                const endYear = 2030;

                for (let year = endYear; year >= startYear; year--) {
                    picYearSelect.append(`<option value="${year}">${year}</option>`);
                    skYearSelect.append(`<option value="${year}">${year}</option>`);
                }
            }

            populateYearDropdowns();

            // FUNGSI BARU DARI V2: Enable/disable month based on year selection
            $('#pic-filter-year').on('change', function () {
                const selectedYear = $(this).val();
                const monthSelect = $('#pic-filter-month');

                if (selectedYear) {
                    monthSelect.prop('disabled', false);
                    populateMonthOptions(monthSelect);
                } else {
                    monthSelect.prop('disabled', true);
                    monthSelect.empty();
                    monthSelect.append('<option value="">Pilih tahun terlebih dahulu</option>');
                    monthSelect.val('');
                }
            });

            $('#sk-filter-year').on('change', function () {
                const selectedYear = $(this).val();
                const monthSelect = $('#sk-filter-month');

                if (selectedYear) {
                    monthSelect.prop('disabled', false);
                    populateMonthOptions(monthSelect);
                } else {
                    monthSelect.prop('disabled', true);
                    monthSelect.empty();
                    monthSelect.append('<option value="">Pilih tahun terlebih dahulu</option>');
                    monthSelect.val('');
                }
            });

            function formatDate(dateString) {
                if (!dateString) return '';
                const date = new Date(dateString);
                const day = date.getDate();
                const month = monthNames[date.getMonth()];
                const year = date.getFullYear();
                return `${day} ${month} ${year}`;
            }

            function getStatusClass(status) {
                const statusLower = (status || '').toLowerCase();
                if (statusLower === 'belum diverifikasi hc' || statusLower === 'belumdiverifikasi') {
                    return 'status-yellow';
                } else if (statusLower === 'disetujui' || statusLower === 'selesai') {
                    return 'status-green';
                } else if (statusLower === 'ditolak') {
                    return 'status-red';
                }
                return 'status-yellow';
            }

            function getStatusText(status) {
                const statusLower = (status || '').toLowerCase();
                if (statusLower === 'belum diverifikasi hc' || statusLower === 'belumdiverifikasi') {
                    return 'Belum Diverifikasi';
                } else if (statusLower === 'disetujui' || statusLower === 'selesai') {
                    return 'Disetujui';
                } else if (statusLower === 'ditolak') {
                    return 'Ditolak';
                }
                return status || 'Tidak Diketahui';
            }

            function canApproveReject(status) {
                const statusLower = (status || '').toLowerCase().trim();
                return statusLower === 'belum diverifikasi hc' ||
                    statusLower === 'belumdiverifikasi' ||
                    statusLower === 'belum diverifikasi';
            }

            window.viewSuratPreview = function (skpId, alasanPermintaan, keterangan) {
                const params = new URLSearchParams({
                    skpId: skpId,
                    alasanPermintaan: encodeURIComponent(alasanPermintaan || ''),
                    keterangan: encodeURIComponent(keterangan || ''),
                    fromAdd: 'false'
                });

                window.location.href = '/Manage/ManagePreviewSuratKeterangan?' + params.toString();
            };

            function renderIdCardItems(data) {
                const container = $('#id-card-list');
                container.empty();

                if (data && data.length > 0) {
                    data.forEach(function (item) {
                        const showActions = canApproveReject(item.pic_status);
                        const actionsHtml = showActions ?
                            '<div class="card-actions">' +
                            '<button class="action-btn approve" data-id="' + item.pic_id + '" data-action="approve" data-type="pic">' +
                            '<span class="material-icons">check</span>' +
                            '</button>' +
                            '<button class="action-btn reject" data-id="' + item.pic_id + '" data-action="reject" data-type="pic">' +
                            '<span class="material-icons">close</span>' +
                            '</button>' +
                            '</div>' : '';

                        // STRUKTUR BARU: Actions di kiri, placeholder di kanan untuk konsistensi
                        const actionsContainerHtml = showActions ?
                            '<div class="card-actions-container">' +
                            actionsHtml +
                            '<div></div>' + // Placeholder untuk menjaga tata letak
                            '</div>' : '';

                        const card = '<div class="card">' +
                            '<div class="card-header">' +
                            '<div class="card-status ' + getStatusClass(item.pic_status) + '">' + getStatusText(item.pic_status) + '</div>' +
                            '</div>' +
                            '<div class="card-content">' +
                            '<div class="card-title">' + (item.pic_id || '-') + '</div>' +
                            '<div class="card-name">' + (item.kry_nama_karyawan || '-') + '</div>' +
                            '<div class="card-npk">NPK: ' + (item.kry_npk || '-') + '</div>' +
                            '<div class="card-reason">Alasan: ' + (item.pic_ah || '-') + '</div>' +
                            '<div class="card-date">' +
                            '<span class="material-icons">schedule</span>' +
                            formatDate(item.pic_crea_date) +
                            '</div>' +
                            '</div>' +
                            actionsContainerHtml +
                            '</div>';
                        container.append(card);
                    });
                } else {
                    container.append('<p style="text-align:center; color:#999; padding:20px;">Tidak ada data Permintaan ID Card.</p>');
                }
            }

            function renderSuratKeteranganItems(data) {
                const container = $('#sk-list');
                container.empty();

                if (data && data.length > 0) {
                    data.forEach(function (item) {
                        const showActions = canApproveReject(item.skp_status);

                        const cardTitle = item.skp_id || '-';
                        const alasan = item.skp_ap || '-';
                        const keterangan = item.skp_ket || '-';

                        const escapedAlasan = alasan.replace(/'/g, "\\'");
                        const escapedKeterangan = keterangan.replace(/'/g, "\\'");

                        const actionsHtml = showActions ?
                            '<div class="card-actions">' +
                            '<button class="action-btn approve" data-id="' + item.skp_id + '" data-action="approve" data-type="skp">' +
                            '<span class="material-icons">check</span>' +
                            '</button>' +
                            '<button class="action-btn reject" data-id="' + item.skp_id + '" data-action="reject" data-type="skp">' +
                            '<span class="material-icons">close</span>' +
                            '</button>' +
                            '</div>' : '';

                        // STRUKTUR BARU: Actions di kiri, Lihat di kanan - TANPA onclick di card
                        const actionsContainerHtml =
                            '<div class="card-actions-container">' +
                            (showActions ? actionsHtml : '<div></div>') + // Actions di kiri (kosong jika tidak ada actions)
                            '<a href="javascript:void(0)" class="lihat-link" onclick="window.viewSuratPreview(\'' + (item.skp_id || '') + '\', \'' + escapedAlasan + '\', \'' + escapedKeterangan + '\');">Lihat →</a>' +
                            '</div>';

                        // Card TANPA onclick - hanya bagian content yang bisa diklik melalui link "Lihat"
                        const card = '<div class="card">' +
                            '<div class="card-header">' +
                            '<div class="card-status ' + getStatusClass(item.skp_status) + '">' + getStatusText(item.skp_status) + '</div>' +
                            '</div>' +
                            '<div class="card-content">' +
                            '<div class="card-title">' + cardTitle + '</div>' +
                            '<div class="card-name">' + (item.kry_nama_karyawan || '-') + '</div>' +
                            '<div class="card-npk">NPK: ' + (item.kry_npk || '-') + '</div>' +
                            '<div class="card-reason"><strong>Keperluan:</strong> ' + alasan + '</div>' +
                            '<div class="card-reason">' + keterangan + '</div>' +
                            '<div class="card-date">' +
                            '<span class="material-icons">schedule</span>' +
                            formatDate(item.skp_crea_date) +
                            '</div>' +
                            '</div>' +
                            actionsContainerHtml +
                            '</div>';
                        container.append(card);
                    });
                } else {
                    container.append('<p style="text-align:center; color:#999; padding:20px;">Tidak ada data Permintaan Surat Keterangan.</p>');
                }
            }

            function updateDisplayRange(filterState, displayElementId) {
                let displayText = '';

                if (filterState.month && filterState.year) {
                    const monthName = monthNames[filterState.month - 1];
                    const lastDay = new Date(filterState.year, filterState.month, 0).getDate();
                    displayText = `1 ${monthName} ${filterState.year} – ${lastDay} ${monthName} ${filterState.year}`;
                } else if (filterState.year) {
                    displayText = `1 Januari ${filterState.year} – 31 Desember ${filterState.year}`;
                } else {
                    displayText = '1 Januari 2025 – 31 Desember 2025';
                }

                $(`#${displayElementId}`).text(displayText);
            }

            function loadIdCardRequests() {
                const url = '/api/PermintaanApi/pic/' + npk + '/' + plant;
                const ajaxData = {};

                if (picFilterState.month && picFilterState.year) {
                    const startDay = '01';
                    const lastDay = new Date(picFilterState.year, picFilterState.month, 0).getDate();
                    ajaxData.startDate = `${picFilterState.year}-${String(picFilterState.month).padStart(2, '0')}-${startDay}`;
                    ajaxData.endDate = `${picFilterState.year}-${String(picFilterState.month).padStart(2, '0')}-${lastDay}`;
                } else if (picFilterState.year) {
                    ajaxData.startDate = `${picFilterState.year}-01-01`;
                    ajaxData.endDate = `${picFilterState.year}-12-31`;
                }

                if (picFilterState.status) ajaxData.status = picFilterState.status;
                if (picFilterState.ah) ajaxData.ah = picFilterState.ah;
                if (picFilterState.dept) ajaxData.dept = picFilterState.dept;

                $('#id-card-list').html('<p style="text-align:center; padding:20px;">Memuat data...</p>');

                $.ajax({
                    url: url,
                    method: 'GET',
                    data: ajaxData,
                    dataType: 'json',
                    success: function (response) {
                        let actualData = null;

                        if (response && response.code === 200) {
                            if (response.data && Array.isArray(response.data) && response.data.length > 0) {
                                const firstItem = response.data[0];
                                if (firstItem.data && Array.isArray(firstItem.data)) {
                                    actualData = firstItem.data;
                                }
                            }
                        } else if (Array.isArray(response)) {
                            actualData = response;
                        }

                        if (actualData && actualData.length > 0) {
                            renderIdCardItems(actualData);
                        } else {
                            $('#id-card-list').html('<p style="text-align:center; color:#999; padding:20px;">Tidak ada data.</p>');
                        }
                    },
                    error: function (xhr, status, error) {
                        console.error("AJAX Error:", status, error);
                        $('#id-card-list').html('<p style="text-align:center; color:#d9534f; padding:20px;">Gagal memuat data.</p>');
                    }
                });
            }

            function loadSuratKeteranganRequests() {
                const url = '/api/PermintaanApi/skp/' + npk + '/' + plant;
                const ajaxData = {};

                if (skFilterState.month && skFilterState.year) {
                    const startDay = '01';
                    const lastDay = new Date(skFilterState.year, skFilterState.month, 0).getDate();
                    ajaxData.startDate = `${skFilterState.year}-${String(skFilterState.month).padStart(2, '0')}-${startDay}`;
                    ajaxData.endDate = `${skFilterState.year}-${String(skFilterState.month).padStart(2, '0')}-${lastDay}`;
                } else if (skFilterState.year) {
                    ajaxData.startDate = `${skFilterState.year}-01-01`;
                    ajaxData.endDate = `${skFilterState.year}-12-31`;
                }

                if (skFilterState.status) ajaxData.status = skFilterState.status;
                if (skFilterState.ap) ajaxData.ap = skFilterState.ap;
                if (skFilterState.dept) ajaxData.dept = skFilterState.dept;

                $('#sk-list').html('<p style="text-align:center; padding:20px;">Memuat data...</p>');

                $.ajax({
                    url: url,
                    method: 'GET',
                    data: ajaxData,
                    dataType: 'json',
                    success: function (response) {
                        let actualData = null;

                        if (response && response.code === 200) {
                            if (response.data && Array.isArray(response.data) && response.data.length > 0) {
                                const firstItem = response.data[0];
                                if (firstItem.data && Array.isArray(firstItem.data)) {
                                    actualData = firstItem.data;
                                }
                            }
                        } else if (Array.isArray(response)) {
                            actualData = response;
                        }

                        if (actualData && actualData.length > 0) {
                            renderSuratKeteranganItems(actualData);
                        } else {
                            $('#sk-list').html('<p style="text-align:center; color:#999; padding:20px;">Tidak ada data.</p>');
                        }
                    },
                    error: function (xhr, status, error) {
                        console.error("AJAX Error:", status, error);
                        $('#sk-list').html('<p style="text-align:center; color:#d9534f; padding:20px;">Gagal memuat data.</p>');
                    }
                });
            }

            // Event listeners
            $('#tab-id-card').on('click', function () {
                $('.tab-button').removeClass('active');
                $(this).addClass('active');
                $('#id-card-content').show();
                $('#surat-keterangan-content').hide();
                loadIdCardRequests();
            });

            $('#tab-surat-keterangan').on('click', function () {
                $('.tab-button').removeClass('active');
                $(this).addClass('active');
                $('#surat-keterangan-content').show();
                $('#id-card-content').hide();
                loadSuratKeteranganRequests();
            });

            // FILTER PIC MODAL - EVENT HANDLER BARU DARI V2
            $('#filter-pic').on('click', function () {
                $('#filterPicModal').addClass('visible');
            });
            $('#closePicFilterModal').on('click', function () {
                $('#filterPicModal').removeClass('visible');
            });

            $('#filterPicForm').on('submit', function (e) {
                e.preventDefault();
                picFilterState.year = $('#pic-filter-year').val() || null;
                picFilterState.month = $('#pic-filter-month').val() || null;
                picFilterState.status = $('#pic-filter-status').val() || null;
                picFilterState.ah = $('#pic-filter-ah').val() || null;
                picFilterState.dept = $('#pic-filter-dept').val() || null;
                updateDisplayRange(picFilterState, 'id-card-display-range');
                $('#filterPicModal').removeClass('visible');
                loadIdCardRequests();
            });

            $('#resetPicFilter').on('click', function () {
                picFilterState = { month: null, year: null, status: null, ah: null, dept: null };
                $('#pic-filter-year, #pic-filter-status, #pic-filter-ah, #pic-filter-dept').val('');
                $('#pic-filter-month').val('').prop('disabled', true).empty().append('<option value="">Pilih tahun terlebih dahulu</option>');
                updateDisplayRange(picFilterState, 'id-card-display-range');
                $('#filterPicModal').removeClass('visible');
                loadIdCardRequests();
            });

            // FILTER SK MODAL - EVENT HANDLER BARU DARI V2
            $('#filter-sk').on('click', function () {
                $('#filterSkModal').addClass('visible');
            });
            $('#closeSkFilterModal').on('click', function () {
                $('#filterSkModal').removeClass('visible');
            });

            $('#filterSkForm').on('submit', function (e) {
                e.preventDefault();
                skFilterState.year = $('#sk-filter-year').val() || null;
                skFilterState.month = $('#sk-filter-month').val() || null;
                skFilterState.status = $('#sk-filter-status').val() || null;
                skFilterState.ap = $('#sk-filter-ap').val() || null;
                skFilterState.dept = $('#sk-filter-dept').val() || null;
                updateDisplayRange(skFilterState, 'sk-display-range');
                $('#filterSkModal').removeClass('visible');
                loadSuratKeteranganRequests();
            });

            $('#resetSkFilter').on('click', function () {
                skFilterState = { month: null, year: null, status: null, ap: null, dept: null };
                $('#sk-filter-year, #sk-filter-status, #sk-filter-ap, #sk-filter-dept').val('');
                $('#sk-filter-month').val('').prop('disabled', true).empty().append('<option value="">Pilih tahun terlebih dahulu</option>');
                updateDisplayRange(skFilterState, 'sk-display-range');
                $('#filterSkModal').removeClass('visible');
                loadSuratKeteranganRequests();
            });

            // PANDUAN MODALS - DENGAN TOMBOL CLOSE BARU
            $('#panduan-pic').on('click', function (e) {
                e.stopPropagation();
                $('#panduanPicModal').addClass('visible');
            });

            $('#panduan-sk').on('click', function (e) {
                e.stopPropagation();
                $('#panduanSkModal').addClass('visible');
            });

            $('#closePanduanPicModalX, #closePanduanPicButton').on('click', function () {
                $('#panduanPicModal').removeClass('visible');
            });

            $('#closePanduanSkModalX, #closePanduanSkButton').on('click', function () {
                $('#panduanSkModal').removeClass('visible');
            });

            // Close modal when clicking outside
            $('.modal-overlay').on('click', function (e) {
                if (e.target === this) {
                    $(this).removeClass('visible');
                }
            });

            $(document).on('click', '.action-btn', function (e) {
                e.stopPropagation();

                const $btn = $(this);
                const action = $btn.data('action');
                const id = $btn.data('id');
                const type = $btn.data('type');

                pendingAction = { action: action, id: id, type: type };

                const isApprove = action === 'approve';
                const actionText = isApprove ? 'menyetujui' : 'menolak';
                const typeText = type === 'pic' ? 'ID Card' : 'Surat Keterangan';

                $('#confirmModalTitle').text(isApprove ? 'Setujui Permintaan' : 'Tolak Permintaan');
                $('#confirmModalMessage').text('Apakah Anda yakin ingin ' + actionText + ' permintaan ' + typeText + ' ini?');

                $('#confirmModalDetail').html(
                    '<div class="modal-detail-row"><span class="modal-detail-label">ID:</span> ' + id + '</div>' +
                    '<div class="modal-detail-row"><span class="modal-detail-label">Tipe:</span> ' + typeText + '</div>'
                ).show();

                $('#confirmModal').addClass('visible');
            });

            $('#confirmBtn').on('click', function () {
                if (!pendingAction) return;

                const action = pendingAction.action;
                const id = pendingAction.id;
                const type = pendingAction.type;
                const newStatus = action === 'approve' ? 'Disetujui' : 'Ditolak';

                $('#confirmModal').removeClass('visible');
                $('#loadingOverlay').addClass('active');

                const endpoint = type === 'pic'
                    ? '/api/PermintaanApi/pic/update-status/' + id
                    : '/api/PermintaanApi/skp/update-status/' + id;

                const requestBody = { Status: newStatus };

                $.ajax({
                    url: endpoint,
                    method: 'PUT',
                    data: JSON.stringify(requestBody),
                    contentType: 'application/json',
                    timeout: 10000,
                    success: function (response) {
                        $('#loadingOverlay').removeClass('active');
                        $('#successModalMessage').text('Permintaan berhasil ' + (action === 'approve' ? 'disetujui' : 'ditolak') + '!');
                        $('#successModal').addClass('visible');

                        if (type === 'pic') {
                            loadIdCardRequests();
                        } else {
                            loadSuratKeteranganRequests();
                        }
                    },
                    error: function (xhr, status, error) {
                        $('#loadingOverlay').removeClass('active');
                        let errorMsg = 'Gagal memperbarui status. Silakan coba lagi.';
                        if (xhr.responseJSON && xhr.responseJSON.message) {
                            errorMsg = xhr.responseJSON.message;
                        }
                        $('#errorModalMessage').text(errorMsg);
                        $('#errorModal').addClass('visible');
                    }
                });

                pendingAction = null;
            });

            $('#cancelBtn').on('click', function () {
                $('#confirmModal').removeClass('visible');
                pendingAction = null;
            });

            $('#successOkBtn').on('click', function () {
                $('#successModal').removeClass('visible');
            });

            $('#errorOkBtn').on('click', function () {
                $('#errorModal').removeClass('visible');
            });

            loadIdCardRequests();
        });
    </script>
</body>
</html>