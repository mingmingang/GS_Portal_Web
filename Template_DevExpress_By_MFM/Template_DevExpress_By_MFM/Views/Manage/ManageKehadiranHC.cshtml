@{
    var logSession = HttpContext.Current.Session["SHealth"] as Template_DevExpress_By_MFM.Models.SessionLogin;
    ViewBag.Title = "Menu Kehadiran";
    Layout = null;
}
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title - GS Track</title>

    <!-- Font & Ikon -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/icon?family=Material+Icons" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:ital,opsz,wght@0,14..32,100..900;1,14..32,100..900&family=Poppins:ital,wght@0,100;0,200;0,300;0,400;0,500;0,600;0,700;0,800;0,900;1,100;1,200;1,300;1,400;1,500;1,600;1,700;1,800;1,900&display=swap" rel="stylesheet">
    <style>
        :root {
            --primary-color: #0d6efd;
            --secondary-color: #6c757d;
            --dark-blue-header: #203A6D;
            --background-color: #f4f7fa;
            --card-bg-color: #ffffff;
            --text-color: #333;
            --text-color-light: #666;
            --border-color: #dee2e6;
            --green-status: #198754;
            --green-status-bg: #d1e7dd;
            --yellow-status: #e59400;
            --yellow-status-bg: #fff3cd;
            --blue-status-text: #0d6efd;
            --blue-status-bg: #cfe2ff;
            --red-status: #dc3545;
            --red-status-bg: #f8d7da;
        }

        body {
            margin: 0px;
            font-family: 'Inter', sans-serif;
        }

        .kehadiran-page-container {
            background-color: var(--background-color);
            padding: 0;
            margin: 0;
            position: relative;
            padding-bottom: 100px;
        }

        .kehadiran-header-section {
            background: #1C2D5A;
            color: white;
            padding: 20px;
            text-align: center;
            position: relative;
        }

            .kehadiran-header-section .back-arrow {
                position: absolute;
                left: 20px;
                top: 50%;
                transform: translateY(-50%);
                font-size: 24px;
                color: white;
                text-decoration: none;
            }

            .kehadiran-header-section h1 {
                margin: 0;
                font-size: 20px;
                font-weight: 600;
            }

        .kehadiran-main-content {
            margin-top: 20px;
            padding: 0 20px;
        }

        .filter-bar {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 8px 0px;
            border-radius: 12px;
            margin-bottom: 20px;
        }

            .filter-bar .date-range {
                font-size: 14px;
                font-weight: bold;
                background-color: #c5d5ff;
                color: #1B3F6B;
                padding: 6px 12px;
                border-radius: 8px;
                display: inline-block;
            }

            .filter-bar .filter-icons {
                display: flex;
                gap: 15px;
            }

                .filter-bar .filter-icons i {
                    font-size: 20px;
                    color: #1E2D56;
                    cursor: pointer;
                }

        .right-group {
            display: flex;
            align-items: center;
            gap: 0.5rem; /* jarak kecil antara search, dropdown, icon */
        }

        #searchBar, #plantDropdown {
            padding: 0.375rem 0.75rem;
            border: 1px solid #ced4da;
            border-radius: 0.25rem;
            font-size: 0.9rem;
        }

        #searchBar, #plantDropdown {
            padding: 0.375rem 0.75rem;
            border: 1px solid #ced4da;
            border-radius: 0.25rem;
            font-size: 0.9rem;
        }

        #searchBar {
            width: 150px;
        }

        #plantDropdown {
            width: 120px;
        }

        .summary-card {
            background-color: #DAF6FA;
            border-radius: 12px;
            padding: 15px;
            margin: 20px 0 20px 0;
            border: 1px solid var(--border-color);
            color: #3898AD;
        }

        .summary-table {
            width: 100%;
            border-collapse: collapse;
        }

            .summary-table td {
                padding: 8px 0;
                font-size: 14px;
            }

                .summary-table td:last-child {
                    text-align: right;
                    font-weight: 600;
                    color: var(--primary-color);
                }

            .summary-table .sisa-kehadiran td {
                font-weight: 600;
                color: var(--text-color);
            }

        .status-filter-container {
            display: flex;
            flex-wrap: wrap;
            gap: 8px;
            margin: 20px 0;
        }

        .status-filter-badge {
            padding: 6px 15px;
            border-radius: 20px;
            font-size: 13px;
            font-weight: 500;
            cursor: pointer;
            background-color: #e9ecef;
            color: var(--text-color-light);
            border: 1px solid var(--border-color);
            transition: all 0.2s ease-in-out;
        }

            .status-filter-badge.active {
                background-color: #1E2D56;
                color: white;
            }

        .kehadiran-list-container {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 16px;
        }

        .no-data-message {
            text-align: center;
            padding: 40px 20px;
            color: var(--text-color-light);
            font-size: 16px;
            font-style: italic;
            display: none;
        }

        .kehadiran-item-card {
            background-color: var(--card-bg-color);
            border-radius: 12px;
            padding: 15px;
            border: 1px solid var(--border-color);
            display: flex;
            flex-direction: column;
            gap: 10px;
        }

        .kehadiran-item-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

            .kehadiran-item-header .kehadiran-id {
                font-weight: 600;
                font-size: 14px;
                color: var(--text-color);
            }

        .kehadiran-item-status {
            padding: 5px 12px;
            border-radius: 20px;
            font-size: 12px;
            font-weight: 500;
        }

        .kehadiran-item-body .kehadiran-type {
            font-size: 14px;
            color: var(--text-color-light);
        }

        .modal-overlay {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background-color: rgba(0,0,0,0.6);
            display: none;
            justify-content: center;
            align-items: center;
            z-index: 1000;
            opacity: 0;
            transition: opacity 0.2s ease-in-out;
        }

            .modal-overlay.visible {
                display: flex;
                opacity: 1;
            }

        .modal-content {
            background-color: white;
            border-radius: 16px;
            box-shadow: 0 10px 25px rgba(0,0,0,0.1);
            pointer-events: auto;
            padding: 24px;
            width: 90%;
            max-width: 500px;
        }

        .modal-header {
            display: flex;
            align-items: center;
            margin-bottom: 16px;
        }

        .modal-icon {
            font-size: 36px;
            color: #2A458A;
            margin-right: 12px;
        }

        .modal-title {
            font-size: 20px;
            font-weight: bold;
            color: #1F2937;
            margin: 0;
        }

        .modal-message {
            font-size: 15px;
            color: #6B7280;
            line-height: 22px;
            margin-bottom: 24px;
        }

        .add:hover {
            text-decoration: none;
            color: white;
            transform: scale(1.1);
        }

        .kehadiran-item-card {
            background: #fff;
        }

        .kehadiran-item-status.badge {
            padding: 4px 12px;
            border-radius: 20px;
            font-size: 13px;
            font-weight: 600;
            color: #fff;
        }

        /* warna sesuai status */
        .status-hadir {
            background-color: #00BE16;
            color: white;
        }

        .status-alpa {
            background-color: #FF2600;
            color: white;
        }

        .status-cuti {
            background-color: #F5C400;
            color: white;
        }

        .status-imp {
            background-color: #65B2E6;
            color: white;
        }

        .panduan-list {
            list-style: none;
            padding: 0;
        }

            .panduan-list li {
                margin-bottom: 10px;
                display: flex;
                align-items: flex-start;
            }

        .panduan-status-label {
            font-weight: bold;
            flex-shrink: 0;
            width: 180px;
            padding: 2px 6px;
            border-radius: 4px;
            text-align: center;
            margin-right: 10px;
        }

        .date-info {
            display: flex;
            align-items: center;
            gap: 6px;
            font-size: 14px;
            color: #000;
        }

        .time-info {
            display: flex;
            align-items: center;
            justify-content: space-between;
        }

        .time-label {
            font-size: 12px;
            color: #888;
        }

        .time-value {
            font-size: 18px;
            font-weight: bold;
            color: #000;
        }

        .status-guide-item {
            margin-bottom: 15px;
        }

            .status-guide-item:last-child {
                margin-bottom: 0;
            }

        .status-guide-badge {
            padding: 8px 18px;
            border-radius: 20px;
            font-size: 14px;
            font-weight: 500;
            display: inline-block;
            margin-bottom: 8px;
        }

        .badge-hadir {
            background-color: #00BE16;
            color: white;
        }

        .badge-cuti {
            background-color: #F5C400;
            color: white;
        }

        .badge-alpa {
            background-color: #FF2600;
            color: white;
        }

        .badge-imp {
            background-color: #65B2E6;
            color: white;
        }

        .status-guide-desc {
            font-size: 14px;
            color: var(--text-color-light);
            line-height: 1.5;
        }
        /* Wrapper 2 kolom untuk input tanggal */
        #filterTahunModal .date-range-row {
            display: flex;
            gap: 12px;
            margin-bottom: 15px;
        }

        #filterTahunModal .date-input-wrapper {
            flex: 1;
            display: flex;
            flex-direction: column;
        }

        #filterTahunModal .date-input {
            width: 87%;
            padding: 8px 10px;
            font-size: 14px;
            border: 1px solid #ccc;
            border-radius: 6px;
            margin-top: 5px;
            transition: border-color 0.2s ease;
        }

            #filterTahunModal .date-input:focus {
                border-color: #007bff;
                outline: none;
                box-shadow: 0 0 4px rgba(0,123,255,0.3);
            }

        /* Tombol sejajar */
        #filterTahunModal .btn-row {
            display: flex;
            gap: 12px;
        }

        #filterTahunModal .apply-filter-btn {
            flex: 1;
            padding: 10px;
            background-color: var(--dark-blue-header);
            color: #fff;
            font-size: 14px;
            font-weight: 500;
            border: none;
            border-radius: 6px;
            cursor: pointer;
            transition: background 0.2s ease;
        }

            #filterTahunModal .apply-filter-btn:hover {
                background-color: #0056b3;
            }

        /* Style khusus reset */
        #filterTahunModal .btn-reset {
            background-color: gray;
        }

            #filterTahunModal .btn-reset:hover {
                background-color: #555;
            }

        .modal-body {
            padding: 20px; /* bagian isi modal dikasih napas */
        }

        .status-guide-item {
            margin-bottom: 18px;
        }

            .status-guide-item:last-child {
                margin-bottom: 0;
            }

        .modal-close-btn {
            background: var(--dark-blue-header);
            color: white;
            border: none;
            width: 32px;
            height: 32px;
            border-radius: 50%;
            font-size: 18px;
            font-weight: bold;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .close-button {
            background-color: #2A458A;
            border: none;
            border-radius: 8px;
            padding: 14px;
            text-align: center;
            width: 100%;
            cursor: pointer;
        }

        .close-button-text {
            color: #fff;
            font-size: 16px;
            font-weight: bold;
        }

        .filter-modal {
            width: 80%;
            max-width: 450px;
            padding: 20px;
            max-height: 80vh;
            overflow-y: auto;
        }

        .filter-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin-bottom: 20px;
        }

        .filter-back-icon {
            margin-right: 12px;
            cursor: pointer;
            font-size: 20px;
        }

        .filter-title {
            flex: 1;
            text-align: center;
            font-size: 20px;
            font-weight: bold;
            color: #2A458A;
        }

        .filter-actions {
            display: flex;
            gap: 12px;
            margin-top: 24px;
        }

        .filter-reset-button {
            flex: 1;
            border: 1px solid #E5E5E5;
            border-radius: 8px;
            padding: 14px;
            background-color: #fff;
            cursor: pointer;
        }

        .filter-reset-text {
            font-size: 16px;
            color: #666;
            font-weight: 500;
            text-align: center;
        }

        .filter-apply-button {
            flex: 1;
            background-color: #1E2D56;
            border: none;
            border-radius: 8px;
            padding: 14px;
            cursor: pointer;
        }

        .filter-apply-text {
            font-size: 16px;
            color: #fff;
            font-weight: 500;
            text-align: center;
        }

        .filter-apply-button:disabled,
        .filter-reset-button:disabled {
            opacity: 0.5;
            cursor: not-allowed;
        }

        .info-banner {
            display: flex;
            background-color: #E3F2FD;
            padding: 12px;
            border-radius: 8px;
            margin-bottom: 24px;
            align-items: flex-start;
        }

        .info-banner-text {
            flex: 1;
            margin-left: 8px;
            font-size: 12px;
            color: #1976D2;
            line-height: 16px;
        }
        .section-title {
            font-size: 16px;
            font-weight: 600;
            color: #333;
            margin-bottom: 12px;
            margin-top: 24px;
        }

            .section-title:first-of-type {
                margin-top: 0;
            }

        .date-range-vertical {
            display: flex;
            flex-direction: column;
            gap: 16px;
            margin-top: 10px;
        }

        .date-input {
            display: flex;
            flex-direction: column;
        }

            .date-input label {
                font-size: 14px;
                color: #374151;
                margin-bottom: 4px;
            }

        .filter-date-input {
            padding: 10px 12px;
            border: 1px solid #d1d5db;
            border-radius: 8px;
            font-size: 14px;
            color: #111827;
            background-color: #fff;
            transition: border-color 0.2s;
        }

            .filter-date-input:focus {
                border-color: #2a458a;
                outline: none;
            }
    </style>
</head>
<body>
    <div class="kehadiran-page-container">
        <div class="kehadiran-header-section mt-4">
            <a href="@Url.Action("Index", "Home")" class="back-arrow">&#8592;</a>
            <h1>Menu Kehadiran</h1>
        </div>

        <div class="kehadiran-main-content">
            <div class="filter-bar">
                <span class="date-range">Loading...</span>

                <div class="right-group">
                    <input id="searchBar" type="text" placeholder="Cari nama...">
                    <select id="plantDropdown">
                        <option value="">Semua Plant</option>
                        <option value="J">Jakarta</option>
                        <option value="K">Karawang</option>
                        <option value="S">Semarang</option>
                    </select>
                    <div class="filter-icons">
                        <i class="fas fa-book" data-modal="panduanModal"></i>
                        <i class="fas fa-filter" data-modal="filterModal"></i>
                    </div>
                </div>
            </div>

            <div class="status-filter-container">
                <span class="status-filter-badge active" data-status="semua">Semua</span>
                <span class="status-filter-badge" data-status="Hadir">Hadir</span>
                <span class="status-filter-badge" data-status="Alpa">Alpa</span>
                <span class="status-filter-badge" data-status="Cuti">Cuti</span>
                <span class="status-filter-badge" data-status="IMP">IMP</span>
            </div>

            <div class="kehadiran-list-container"></div>
            <div class="no-data-message" style="display: block;">Memuat daftar absensi...</div>
        </div>
    </div>

    <!-- Modal Panduan -->
    <div id="panduanModal" class="modal-overlay">
        <div class="modal-content">
            <div class="modal-header">
                <i class="fas fa-book modal-icon"></i>
                <h2 class="modal-title">Panduan Status</h2>
            </div>
            <div class="modal-message">
                <p>Berikut penjelasan untuk setiap status kehadiran:</p>
                <ul class="panduan-list">
                    <li>
                        <span class="panduan-status-label status-hadir">Hadir</span>Anda tercatat masuk kerja sesuai jadwal.
                    </li>
                    <li>
                        <span class="panduan-status-label status-alpa">Alpa</span>Anda tidak hadir tanpa keterangan atau izin.
                    </li>
                    <li>
                        <span class="panduan-status-label status-cuti">Cuti</span>Anda tidak hadir karena sedang mengambil cuti resmi.
                    </li>
                    <li>
                        <span class="panduan-status-label status-imp">IMP</span>Anda tidak hadir karena tugas dinas, izin, atau keperluan penting yang disetujui.
                    </li>
                </ul>
            </div>
            <button class="close-button" data-close="panduanModal">
                <span class="close-button-text">Mengerti</span>
            </button>
        </div>
    </div>


    <!-- Modal Filter -->
    <div id="filterModal" class="modal-overlay">
        <div class="modal-content filter-modal">
            <div class="filter-header">
                <i class="fas fa-chevron-left filter-back-icon" data-close="filterModal"></i>
                <span class="filter-title">Filter Kehadiran</span>
                <div style="width: 20px;"></div>
            </div>

            <!-- Info Banner -->
            <div class="info-banner">
                <i class="fas fa-info-circle" style="color: #4A90E2; font-size: 16px;"></i>
                <div class="info-banner-text">
                    Pilih tanggal awal dan akhir untuk memfilter data kehadiran.
                </div>
            </div>

            <!-- Periode Kehadiran -->
            <div class="section-title">Periode Kehadiran</div>

            <div class="date-range-vertical">
                <div class="date-input">
                    <label for="dateFrom">Dari</label>
                    <input type="date" id="dateFrom" name="dateFrom" class="filter-date-input" />
                </div>
                <div class="date-input">
                    <label for="dateTo">Sampai</label>
                    <input type="date" id="dateTo" name="dateTo" class="filter-date-input" />
                </div>
            </div>

            <!-- Action Buttons -->
            <div class="filter-actions">
                <button class="filter-reset-button" id="filterResetButton">
                    <div class="filter-reset-text">Reset</div>
                </button>
                <button class="filter-apply-button" id="filterApplyButton">
                    <div class="filter-apply-text">Terapkan Filter</div>
                </button>
            </div>
        </div>
    </div>
    <script src="https://code.jquery.com/jquery-3.5.1.min.js"></script>
    <script>
        $(function () {
            // ====== STATE ======
            let offset = 0, limit = 20, isLoading = false, hasMore = true;
            let allKehadiranData = [];
            let currentStatus = "semua"; // status filter aktif

            // ====== ELEMENTS ======
            const $listContainer = $('.kehadiran-list-container');
            const $noDataMessage = $('.no-data-message');
            const $searchBar = $('#searchBar');
            const $plantDropdown = $('#plantDropdown');
            const $statusBadges = $('.status-filter-badge');

            // ====== HELPERS ======
            const mapStatus = s => ({ "hadir": "Hadir", "alpa": "Alpa", "imp": "IMP", "cuti": "Cuti" }[String(s || "imp").toLowerCase()] || s);
            const formatShift = v => v ? String(v).slice(0, 5) : "--:--";
            const formatDate = v => {
                if (!v) return "-";
                const [d, m, y] = v.split('-').map(Number);
                if (!d || !m || !y) return "-";
                return new Date(y, m - 1, d).toLocaleDateString('id-ID', { weekday: 'long', day: '2-digit', month: 'short', year: 'numeric' });
            };

            const toggleModal = (id, show = true) => {
                const modal = document.getElementById(id);
                if (!modal) return console.error(`Modal ${id} gak ketemu`);
                if (show) {
                    modal.style.display = "flex";
                    requestAnimationFrame(() => modal.classList.add("visible"));
                } else {
                    modal.classList.remove("visible");
                    modal.addEventListener("transitionend", () => modal.style.display = "none", { once: true });
                }
            };

            // ====== MODAL EVENTS ======
            $("[data-modal]").click(e => toggleModal($(e.currentTarget).data("modal"), true));
            $("[data-close]").click(e => toggleModal($(e.currentTarget).data("close"), false));
            $(window).click(e => { if (e.target.classList.contains("modal-overlay")) toggleModal(e.target.id, false); });

            const plantMapping = {
                'J': 'Jakarta',
                'K': 'Karawang',
                'S': 'Semarang'
            };

            // ====== RENDERING ======
            const renderItems = items => {
                if (!items?.length) return;
                const html = items.map(k => {
                    const status = mapStatus(k.keterangan);
                    return `
                    <div class="kehadiran-item-card" data-status="${status}">
                        <div class="header-row" style="display: flex; justify-content: space-between; align-items: center;">
                            <div class="date-info" style="font-size: 16px; font-weight: 600; color: black;">
                                <i class="fas fa-calendar-alt"></i> <span>${formatDate(k.tgl)}</span>
                            </div>
                            <span class="kehadiran-item-status badge status-${status.toLowerCase()}" style="font-size: 14px; padding: 4px 10px;">${status}</span>
                        </div>

                        <div class="time-info flex items-center justify-between">
                            <div class="text-center flex-1">
                                <div class="time-label" style="font-size: 13px;">Masuk</div>
                                <div class="time-value" style="font-size: 18px; font-weight: bold;">${formatShift(k.inshiftact)}</div>
                            </div>
                            <div class="arrow px-2" style="font-size: 18px;"><i class="fa fa-arrow-right"></i></div>
                            <div class="text-center flex-1">
                                <div class="time-label" style="font-size: 13px;">Keluar</div>
                                <div class="time-value" style="font-size: 18px; font-weight: bold;">${formatShift(k.outshiftact)}</div>
                            </div>
                        </div>

                        <hr style="margin: 10px 0; border: none; border-top: 1px solid rgba(0,0,0,0.1);">

                        <div class="extra-info" style="display: flex; justify-content: space-between; font-size: 14px; color: #333;">
                            <div class="name">${k.full_name}</div>
                            <div class="plant">${plantMapping[k.plant] || 'Lainnya'}</div>
                        </div>
                    </div>
                    `;

                }).join('');
                $listContainer.append(html);
            };

            const renderList = (data, clear = false) => {
                if (clear) $listContainer.html('');
                if (!data.length) {
                    $noDataMessage.text('Tidak ada data kehadiran pada periode ini.').show();
                    return;
                }
                $noDataMessage.hide();
                renderItems(data);
            };

            // ====== API ======
            const loadKehadiranList = (fromDate, toDate, clear = true) => {
                if (clear) { offset = 0; hasMore = true; allKehadiranData = []; $listContainer.html(''); $noDataMessage.text('Memuat data...').show(); }
                if (!hasMore || isLoading) return;
                isLoading = true;

                console.log(currentStatus.toLowerCase());

                $.ajax({
                    url: '/api/KehadiranApi/list_absensi_hc',
                    type: 'POST',
                    contentType: 'application/json',
                    data: JSON.stringify({
                        FromDate: fromDate,
                        ToDate: toDate,
                        keterangan: currentStatus.toLowerCase(),
                        FullName: $searchBar.val() || "",
                        Plant: $plantDropdown.val() || "",
                        Offset: offset,
                        Limit: limit
                    }),
                    success: res => {
                        const list = res?.data || [];
                        if (list.length) {
                            allKehadiranData = [...allKehadiranData, ...list]
                                .reduce((acc, item) => {
                                    const key = item.npk + "_" + item.tgl;
                                    if (!acc.map[key]) { acc.map[key] = true; acc.list.push(item); }
                                    return acc;
                                }, { map: {}, list: [] }).list;
                        }
                        if (list.length < limit) hasMore = false;
                        offset += limit;

                        renderList(allKehadiranData, clear);
                        isLoading = false;
                    },
                    error: () => { isLoading = false; $noDataMessage.text('Gagal memuat data.').show(); }
                });
            };

            // ====== EVENTS ======
            let searchTimeout;
            $searchBar.on('input', () => {
                clearTimeout(searchTimeout); searchTimeout = setTimeout(() => {
                    loadKehadiranList($('#dateFrom').val(), $('#dateTo').val(), true);
                }, 400);
            });

            $plantDropdown.on('change', () => loadKehadiranList($('#dateFrom').val(), $('#dateTo').val(), true));

            $statusBadges.on('click', function () {
                $statusBadges.removeClass('active');
                $(this).addClass('active');

                // update status filter dan reload dari API
                currentStatus = $(this).data("status") || "semua";
                loadKehadiranList($('#dateFrom').val(), $('#dateTo').val(), true);
            });

            $('#filterApplyButton').on('click', () => {
                const f = $('#dateFrom').val(), t = $('#dateTo').val();
                if (!f || !t) { alert("Tanggal harus dipilih semua."); return; }
                if (new Date(f) > new Date(t)) { alert("Tanggal awal tidak boleh lebih besar dari tanggal akhir."); return; }
                const formattedFrom = new Date(f).toLocaleDateString('id-ID', { day: 'numeric', month: 'long', year: 'numeric' });
                const formattedTo = new Date(t).toLocaleDateString('id-ID', { day: 'numeric', month: 'long', year: 'numeric' });
                $('.date-range').text(`${formattedFrom} - ${formattedTo}`);
                loadKehadiranList(f, t, true); toggleModal("filterModal", false);
            });

            $('#filterResetButton').on('click', () => setDefaultDateRange());

            $(window).on('scroll', () => {
                if ($(window).scrollTop() + $(window).height() >= $(document).height() - 200)
                    loadKehadiranList($('#dateFrom').val(), $('#dateTo').val(), false);
            });

            // ====== DEFAULT DATE RANGE ======
            const formatDateInput = date => `${date.getFullYear()}-${String(date.getMonth() + 1).padStart(2, '0')}-${String(date.getDate()).padStart(2, '0')}`;
            const setDefaultDateRange = () => {
                const now = new Date(), firstDay = new Date(now.getFullYear(), 0, 1);
                $('#dateFrom').val(formatDateInput(firstDay));
                $('#dateTo').val(formatDateInput(now));
                $('.date-range').text(`${firstDay.toLocaleDateString('id-ID', { day: 'numeric', month: 'long', year: 'numeric' })} - ${now.toLocaleDateString('id-ID', { day: 'numeric', month: 'long', year: 'numeric' })}`);
                loadKehadiranList(formatDateInput(firstDay), formatDateInput(now), true);
            };

            setDefaultDateRange();
        });
    </script>



</body>
</html>
