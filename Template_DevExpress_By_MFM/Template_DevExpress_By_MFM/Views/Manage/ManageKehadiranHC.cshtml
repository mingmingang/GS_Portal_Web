@{
    var logSession = HttpContext.Current.Session["SHealth"] as Template_DevExpress_By_MFM.Models.SessionLogin;
    ViewBag.Title = "Menu Kehadiran";
    Layout = null;
}
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title - GS Track</title>

    <!-- Font & Ikon -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/icon?family=Material+Icons" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:ital,opsz,wght@0,14..32,100..900;1,14..32,100..900&family=Poppins:ital,wght@0,100;0,200;0,300;0,400;0,500;0,600;0,700;0,800;0,900;1,100;1,200;1,300;1,400;1,500;1,600;1,700;1,800;1,900&display=swap" rel="stylesheet">
    <style>
        :root {
            --primary-color: #0d6efd;
            --secondary-color: #6c757d;
            --dark-blue-header: #203A6D;
            --background-color: #f4f7fa;
            --card-bg-color: #ffffff;
            --text-color: #333;
            --text-color-light: #666;
            --border-color: #dee2e6;
            --green-status: #198754;
            --green-status-bg: #d1e7dd;
            --yellow-status: #e59400;
            --yellow-status-bg: #fff3cd;
            --blue-status-text: #0d6efd;
            --blue-status-bg: #cfe2ff;
            --red-status: #dc3545;
            --red-status-bg: #f8d7da;
        }

        body {
            margin: 0px;
            font-family: 'Inter', sans-serif;
            -webkit-font-smoothing: antialiased;
            -moz-osx-font-smoothing: grayscale;
            background-color: #fff;
        }

        .kehadiran-page-container {
            background-color: #fff;
            transition: margin-left 0.3s ease-in-out;
        }

        .kehadiran-header-section {
            background-color: #2A458A;
            background: linear-gradient(135deg, #1E2D56 0%, #2A4A7B 100%);
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 16px;
            position: sticky;
            top: 0;
            z-index: 10;
        }



        .header-text {
            color: #fff;
            font-size: 18px;
            font-weight: bold;
            margin: 0;
            text-align: center;
            width: 100%;
            z-index: 1;
        }

        .header-spacer {
            width: 24px;
            visibility: hidden;
        }

        .back-button {
            color: #fff;
            font-size: 20px;
            text-decoration: none;
            position: absolute;
            left: 16px;
            top: 50%;
            transform: translateY(-50%);
            z-index: 2;
            cursor: pointer;
        }

        .kehadiran-main-content {
            padding: 0 20px;
        }

        .filter-bar {
            display: flex;
            flex-direction: column;
            gap: 10px;
        }

        /* 🔍 SEARCH BAR WRAPPER */
        .search-section {
            margin-top: 15px;
            display: flex;
            align-items: stretch;
            gap: 10px; /* gap hanya antar grup */
        }

        /* 🔗 Input + Button jadi satu grup */
        .search-group {
            display: flex;
            flex: 1;
        }

        /* Input menempel kiri */
        #searchBar {
            flex: 1;
            padding: 10px 14px;
            border: 1px solid #b8c8ff;
            border-right: none;
            border-radius: 8px 0 0 8px;
            font-size: 14px;
            outline: none;
            transition: box-shadow 0.2s ease-in-out;
        }

            #searchBar:focus {
                border-color: #203A6D;
                box-shadow: 0 0 0 2px rgba(32, 58, 109, 0.25);
            }

        /* Button search menempel ke input */
        .btn-search {
            background-color: #203A6D;
            border: 1px solid #203A6D;
            border-radius: 0 8px 8px 0;
            padding: 10px 14px;
            cursor: pointer;
            display: flex;
            align-items: center;
            color: white;
            transition: background 0.2s ease-in-out, box-shadow 0.2s;
        }

            .btn-search:hover {
                background-color: #102A50;
                box-shadow: 0 0 6px rgba(32, 58, 109, 0.4);
            }

        /* 🔻 Plant Dropdown — Konsisten Style */
        #plantDropdown {
            padding: 10px 14px;
            border-radius: 8px;
            border: 1px solid #b8c8ff;
            background: white;
            font-size: 14px;
            min-width: 130px;
            cursor: pointer;
            transition: box-shadow 0.2s ease-in-out, border 0.2s;
        }

            #plantDropdown:hover,
            #plantDropdown:focus {
                border-color: #203A6D;
                box-shadow: 0 0 0 2px rgba(32, 58, 109, 0.2);
            }

        /* Responsive tweak */
        @@media (max-width: 600px) {
            .search-section {
                flex-direction: column;
            }

            .search-group > * {
                border-radius: 8px;
            }

            .search-group {
                flex-direction: column;
            }

            #plantDropdown {
                width: 100%;
            }
        }



        /* 📌 Date range + icons row */
        .bottom-filter-row {
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .filter-bar .date-range {
            color: #1E2D56;
            font-weight: 600;
            background-color: #E7EFFD;
            padding: 10px;
            border-radius: 8px;
            font-size: 14px;
        }

        .filter-bar .filter-icons {
            display: flex;
            gap: 15px;
        }

            .filter-bar .filter-icons i {
                font-size: 20px;
                color: #1E2D56;
                cursor: pointer;
            }


        .status-filter-container {
            display: flex;
            margin-bottom: 12px;
            overflow-x: auto;
            padding-bottom: 5px;
        }

        .status-filter-badge {
            margin-right: 12px;
            color: #999;
            font-weight: 600;
            padding: 6px 16px;
            margin-top: 15px;
            white-space: nowrap;
            cursor: pointer;
            border-radius: 16px;
            transition: all 0.2s ease;
        }

            .status-filter-badge.active {
                background-color: #1E2D56;
                color: #fff;
            }

        .kehadiran-list-container {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 16px;
        }

        .no-data-message {
            text-align: center;
            padding: 40px 20px;
            color: var(--text-color-light);
            font-size: 16px;
            font-style: italic;
            display: none;
        }

        .kehadiran-item-card {
            background-color: var(--card-bg-color);
            border-radius: 12px;
            padding: 15px;
            border: 1px solid var(--border-color);
            display: flex;
            flex-direction: column;
            gap: 10px;
        }

        .kehadiran-item-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

            .kehadiran-item-header .kehadiran-id {
                font-weight: 600;
                font-size: 14px;
                color: var(--text-color);
            }

        .kehadiran-item-status {
            padding: 5px 12px;
            border-radius: 20px;
            font-size: 12px;
            font-weight: 500;
        }

        .kehadiran-item-body .kehadiran-type {
            font-size: 14px;
            color: var(--text-color-light);
        }

        .modal-overlay {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background-color: rgba(0,0,0,0.6);
            display: none;
            justify-content: center;
            align-items: center;
            z-index: 1000;
            opacity: 0;
            transition: opacity 0.2s ease-in-out;
        }

            .modal-overlay.visible {
                display: flex;
                opacity: 1;
            }

        .modal-content {
            background-color: white;
            border-radius: 16px;
            box-shadow: 0 10px 25px rgba(0,0,0,0.1);
            pointer-events: auto;
            padding: 24px;
            width: 90%;
            max-width: 500px;
        }

        .modal-header {
            display: flex;
            align-items: center;
            margin-bottom: 16px;
        }

        .modal-icon {
            font-size: 36px;
            color: #2A458A;
            margin-right: 12px;
        }

        .modal-title {
            font-size: 20px;
            font-weight: bold;
            color: #1F2937;
            margin: 0;
        }

        .modal-message {
            font-size: 15px;
            color: #6B7280;
            line-height: 22px;
            margin-bottom: 24px;
        }

        .add:hover {
            text-decoration: none;
            color: white;
            transform: scale(1.1);
        }

        .kehadiran-item-card {
            background: #fff;
        }

        .kehadiran-item-status.badge {
            padding: 4px 12px;
            border-radius: 20px;
            font-size: 13px;
            font-weight: 600;
            color: #fff;
        }

        /* warna sesuai status */
        .status-hadir {
            background-color: #D1F7D6;
            color: #0A7A32;
        }

        .status-alpa {
            background-color: #FEE2E2;
            color: #B91C1C;
        }

        .status-cuti {
            background-color: #FEF3C7;
            color: #9A5B03;
        }

        /* Update */
        .status-izin {
            background-color: #DBEAFE;
            color: #1E3A8A;
        }

        /* New */
        .status-terlambat {
            background-color: #FFE9C7;
            color: #B45309;
        }

        .status-sakit {
            background-color: #CCFBF1;
            color: #0F766E;
        }

        .status-no-ci-co {
            background-color: #E5E7EB;
            color: #374151;
        }



        .panduan-list {
            list-style: none;
            padding: 0;
        }

            .panduan-list li {
                margin-bottom: 10px;
                display: flex;
                align-items: flex-start;
            }

        .panduan-status-label {
            font-weight: bold;
            flex-shrink: 0;
            width: 180px;
            padding: 2px 6px;
            border-radius: 4px;
            text-align: center;
            margin-right: 10px;
        }

        .date-info {
            display: flex;
            align-items: center;
            gap: 6px;
            font-size: 14px;
            color: #000;
        }

        .time-info {
            display: flex;
            align-items: center;
            justify-content: space-between;
        }

        .time-label {
            font-size: 12px;
            color: #888;
        }

        .time-value {
            font-size: 18px;
            font-weight: bold;
            color: #000;
        }

        .status-guide-item {
            margin-bottom: 15px;
        }

            .status-guide-item:last-child {
                margin-bottom: 0;
            }

        .status-guide-badge {
            padding: 6px 12px;
            border-radius: 6px;
            font-size: 14px;
            font-weight: 500;
            text-align: center;
            white-space: nowrap; /* Mencegah teks badge turun baris */
        }

        .badge-hadir {
            background-color: #D1FAE5; /* Hijau muda */
            color: #065F46;
        }

        .badge-cuti {
            background-color: #FEF3C7; /* Kuning pastel */
            color: #9A5B03;
        }

        .badge-alpa {
            background-color: #FEE2E2; /* Merah pastel */
            color: #991B1B;
        }

        /* Update dari imp -> izin */
        .badge-izin {
            background-color: #DBEAFE; /* Biru pastel */
            color: #1E40AF;
        }

        /* New */
        .badge-terlambat {
            background-color: #FFE9C7; /* Orange pastel */
            color: #B45309;
        }

        .badge-sakit {
            background-color: #CCFBF1; /* Mint aqua pastel */
            color: #0F766E;
        }

        .badge-no-ci-co {
            background-color: #E5E7EB; /* Gray soft */
            color: #374151;
        }


        .status-guide-desc {
            font-size: 14px;
            color: var(--text-color-light);
            line-height: 1.5;
        }
        /* Wrapper 2 kolom untuk input tanggal */
        #filterTahunModal .date-range-row {
            display: flex;
            gap: 12px;
            margin-bottom: 15px;
        }

        #filterTahunModal .date-input-wrapper {
            flex: 1;
            display: flex;
            flex-direction: column;
        }

        #filterTahunModal .date-input {
            width: 87%;
            padding: 8px 10px;
            font-size: 14px;
            border: 1px solid #ccc;
            border-radius: 6px;
            margin-top: 5px;
            transition: border-color 0.2s ease;
        }

            #filterTahunModal .date-input:focus {
                border-color: #007bff;
                outline: none;
                box-shadow: 0 0 4px rgba(0,123,255,0.3);
            }

        /* Tombol sejajar */
        #filterTahunModal .btn-row {
            display: flex;
            gap: 12px;
        }

        #filterTahunModal .apply-filter-btn {
            flex: 1;
            padding: 10px;
            background-color: var(--dark-blue-header);
            color: #fff;
            font-size: 14px;
            font-weight: 500;
            border: none;
            border-radius: 6px;
            cursor: pointer;
            transition: background 0.2s ease;
        }

            #filterTahunModal .apply-filter-btn:hover {
                background-color: #0056b3;
            }

        /* Style khusus reset */
        #filterTahunModal .btn-reset {
            background-color: gray;
        }

            #filterTahunModal .btn-reset:hover {
                background-color: #555;
            }

        .modal-body {
            padding: 20px; /* bagian isi modal dikasih napas */
        }

        .status-guide-item {
            margin-bottom: 18px;
        }

            .status-guide-item:last-child {
                margin-bottom: 0;
            }

        .modal-close-btn {
            background: var(--dark-blue-header);
            color: white;
            border: none;
            width: 32px;
            height: 32px;
            border-radius: 50%;
            font-size: 18px;
            font-weight: bold;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .close-button {
            background-color: #2A458A;
            border: none;
            border-radius: 8px;
            padding: 14px;
            text-align: center;
            width: 100%;
            cursor: pointer;
        }

        .close-button-text {
            color: #fff;
            font-size: 16px;
            font-weight: bold;
        }

        .filter-modal {
            width: 80%;
            max-width: 450px;
            padding: 20px;
            max-height: 80vh;
            overflow-y: auto;
        }

        .filter-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin-bottom: 20px;
        }

        .filter-back-icon {
            margin-right: 12px;
            cursor: pointer;
            font-size: 20px;
        }

        .filter-title {
            flex: 1;
            text-align: center;
            font-size: 20px;
            font-weight: bold;
            color: #2A458A;
        }

        .filter-actions {
            display: flex;
            gap: 12px;
            margin-top: 24px;
        }

        .filter-reset-button {
            flex: 1;
            border: 1px solid #E5E5E5;
            border-radius: 8px;
            padding: 14px;
            background-color: #fff;
            cursor: pointer;
        }

        .filter-reset-text {
            font-size: 16px;
            color: #666;
            font-weight: 500;
            text-align: center;
        }

        .filter-apply-button {
            flex: 1;
            background-color: #1E2D56;
            border: none;
            border-radius: 8px;
            padding: 14px;
            cursor: pointer;
        }

        .filter-apply-text {
            font-size: 16px;
            color: #fff;
            font-weight: 500;
            text-align: center;
        }

        .filter-apply-button:disabled,
        .filter-reset-button:disabled {
            opacity: 0.5;
            cursor: not-allowed;
        }

        .info-banner {
            display: flex;
            background-color: #E3F2FD;
            padding: 12px;
            border-radius: 8px;
            margin-bottom: 24px;
            align-items: flex-start;
        }

        .info-banner-text {
            flex: 1;
            margin-left: 8px;
            font-size: 12px;
            color: #1976D2;
            line-height: 16px;
        }

        .section-title {
            font-size: 16px;
            font-weight: 600;
            color: #333;
            margin-bottom: 12px;
            margin-top: 24px;
        }

            .section-title:first-of-type {
                margin-top: 0;
            }

        .date-range-vertical {
            display: flex;
            flex-direction: column;
            gap: 16px;
            margin-top: 10px;
        }

        .date-input {
            display: flex;
            flex-direction: column;
        }

            .date-input label {
                font-size: 14px;
                color: #374151;
                margin-bottom: 4px;
            }

        .filter-date-input {
            padding: 10px 12px;
            border: 1px solid #d1d5db;
            border-radius: 8px;
            font-size: 14px;
            color: #111827;
            background-color: #fff;
            transition: border-color 0.2s;
        }

            .filter-date-input:focus {
                border-color: #2a458a;
                outline: none;
            }

        .icons-divider {
            width: 1px;
            height: 20px;
            background-color: #ddd;
            margin: 0 8px;
        }


        .kehadiran-table {
            width: 100%;
            border-collapse: collapse;
            margin-top: 15px;
            background: white;
            border-radius: 10px;
            overflow: hidden;
            font-size: 14px;
        }

            .kehadiran-table thead {
                background: #1E2D56;
                color: #fff;
            }

            .kehadiran-table th,
            .kehadiran-table td {
                padding: 10px 12px;
                border-bottom: 1px solid #e5e5e5;
                text-align: center;
            }

            .kehadiran-table tr:last-child td {
                border-bottom: none;
            }

        /* Wrapper optional biar rapi */
        .filter-controls {
            display: flex;
            gap: 12px;
            align-items: center;
            flex-wrap: wrap;
        }

        /* Input & Select style ala Bootstrap */
        #searchBar,
        #plantDropdown {
            padding: 8px 12px;
            border: 1px solid #d1d5db; /* abu-abu soft */
            border-radius: 6px;
            font-size: 14px;
            outline: none;
            background-color: #ffffff;
            transition: all 0.2s ease;
            box-shadow: 0 1px 2px rgba(0,0,0,0.04);
        }

            /* Hover */
            #searchBar:hover,
            #plantDropdown:hover {
                border-color: #b6bec8;
            }

            /* Focus effect ala Bootstrap */
            #searchBar:focus,
            #plantDropdown:focus {
                border-color: #3b82f6;
                box-shadow: 0 0 0 3px rgba(59,130,246,0.2);
            }

        /* Cursor & select */
        #plantDropdown {
            min-width: 150px;
            cursor: pointer;
        }

        /* 🔄 SPINNER LOADING */
        .loading-spinner {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            padding: 12px;
            color: #1E2D56;
            font-size: 14px;
            font-weight: 500;
        }

        .spinner {
            width: 18px;
            height: 18px;
            border: 3px solid #ccd7ff;
            border-top-color: #203A6D;
            border-radius: 50%;
            animation: spin 0.8s linear infinite;
        }

        @@keyframes spin {
            to {
                transform: rotate(360deg);
            }
        }
    </style>
</head>
<body>
    <div class="kehadiran-page-container">
        <div class="kehadiran-header-section mt-4">
            <a href="@Url.Action("Index", "Home")" class="back-button">
                <i class="fas fa-arrow-left"></i>
            </a>
            <div class="header-text">@ViewBag.Title</div>
            <div class="header-spacer"></div>
        </div>

        <div class="kehadiran-main-content">
            <div class="filter-bar">

                <div class="search-section">

                    <div class="search-group">
                        <input id="searchBar" type="text" placeholder="Cari nama...">
                        <button id="searchButton" class="btn-search">
                            <i class="fas fa-search"></i>
                        </button>
                    </div>

                    <select id="plantDropdown">
                        <option value="K">Karawang</option>
                        <option value="J">Jakarta</option>
                        <option value="S">Semarang</option>
                    </select>

                </div>


                <div class="bottom-filter-row">
                    <span class="date-range">Loading...</span>

                    <div class="filter-icons">
                        <i class="fas fa-book" data-modal="panduanModal"></i>
                        <div class="icons-divider"></div>
                        <i class="fas fa-filter" data-modal="filterModal"></i>
                    </div>
                </div>
            </div>


            <div class="status-filter-container">
                <span class="status-filter-badge active" data-status="semua">Semua</span>
                <span class="status-filter-badge" data-status="Hadir">Hadir</span>
                <span class="status-filter-badge" data-status="Alpa">Alpa</span>
                <span class="status-filter-badge" data-status="Cuti">Cuti</span>
                <span class="status-filter-badge" data-status="Izin">Izin</span>
                <span class="status-filter-badge" data-status="Terlambat">Terlambat</span>
                <span class="status-filter-badge" data-status="Sakit">Sakit</span>
                <span class="status-filter-badge" data-status="NO-CI-CO">No CI/CO</span>
            </div>

            <table class="kehadiran-table">
                <thead>
                    <tr>
                        <th>NPK</th>
                        <th>Nama Karyawan</th>
                        <th>Plant</th>
                        <th>Tanggal</th>
                        <th>Masuk</th>
                        <th>Keluar</th>
                        <th>Shift</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody class="kehadiran-table-body"></tbody>
            </table>

            <div class="no-data-message" style="display: block;">Tidak ada data absensi</div>

            <div class="loading-spinner" style="display:none;">
                <div class="spinner"></div>
                <span class="loading-text">Memuat data...</span>
            </div>

        </div>
    </div>

    <!-- Modal Panduan -->
    <div id="panduanModal" class="modal-overlay">
        <div class="modal-content">
            <div class="modal-header">
                <i class="fas fa-book modal-icon"></i>
                <h2 class="modal-title">Panduan Status</h2>
            </div>
            <div class="modal-message">
                <p>Berikut penjelasan untuk setiap status kehadiran:</p>
                <ul class="panduan-list">
                    <li>
                        <span class="panduan-status-label badge-hadir">Hadir</span>
                        Hadir pada hari kerja wajib atau lembur
                    </li>
                    <li>
                        <span class="panduan-status-label badge-alpa">Alpa</span>
                        Tidak hadir tanpa keterangan pada hari kerja wajib
                    </li>
                    <li>
                        <span class="panduan-status-label badge-cuti">Cuti</span>
                        Semua jenis cuti yang disetujui
                    </li>
                    <li>
                        <span class="panduan-status-label badge-izin">Izin</span>
                        Izin resmi perusahaan (termasuk dispensasi & tugas khusus)
                    </li>
                    <li>
                        <span class="panduan-status-label badge-terlambat">Terlambat</span>
                        Jam masuk melebihi batas ketentuan
                    </li>
                    <li>
                        <span class="panduan-status-label badge-sakit">Sakit</span>
                        Sakit dengan surat dokter atau opname
                    </li>
                    <li>
                        <span class="panduan-status-label badge-no-ci-co">No CI/CO</span>
                        Tidak tercatat absensi masuk atau pulang
                    </li>
                </ul>
            </div>
            <button class="close-button" data-close="panduanModal">
                <span class="close-button-text">Mengerti</span>
            </button>
        </div>
    </div>


    <!-- Modal Filter -->
    <div id="filterModal" class="modal-overlay">
        <div class="modal-content filter-modal">
            <div class="filter-header">
                <i class="fas fa-chevron-left filter-back-icon" data-close="filterModal"></i>
                <span class="filter-title">Filter Kehadiran</span>
                <div style="width: 20px;"></div>
            </div>

            <!-- Info Banner -->
            <div class="info-banner">
                <i class="fas fa-info-circle" style="color: #4A90E2; font-size: 16px;"></i>
                <div class="info-banner-text">
                    Pilih tanggal awal dan akhir untuk memfilter data kehadiran.
                </div>
            </div>

            <!-- Periode Kehadiran -->
            <div class="section-title">Periode Kehadiran</div>

            <div id="filterError" class="filter-error" style="
                display:none;
                background:#ffe5e5;
                color:#b30000;
                padding:10px;
                border-radius:6px;
                font-size:13px;
                margin-bottom:10px;">
            </div>

            <div class="date-range-vertical">
                <div class="date-input">
                    <label for="dateFrom">Dari</label>
                    <input type="date" id="dateFrom" name="dateFrom" class="filter-date-input" />
                </div>
                <div class="date-input">
                    <label for="dateTo">Sampai</label>
                    <input type="date" id="dateTo" name="dateTo" class="filter-date-input" />
                </div>
            </div>

            <!-- Action Buttons -->
            <div class="filter-actions">
                <button class="filter-reset-button" id="filterResetButton">
                    <div class="filter-reset-text">Reset</div>
                </button>
                <button class="filter-apply-button" id="filterApplyButton">
                    <div class="filter-apply-text">Terapkan Filter</div>
                </button>
            </div>
        </div>
    </div>
    <script src="https://code.jquery.com/jquery-3.5.1.min.js"></script>
    <script>
        $(function () {

            let allKehadiranData = [];
            let filteredData = [];

            // === FILTER GLOBAL ===
            let plantFilter = "K"; // default Karawang
            let nameFilter = "A";  // default nama awalan A
            let searchTimeout = null;

            // ======= MODAL HANDLER ========
            function toggleModal(modalId, show = true) {
                const modal = document.getElementById(modalId);
                if (!modal) return console.error(`Modal ${modalId} gak ketemu`);

                if (show) {
                    modal.style.display = "flex";
                    requestAnimationFrame(() => modal.classList.add("visible"));
                } else {
                    modal.classList.remove("visible");
                    modal.addEventListener(
                        "transitionend",
                        () => {
                            if (!modal.classList.contains("visible")) modal.style.display = "none";
                        },
                        { once: true }
                    );
                }
            }

            document.querySelectorAll("[data-modal]").forEach(btn => {
                btn.addEventListener("click", () => toggleModal(btn.getAttribute("data-modal"), true));
            });

            document.querySelectorAll("[data-close]").forEach(btn => {
                btn.addEventListener("click", () => toggleModal(btn.getAttribute("data-close"), false));
            });

            function showFilterError(msg) {
                $('#filterError').text(msg).fadeIn(150);
            }

            function hideFilterError() {
                $('#filterError').hide().text('');
            }

            window.addEventListener("click", e => {
                const modal = e.target.closest(".modal-overlay");
                if (e.target === modal) toggleModal(modal.id, false);
            });

            // ======== DATE FORMATTER ========
            function formatDateInput(date) {
                return `${date.getFullYear()}-${String(date.getMonth() + 1).padStart(2, '0')}-${String(date.getDate()).padStart(2, '0')}`;
            }

            function setDefaultDateRange() {
                const now = new Date();

                // Awal bulan berjalan
                const firstDay = new Date(now.getFullYear(), now.getMonth(), 1);

                // Tanggal hari ini
                const today = now;

                const firstDayStr = formatDateInput(firstDay);
                const todayStr = formatDateInput(today);

                $('#dateFrom').val(firstDayStr);
                $('#dateTo').val(todayStr);

                const formattedFrom = firstDay.toLocaleDateString('id-ID', {
                    day: 'numeric',
                    month: 'long',
                    year: 'numeric'
                });
                const formattedTo = today.toLocaleDateString('id-ID', {
                    day: 'numeric',
                    month: 'long',
                    year: 'numeric'
                });

                $('.date-range').text(`${formattedFrom} - ${formattedTo}`);

                loadKehadiranList(firstDayStr, todayStr);
            }


            // ======== FILTER APPLY ========
            // Apply filter
            $('#filterApplyButton').on('click', function () {
                hideFilterError();

                const fromDate = $('#dateFrom').val();
                const toDate = $('#dateTo').val();

                if (!fromDate || !toDate) {
                    showFilterError("Tanggal harus dipilih semua.");
                    return;
                }

                if (new Date(fromDate) > new Date(toDate)) {
                    showFilterError("Tanggal awal tidak boleh lebih besar dari tanggal akhir.");
                    return;
                }

                const from = new Date(fromDate);
                const to = new Date(toDate);

                const formattedFrom = from.toLocaleDateString('id-ID', { day: 'numeric', month: 'long', year: 'numeric' });
                const formattedTo = to.toLocaleDateString('id-ID', { day: 'numeric', month: 'long', year: 'numeric' });

                console.log(fromDate);
                console.log(toDate);

                $('.date-range').text(`${formattedFrom} - ${formattedTo}`);
                loadKehadiranList(fromDate, toDate);
                toggleModal("filterModal", false);
            });

            $("#filterResetButton").on("click", function () {
                setDefaultDateRange();
            });

            // ======= FILTER DROPDOWN PLANT ========
            $("#plantDropdown").on("change", function () {
                plantFilter = $(this).val() || "K";
                refreshData();
            });

            // ======= SEARCH PAKAI TOMBOL CLICK ========
            $("#searchButton").on("click", function () {
                nameFilter = $("#searchBar").val() || "A";
                $(".no-data-message").hide().text(""); // jangan display message, biarkan spinner yang tampil
                $(".loading-spinner").show();
                refreshData();
            });

            // ======= SEARCH PAKAI ENTER ========
            $("#searchBar").on("keypress", function (e) {
                if (e.key === "Enter") {
                    $("#searchButton").click();
                }
            });


            // ======= CALL API ========
            function refreshData() {
                const fromDate = $("#dateFrom").val();
                const toDate = $("#dateTo").val();
                loadKehadiranList(fromDate, toDate);
            }

            function loadKehadiranList(fromDate, toDate) {
                const url = `/api/KehadiranApi/list_absensi_hc`;
                const $listContainer = $(".kehadiran-list-container");
                const $noDataMessage = $(".no-data-message");

                $listContainer.html("");
                $noDataMessage.hide();
                $(".loading-spinner").show(); // <<< tampilkan loading

                allKehadiranData = [];

                $.ajax({
                    url: url,
                    type: "POST",
                    contentType: "application/json",
                    data: JSON.stringify({
                        Plant: plantFilter,
                        FromDate: fromDate,
                        ToDate: toDate,
                        keterangan: "semua",
                        Fullname: nameFilter
                    }),
                    success: (res) => {
                        console.log("API Response", res);

                        // HIDE LOADING WHEN RESPONSE ARRIVE
                        $(".loading-spinner").hide();

                        // ===== HANDLING API RETURN 413 =====
                        if (res.meta && res.meta[0].code === 413) {
                            allKehadiranData = [];
                            filteredData = [];
                            $noDataMessage.text(res.meta[0].message).show();
                            return;
                        }

                        // ===== HANDLE API 404 (DATA TIDAK ADA) =====
                        if (res.meta && res.meta[0].code === 404) {
                            allKehadiranData = [];
                            filteredData = [];
                            $noDataMessage.text("Tidak ada data kehadiran ditemukan.").show();
                            return;
                        }

                        // normal fetch
                        allKehadiranData = res?.data?.length > 0 ? res.data : [];
                        filteredData = allKehadiranData;
                        $(".no-data-message").hide().text(""); // reset pesan mencari sebelumnya
                        updateKehadiranListView();
                    },
                    error: () => {
                        $(".loading-spinner").hide();

                        allKehadiranData = [];
                        filteredData = [];
                        $noDataMessage.text("Gagal memuat daftar kehadiran.").show();
                        renderAllData();
                    }
                });
            }


            // ====== MAPPING / FORMATTER ======
            function mapStatus(apiStatus) {
                const statusMap = {
                    "hadir": "Hadir",
                    "alpa": "Alpa",
                    "izin": "Izin",
                    "cuti": "Cuti",
                    "terlambat": "Terlambat",
                    "sakit": "Sakit",
                    "no_ci_co": "NO-CI-CO"
                };
                if (!apiStatus) return "-";
                return statusMap[apiStatus.toLowerCase()] || apiStatus;
            }

            function mapPlan(plant) {
                const plants = { "J": "Jakarta", "K": "Karawang", "S": "Semarang" };
                return plants[plant.toUpperCase()] || plant;
            }

            function formatShift(val) {
                if (!val) return "--:--";
                return val.slice(0, 5);
            }

            function formatDate(val) {
                if (!val) return "-";
                const parts = val.split("-");
                if (parts.length !== 3) return "-";
                let [day, month, year] = parts.map(Number);
                const date = new Date(year, month - 1, day);
                return date.toLocaleDateString('id-ID', {
                    weekday: 'long',
                    day: '2-digit',
                    month: 'short',
                    year: 'numeric'
                });
            }

            function formatShiftText(shift) {
                if (!shift) return "-";

                shift = String(shift).toUpperCase();

                // Match SH + angka + (K atau S) + optional _OFF
                const regex = /^SH(\d)([KS])(_OFF)?$/;
                const match = shift.match(regex);

                if (match) {
                    const nomorShift = match[1];
                    const isOff = !!match[3];
                    return isOff ? `Shift ${nomorShift} Off` : `Shift ${nomorShift}`;
                }

                // fallback (contoh WFH, ODT, dll)
                return shift;
            }

            // ====== TABLE RENDER ======
            function renderAllData() {
                const $tbody = $(".kehadiran-table-body");
                const $noDataMessage = $(".no-data-message");

                $tbody.html("");

                $noDataMessage.hide().text(""); // reset dulu

                if (filteredData.length === 0) {
                    $noDataMessage.text("Tidak ada data kehadiran pada periode ini.").show();
                    return;
                }


                filteredData.forEach(kehadiran => {
                    const statusText = mapStatus(kehadiran.keterangan);
                    const statusClass = "status-" + statusText.toLowerCase();
                    const date = formatDate(kehadiran.tgl);

                    $tbody.append(`
                    <tr>
                        <td>${kehadiran.npk}</td>
                        <td style="text-align: left !important;">${kehadiran.full_name}</td>
                        <td>${mapPlan(kehadiran.plant)}</td>
                        <td>${date}</td>
                        <td>${formatShift(kehadiran.inshiftact)}</td>
                        <td>${formatShift(kehadiran.outshiftact)}</td>
                        <td>${formatShiftText(kehadiran.shift)}</td>
                        <td><span class="kehadiran-item-status ${statusClass}">${statusText}</span></td>
                    </tr>
                `);
                });
            }

            function updateKehadiranListView() {
                const activeStatus = $(".status-filter-badge.active").data("status");
                filteredData = activeStatus === "semua"
                    ? allKehadiranData
                    : allKehadiranData.filter(c => mapStatus(c.keterangan) === activeStatus);

                renderAllData();
            }

            $(".status-filter-badge").on("click", function () {
                $(".status-filter-badge").removeClass("active");
                $(this).addClass("active");

                // 🔥 reset pesan kebekas
                $(".no-data-message").hide().text("");

                updateKehadiranListView();
            });


            // ===== INIT PAGE =====
            setDefaultDateRange();
        });
    </script>

</body>
</html>
