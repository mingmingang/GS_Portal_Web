@model Template_DevExpress_By_MFM.Models.CutiModel
@{
    ViewBag.Title = "Pembatalan Cuti";
    var logSession = HttpContext.Current.Session["SHealth"] as Template_DevExpress_By_MFM.Models.SessionLogin;
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title</title>

    <!-- Link ke file CSS eksternal -->
    <link href="~/Content/CutiStyle/PembatalanCuti.css" rel="stylesheet" />

    <!-- Library CSS -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.min.css">
</head>
<body>

    <div class="page-container">
        <div class="header-section">
            <a href="@ViewBag.BackUrl" class="back-arrow">&#8592;</a>
            <h1>Pembatalan Cuti</h1>
        </div>

        <div class="main-content">
            <form id="cancellation-form">
                <div class="form-card">
                    <div class="form-group">
                        <label class="form-label">No. Pengajuan Cuti</label>
                        <input type="text" id="request_no" class="form-control" readonly>
                    </div>
                    <div class="form-group">
                        <label class="form-label">Tipe Cuti</label>
                        <input type="text" id="leave_type" class="form-control" readonly>
                    </div>
                    <div class="form-group">
                        <label class="form-label">Tanggal Cuti</label>
                        <div class="date-inputs">
                            <div class="date-input-group">
                                <label class="form-label" style="font-size: 12px; color: var(--text-color-light);">Mulai Dari</label>
                                <input type="text" id="start_date" class="form-control" readonly>
                            </div>
                            <div class="date-input-group">
                                <label class="form-label" style="font-size: 12px; color: var(--text-color-light);">Sampai Dengan</label>
                                <input type="text" id="end_date" class="form-control" readonly>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="form-card">
                    <div class="form-group">
                        <label class="form-label">Tanggal Pembatalan</label>
                        <div class="cancellation-dates-section">
                            <table class="cancellation-table">
                                <thead>
                                    <tr>
                                        <th>Tanggal</th>
                                        <th style="text-align: right;">Batalkan</th>
                                    </tr>
                                </thead>
                                <tbody id="cancellation-dates-tbody">
                                    <!-- Baris tanggal akan di-generate oleh JavaScript di sini -->
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>

                <div class="form-card">
                    <div class="form-group">
                        <label class="form-label" for="cancellation_reason">Alasan Pembatalan</label>
                        <textarea id="cancellation_reason" class="form-control" placeholder="Contoh: Tidak jadi mudik"></textarea>
                    </div>
                    <div class="form-actions">
                        <button type="submit" id="btnSubmit" class="btn-action btn-submit"><i class="fa-solid fa-paper-plane"></i> Submit</button>
                    </div>
                </div>
            </form>
        </div>
    </div>

    <!-- ======================================================= -->
    <!-- ================= BAGIAN JAVASCRIPT =================== -->
    <!-- ======================================================= -->
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <!-- Sertakan file JavaScript custom Anda -->
    <script src="~/Scripts/CutiScript/PembatalanCuti.js"></script>

    <!-- Script inisialisasi untuk mengirim data dari server ke JS -->
    <script>
        $(document).ready(function() {
            // Data dari server (Razor)
            var pageConfig = {
                cutiId: '@ViewBag.CutiId',
                userNpk: '@(logSession.empid ?? "")',
                backUrl: '@ViewBag.BackUrl'
            };

            // Panggil fungsi init dari file PembatalanCuti.js dan kirimkan data
            PembatalanCutiPage.init(pageConfig);
        });
    </script>

</body>
</html>