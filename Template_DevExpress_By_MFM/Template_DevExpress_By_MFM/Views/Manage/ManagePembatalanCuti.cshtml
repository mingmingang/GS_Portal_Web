@model Template_DevExpress_By_MFM.Models.CutiModel
@{
    ViewBag.Title = "Pembatalan Cuti";
}

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.min.css">

<style>
    @@import url('https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700&display=swap');

    :root {
        --dark-blue: #203A6D;
        --light-blue-bg: #eef5ff;
        --background-color: #f4f7fa;
        --card-bg-color: #ffffff;
        --text-color-dark: #333;
        --text-color-light: #6c757d;
        --border-color: #dee2e6;
        --green-button: #28a745;
        --green-button-hover: #218838;
    }

    body {
        margin: 0;
        font-family: 'Poppins', sans-serif;
        background-color: var(--background-color);
    }

    .page-container {
        padding-bottom: 40px;
    }

    .header-section {
        background: var(--dark-blue);
        color: white;
        padding: 20px;
        padding-top: 50px;
        text-align: center;
        position: relative;
    }

        .header-section .back-arrow {
            position: absolute;
            left: 20px;
            top: 50%;
            transform: translateY(-50%);
            font-size: 24px;
            color: white;
            text-decoration: none;
        }

        .header-section h1 {
            margin: 0;
            font-size: 20px;
            font-weight: 600;
        }

    .main-content {
        padding: 20px;
        max-width: 100%; /* Batasi lebar untuk tampilan web yang lebih baik */
        margin: 0 auto;
        margin-bottom:100px;
    }

    .form-card {
        background-color: var(--card-bg-color);
        border-radius: 16px;
        padding: 25px;
        margin-bottom: 20px;
        box-shadow: 0 4px 20px rgba(0,0,0,0.06);
    }

    .form-group {
        margin-bottom: 20px;
    }

    .form-label {
        display: block;
        font-weight: 500;
        color: var(--text-color-dark);
        margin-bottom: 8px;
        font-size: 14px;
    }

    .form-control{
        max-width:100%;
    }

    .form-control, .form-control-date {
        width: 100%;
        padding: 12px 15px;
        border: 1px solid var(--border-color);
        border-radius: 8px;
        background-color: #f8f9fa; /* Warna disabled */
        font-family: 'Poppins', sans-serif;
        font-size: 15px;
        color: var(--text-color-light);
        cursor: not-allowed;
    }

    .date-inputs {
        display: flex;
        gap: 15px;
    }

    .date-input-group {
        flex: 1;
    }

    /* === BAGIAN TANGGAL PEMBATALAN (Paling Penting) === */
    .cancellation-dates-section {
        background-color: #f7f9fc;
        border-radius: 12px;
        overflow: hidden;
        border: 1px solid #e9ecef;
    }

    .cancellation-dates-header {
        background-color: var(--dark-blue);
        color: white;
        display: flex;
        justify-content: space-between;
        padding: 12px 20px;
        font-weight: 600;
        font-size: 14px;
    }

    #cancellation-dates-container {
        padding: 10px 20px;
        display:flex;
        justify-content:space-between;
    }

    .date-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 12px 0;
        border-bottom: 1px solid #e9ecef;
    }

        .date-row:last-child {
            border-bottom: none;
        }

        .date-row label {
            color: var(--text-color-dark);
            font-size: 15px;
        }

    /* Custom Checkbox */
    .form-check-input {
        width: 1.25em;
        height: 1.25em;
        cursor: pointer;
    }

    textarea.form-control {
        min-height: 120px;
        resize: vertical;
        background-color: white; /* Textarea bisa diisi */
        cursor: text;
        color: var(--text-color-dark);
    }

    .btn-submit {
        display: block;
        width: 100%;
        padding: 15px;
        background-color: var(--green-button);
        color: white;
        border: none;
        border-radius: 12px;
        font-size: 16px;
        font-weight: 600;
        cursor: pointer;
        transition: background-color 0.3s;
    }

        .btn-submit:hover {
            background-color: var(--green-button-hover);
        }
</style>

<div class="page-container">

    <div class="header-section">
        <a href="@ViewBag.BackUrl" class="back-arrow">&#8592;</a>
        <h1>Pembatalan Cuti</h1>
    </div>

    <div class="main-content">
        <form id="cancellation-form">
            <div class="form-card">
                <div class="form-group">
                    <label class="form-label">No. Pengajuan Cuti</label>
                    <input type="text" id="request_no" class="form-control" readonly>
                </div>
                <div class="form-group">
                    <label class="form-label">Tipe Cuti</label>
                    <input type="text" id="leave_type" class="form-control" readonly>
                </div>
                <div class="form-group">
                    <label class="form-label">Tanggal Cuti</label>
                    <div class="date-inputs">
                        <div class="date-input-group">
                            <label class="form-label" style="font-size: 12px; color: var(--text-color-light);">Mulai Dari</label>
                            <input type="text" id="start_date" class="form-control" readonly>
                        </div>
                        <div class="date-input-group">
                            <label class="form-label" style="font-size: 12px; color: var(--text-color-light);">Sampai Dengan</label>
                            <input type="text" id="end_date" class="form-control" readonly>
                        </div>
                    </div>
                </div>
            </div>

            <div class="form-card">
                <div class="form-group">
                    <label class="form-label">Tanggal Pembatalan</label>
                    <div class="cancellation-dates-section">
                        <div class="cancellation-dates-header">
                            <span>Tanggal</span>
                            <span>Batalkan</span>
                        </div>
                        <div id="cancellation-dates-container">
                            <!-- Tanggal akan di-generate oleh JavaScript -->
                            <p style="text-align:center; padding: 20px; color: var(--text-color-light);">Memuat tanggal...</p>
                        </div>
                    </div>
                </div>
            </div>

            <div class="form-card">
                <div class="form-group">
                    <label class="form-label" for="cancellation_reason">Alasan Pembatalan</label>
                    <textarea id="cancellation_reason" class="form-control" placeholder="Contoh: Tidak jadi mudik"></textarea>
                </div>
            </div>

            <button type="submit" class="btn-submit">Submit</button>
        </form>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
$(document).ready(function() {
    const cutiId = '@ViewBag.CutiId';

    function loadCancellationData(id) {
        if (!id) {
            $('.main-content').html('<p style="text-align:center;">ID Pengajuan Cuti tidak valid.</p>');
            return;
        }

        const url = `/api/CutiApi/detailCuti/${id}`;
        $.ajax({
            url: url,
            type: 'GET',
            success: function(response) {
                if (response && response.data && response.data.length > 0) {
                    const cuti = response.data[0];
                    populateForm(cuti);
                    generateCancellationDates(cuti.startdate, cuti.enddate);
                } else {
                    $('.main-content').html('<p style="text-align:center;">Detail cuti tidak ditemukan.</p>');
                }
            },
            error: function() {
                $('.main-content').html('<p style="text-align:center;">Gagal memuat data cuti.</p>');
            }
        });
    }

    function populateForm(data) {
        const options = { year: 'numeric', month: 'long', day: 'numeric' };
        $('#request_no').val(data.request_no);
        $('#leave_type').val(data.leave_code); // Ganti dengan nama tipe cuti jika ada di API
        $('#start_date').val(new Date(data.startdate).toLocaleDateString('id-ID', options));
        $('#end_date').val(new Date(data.enddate).toLocaleDateString('id-ID', options));
    }

    function generateCancellationDates(startDateStr, endDateStr) {
        const $container = $('#cancellation-dates-container');
        $container.empty(); // Kosongkan container

        const startDate = new Date(startDateStr);
        const endDate = new Date(endDateStr);

        // Pastikan tanggal valid sebelum melanjutkan
        if (isNaN(startDate.getTime()) || isNaN(endDate.getTime())) {
            $container.html('<p style="text-align:center; padding: 20px; color: red;">Format tanggal dari API tidak valid.</p>');
            return;
        }

        // --- INI BAGIAN KUNCI YANG DIPERBAIKI ---
        // Pastikan 'day' ada di dalam options untuk menampilkan tanggal harian.
        const options = { year: 'numeric', month: 'long', day: 'numeric' };

        let currentDate = new Date(startDate);

        while (currentDate <= endDate) {
            const formattedDate = currentDate.toLocaleDateString('id-ID', options);
            // Format YYYY-MM-DD untuk value, penting untuk dikirim ke backend
            const valueDate = currentDate.toISOString().split('T')[0];

            const dateRowHtml = `
            <div class="date-row">
                <label for="date-${valueDate}" style="cursor: pointer;">${formattedDate}</label>
                <input class="form-check-input" type="checkbox" value="${valueDate}" id="date-${valueDate}">
            </div>
        `;
            $container.append(dateRowHtml);

            // Pindah ke hari berikutnya
            currentDate.setDate(currentDate.getDate() + 1);
        }
    }

    $('#cancellation-form').on('submit', function(e) {
        e.preventDefault();

        const selectedDates = [];
        $('#cancellation-dates-container input[type="checkbox"]:checked').each(function() {
            selectedDates.push($(this).val());
        });

        const reason = $('#cancellation_reason').val().trim();

        // Validasi
        if (selectedDates.length === 0) {
            Swal.fire('Peringatan', 'Silakan pilih minimal satu tanggal untuk dibatalkan.', 'warning');
            return;
        }
        if (reason === '') {
            Swal.fire('Peringatan', 'Alasan pembatalan tidak boleh kosong.', 'warning');
            return;
        }

        const submissionData = {
            request_no: $('#request_no').val(),
            cancelled_dates: selectedDates,
            cancellation_reason: reason
        };

        console.log("Data yang akan dikirim:", submissionData);

        // Tampilkan konfirmasi
        Swal.fire({
            title: 'Konfirmasi Pembatalan',
            text: `Anda akan membatalkan cuti pada ${selectedDates.length} hari yang dipilih. Lanjutkan?`,
            icon: 'question',
            showCancelButton: true,
            confirmButtonColor: '#3085d6',
            cancelButtonColor: '#d33',
            confirmButtonText: 'Ya, Lanjutkan!',
            cancelButtonText: 'Batal'
        }).then((result) => {
            if (result.isConfirmed) {
                // Ganti URL ini dengan endpoint API pembatalan Anda
                const apiUrl = '/api/CutiApi/cancelCuti';

                $.ajax({
                    url: apiUrl,
                    type: 'POST', // atau PUT, sesuai desain API Anda
                    contentType: 'application/json',
                    data: JSON.stringify(submissionData),
                    success: function(response) {
                        Swal.fire(
                            'Berhasil!',
                            'Pengajuan pembatalan cuti Anda telah berhasil dikirim.',
                            'success'
                        ).then(() => {
                            window.location.href = '@ViewBag.BackUrl'; 
                        });
                    },
                    error: function(xhr) {
                        Swal.fire(
                            'Gagal!',
                            'Terjadi kesalahan saat mengirim pengajuan. ' + (xhr.responseJSON?.message || ''),
                            'error'
                        );
                    }
                });
            }
        });
    });

    // Mulai memuat data saat halaman siap
    loadCancellationData(cutiId);
});
    </script>
}