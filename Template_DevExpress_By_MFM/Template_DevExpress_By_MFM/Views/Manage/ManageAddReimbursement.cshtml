@using DevExtreme.AspNet.Mvc;
@{
    ViewBag.Title = "Tambah Reimbursement";
    Layout = null;
}
<!DOCTYPE html>
<html>
<head>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewBag.Title</title>
    <!-- Referensi Font Awesome, jQuery & Select2 -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/select2/4.0.13/css/select2.min.css" rel="stylesheet" />
    <script src="https://ajax.googleapis.com/ajax/libs/jquery/3.6.0/jquery.min.js"></script>

    <style>
        body {
            margin: 0;
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
            -webkit-font-smoothing: antialiased;
            -moz-osx-font-smoothing: grayscale;
            background-color: #FFFFFF;
        }

        .reimbursement-page-container {
            background-color: #FFFFFF
        }

        .blue-section {
            background-color: #2A458A;
            padding-bottom: 70px;
            background-image: url('../../../../assets/bg_navbarbot_index_reimbursement.png');
            background-size: cover;
            background-position: center;
            background-repeat: no-repeat
        }

        .page-header-standalone {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 16px;
            position: relative
        }

        .back-button {
            color: #fff;
            font-size: 20px;
            text-decoration: none;
            position: absolute;
            left: 16px;
            top: 50%;
            transform: translateY(-50%);
            z-index: 2
        }

        .page-header-title {
            color: #fff;
            font-size: 18px;
            font-weight: bold;
            margin: 0;
            text-align: center;
            width: 100%;
            z-index: 1
        }

        .form-content-section {
            background-color: #FFFFFF;
            margin-top: -60px;
            padding: 20px 16px 24px 16px
        }

        #reimbursementForm.form {
            display: flex;
            flex-direction: column;
            gap: 24px;
            margin: 0;
            padding-top: 24px
        }

        .form-row {
            display: flex;
            flex-wrap: wrap;
            gap: 20px
        }

        .form-col {
            width: calc((100% - 40px) / 3);
            flex-shrink: 0
        }

        .file-upload-row .form-col {
            width: calc((100% - 60px) / 4)
        }

        @@media (max-width:768px) {
            .form-col, .file-upload-row .form-col {
                width: 100%
            }
        }

        .reimbursement-header {
            margin-bottom: 25px
        }

        .form-title {
            font-size: 20px;
            font-weight: 700;
            color: #111827;
            margin: 0 0 5px 0;
            display: flex;
            align-items: center;
            gap: 10px
        }

        .title-icon {
            color: #1B3D97;
            font-size: 20px
        }

        .form-subtitle {
            font-size: 14px;
            color: #6B7280;
            margin: 0
        }

        /* [PERUBAHAN CSS] Label sekarang menjadi flex container */
        label {
            font-weight: 600;
            margin-bottom: 8px;
            display: flex; /* <-- Mengaktifkan flexbox */
            align-items: baseline; /* <-- Menyejajarkan teks di dasar */
            flex-wrap: wrap;
            font-size: 14px;
            color: #374151;
        }

        .text-danger {
            color: #DC2626;
            margin: 0 8px; /* <-- Memberi jarak kiri-kanan pada asterisk */
        }

        /* [PERUBAHAN CSS] Style pesan error */
        .error-message {
            color: #DC2626;
            font-size: 12px;
            font-weight: 500;
            font-style: italic;
        }

        small {
            color: #6B7280;
            font-size: 12px;
            margin-top: 4px;
            display: block
        }

        .form-control.is-invalid {
            border-color: #DC2626 !important
        }

        .form-control, .select2-container .select2-selection--single {
            width: 100%;
            padding: 10px 12px;
            border: 1px solid #D1D5DB;
            border-radius: 8px;
            font-size: 14px;
            box-sizing: border-box;
            background-color: #ffffff;
            height: 42px !important
        }

            .form-control:disabled, input[readonly] {
                background-color: #F3F4F6;
                cursor: not-allowed;
                color: #6B7280
            }

        .select2-container--default .select2-selection--single .select2-selection__rendered {
            line-height: 20px;
            padding-left: 0;
            color: #1F2937
        }

        .select2-container--default .select2-selection--single .select2-selection__arrow {
            height: 40px
        }

        .select2-dropdown {
            border-radius: 8px;
            border: 1px solid #D1D5DB
        }

        .conditional-field {
            display: none
        }

        .note-box {
            background-color: #EFF6FF;
            padding: 15px;
            border-radius: 8px;
            font-size: 14px;
            color: #1E40AF;
            border-left: 4px solid #3B82F6
        }

            .note-box strong {
                color: #1D4ED8
            }

            .note-box.error {
                background-color: #FEF2F2;
                color: #991B1B;
                border-left-color: #EF4444
            }

        .form-actions {
            display: flex;
            justify-content: flex-end;
            gap: 12px
        }

        .btn {
            padding: 10px 28px;
            font-size: 14px;
            font-weight: 600;
            border-radius: 8px;
            border: 1px solid transparent;
            cursor: pointer;
            transition: all .2s
        }

        .btn-batal {
            background-color: #F3F4F6;
            color: #374151;
            border-color: #D1D5DB
        }

            .btn-batal:hover {
                background-color: #E5E7EB
            }

        .btn-simpan {
            background-color: #16A34A;
            color: white
        }

            .btn-simpan:hover {
                background-color: #15803D
            }

            .btn-simpan:disabled {
                background-color: #86EFAC;
                cursor: not-allowed
            }

        .custom-modal-overlay {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(0,0,0,0.5);
            display: none;
            align-items: center;
            justify-content: center;
            z-index: 1050;
            opacity: 0;
            transition: opacity .2s ease
        }

            .custom-modal-overlay.show {
                display: flex !important;
                opacity: 1
            }

        .custom-modal {
            background: white;
            padding: 30px 35px;
            border-radius: 16px;
            width: 90%;
            max-width: 400px;
            box-shadow: 0 5px 15px rgba(0,0,0,0.2);
            text-align: center;
            transform: scale(0.95);
            transition: transform .2s ease
        }

        .custom-modal-overlay.show .custom-modal {
            transform: scale(1)
        }

        .modal-title {
            font-size: 24px;
            font-weight: bold;
            color: #333;
            margin: 0 0 15px 0
        }

        .modal-text {
            font-size: 16px;
            color: #666;
            margin-bottom: 30px
        }

        .modal-actions {
            display: flex;
            justify-content: center;
            gap: 15px
        }

        .modal-btn {
            flex: 1;
            padding: 12px 20px;
            border-radius: 8px;
            border: none;
            font-size: 16px;
            font-weight: bold;
            cursor: pointer;
            transition: background-color .2s
        }

        .modal-btn-cancel {
            background-color: #E9ECEF;
            color: #495057
        }

            .modal-btn-cancel:hover {
                background-color: #dee2e6
            }

        .modal-btn-confirm {
            background-color: #1F4AB8;
            color: white
        }

            .modal-btn-confirm:hover {
                background-color: #1a3f99
            }

        .modal-icon-success .checkmark {
            width: 80px;
            height: 80px;
            border-radius: 50%;
            display: inline-block;
            stroke-width: 3;
            stroke: #fff;
            stroke-miterlimit: 10;
            box-shadow: inset 0 0 0 #28a745;
            animation: fill .4s ease-in-out .4s forwards,scale .3s ease-in-out .9s both
        }

        .modal-icon-success .checkmark-circle {
            stroke-dasharray: 166;
            stroke-dashoffset: 166;
            stroke-width: 3;
            stroke-miterlimit: 10;
            stroke: #28a745;
            fill: none;
            animation: stroke .6s cubic-bezier(0.65,0,0.45,1) forwards
        }

        .modal-icon-success .checkmark-check {
            transform-origin: 50% 50%;
            stroke-dasharray: 48;
            stroke-dashoffset: 48;
            animation: stroke .3s cubic-bezier(0.65,0,0.45,1) .8s forwards
        }

        @@keyframes stroke {
            100% {
                stroke-dashoffset: 0
            }
        }

        @@keyframes scale {
            0%, 100% {
                transform: none
            }

            50% {
                transform: scale3d(1.1,1.1,1)
            }
        }

        @@keyframes fill {
            100% {
                box-shadow: inset 0 0 0 50px #28a745
            }
        }

        .modal-text-success {
            font-size: 18px;
            color: #495057;
            margin-top: 15px;
            margin-bottom: 25px
        }
    </style>
</head>
<body>
    <div class="reimbursement-page-container">
        <div class="blue-section">
            <div class="page-header-standalone">
                <a href="javascript:window.history.back()" class="back-button" aria-label="Kembali">
                    <i class="fas fa-arrow-left"></i>
                </a>
                <h1 class="page-header-title">@ViewBag.Title</h1>
            </div>
        </div>

        <!-- SECTION 2: Form Content Area -->
        <div class="form-content-section">
            <div class="reimbursement-container">

                <div id="dateValidationError" class="note-box error" style="display: none;"></div>

                <form id="reimbursementForm" class="form" novalidate enctype="multipart/form-data">

                    <!-- Baris 1: Info Karyawan (Readonly) -->
                    <div class="form-row">
                        <div class="form-col">
                            <label>No. Pengajuan</label>
                            <input type="text" id="RmbNoRequest" name="RmbNoRequest" class="form-control" value="Memuat..." readonly>
                        </div>
                        <div class="form-col">
                            <label>NPK</label>
                            <input type="text" id="RmbNpk" name="RmbNpk" class="form-control" value="@ViewBag.Npk" readonly>
                        </div>
                        <div class="form-col">
                            <label>Nama Karyawan</label>
                            <input type="text" id="namaKaryawan" name="NamaKaryawan" class="form-control" value="@ViewBag.NamaKaryawan" readonly>
                        </div>
                    </div>

                    <input type="hidden" name="RmbPlant" value="@ViewBag.Plant">
                    <input type="hidden" name="RmbJenisClaimId" value="@ViewBag.JenisClaimId">

                    <!-- Baris 2: Data Pasien & Biaya -->
                    <div class="form-row">
                        <div class="form-col">
                            <label>Nama Pasien <span class="text-danger">*</span><span class="error-message"></span></label>
                            <select id="namaPasien" name="RmbNamaPasien" class="form-control searchable-select" required data-placeholder="Pilih Nama Pasien"></select>
                        </div>
                        <div class="form-col">
                            <label>Biaya Pengobatan <span class="text-danger">*</span><span class="error-message"></span></label>
                            <input type="number" id="rbmCost" name="RmbBiayaPeriksa" class="form-control" placeholder="Masukkan Biaya Pengobatan" required>
                        </div>
                        <div class="form-col">
                            <label id="diagnosaLabel">Diagnosa <span class="text-danger">*</span><span class="error-message"></span></label>
                            <select id="diagnosa" name="RmbDiagnosa" class="form-control searchable-select" required data-placeholder="Pilih Diagnosa"></select>
                        </div>
                    </div>

                    <!-- Baris 3: Data Medis -->
                    <div class="form-row">
                        <div class="form-col">
                            <label>Rumah Sakit<span class="text-danger">*</span><span class="error-message"></span></label>
                            <select id="rumahSakit" name="RmbRumahSakit" class="form-control searchable-select" required data-placeholder="Pilih Rumah Sakit"></select>
                        </div>
                        <div class="form-col">
                            <label>Dokter <span class="text-danger">*</span><span class="error-message"></span></label>
                            <input type="text" id="dokter" name="RmbNamaDokter" class="form-control" placeholder="Masukkan Nama Dokter" required>
                        </div>
                        <div class="form-col" id="diagnosaOtherRow" style="display: none;">
                            <label>Sebutkan Diagnosa <span class="text-danger">*</span><span class="error-message"></span></label>
                            <input type="text" id="rbmDiagnosaOther" name="RmbDiagnosaOther" class="form-control" placeholder="Tulis diagnosa spesifik...">
                        </div>
                    </div>

                    <!-- Baris 4: Tanggal -->
                    <div class="form-row">
                        <div class="form-col">
                            <label id="tanggalLabel">Tanggal Berobat <span class="text-danger">*</span><span class="error-message"></span></label>
                            <input type="date" id="mulaiDariDate" name="RmbTanggalMulai" class="form-control" required>
                        </div>
                        <div id="sampaiDenganCol" class="form-col">
                            <label>Sampai Dengan <span class="text-danger">*</span><span class="error-message"></span></label>
                            <input type="date" id="sampaiDenganDate" name="RmbTanggalAkhir" class="form-control" required>
                        </div>
                    </div>

                    <!-- Baris 5: File Uploads -->
                    <div id="fileUploadSection" class="form-row file-upload-row">
                        <div id="kwitansiUpload" class="form-col conditional-field">
                            <label>Kwitansi <span class="text-danger">*</span><span class="error-message"></span></label>
                            <input type="file" name="kwitansiFile" class="form-control" required accept=".pdf, .jpg, .jpeg">
                            <small>*.jpg, .pdf (Maks. 2MB)</small>
                        </div>
                        <div id="rincianObatUpload" class="form-col conditional-field">
                            <label>Rincian Obat <span class="text-danger">*</span><span class="error-message"></span></label>
                            <input type="file" name="rincianObatFile" class="form-control" required accept=".pdf, .jpg, .jpeg">
                            <small>*.jpg, .pdf (Maks. 2MB)</small>
                        </div>
                        <div id="hasilLabUpload" class="form-col conditional-field">
                            <label>Hasil Lab <span class="text-danger">*</span><span class="error-message"></span></label>
                            <input type="file" name="hasilLabFile" class="form-control" required accept=".pdf, .jpg, .jpeg">
                            <small>*.jpg, .pdf (Maks. 2MB)</small>
                        </div>
                        <div id="resumeMedisUpload" class="form-col conditional-field">
                            <label>Resume Medis <span class="text-danger">*</span><span class="error-message"></span></label>
                            <input type="file" name="resumeMedisFile" class="form-control" required accept=".pdf, .jpg, .jpeg">
                            <small>*.jpg, .pdf (Maks. 2MB)</small>
                        </div>
                    </div>

                    <!-- Tombol Aksi -->
                    <div class="note-box" style="display: none;"></div>
                    <div class="form-actions">
                        <button type="button" class="btn btn-batal">Batal</button>
                        <button type="submit" class="btn btn-simpan">Simpan Pengajuan</button>
                    </div>

                </form>
            </div>
        </div>

        <!-- Modals -->
        <div id="confirmModal" class="custom-modal-overlay">
            <div class="custom-modal">
                <h2 class="modal-title">Konfirmasi Pengajuan</h2>
                <p class="modal-text">Apakah Anda yakin data yang dimasukkan sudah benar?</p>
                <div class="modal-actions">
                    <button id="cancel-save-btn" class="modal-btn modal-btn-cancel">Periksa Lagi</button>
                    <button id="confirm-save-btn" class="modal-btn modal-btn-confirm">Ya, Simpan</button>
                </div>
            </div>
        </div>
        <div id="successModal" class="custom-modal-overlay">
            <div class="custom-modal">
                <div class="modal-icon-success">
                    <svg class="checkmark" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 52 52">
                        <circle class="checkmark-circle" cx="26" cy="26" r="25" fill="none" />
                        <path class="checkmark-check" fill="none" d="M14.1 27.2l7.1 7.2 16.7-16.8" />
                    </svg>
                </div>
                <p class="modal-text-success">Pengajuan Reimbursement berhasil disimpan!</p>
                <button id="close-success-btn" class="modal-btn modal-btn-confirm" style="width: 50%; margin: 0 auto;">OK</button>
            </div>
        </div>
    </div>

    <!-- Script Libraries -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/select2/4.0.13/js/select2.min.js"></script>

    <script>
    $(document).ready(function () {
        let currentClaimType = '';
        const select2Options = {
            width: '100%',
            placeholder: 'Pilih...',
            dropdownParent: $('#reimbursementForm')
        };

        const $submitButton = $('.btn-simpan');
        const originalButtonHtml = $submitButton.html();

        function setupFormLayoutByType(claimType) {
            console.log(`Menyiapkan layout form untuk jenis: "${claimType}"`);

            $('#fileUploadSection .conditional-field').hide().find('input').prop({
                required: false,
                disabled: true
            }).val('');

            $('.note-box:not(.error)').hide();
            $('#sampaiDenganCol').css('visibility', 'hidden').find('input').prop('required', false).val('');

            $('#tanggalLabel').contents().filter(function () {
                return this.nodeType === 3;
            }).first().replaceWith('Tanggal Berobat ');

            $('#diagnosaLabel').contents().filter(function () {
                return this.nodeType === 3;
            }).first().replaceWith('Diagnosa ');

            $('#diagnosa').prop('required', true);

            const enableFields = (selector) => $(selector).show().find('input').prop({
                required: true,
                disabled: false
            });

            const noteText = '<strong>Penting:</strong> Harap serahkan dokumen fisik asli ke HC maksimal 2x24 jam setelah pengajuan disetujui, dan pastikan sudah ditandatangani oleh atasan Anda.';
            let titleText = "Tambah Reimbursement";

            switch (claimType) {
                case 'Rawat Jalan':
                    titleText = 'Pengajuan Rawat Jalan';
                    enableFields('#kwitansiUpload, #rincianObatUpload');

                    break;
                case 'Kacamata':
                    titleText = 'Pengajuan Kacamata';
                    enableFields('#kwitansiUpload, #rincianObatUpload');

                    $('#diagnosaLabel').contents().filter(function () {
                        return this.nodeType === 3;
                    }).first().replaceWith('Diagnosa');

                    $('#diagnosa').prop('required', false).closest('.form-col').find('.text-danger, .error-message').hide();

                    break;
                case 'Rawat Inap':
                case 'Maternity':
                    titleText = claimType === 'Rawat Inap' ? 'Pengajuan Rawat Inap' : 'Pengajuan Maternity';

                    $('#tanggalLabel').contents().filter(function () {
                        return this.nodeType === 3;
                    }).first().replaceWith('Mulai Dari ');

                    $('#sampaiDenganCol').css('visibility', 'visible').find('input').prop('required', true);
                    enableFields('#kwitansiUpload, #rincianObatUpload, #hasilLabUpload, #resumeMedisUpload');

                    break;
                case 'KB':
                    titleText = 'Pengajuan KB';
                    enableFields('#kwitansiUpload');

                    break;
                default:
                    console.warn(`Jenis klaim "${claimType}" tidak dikenali.`);

                    break;
            }if (claimType !== 'Kacamata') {
                $('#diagnosa').closest('.form-col').find('.text-danger, .error-message').show();
            }
            $('.note-box:not(.error)').html(noteText).show(); $('.page-header-title').text(titleText);
        }

        function populatePasienDropdown() {
            return $.getJSON('@Url.Content("~/api/ReimbursementApi/list_keluarga")',
                r => {
                    const d = $('#namaPasien'), data = r.data || [];
                    d.empty().append('<option></option>');

                    if (data.length > 0) $.each(data, (i, item) => {
                        let rel = item.relationship.toLowerCase() === 'sendiri'
                            ? 'Anda' : item.relationship.charAt(0).toUpperCase() + item.relationship.slice(1);

                        d.append($('<option>', {
                            value: item.empfamily_id,
                            text: `${item.name} (${rel})`
                        }))
                    }); d.trigger('change')
                });
        }

        function populateDiagnosaDropdown() {
            return $.getJSON('@Url.Content("~/api/ReimbursementApi/getDisease")',
                r => {
                    const d = $('#diagnosa'),
                        data = r.data || [];
                    d.empty().append('<option></option>');

                    if (data.length > 0) data.forEach(item => d.append($('<option>', {
                        value: item.DiseaseCode,
                        text: item.DiseaseNameId
                    }))); d.trigger('change')
                });
        }

        function populateRumahSakitDropdown() {
            return $.getJSON('@Url.Content("~/api/ReimbursementApi/getDoctorHospital")',
                r => {
                    const d = $('#rumahSakit'),
                        data = r.data || [];
                    d.empty().append('<option></option>');

                    if (data.length > 0) data.forEach(item => d.append($('<option>', {
                        value: item.DoctorHospitalCode,
                        text: item.DoctorHospitalName
                    }))); d.trigger('change')
                });
        }

        function getAndSetReimbursementId() {
            const n = "@ViewBag.Npk",
                f = $("#RmbNoRequest");
            $submitButton.prop("disabled", !0).text("Memuat...");
            $.ajax({
                url: `/api/ReimbursementApi/generateReimbursementNo/${n}`,
                type: "GET", success: r => {
                    r && r.data && r.data.RmbNoRequest
                        ? (f.val(r.data.RmbNoRequest),
                            $submitButton.prop("disabled", !1).html(originalButtonHtml))
                        : (f.val("GAGAL"), alert("Gagal mendapatkan nomor pengajuan."))
                }, error: () => {
                    f.val("ERROR!"),
                        alert("Gagal terhubung untuk mengambil nomor pengajuan.")
                }
            })
        }


        function submitFormAjax() {
            const $confirmButton = $('#confirm-save-btn');

            $confirmButton.prop('disabled', true).html('<i class="fas fa-spinner fa-spin"></i> Menyimpan...');

            const formData = new FormData(document.getElementById('reimbursementForm'));
            let formObject = {};

            if (formData.get('RmbDiagnosa') === '001') {
                const diagnosaLainnyaValue = formData.get('RmbDiagnosaOther');

                formData.set('RmbDiagnosa', diagnosaLainnyaValue);
                formData.delete('RmbDiagnosaOther');
            }

            formData.forEach((value, key) => {
                if (!(value instanceof File)) formObject[key] = value
            });
            formObject['RmbJenisClaim'] = currentClaimType;
            formData.append('values', JSON.stringify(formObject));

            $.ajax({
                url: '/api/ReimbursementApi/createReimbursement',
                type: 'POST',
                data: formData,
                processData: false,
                contentType: false,
                success: function () {
                    console.log('AJAX Success');
                    $('#confirmModal').removeClass('show');
                    $('#successModal').addClass('show');
                },
                error: function (jqXHR) {
                    console.error('AJAX Error:', jqXHR);
                    $('#confirmModal').removeClass('show');
                    let msg = (jqXHR.responseJSON && jqXHR.responseJSON.Message) || 'Terjadi kesalahan saat menyimpan.';
                    alert('Error: ' + msg);
                    // Jika gagal, aktifkan kembali tombol utama
                    $submitButton.prop('disabled', false);
                },
                complete: function() {
                    // Selalu reset tombol popup ke keadaan semula jika proses gagal
                    if (!$('#successModal').is(':visible')) {
                       $confirmButton.prop('disabled', false).text('Ya, Simpan');
                    }
                }
            });
        }

        function validateField($field) {
            const $errorSpan = $field.closest('.form-col').find('.error-message');
            let hasValue = false; if ($field.is(':file')) {
                hasValue = $field[0].files.length > 0;
            } else {
                hasValue = $field.val() && $.trim($field.val()) !== '';
            } if (!hasValue && $field.is('[required]:visible')) {
                $errorSpan.text('Wajib diisi.');
                $field.addClass('is-invalid');

                return false;
            } else {
                $errorSpan.text('');
                $field.removeClass('is-invalid');

                return true;
            }
        }
        function initRealTimeValidation() {
             console.log("Mengaktifkan validasi real-time...");
             $('#reimbursementForm').on('blur input change', ':input[required]', function() {
                validateField($(this));
            });
        }
        function loadAllMasterData() {
            getAndSetReimbursementId();

            $.when(populatePasienDropdown(), populateDiagnosaDropdown(), populateRumahSakitDropdown()).done(() => {
                console.log("SUKSES: Semua data API berhasil dimuat.");
                $('.searchable-select').select2(select2Options);
                $('#diagnosa').on('change', function () {
                    if ($(this).val() === '001') {
                        $('#diagnosaOtherRow').show().find('input').prop('required', true);
                    } else { $('#diagnosaOtherRow').hide().find('input').prop('required', false).val(''); }
                }); initRealTimeValidation();
            }).fail(() => alert("Gagal memuat data master. Silakan muat ulang halaman."));
        }

        $('.btn-batal').on('click', () => window.history.back());

        // [MODIFIKASI] Event Handler Form Submit
        $('#reimbursementForm').on('submit', function (event) {
            event.preventDefault();

            let isFormValid = true;
            $('#dateValidationError').hide();

            $(this).find(':input[required]:visible').each(function () {
                if (!validateField($(this))) {
                    isFormValid = false;
                }
            });

            const MAX_FILE_SIZE_MB = 2, MAX_FILE_SIZE_BYTES = MAX_FILE_SIZE_MB * 1024 * 1024;

            $(this).find('input[type="file"]:visible').each(function () {
                if (this.files[0] && this.files[0].size > MAX_FILE_SIZE_BYTES) {
                    isFormValid = false;
                    const $errorSpan = $(this).closest('.form-col').find('.error-message');

                    if ($errorSpan.text() === '') $errorSpan.text(`File > ${MAX_FILE_SIZE_MB}MB`); $(this).addClass('is-invalid');
                }
            });
            const startDate = $('#mulaiDariDate').val(), endDate = $('#sampaiDenganDate').val();

            if ($('#sampaiDenganCol').is(':visible') && startDate && endDate && startDate > endDate) {
                isFormValid = false;
                $('#dateValidationError').text("Tanggal 'Mulai Dari' tidak boleh melebihi 'Sampai Dengan'.").show();
            }

            if (isFormValid) {
                // Nonaktifkan tombol utama SAAT popup muncul
                $submitButton.prop('disabled', true);
                $('#confirmModal').addClass('show');
            }
        });

        // Inisialisasi awal
        try {
            currentClaimType = new URLSearchParams(window.location.search).get('type');
            if (currentClaimType) {
                setupFormLayoutByType(currentClaimType);
                loadAllMasterData();
            }
            else {
                alert("Jenis klaim tidak valid.");
                $('#reimbursementForm :input, .btn-simpan').prop('disabled', true).text('Tidak Valid');
            }
        } catch (e) {
            alert("Terjadi kesalahan, form tidak dapat dimuat.");
            $('#reimbursementForm :input').prop('disabled', true);
        }


        $('#confirm-save-btn').on('click', submitFormAjax);

        $('#cancel-save-btn, .custom-modal-overlay').on('click', function(e) {
            // Jika user membatalkan (klik tombol "Periksa Lagi" atau klik area luar modal)
            if (e.target === this || $(this).is('#cancel-save-btn')) {
                $(this).closest('.custom-modal-overlay').removeClass('show');
                // Aktifkan kembali tombol utama
                $submitButton.prop('disabled', false);
            }
        });

        $('#close-success-btn').on('click', () => window.location.href = '@Url.Action("ManageReimbursementKaryawan", "Manage")');
    });
    </script>
</body>
</html>