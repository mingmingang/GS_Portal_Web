@using DevExtreme.AspNet.Mvc;
@{
    ViewBag.Title = "Tambah Reimbursement";
    Layout = null;
}

@helper RenderFileUpload(string id, string label, string name)
{
    <div id="@id" class="form-col conditional-field">
        <label>@label <span class="text-danger">*</span><span class="error-message"></span></label>
        <div class="file-upload-wrapper">
            <!-- Tombol Aksi -->
            <div class="file-upload-actions">
                <button type="button" class="btn-upload" data-action="pick"><i class="fas fa-file-alt"></i> Pilih File</button>
                <button type="button" class="btn-upload" data-action="capture"><i class="fas fa-camera"></i> Kamera</button>
            </div>
            <!-- Input File Asli (disembunyikan) -->
            <!-- [PERBAIKAN 2] Menghapus 'image/*' agar dialog file lebih spesifik -->
            <input type="file" name="@name" class="file-input-hidden" required accept=".pdf, .jpg, .jpeg" style="display: none;">
            <!-- Preview Nama File -->
            <div class="file-preview">
                <span class="file-name">Belum ada file dipilih</span>
            </div>
        </div>
        <small>*.jpg, .jpeg, .pdf (Maks. 2MB)</small>
    </div>
}
<!DOCTYPE html>
<html>
<head>
    <meta name="viewport" content="width=device-width, initial-scale-1.0" />
    <title>@ViewBag.Title</title>
    <!-- Referensi Font Awesome, jQuery & Select2 -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/select2/4.0.13/css/select2.min.css" rel="stylesheet" />
    <script src="https://ajax.googleapis.com/ajax/libs/jquery/3.6.0/jquery.min.js"></script>

    <style>
        body {
            margin: 0;
/*            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;*/
            font-family: 'Inter', sans-serif;
            -webkit-font-smoothing: antialiased;
            -moz-osx-font-smoothing: grayscale;
            background-color: #FFFFFF;
        }

        .reimbursement-page-container {
            background-color: #FFFFFF
        }

        .blue-section {
            background-color: #2A458A;
            background: linear-gradient(135deg, #1E2D56 0%, #2A4A7B 100%);
            /*            padding-bottom: 70px;*/
            /*            background-image: url('../../../../assets/bg_navbarbot_index_reimbursement.png');*/
            background-size: cover;
            background-position: center;
            background-repeat: no-repeat;
            position: sticky;
            top: 0;
            z-index: 10;
        }

        .blue-section2 {
            background-color: #2A458A;
            background: linear-gradient(135deg, #1E2D56 0%, #2A4A7B 100%);
            padding-bottom: 70px;
/*            background-image: url('../../../../assets/bg_navbarbot_index_reimbursement.png');*/
            background-size: cover;
            background-position: center;
            background-repeat: no-repeat
        }

        .page-header-standalone {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 16px;
            position: relative
        }

        .back-button {
            color: #fff;
            font-size: 20px;
            text-decoration: none;
            position: absolute;
            left: 16px;
            top: 50%;
            transform: translateY(-50%);
            z-index: 2
        }

        .page-header-title {
            color: #fff;
            font-size: 18px;
            font-weight: bold;
            margin: 0;
            text-align: center;
            width: 100%;
            z-index: 1
        }

        .form-content-section {
            background-color: #FFFFFF;
            margin-top: -30px;
            padding: 20px 16px 24px 16px
        }

        #reimbursementForm.form {
            display: flex;
            flex-direction: column;
            gap: 24px;
            margin: 0;
            padding-top: 24px
        }

        .form-row {
            display: flex;
            flex-wrap: wrap;
            gap: 20px
        }

        .form-col {
            width: calc((100% - 40px) / 3);
            flex-shrink: 0
        }

        .file-upload-row .form-col {
            width: calc((100% - 60px) / 4)
        }

        @@media (max-width:768px) {
            .form-col, .file-upload-row .form-col {
                width: 100%
            }
        }

        .reimbursement-header {
            margin-bottom: 25px
        }

        .form-title {
            font-size: 20px;
            font-weight: 700;
            color: #111827;
            margin: 0 0 5px 0;
            display: flex;
            align-items: center;
            gap: 10px
        }

        .title-icon {
            color: #1B3D97;
            font-size: 20px
        }

        .form-subtitle {
            font-size: 14px;
            color: #6B7280;
            margin: 0
        }

        label {
            font-weight: 600;
            margin-bottom: 8px;
            display: flex;
            align-items: baseline;
            flex-wrap: wrap;
            font-size: 14px;
            color: #374151;
        }

        .text-danger {
            color: #DC2626;
            margin: 0 8px;
        }

        .error-message {
            color: #DC2626;
            font-size: 12px;
            font-weight: 500;
            font-style: italic;
        }

        small {
            color: #6B7280;
            font-size: 12px;
            margin-top: 4px;
            display: block
        }

        /* [PERBAIKAN 1] Tambahkan style ini agar field tanggal (date) juga ikut merah */
        input[type="date"].form-control.is-invalid {
            border-color: #DC2626 !important;
        }

        .form-control.is-invalid {
            border-color: #DC2626 !important
        }

        select.form-control.is-invalid + .select2-container--default .select2-selection--single {
            border-color: #DC2626 !important;
        }


        .form-control, .select2-container .select2-selection--single {
            width: 100%;
            padding: 10px 12px;
            border: 1px solid #D1D5DB;
            border-radius: 8px;
            font-size: 14px;
            box-sizing: border-box;
            background-color: #ffffff;
            height: 42px !important
        }

            .form-control:disabled, input[readonly] {
                background-color: #F3F4F6;
                cursor: not-allowed;
                color: #6B7280
            }

        .select2-container--default .select2-selection--single .select2-selection__rendered {
            line-height: 20px;
            padding-left: 0;
            color: #1F2937
        }

        .select2-container--default .select2-selection--single .select2-selection__arrow {
            height: 40px
        }

        .select2-dropdown {
            border-radius: 8px;
            border: 1px solid #D1D5DB
        }

        .conditional-field {
            display: none
        }

        .note-box {
            background-color: #EFF6FF;
            padding: 15px;
            border-radius: 8px;
            font-size: 14px;
            color: #1E40AF;
            border-left: 4px solid #3B82F6
        }

            .note-box strong {
                color: #1D4ED8
            }

            .note-box.error {
                background-color: #FEF2F2;
                color: #991B1B;
                border-left-color: #EF4444
            }

        .form-actions {
            display: flex;
            justify-content: flex-end;
            gap: 12px
        }

        .btn {
            padding: 10px 28px;
            font-size: 14px;
            font-weight: 600;
            border-radius: 8px;
            border: 1px solid transparent;
            cursor: pointer;
            transition: all .2s
        }

        .btn-batal {
            background-color: #F3F4F6;
            color: #374151;
            border-color: #D1D5DB
        }

            .btn-batal:hover {
                background-color: #E5E7EB
            }

        .btn-simpan {
            /*            background-color: #16A34A;*/
            background-color: #198754;
            color: white
        }

            .btn-simpan:hover {
                background-color: #15803D;
            }

            .btn-simpan:disabled {
                background-color: #86EFAC;
                cursor: not-allowed
            }

        .custom-modal-overlay {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(0,0,0,0.5);
            display: none;
            align-items: center;
            justify-content: center;
            z-index: 1050;
            opacity: 0;
            transition: opacity .2s ease
        }

            .custom-modal-overlay.show {
                display: flex !important;
                opacity: 1
            }

        .custom-modal {
            background: white;
            padding: 30px 35px;
            border-radius: 16px;
            width: 90%;
            max-width: 400px;
            box-shadow: 0 5px 15px rgba(0,0,0,0.2);
            text-align: center;
            transform: scale(0.95);
            transition: transform .2s ease
        }

        .custom-modal-overlay.show .custom-modal {
            transform: scale(1)
        }

        .modal-title {
            font-size: 24px;
            font-weight: bold;
            color: #333;
            margin: 0 0 15px 0
        }

        .modal-text {
            font-size: 16px;
            color: #666;
            margin-bottom: 30px;
            line-height: 1.5;
        }

        .modal-actions {
            display: flex;
            justify-content: center;
            gap: 15px
        }

        .modal-btn {
            flex: 1;
            padding: 12px 20px;
            border-radius: 8px;
            border: none;
            font-size: 16px;
            font-weight: bold;
            cursor: pointer;
            transition: background-color .2s
        }

        .modal-btn-cancel {
            background-color: #E9ECEF;
            color: #495057
        }

            .modal-btn-cancel:hover {
                background-color: #dee2e6
            }

        .modal-btn-confirm {
            background-color: #1F4AB8;
            color: white
        }

            .modal-btn-confirm:hover {
                background-color: #1a3f99
            }

        .modal-icon-success .checkmark {
            width: 80px;
            height: 80px;
            border-radius: 50%;
            display: inline-block;
            stroke-width: 3;
            stroke: #fff;
            stroke-miterlimit: 10;
            box-shadow: inset 0 0 0 #28a745;
            animation: fill .4s ease-in-out .4s forwards,scale .3s ease-in-out .9s both
        }

        .modal-icon-success .checkmark-circle {
            stroke-dasharray: 166;
            stroke-dashoffset: 166;
            stroke-width: 3;
            stroke-miterlimit: 10;
            stroke: #28a745;
            fill: none;
            animation: stroke .6s cubic-bezier(0.65,0,0.45,1) forwards
        }

        .modal-icon-success .checkmark-check {
            transform-origin: 50% 50%;
            stroke-dasharray: 48;
            stroke-dashoffset: 48;
            animation: stroke .3s cubic-bezier(0.65,0,0.45,1) .8s forwards
        }

        @@keyframes stroke {
            100% {
                stroke-dashoffset: 0
            }
        }

        @@keyframes scale {
            0%, 100% {
                transform: none
            }

            50% {
                transform: scale3d(1.1,1.1,1)
            }
        }

        @@keyframes fill {
            100% {
                box-shadow: inset 0 0 0 50px #28a745
            }
        }

        .modal-text-success {
            font-size: 18px;
            color: #495057;
            margin-top: 15px;
            margin-bottom: 25px
        }

        .file-upload-wrapper {
            width: 100%;
        }

        .file-upload-actions {
            display: flex;
            gap: 10px;
            margin-bottom: 8px;
        }

        .btn-upload {
            flex: 1;
            padding: 8px 12px;
            font-size: 14px;
            font-weight: 500;
            border-radius: 6px;
            border: 1px solid #D1D5DB;
            background-color: #F9FAFB;
            color: #374151;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            transition: background-color .2s;
        }

            .btn-upload:hover {
                background-color: #F3F4F6;
            }

        .file-preview {
            font-size: 13px;
            color: #4B5563;
            padding: 8px 12px;
            background-color: #F3F4F6;
            border-radius: 6px;
            border: 1px dashed #D1D5DB;
            text-align: center;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

            .file-preview .file-name {
                font-style: italic;
                color: #6B7280;
            }

                .file-preview .file-name.selected {
                    font-style: normal;
                    font-weight: 500;
                    color: #1F2937;
                }

        .file-upload-wrapper.is-invalid .file-preview {
            border-color: #EF4444;
            border-style: solid;
        }

    </style>
</head>
<body>
    <div class="reimbursement-page-container">
        <div class="blue-section">
            <div class="page-header-standalone">
                <a href="javascript:window.history.back()" class="back-button" aria-label="Kembali">
                    <i class="fas fa-arrow-left"></i>
                </a>
                <h1 class="page-header-title">@ViewBag.Title</h1>
            </div>
        </div>

        <!-- SECTION 2: Form Content Area -->
        <div class="form-content-section">
            <div class="reimbursement-container">


                <form id="reimbursementForm" class="form" novalidate enctype="multipart/form-data">
                <div id="dateValidationError" class="note-box error" style="display: none;"></div>

                    <!-- Baris 1: Info Karyawan (Readonly) -->
                    <div class="form-row">
                        <div class="form-col">
                            <label>No. Pengajuan</label>
                            <input type="text" id="RmbNoRequest" name="RmbNoRequest" class="form-control" value="Memuat..." readonly>
                        </div>
                        <div class="form-col">
                            <label>NPK</label>
                            <input type="text" id="RmbNpk" name="RmbNpk" class="form-control" value="@ViewBag.Npk" readonly>
                        </div>
                        <div class="form-col">
                            <label>Nama Karyawan</label>
                            <input type="text" id="namaKaryawan" name="NamaKaryawan" class="form-control" value="@ViewBag.NamaKaryawan" readonly>
                        </div>
                    </div>

                    <input type="hidden" name="RmbPlant" value="@ViewBag.Plant">
                    <input type="hidden" name="RmbJenisClaimId" value="@ViewBag.JenisClaimId">

                    <!-- Baris 2: Data Pasien & Biaya -->
                    <div class="form-row">
                        <div class="form-col">
                            <label>Nama Pasien <span class="text-danger">*</span><span class="error-message"></span></label>
                            <select id="RmbNamaPasien" name="RmbNamaPasien" class="form-control searchable-select" required data-placeholder="Pilih Nama Pasien"></select>
                        </div>
                        <div class="form-col">
                            <label>Biaya Pengobatan <span class="text-danger">*</span><span class="error-message"></span></label>
                            <input type="text" id="rbmCost" class="form-control" placeholder="Masukkan Biaya Pengobatan" required maxlength="25">
                            <input type="hidden" id="RmbBiayaPeriksaHidden" name="RmbBiayaPeriksa">
                        </div>
                        <div class="form-col">
                            <label id="diagnosaLabel">Diagnosa <span class="text-danger">*</span><span class="error-message"></span></label>
                            <select id="diagnosa" name="RmbDiagnosa" class="form-control searchable-select" required data-placeholder="Pilih Diagnosa"></select>
                        </div>
                    </div>

                    <!-- Baris 3: Data Medis -->
                    <div class="form-row">
                        <div class="form-col">
                            <label>Rumah Sakit<span class="text-danger">*</span><span class="error-message"></span></label>
                            <select id="rumahSakit" name="RmbRumahSakit" class="form-control searchable-select" required data-placeholder="Pilih Rumah Sakit"></select>
                        </div>
                        <div class="form-col">
                            <label>Dokter <span class="text-danger">*</span><span class="error-message"></span></label>
                            <input type="text" id="dokter" name="RmbNamaDokter" class="form-control" placeholder="Masukkan Nama Dokter" required maxlength="50">
                        </div>
                        <div class="form-col" id="diagnosaOtherRow" style="display: none;">
                            <label>Sebutkan Diagnosa <span class="text-danger">*</span><span class="error-message"></span></label>
                            <input type="text" id="rbmDiagnosaOther" name="RmbDiagnosaOther" class="form-control" placeholder="Tulis diagnosa spesifik...">
                        </div>
                    </div>

                    <!-- Baris 4: Tanggal -->
                    <div class="form-row">
                        <div class="form-col">
                            <label id="tanggalLabel">Tanggal Berobat <span class="text-danger">*</span><span class="error-message"></span></label>
                            <input type="date" id="mulaiDariDate" name="RmbTanggalMulai" class="form-control" required>
                        </div>
                        <div id="sampaiDenganCol" class="form-col">
                            <label>Sampai Dengan <span class="text-danger">*</span><span class="error-message"></span></label>
                            <input type="date" id="sampaiDenganDate" name="RmbTanggalAkhir" class="form-control" required>
                        </div>
                    </div>

                    <!-- Baris 5: File Uploads -->
                    <div id="fileUploadSection" class="form-row file-upload-row">
                        @RenderFileUpload("kwitansiUpload", "Kwitansi", "kwitansiFile")
                        @RenderFileUpload("rincianObatUpload", "Rincian Obat", "rincianObatFile")
                        @RenderFileUpload("hasilLabUpload", "Hasil Lab", "hasilLabFile")
                        @RenderFileUpload("resumeMedisUpload", "Resume Medis", "resumeMedisFile")
                    </div>

                    <!-- Tombol Aksi -->
                    <div class="note-box" style="display: none;"></div>
                    <div class="form-actions">
                        <button type="button" class="btn btn-batal">Batal</button>
                        <button type="submit" class="btn btn-simpan">Kirim</button>
                    </div>

                </form>
            </div>
        </div>

        <!-- Modals -->
        <div id="confirmModal" class="custom-modal-overlay">
            <div class="custom-modal">
                <h2 class="modal-title">Konfirmasi Pengajuan</h2>
                <p class="modal-text">Apakah Anda yakin data yang dimasukkan sudah benar?</p>
                <div class="modal-actions">
                    <button id="cancel-save-btn" class="modal-btn modal-btn-cancel">Periksa Lagi</button>
                    <button id="confirm-save-btn" class="modal-btn modal-btn-confirm">Ya, Kirim</button>
                </div>
            </div>
        </div>
        <div id="successModal" class="custom-modal-overlay">
            <div class="custom-modal">
                <div class="modal-icon-success">
                    <svg class="checkmark" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 52 52">
                        <circle class="checkmark-circle" cx="26" cy="26" r="25" fill="none" />
                        <path class="checkmark-check" fill="none" d="M14.1 27.2l7.1 7.2 16.7-16.8" />
                    </svg>
                </div>
                <p class="modal-text-success">Pengajuan Reimbursement berhasil disimpan!</p>
                <button id="close-success-btn" class="modal-btn modal-btn-confirm" style="width: 50%; margin: 0 auto;">OK</button>
            </div>
        </div>

        <!-- [PERUBAHAN 1] Modal ini sekarang menjadi Modal Konfirmasi, bukan hanya peringatan -->
        <div id="plafondWarningModal" class="custom-modal-overlay">
            <div class="custom-modal">
                <h2 class="modal-title" style="color: #F59E0B; display: flex; align-items: center; justify-content: center; gap: 10px;">
                    <i class="fas fa-exclamation-triangle"></i> Plafon Tidak Cukup!
                </h2>
                <p class="modal-text" id="plafondWarningText"></p>
                <div class="modal-actions">
                    <!-- Tombol Batal & Lanjutkan -->
                    <button id="cancel-plafond-btn" class="modal-btn modal-btn-cancel">Batal</button>
                    <button id="confirm-continue-anyway-btn" class="modal-btn modal-btn-confirm" style="background-color:#DC2626;">Ya, Lanjutkan</button>
                </div>
            </div>
        </div>
    </div>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/select2/4.0.13/js/select2.min.js"></script>

    <script>
        $(document).ready(function () {
            const today = new Date();
            const currentYear = today.getFullYear();

            const todayString = today.toISOString().split('T')[0];
            const startOfYearString = `${currentYear}-01-01`;
            const endOfYearString = `${currentYear}-12-31`;

            $('#mulaiDariDate').attr({
                'min': startOfYearString,
                'max': todayString
            });

            $('#sampaiDenganDate').attr({
                'min': startOfYearString,
                'max': ''
            });

            //$('#sampaiDenganDate').attr('max', todayString);

            const $startDateInput = $('#mulaiDariDate');
            const $endDateInput = $('#sampaiDenganDate');
            $endDateInput.prop('disabled', true);
            $startDateInput.on('change', function () {
                const startDateValue = $(this).val();
                if (startDateValue) {
                    $endDateInput.prop('disabled', false).attr('min', startDateValue);
                    if ($endDateInput.val() < startDateValue) {
                        $endDateInput.val('');
                    }
                } else {
                    $endDateInput.prop('disabled', true).val('').attr('min', startOfYearString);
                }
            });

            // Definisikan dua variabel untuk menyimpan kedua jenis nama claim.
            let claimTypeForDb = '';       // e.g., "KB", "Rawat Jalan" (Untuk disimpan)
            let claimTypeForLayout = '';   // e.g., "HR Reimbursement..." (Untuk logika layout)
            let currentClaimType = '';
            let plafondSummaryData = null;

            function fetchPlafondSummary() {
                const npk = "@ViewBag.Npk";
                const plant = "@ViewBag.Plant";
                return $.ajax({
                    url: `/api/ReimbursementApi/getReimbursementSummary/${npk}/${plant}?year=${currentYear}`,
                    type: 'GET',
                    success: function (response) {
                        if (response && response.data && response.data.length > 0) {
                            plafondSummaryData = response.data[0];
                        } else {
                            plafondSummaryData = null;
                        }
                    },
                    error: function () {
                        plafondSummaryData = null;
                    }
                });
            }

            function getRelevantPlafond(claimType, summaryData) {
                if (!summaryData || !summaryData.DetailedSummary) return null;
                const lowerCaseClaimType = claimType.toLowerCase();
                let plafondDetail = summaryData.DetailedSummary.find(p => p.Title.toLowerCase() === lowerCaseClaimType) ||
                                    summaryData.DetailedSummary.find(p => p.Title.toLowerCase().includes(lowerCaseClaimType));
                return plafondDetail || summaryData.CollapsedSummary || null;
            }

            const select2Options = { width: '100%', placeholder: 'Pilih...', dropdownParent: $('#reimbursementForm') };
            $('#rbmCost').on('input', function () {
                let rawValue = $(this).val().replace(/[^0-9]/g, '');
                $('#RmbBiayaPeriksaHidden').val(rawValue);
                if (rawValue === '' || isNaN(parseInt(rawValue))) { $(this).val(''); return; }
                $(this).val('Rp ' + parseInt(rawValue, 10).toLocaleString('id-ID'));
                $(this).trigger('change');
            }).on('blur', function () { validateField($(this)); });

            const $submitButton = $('.btn-simpan');
            const originalButtonHtml = $submitButton.html();

            $('#dokter').on('input', function (e) {
                // Regex: Mengizinkan huruf (a-z, A-Z), spasi, titik (.), dan koma (,)
                // Karakter selain itu akan dihapus.
                const regex = /[^a-zA-Z .,]/g;
                let currentValue = $(this).val();
                let sanitizedValue = currentValue.replace(regex, '');

                // Update value input jika ada perubahan
                if (currentValue !== sanitizedValue) {
                    $(this).val(sanitizedValue);
                }
            });

            function setupFormLayoutByType(claimType) {
                $('#fileUploadSection .conditional-field').hide().find('input[type="file"]').prop({ required: false, disabled: true }).val('').trigger('change');
                $('.note-box:not(.error)').hide();
                $('#sampaiDenganCol').css('visibility', 'hidden').find('input').prop('required', false).val('');
                $('#tanggalLabel').contents().filter((i, el) => el.nodeType === 3).first().replaceWith('Tanggal Berobat ');
                $('#diagnosaLabel').contents().filter((i, el) => el.nodeType === 3).first().replaceWith('Diagnosa ');
                $('#diagnosa').prop('required', true).closest('.form-col').find('.text-danger, .error-message').show();

                const enableFields = (selector) => $(selector).show().find('input').prop({ required: true, disabled: false });
                const noteText = '<strong>Catatan:</strong> Harap serahkan dokumen fisik asli ke HC maksimal 2x24 jam dengan kondisi sudah ditandatangani oleh atasan anda (minimal kepala seksi).';
                let titleText = "Tambah Reimbursement";

                const lowerCaseClaimType = claimType.toLowerCase();

                // -- KELOMPOK RAWAT INAP --
                // Mencakup: 'Rawat Inap Kary Kontrak', 'Rawat Inap Kary Tetap'
                if (lowerCaseClaimType.includes('rawat inap')) {
                    titleText = 'Pengajuan Rawat Inap';
                    // Butuh tanggal mulai & akhir
                    $('#tanggalLabel').contents().filter((i, el) => el.nodeType === 3).first().replaceWith('Mulai Dari ');
                    $('#sampaiDenganCol').css('visibility', 'visible').find('input').prop('required', true);
                    // Semua file upload diperlukan
                    enableFields('#kwitansiUpload, #rincianObatUpload, #hasilLabUpload, #resumeMedisUpload');
                }

                // -- KELOMPOK MATERNITY --
                // Mencakup: 'Melahirkan, Cesar dan Keguguran'
                else if (lowerCaseClaimType.includes('melahirkan') || lowerCaseClaimType.includes('cesar') || lowerCaseClaimType.includes('keguguran')) {
                    titleText = 'Pengajuan Maternity';
                    // Butuh tanggal mulai & akhir
                    $('#tanggalLabel').contents().filter((i, el) => el.nodeType === 3).first().replaceWith('Mulai Dari ');
                    $('#sampaiDenganCol').css('visibility', 'visible').find('input').prop('required', true);
                    // Semua file upload diperlukan
                    enableFields('#kwitansiUpload, #rincianObatUpload, #hasilLabUpload, #resumeMedisUpload');
                }

                // -- KELOMPOK KACAMATA --
                // Mencakup: Semua jenis 'Lensa' dan 'Frame'
                else if (lowerCaseClaimType.includes('lensa') || lowerCaseClaimType.includes('frame')) {
                    titleText = 'Pengajuan Kacamata';
                    enableFields('#kwitansiUpload, #rincianObatUpload');
                    // Kacamata tidak perlu diagnosa wajib, jadi sembunyikan requirement-nya
                    $('#diagnosa').prop('required', false).closest('.form-col').find('.text-danger, .error-message').hide();
                }

                // -- KELOMPOK KB (KELUARGA BERENCANA) --
                // Mencakup: 'Keluarga Berencana'
                else if (lowerCaseClaimType.includes('keluarga berencana')) {
                    titleText = 'Pengajuan KB';
                    // KB biasanya hanya perlu kwitansi
                    enableFields('#kwitansiUpload');
                }

                // -- KELOMPOK RAWAT JALAN (SEBAGAI DEFAULT) --
                // Mencakup: 'Rawat Jalan Karyawan', 'Rawat Jalan Direksi', 'Rawat Jalan Kontrak'
                // Logika ini akan menangkap semua yang tidak cocok di atas, termasuk semua varian 'Rawat Jalan'
                else {
                    titleText = 'Pengajuan Rawat Jalan';
                    enableFields('#kwitansiUpload, #rincianObatUpload');
                }
                $('.note-box:not(.error)').html(noteText).show();
                $('.page-header-title').text(titleText);
            }

            function populatePasienDropdown() {
                // Panggil endpoint proxy yang BENAR. Tidak perlu parameter empid di URL.
                return $.getJSON('@Url.Content("~/api/ReimbursementApi/list_keluarga")', function(response) {

                    const selectDropdown = $('#RmbNamaPasien');

                    // NOTE: Lihat di response.meta dulu untuk cek error atau sukses
                    // Berdasarkan API GsTracker, data ada di response.data
                    const data = response.data || [];
                    // ... sisa kode Anda tetap sama
                    // ... (mengisi dropdown dari 'data')
                    // ...

                    selectDropdown.empty().append('<option></option>');

                    if (data.length > 0) {
                        // Pastikan sorting ini aman jika relationship tidak ada
                        data.sort(function(a, b) {
                            if (a.relationship && a.relationship.toLowerCase() === 'sendiri') return -1;
                            if (b.relationship && b.relationship.toLowerCase() === 'sendiri') return 1;
                            return 0;
                        });

                        $.each(data, function(index, item) {
                            let rel = item.relationship || '';
                            let relationshipLabel = rel.toLowerCase() === 'sendiri' ? 'Anda' : (rel ? rel.charAt(0).toUpperCase() + rel.slice(1) : '');

                            let optionText = `${item.name} (${relationshipLabel})`;

                            // PASTIKAN Anda sudah memperbaiki API gstracker Anda
                            // untuk mengembalikan 'empfamily_id'
                            let optionValue = item.empfamily_id;

                            selectDropdown.append($('<option>', {
                                value: optionValue,
                                text: optionText
                            }));
                        });
                    }

                    selectDropdown.trigger('change');

                }).fail(function() {
                    console.error("Gagal mengambil data keluarga.");
                    alert("Tidak dapat memuat daftar nama pasien. Silakan coba muat ulang halaman.");
                });
            }

            function populateDiagnosaDropdown() {
                return $.getJSON('@Url.Content("~/api/ReimbursementApi/getDisease")', r => { const d = $('#diagnosa'), data = r.data || []; d.empty().append('<option></option>'); if (data.length > 0) data.forEach(item => d.append($('<option>', { value: item.DiseaseCode, text: item.DiseaseNameId }))); d.trigger('change') });
            }

            function populateRumahSakitDropdown() {
                return $.getJSON('@Url.Content("~/api/ReimbursementApi/getDoctorHospital")', r => { const d = $('#rumahSakit'), data = r.data || []; d.empty().append('<option></option>'); if (data.length > 0) data.forEach(item => d.append($('<option>', { value: item.DoctorHospitalCode, text: item.DoctorHospitalName }))); d.trigger('change') });
            }

            function getAndSetReimbursementId() {
                const n = "@ViewBag.Npk", f = $("#RmbNoRequest");
                $submitButton.prop("disabled", true).text("Memuat...");
                $.ajax({ url: `/api/ReimbursementApi/generateReimbursementNo/${n}`, type: "GET", success: r => { r && r.data && r.data.RmbNoRequest ? (f.val(r.data.RmbNoRequest), $submitButton.prop("disabled", false).html(originalButtonHtml)) : (f.val("GAGAL"), alert("Gagal mendapatkan nomor pengajuan.")) }, error: () => { f.val("ERROR!"), alert("Gagal terhubung untuk mengambil nomor pengajuan.") } })
            }

            function submitFormAjax() {
                const $confirmButton = $('#confirm-save-btn, #confirm-continue-anyway-btn');
                $confirmButton.prop('disabled', true).html('<i class="fas fa-spinner fa-spin"></i> Menyimpan...');

                const formData = new FormData(document.getElementById('reimbursementForm'));
                let formObject = {};
                if (formData.get('RmbDiagnosa') === '001') {
                    formData.set('RmbDiagnosa', formData.get('RmbDiagnosaOther'));
                }
                formData.delete('RmbDiagnosaOther');
                formData.forEach((value, key) => { if (!(value instanceof File)) formObject[key] = value });
                //formObject['RmbJenisClaim'] = currentClaimType;
                formObject['RmbJenisClaim'] = claimTypeForDb;
                formData.append('values', JSON.stringify(formObject));
                $.ajax({
                    url: '/api/ReimbursementApi/createReimbursement', type: 'POST', data: formData, processData: false, contentType: false,
                    success: () => {
                        $('.custom-modal-overlay').removeClass('show');
                        $('#successModal').addClass('show');
                    },
                    error: (jqXHR) => {
                        $('.custom-modal-overlay').removeClass('show');
                        alert('Error: ' + ((jqXHR.responseJSON && jqXHR.responseJSON.Message) || 'Terjadi kesalahan saat menyimpan.'));
                        $submitButton.prop('disabled', false);
                    },
                    complete: () => {
                        if (!$('#successModal').is(':visible')) {
                            $confirmButton.prop('disabled', false).text('Ya, Kirim'); // reset both buttons
                            $('#confirm-continue-anyway-btn').text('Ya, Lanjutkan');
                        }
                    }
                });
            }

            function validateField($field) {
                const isFileInput = $field.is('input[type="file"]');
                const $parentCol = $field.closest('.form-col');
                const $errorSpan = $parentCol.find('.error-message');
                let hasValue = isFileInput ? $field[0].files.length > 0 : ($field.val() && $.trim($field.val()) !== '');
                let $targetInvalid = isFileInput ? $field.closest('.file-upload-wrapper') : $field;

                if ($field.is('[required]') && !hasValue) {
                    $errorSpan.text('Wajib diisi.');
                    $targetInvalid.addClass('is-invalid');
                    return false;
                }

                if ($field.attr('id') === 'dokter') {
                    const dokterValue = $field.val();

                    if (dokterValue && !/[a-zA-Z]/.test(dokterValue)) {
                        $errorSpan.text('Nama Dokter harus mengandung huruf.');
                        $targetInvalid.addClass('is-invalid');
                        return false;
                    }
                }
                $errorSpan.text('');
                $targetInvalid.removeClass('is-invalid');
                return true;
            }

            function initRealTimeValidation() {
                $('#reimbursementForm').on('blur input change', ':input[required]', function () { validateField($(this)); });
            }

            function loadAllMasterData() {
                getAndSetReimbursementId();
                $.when(populatePasienDropdown(), populateDiagnosaDropdown(), populateRumahSakitDropdown(), fetchPlafondSummary())
                    .done(() => {
                        $('.searchable-select').select2(select2Options);
                        $('#diagnosa').on('change', function () {
                            const isOther = $(this).val() === '001';
                            $('#diagnosaOtherRow').toggle(isOther).find('input').prop('required', isOther).val('');
                        });
                        initRealTimeValidation();
                    }).fail(() => alert("Gagal memuat beberapa data master. Silakan muat ulang halaman."));
            }

            $('.btn-batal').on('click', () => window.history.back());

            $('#reimbursementForm').on('submit', function (event) {
                event.preventDefault();
                let isFormValid = true;
                $('#dateValidationError').hide();
                // Bersihkan error class dari validasi tanggal sebelumnya
                $('#mulaiDariDate, #sampaiDenganDate').removeClass('is-invalid');

                // 1. Validasi untuk semua field standar yang terlihat (input text, select, dll)
                $(this).find(':input[required]:visible:not(:disabled)').each(function () {
                    if (!validateField($(this))) {
                        isFormValid = false;
                    }
                });

                // 2. Validasi KOMPREHENSIF untuk semua file input yang ada di container yang terlihat
                const MAX_FILE_SIZE_MB = 2;
                const MAX_BYTES = MAX_FILE_SIZE_MB * 1024 * 1024;
                const ALLOWED_EXT = ['jpg', 'jpeg', 'pdf'];

                $(this).find('.conditional-field:visible input[type="file"]').each(function () {
                    const $input = $(this);
                    const file = this.files[0];
                    const $errorSpan = $input.closest('.form-col').find('.error-message');
                    const $wrapper = $input.closest('.file-upload-wrapper');

                    // PERBAIKAN: Cek apakah field file ini wajib diisi tapi kosong
                    if ($input.prop('required') && !file) {
                        // Panggil fungsi `validateField` agar konsisten (akan menampilkan pesan 'Wajib diisi')
                        validateField($input);
                        isFormValid = false;
                    }
                    // Jika ada file, lakukan validasi ukuran dan tipe
                    else if (file) {
                        const extension = file.name.toLowerCase().split('.').pop();
                        let fileError = '';

                        if (file.size > MAX_BYTES) {
                            fileError = `File > ${MAX_FILE_SIZE_MB}MB`;
                        } else if (!ALLOWED_EXT.includes(extension)) {
                            fileError = `Tipe file salah.`;
                        }

                        if (fileError) {
                            isFormValid = false;
                            $errorSpan.text(fileError);
                            $wrapper.addClass('is-invalid');
                        } else {
                            // Pastikan untuk membersihkan error jika file valid
                            $errorSpan.text('');
                            $wrapper.removeClass('is-invalid');
                        }
                    }
                });

                const todayString = new Date().toISOString().split('T')[0];
                const startDate = $('#mulaiDariDate').val();
                const endDate = $('#sampaiDenganDate').val();
                let dateErrorFound = false;

                // Cek berdasarkan tipe form (visibility dari kolom "Sampai Dengan")
                if (!$('#sampaiDenganCol').is(':visible')) {
                    // Point 2: Untuk Rawat Jalan, KB, Kacamata (hanya 1 form tanggal)
                    if (startDate && startDate > todayString) {
                        $('#dateValidationError').text("Tidak dapat memilih tanggal lebih dari hari ini").show();
                        $('#mulaiDariDate').addClass('is-invalid');
                        dateErrorFound = true;
                    }
                } else {
                    // Point 3: Untuk Rawat Inap & Maternity (ada 2 form tanggal)
                    // Pertama, cek apakah tanggal melebihi hari ini
                    if ((startDate && startDate > todayString) || (endDate && endDate > todayString)) {
                        $('#dateValidationError').text("Tanggal berobat tidak dapat melebihi hari ini").show();
                        if (startDate > todayString) $('#mulaiDariDate').addClass('is-invalid');
                        if (endDate > todayString) $('#sampaiDenganDate').addClass('is-invalid');
                        dateErrorFound = true;
                        // Kedua, jika tanggal valid (tidak di masa depan), cek urutannya
                    } else if (startDate && endDate && startDate > endDate) {
                        // Menggunakan teks yang diminta pada Poin 3
                        $('#dateValidationError').text('Tanggal "Mulai Dari" tidak boleh melewati tanggal "Sampai Dengan"').show();
                        $('#mulaiDariDate, #sampaiDenganDate').addClass('is-invalid');
                        dateErrorFound = true;
                    }
                }

                if (dateErrorFound) {
                    isFormValid = false;
                }

                // 4. Jika form tidak valid, scroll ke error pertama dan hentikan proses
                if (!isFormValid) {
                    // Cari elemen pertama yang invalid (baik input biasa maupun wrapper file upload)
                    $('html, body').animate({
                        scrollTop: $('.is-invalid, .error-message:not(:empty), #dateValidationError:visible').first().offset().top - 100
                    }, 500);
                    return;
                }

                // Lanjutkan ke logika konfirmasi modal jika semua validasi lolos
                $submitButton.prop('disabled', true);
                const nominalBiaya = parseInt($('#RmbBiayaPeriksaHidden').val(), 10) || 0;
                if (['Kacamata', 'Rawat Inap', 'Maternity'].includes(claimTypeForDb) || !plafondSummaryData) {
                    $('#confirmModal').addClass('show');
                } else {
                    const plafon = getRelevantPlafond(claimTypeForDb, plafondSummaryData);
                    const sisaPlafond = plafon ? (parseFloat(plafon.Sisa) || 0) : 0;
                    if (plafon && !isNaN(parseFloat(plafon.Plafon)) && nominalBiaya > sisaPlafond) {
                        const formatCurrency = val => new Intl.NumberFormat('id-ID', { style: 'currency', currency: 'IDR', minimumFractionDigits: 0 }).format(val);
                        $('#plafondWarningText').html(`Jumlah pengajuan Anda <b>${formatCurrency(nominalBiaya)}</b><br> melebihi sisa plafon.<br><br>Sisa Plafon Anda saat ini: <b>${formatCurrency(sisaPlafond)}</b>.<br><br>Kelebihan biaya akan dipotong dari gaji Anda.<br><br><b>Apakah Anda yakin ingin melanjutkan?</b>`);
                        $('#plafondWarningModal').addClass('show');
                    } else {
                        $('#confirmModal').addClass('show');
                    }
                }
            });

            //try {
            //    currentClaimType = new URLSearchParams(window.location.search).get('type');
            //    if (currentClaimType) { setupFormLayoutByType(currentClaimType); loadAllMasterData(); }
            //    else { alert("Jenis klaim tidak valid."); $('#reimbursementForm :input, .btn-simpan').prop('disabled', true).text('Tidak Valid'); }
            //} catch (e) { alert("Terjadi kesalahan, form tidak dapat dimuat."); $('#reimbursementForm :input').prop('disabled', true); }

            try {
                const urlParams = new URLSearchParams(window.location.search);
                claimTypeForDb = urlParams.get('type');         // Ambil nama pendek
                claimTypeForLayout = urlParams.get('displayName'); // Ambil nama panjang

                if (claimTypeForDb && claimTypeForLayout) {
                    // Gunakan NAMA PANJANG untuk mengatur layout form
                    setupFormLayoutByType(claimTypeForLayout);
                    loadAllMasterData();
                } else {
                    alert("Jenis klaim tidak valid atau parameter tidak lengkap.");
                    $('#reimbursementForm :input, .btn-simpan').prop('disabled', true).text('Tidak Valid');
                }
            } catch (e) {
                alert("Terjadi kesalahan, form tidak dapat dimuat.");
                $('#reimbursementForm :input').prop('disabled', true);
            }

            $('#confirm-save-btn').on('click', submitFormAjax);
            $('.custom-modal-overlay').on('click', function (e) { if ($(e.target).is('.custom-modal-overlay, #cancel-save-btn, #cancel-plafond-btn')) { $(this).removeClass('show'); $submitButton.prop('disabled', false); } });
            $('#close-success-btn').on('click', () => window.location.href = '@Url.Action("ManageReimbursementKaryawan", "Manage")');
            $('#confirm-continue-anyway-btn').on('click', () => { $('#plafondWarningModal').removeClass('show'); submitFormAjax(); });

            // ... sisa kode untuk kamera
            let currentStream, currentFileInputTarget;
            const cameraModal = $('#cameraModal'), video = document.getElementById('cameraFeed'), canvas = document.getElementById('cameraCanvas'), snapBtn = $('#snapPhotoBtn'), cancelCamBtn = $('#cancelCameraBtn');
            function stopCamera() {
                if (currentStream) {
                    currentStream.getTracks().forEach(t => t.stop());
                }
                cameraModal.removeClass('show');
            }
            $('.file-input-hidden').on('change', function () {
                const $fileInput = $(this), $wrapper = $fileInput.closest('.file-upload-wrapper'), $fileNameSpan = $wrapper.find('.file-name');

                if (this.files && this.files.length > 0) {
                    $fileNameSpan.text(this.files[0].name).addClass('selected');
                } else {
                    $fileNameSpan.text('Belum ada file dipilih').removeClass('selected');
                } validateField($fileInput);
            });
            $('.file-upload-actions').on('click', '.btn-upload', function () {
                const action = $(this).data('action'), $fileInput = $(this).closest('.file-upload-wrapper').find('.file-input-hidden');
                currentFileInputTarget = $fileInput;

                if (action === 'pick') {
                    $fileInput.removeAttr('capture').trigger('click');
                    return;
                } if (action === 'capture') {
                    if (navigator.mediaDevices && navigator.mediaDevices.getUserMedia) {
                        navigator.mediaDevices.getUserMedia({
                            video: {
                                facingMode: 'environment'
                            }
                        }).then(stream => {
                            currentStream = stream;
                            video.srcObject = stream;
                            video.play();
                            cameraModal.addClass('show');
                        }).catch(() => {
                            alert("Tidak bisa mengakses kamera. Silakan pilih file atau pastikan browser memiliki izin kamera.");
                            $fileInput.attr('capture', 'environment').trigger('click');
                        });
                    } else {
                        alert("Browser tidak mendukung kamera. Silakan pilih file.");
                        $fileInput.attr('capture', 'environment').trigger('click');
                    }
                }
            });
            snapBtn.on('click', function () { canvas.width = video.videoWidth; canvas.height = video.videoHeight; canvas.getContext('2d').drawImage(video, 0, 0, canvas.width, canvas.height); canvas.toBlob(function (blob) { const file = new File([blob], `capture_${new Date().toISOString()}.jpg`, { type: 'image/jpeg' }); const dataTransfer = new DataTransfer(); dataTransfer.items.add(file); if (currentFileInputTarget) { currentFileInputTarget[0].files = dataTransfer.files; currentFileInputTarget.trigger('change'); } }, 'image/jpeg'); stopCamera(); });
            cancelCamBtn.on('click', stopCamera);

        });
    </script>

    <div id="cameraModal" class="custom-modal-overlay">
        <div class="custom-modal" style="max-width: 640px; padding: 15px; background-color: #333;">
            <video id="cameraFeed" playsinline autoplay style="width: 100%; border-radius: 8px; transform: scaleX(-1);"></video>
            <canvas id="cameraCanvas" style="display:none;"></canvas>
            <div class="modal-actions" style="margin-top: 15px;">
                <button id="cancelCameraBtn" class="modal-btn modal-btn-cancel">Batal</button>
                <button id="snapPhotoBtn" class="modal-btn modal-btn-confirm"><i class="fas fa-camera"></i> Ambil Foto</button>
            </div>
        </div>
    </div>
</body>
</html>