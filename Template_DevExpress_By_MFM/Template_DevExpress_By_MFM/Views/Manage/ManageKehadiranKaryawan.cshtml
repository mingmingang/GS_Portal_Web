@{
    var logSession = HttpContext.Current.Session["SHealth"] as Template_DevExpress_By_MFM.Models.SessionLogin;
    ViewBag.Title = "Menu Kehadiran";
    //Layout = null;
}
<style>
    :root {
        --primary-color: #0d6efd;
        --secondary-color: #6c757d;
        --dark-blue-header: #203A6D;
        --background-color: #f4f7fa;
        --card-bg-color: #ffffff;
        --text-color: #333;
        --text-color-light: #666;
        --border-color: #dee2e6;
        --green-status: #198754;
        --green-status-bg: #d1e7dd;
        --yellow-status: #e59400;
        --yellow-status-bg: #fff3cd;
        --blue-status-text: #0d6efd;
        --blue-status-bg: #cfe2ff;
        --red-status: #dc3545;
        --red-status-bg: #f8d7da;
    }

    body {
        margin: 0px;
        font-family: 'Inter', sans-serif;
    }

    @@import url('https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700&display=swap');

    .kehadiran-page-container {
        background-color: var(--background-color);
        padding: 0;
        margin: 0;
        position: relative;
        padding-bottom: 100px;
    }

    .kehadiran-header-section {
        background: #1C2D5A;
        color: white;
        padding: 20px;
        text-align: center;
        position: relative;
    }

        .kehadiran-header-section .back-arrow {
            position: absolute;
            left: 20px;
            top: 50%;
            transform: translateY(-50%);
            font-size: 24px;
            color: white;
            text-decoration: none;
        }

        .kehadiran-header-section h1 {
            margin: 0;
            font-size: 20px;
            font-weight: 600;
        }

    .kehadiran-main-content {
        padding: 0 20px;
    }

    .filter-bar {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 8px 0px;
        border-radius: 12px;
        margin-bottom: 20px;
    }

        .filter-bar .date-range {
            font-size: 14px;
            font-weight: bold;
            background-color: #c5d5ff;
            color: #1B3F6B;
            padding: 6px 12px;
            border-radius: 8px;
            display: inline-block;
        }

        .filter-bar .filter-icons {
            display: flex;
            gap: 15px;
        }

            .filter-bar .filter-icons i {
                font-size: 20px;
                color: var(--secondary-color);
                cursor: pointer;
            }

    .summary-card {
        background-color: #DAF6FA;
        border-radius: 12px;
        padding: 15px;
        margin: 20px 0 20px 0;
        border: 1px solid var(--border-color);
        color: #3898AD;
    }

    .summary-table {
        width: 100%;
        border-collapse: collapse;
    }

        .summary-table td {
            padding: 8px 0;
            font-size: 14px;
        }

            .summary-table td:last-child {
                text-align: right;
                font-weight: 600;
                color: var(--primary-color);
            }

        .summary-table .sisa-kehadiran td {
            font-weight: 600;
            color: var(--text-color);
        }

    .status-filter-container {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
        margin: 20px 0;
    }

    .status-filter-badge {
        padding: 6px 15px;
        border-radius: 20px;
        font-size: 13px;
        font-weight: 500;
        cursor: pointer;
        background-color: #e9ecef;
        color: var(--text-color-light);
        border: 1px solid var(--border-color);
        transition: all 0.2s ease-in-out;
    }

        .status-filter-badge.active {
            background-color: var(--primary-color);
            color: white;
            border-color: var(--primary-color);
        }

    .kehadiran-list-container {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 16px;
    }

    .no-data-message {
        text-align: center;
        padding: 40px 20px;
        color: var(--text-color-light);
        font-size: 16px;
        font-style: italic;
        display: none;
    }

    .kehadiran-item-card {
        background-color: var(--card-bg-color);
        border-radius: 12px;
        padding: 15px;
        border: 1px solid var(--border-color);
        display: flex;
        flex-direction: column;
        gap: 10px;
    }

    .kehadiran-item-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

        .kehadiran-item-header .kehadiran-id {
            font-weight: 600;
            font-size: 14px;
            color: var(--text-color);
        }

    .kehadiran-item-status {
        padding: 5px 12px;
        border-radius: 20px;
        font-size: 12px;
        font-weight: 500;
    }

    .kehadiran-item-body .kehadiran-type {
        font-size: 14px;
        color: var(--text-color-light);
    }

    /* modal tetap sama */
    .modal-backdrop {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background-color: rgba(0, 0, 0, 0.6);
        z-index: 1000;
        display: none;
        align-items: center;
        justify-content: center;
    }

        .modal-backdrop.show {
            display: flex;
            opacity: 100%;
        }

    .modal-content {
        background: white;
        border-radius: 16px;
        box-shadow: 0 5px 20px rgba(0, 0, 0, 0.1);
        width: 90%;
        max-width: 400px;
        position: absolute;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
    }

    .modal-header {
        display: flex;
        align-items: center;
    }

        .modal-header .modal-close-btn {
            margin-left: auto;
        }

        .modal-header h2 {
            margin: 0;
            font-size: 18px;
            font-weight: 600;
            display: flex;
            align-items: center;
            gap: 10px;
        }

            .modal-header h2 .icon-bg {
                background-color: var(--dark-blue-header);
                color: white;
                width: 32px;
                height: 32px;
                border-radius: 8px;
                display: inline-flex;
                align-items: center;
                justify-content: center;
            }

    .modal-close-btn {
        background: var(--dark-blue-header);
        color: white;
        border: none;
        width: 32px;
        height: 32px;
        border-radius: 50%;
        font-size: 18px;
        font-weight: bold;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    #filterTahunModal h2 {
        font-size: 20px;
        text-align: center;
        width: 100%;
    }

    .year-list {
        text-align: center;
    }

    .year-item {
        font-size: 22px;
        font-weight: 500;
        color: #b0b0b0;
        padding: 10px 0;
        cursor: pointer;
        transition: all 0.2s ease;
    }

        .year-item.selected {
            font-size: 28px;
            font-weight: 700;
            color: var(--dark-blue-header);
            transform: scale(1.1);
        }

    .year-arrow {
        font-size: 24px;
        color: var(--dark-blue-header);
    }

    .year-list {
        text-align: center;
        font-size: 1.2em;
        user-select: none;
    }

    .year-arrow {
        cursor: pointer;
        color: #007bff;
        padding: 10px 0;
    }

        .year-arrow:hover {
            opacity: 0.7;
        }

    .year-item {
        padding: 8px 0;
        cursor: pointer;
        color: #888;
        transition: all 0.2s ease-in-out;
    }

        .year-item.selected {
            font-weight: bold;
            font-size: 1.5em;
            color: #333;
        }

    .pagination-controls {
        display: flex;
        justify-content: center;
        align-items: center;
        margin: 20px 0;
        user-select: none;
    }

    .pagination-btn {
        background-color: #f0f0f0;
        border: 1px solid #ddd;
        padding: 8px 16px;
        border-radius: 5px;
        cursor: pointer;
        font-weight: bold;
    }

        .pagination-btn:disabled {
            background-color: #f9f9f9;
            color: #ccc;
            cursor: not-allowed;
        }

    #page-info {
        margin: 0 15px;
        font-size: 14px;
        color: #555;
    }

    .add:hover {
        text-decoration: none;
        color: white;
        transform: scale(1.1);
    }

    .kehadiran-item-card {
        background: #fff;
    }

    .kehadiran-item-status.badge {
        padding: 4px 12px;
        border-radius: 20px;
        font-size: 13px;
        font-weight: 600;
        color: #fff;
    }

    /* warna sesuai status */
    .status-hadir {
        background-color: #00BE16;
    }

    .status-alpa {
        background-color: #FF2600;
    }

    .status-cuti {
        background-color: #F5C400;
    }

    .status-imp {
        background-color: #65B2E6;
    }

    .date-info {
        display: flex;
        align-items: center;
        gap: 6px;
        font-size: 14px;
        color: #000;
    }

    .time-info {
        display: flex;
        align-items: center;
        justify-content: space-between;
    }

    .time-label {
        font-size: 12px;
        color: #888;
    }

    .time-value {
        font-size: 18px;
        font-weight: bold;
        color: #000;
    }

    .status-guide-item {
        margin-bottom: 15px;
    }

        .status-guide-item:last-child {
            margin-bottom: 0;
        }

    .status-guide-badge {
        padding: 8px 18px;
        border-radius: 20px;
        font-size: 14px;
        font-weight: 500;
        display: inline-block;
        margin-bottom: 8px;
    }

    .badge-hadir {
        background-color: #00BE16;
        color: white;
    }

    .badge-cuti {
        background-color: #F5C400;
        color: white;
    }

    .badge-alpa {
        background-color: #FF2600;
        color: white;
    }

    .badge-imp {
        background-color: #65B2E6;
        color: white;
    }

    .status-guide-desc {
        font-size: 14px;
        color: var(--text-color-light);
        line-height: 1.5;
    }
    /* Wrapper 2 kolom untuk input tanggal */
    #filterTahunModal .date-range-row {
        display: flex;
        gap: 12px;
        margin-bottom: 15px;
    }

    #filterTahunModal .date-input-wrapper {
        flex: 1;
        display: flex;
        flex-direction: column;
    }

    #filterTahunModal .date-input {
        width: 100%;
        padding: 8px 10px;
        font-size: 14px;
        border: 1px solid #ccc;
        border-radius: 6px;
        margin-top: 5px;
        transition: border-color 0.2s ease;
    }

        #filterTahunModal .date-input:focus {
            border-color: #007bff;
            outline: none;
            box-shadow: 0 0 4px rgba(0,123,255,0.3);
        }

    /* Tombol sejajar */
    #filterTahunModal .btn-row {
        display: flex;
        gap: 12px;
    }

    #filterTahunModal .apply-filter-btn {
        flex: 1;
        padding: 10px;
        background-color: var(--dark-blue-header);
        color: #fff;
        font-size: 14px;
        font-weight: 500;
        border: none;
        border-radius: 6px;
        cursor: pointer;
        transition: background 0.2s ease;
    }

        #filterTahunModal .apply-filter-btn:hover {
            background-color: #0056b3;
        }

    /* Style khusus reset */
    #filterTahunModal .btn-reset {
        background-color: gray;
    }

        #filterTahunModal .btn-reset:hover {
            background-color: #555;
        }
</style>

<div class="kehadiran-page-container">
    <div class="kehadiran-header-section mt-4">
        <a href="@Url.Action("Index", "Home")" class="back-arrow">&#8592;</a>
        <h1>Menu Kehadiran</h1>
    </div>

    <div class="kehadiran-main-content">
        <div class="summary-card">
            <table class="summary-table">
                <tbody id="summary-tbody">
                    <tr><td colspan="3" style="text-align:center;">Memuat data...</td></tr>
                </tbody>
            </table>
        </div>


        <div class="filter-bar">
            <span class="date-range">Loading...</span>
            <div class="filter-icons">
                <i class="fas fa-book" id="panduanBtn"></i>
                <i class="fas fa-filter" id="filterBtn"></i>
            </div>
        </div>

        <div class="status-filter-container">
            <span class="status-filter-badge active" data-status="semua">Semua</span>
            <span class="status-filter-badge" data-status="Hadir">Hadir</span>
            <span class="status-filter-badge" data-status="Alpa">Alpa</span>
            <span class="status-filter-badge" data-status="Cuti">Cuti</span>
            <span class="status-filter-badge" data-status="IMP">IMP</span>
        </div>

        <div class="kehadiran-list-container"></div>
        <div class="no-data-message" style="display: block;">Memuat daftar absensi...</div>
        <div id="pagination-controls" class="pagination-controls" style="display: none;">
            <button id="prev-page-btn" class="pagination-btn">&laquo; Sebelumnya</button>
            <span id="page-info"></span>
            <button id="next-page-btn" class="pagination-btn">Berikutnya &raquo;</button>
        </div>
    </div>
</div>

<div id="modalBackdrop" class="modal-backdrop">
    <div id="panduanModal" class="modal-content" style="display: none;">
        <div class="modal-header">
            <h2><span class="icon-bg"><i class="fas fa-book"></i></span> Panduan Status</h2>
            <button class="modal-close-btn">X</button>
        </div>
        <div class="modal-body">
            <div class="status-guide-item">
                <span class="status-guide-badge badge-hadir">Hadir</span>
                <p class="status-guide-desc">Anda tercatat masuk kerja sesuai jadwal.</p>
            </div>

            <div class="status-guide-item">
                <span class="status-guide-badge badge-alpa">Alpa</span>
                <p class="status-guide-desc">Anda tidak hadir tanpa keterangan atau izin.</p>
            </div>

            <div class="status-guide-item">
                <span class="status-guide-badge badge-cuti">Cuti</span>
                <p class="status-guide-desc">Anda tidak hadir karena sedang mengambil cuti resmi.</p>
            </div>

            <div class="status-guide-item">
                <span class="status-guide-badge badge-imp">IMP</span>
                <p class="status-guide-desc">Anda tidak hadir karena tugas dinas, izin, atau keperluan penting yang disetujui.</p>
            </div>

        </div>
    </div>
    <div id="filterTahunModal" class="modal-content" style="display: none;">
        <button class="modal-close-btn" style="position: absolute; top: 15px; right: 15px;">X</button>
        <div class="modal-header"><h2>Filter Kehadiran</h2></div>
        <div class="modal-body">

            <div class="date-range-row">
                <div class="date-input-wrapper">
                    <label for="fromDate">Dari</label>
                    <input type="date" id="fromDate" class="date-input" />
                </div>
                <div class="date-input-wrapper">
                    <label for="toDate">Sampai</label>
                    <input type="date" id="toDate" class="date-input" />
                </div>
            </div>

            <div class="btn-row">
                <button id="resetFilterBtn" class="apply-filter-btn btn-reset">Reset</button>
                <button id="applyFilterBtn" class="apply-filter-btn">Terapkan</button>
            </div>
        </div>
    </div>

</div>

@section Scripts {
    <script>
    $(document).ready(function () {
       @{
           string employeeIdValue = "";
           string employeePlantValue = "";
           if (logSession != null)
           {
               employeeIdValue = logSession.npk;
               employeePlantValue = logSession.userplant;
           }
       }
       const employeeId = '@employeeIdValue';
       const employeePlant = '@employeePlantValue';
       const employeePlantChar = employeePlant.charAt(0).toUpperCase();

       let allKehadiranData = [];
       let filteredData = [];
       let currentPage = 1;
       const itemsPerPage = 10;

       const backdrop = $('#modalBackdrop');
       const filterTahunModal = $('#filterTahunModal');
       const panduanModal = $('#panduanModal');

       function openModal(modal) { backdrop.addClass('show'); modal.show(); }
       function closeModal() { backdrop.removeClass('show'); filterTahunModal.hide(); panduanModal.hide(); }

       // === FILTER RANGE TANGGAL ===
       $('#applyFilterBtn').on('click', function () {
           const fromDate = $('#fromDate').val();
           const toDate = $('#toDate').val();

           if (!fromDate || !toDate) {
               alert("Tanggal harus dipilih semua.");
               return;
           }

           if (new Date(fromDate) > new Date(toDate)) {
               alert("Tanggal awal tidak boleh lebih besar dari tanggal akhir.");
               return;
           }

           // Format date-range text
           const from = new Date(fromDate);
           const to = new Date(toDate);

           const formattedFrom = from.toLocaleDateString('id-ID', { day: 'numeric', month: 'long', year: 'numeric' });
           const formattedTo = to.toLocaleDateString('id-ID', { day: 'numeric', month: 'long', year: 'numeric' });

           $('.date-range').text(`${formattedFrom} - ${formattedTo}`);

           // Load data
           loadKehadiranList(fromDate, toDate);

           // Tutup modal
           closeModal();
       });

        function formatDateInput(date) {
            const year = date.getFullYear();
            const month = String(date.getMonth() + 1).padStart(2, '0'); // bulan mulai dari 0
            const day = String(date.getDate()).padStart(2, '0');
            return `${year}-${month}-${day}`;
        }

        function setDefaultDateRange() {
            const now = new Date();
            const firstDay = new Date(now.getFullYear(), 0, 1); // 1 Januari tahun ini
            const today = now; // hari ini

            const firstDayStr = formatDateInput(firstDay);
            const todayStr = formatDateInput(today);

            $('#fromDate').val(firstDayStr);
            $('#toDate').val(todayStr);

            const formattedFrom = firstDay.toLocaleDateString('id-ID', { day: 'numeric', month: 'long', year: 'numeric' });
            const formattedTo = today.toLocaleDateString('id-ID', { day: 'numeric', month: 'long', year: 'numeric' });

            $('.date-range').text(`${formattedFrom} - ${formattedTo}`);
            loadKehadiranList(firstDayStr, todayStr);
        }

        $('#resetFilterBtn').on('click', function () {
            setDefaultDateRange();
            closeModal(); // tutup modal setelah reset
        });

       // === CEK ABSEN HARI INI ===
       function loadCurrentHadir() {
           if (!employeeId) return;

           $.ajax({
               url: `/api/KehadiranApi/cek_jam_in_out?npk=${employeeId}&plant=${employeePlantChar}`,
               type: "GET",
               success: function (r) {
                   const formatJam = (dt) => {
                       if (!dt) return null;
                       const d = new Date(dt);
                       const jam = d.getHours().toString().padStart(2, '0');
                       const menit = d.getMinutes().toString().padStart(2, '0');
                       return `${jam}:${menit}`;
                   };

                   const jamMasuk = formatJam(r?.data?.inshiftact);
                   const jamKeluar = formatJam(r?.data?.outshiftact);

                   if (jamMasuk || jamKeluar) {
                       $('#summary-tbody').html(`
                           <tr>
                               <td style="text-align:center; font-weight:600; font-size:20px; color:var(--dark-blue-header);">${jamMasuk ?? "Anda belum absen hari ini"}</td>
                               <td style="text-align:center; font-size:24px; color:#000;">
                                   ${jamMasuk && jamKeluar ? '<i class="fas fa-arrow-right" style="margin: 0 8px;"></i>' : ''}
                               </td>
                               <td style="text-align:center; font-weight:600; font-size:20px; color:var(--dark-blue-header);">${jamKeluar ?? "Anda belum absen hari ini"}</td>
                           </tr>
                       `);
                   } else {
                       $('#summary-tbody').html(`
                           <tr><td colspan="3" style="text-align:center;">Anda belum absen hari ini</td></tr>
                       `);
                   }
               },
               error: () => {
                   $('#summary-tbody').html(`
                       <tr><td colspan="3" style="text-align:center;">Anda belum absen hari ini</td></tr>
                   `);
               }
           });
       }

       // === LOAD LIST KEHADIRAN ===
       function loadKehadiranList(fromDate, toDate) {
           if (!employeeId) return;
           const url = `/api/KehadiranApi/list_absensi`;
           const $listContainer = $('.kehadiran-list-container');
           const $noDataMessage = $('.no-data-message');
           const $paginationControls = $('#pagination-controls');

           $listContainer.html('');
           $paginationControls.hide();
           $noDataMessage.text('Memuat daftar kehadiran...').show();
           allKehadiranData = [];

           $.ajax({
               url: url,
               type: 'POST',
               contentType: 'application/json',
               data: JSON.stringify({
                   Npk: employeeId,
                   Plant: employeePlantChar,
                   FromDate: fromDate,
                   ToDate: toDate,
                   keterangan: "semua"
               }),
               success: (res) => {
                   allKehadiranData = res?.data?.length > 0 ? res.data : [];
                   filteredData = allKehadiranData;
                   updateKehadiranListView();
               },
               error: () => {
                   allKehadiranData = [];
                   updateKehadiranListView();
                   $noDataMessage.text('Gagal memuat daftar kehadiran.').show();
               }
           });
       }

       function mapStatus(apiStatus) {
           const statusMap = {
               "hadir": "Hadir",
               "alpa": "Alpa",
               "imp": "IMP",
               "cuti": "Cuti"
           };
           if (!apiStatus) return "IMP";
           return statusMap[apiStatus.toLowerCase()] || apiStatus;
       }

       function formatShift(val) {
           if (!val) return "--:--";
           return val.slice(0, 5);
       }

       function formatDate(val) {
           if (!val) return "-";
           const parts = val.split('-');
           if (parts.length !== 3) return "-";
           const [day, month, year] = parts.map(Number);
           if (!day || !month || !year) return "-";

           const date = new Date(year, month - 1, day);
           return date.toLocaleDateString('id-ID', {
               weekday: 'long',
               day: '2-digit',
               month: 'short',
               year: 'numeric'
           });
       }

       // === RENDER DATA LIST + PAGINATION ===
       function renderPage(page) {
           const $listContainer = $('.kehadiran-list-container');
           const $noDataMessage = $('.no-data-message');
           $listContainer.html('');

           if (filteredData.length === 0) {
               $noDataMessage
                   .text(allKehadiranData.length > 0 ? 'Tidak ada data.' : 'Tidak ada data kehadiran pada periode ini.')
                   .show();
               return;
           }
           $noDataMessage.hide();

           const startIndex = (page - 1) * itemsPerPage;
           const pageData = filteredData.slice(startIndex, startIndex + itemsPerPage);

           pageData.forEach(kehadiran => {
               const statusText = mapStatus(kehadiran.keterangan);
               const statusClass = 'status-' + statusText.toLowerCase();
               const date = formatDate(kehadiran.tgl);

               $listContainer.append(`
                   <div class="kehadiran-item-card" data-status="${statusText}">
                       <div class="header-row" style="display: flex; justify-content: space-between; align-items: center;">
                           <div class="date-info" style="font-size: 16px; font-weight: 600; color: black;">
                               <i class="fas fa-calendar-alt"></i> <span>${date}</span>
                           </div>
                           <span class="kehadiran-item-status badge ${statusClass}" style="font-size: 14px; padding: 4px 10px;">${statusText}</span>
                       </div>
                       <div class="time-info flex items-center justify-between">
                           <div class="text-center flex-1">
                               <div class="time-label" style="font-size: 13px;">Masuk</div>
                               <div class="time-value" style="font-size: 18px; font-weight: bold;">${formatShift(kehadiran.inshiftact)}</div>
                           </div>
                           <div class="arrow px-2" style="font-size: 18px;"><i class="fa fa-arrow-right"></i></div>
                           <div class="text-center flex-1">
                               <div class="time-label" style="font-size: 13px;">Keluar</div>
                               <div class="time-value" style="font-size: 18px; font-weight: bold;">${formatShift(kehadiran.outshiftact)}</div>
                           </div>
                       </div>
                   </div>
               `);
           });

           setupPagination();
       }

       function setupPagination() {
           const totalPages = Math.ceil(filteredData.length / itemsPerPage);
           const $paginationControls = $('#pagination-controls');

           if (totalPages <= 1) { $paginationControls.hide(); return; }
           $paginationControls.show();

           $('#page-info').text(`Halaman ${currentPage} dari ${totalPages}`);
           $('#prev-page-btn').prop('disabled', currentPage === 1);
           $('#next-page-btn').prop('disabled', currentPage === totalPages);
       }

       function updateKehadiranListView() {
           const activeStatus = $('.status-filter-badge.active').data('status');
           filteredData = activeStatus === 'semua'
               ? allKehadiranData
               : allKehadiranData.filter(c => mapStatus(c.keterangan) === activeStatus);

           currentPage = 1;
           renderPage(currentPage);
           setupPagination();
       }

       // === EVENT ===
       $('#panduanBtn').on('click', () => openModal(panduanModal));
       $('#filterBtn').on('click', () => { openModal(filterTahunModal); });
       $('.modal-close-btn').on('click', closeModal);
       backdrop.on('click', (e) => { if ($(e.target).is(backdrop)) closeModal(); });

       $('#prev-page-btn').on('click', function () { if (currentPage > 1) { currentPage--; renderPage(currentPage); } });
       $('#next-page-btn').on('click', function () { const totalPages = Math.ceil(filteredData.length / itemsPerPage); if (currentPage < totalPages) { currentPage++; renderPage(currentPage); } });

       $('.status-filter-badge').on('click', function () {
           $('.status-filter-badge').removeClass('active');
           $(this).addClass('active');
           updateKehadiranListView();
       });

       // === INIT ===
       setDefaultDateRange();
       loadCurrentHadir();
    });
    </script>
}

