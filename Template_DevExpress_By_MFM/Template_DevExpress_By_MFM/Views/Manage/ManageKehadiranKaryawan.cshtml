    <style>
        :root {
            --primary-color: #0d6efd;
            --secondary-color: #6c757d;
            --dark-blue-header: #203A6D;
            --background-color: #f4f7fa;
            --card-bg-color: #ffffff;
            --text-color: #333;
            --text-color-light: #666;
            --border-color: #dee2e6;
            --green-status: #198754;
            --green-status-bg: #d1e7dd;
            --yellow-status: #e59400;
            --yellow-status-bg: #fff3cd;
            --blue-status-text: #0d6efd;
            --blue-status-bg: #cfe2ff;
            --red-status: #dc3545;
            --red-status-bg: #f8d7da;
        }

        body {
            margin: 0px;
            font-family: 'Inter', sans-serif;
        }

        .kehadiran-page-container {
            background-color: var(--background-color);
            padding: 0;
            margin: 0;
            position: relative;
            padding-bottom: 100px;
        }

        .kehadiran-header-section {
            background: #1C2D5A;
            color: white;
            padding: 20px;
            text-align: center;
            position: relative;
        }

            .kehadiran-header-section .back-arrow {
                position: absolute;
                left: 20px;
                top: 50%;
                transform: translateY(-50%);
                font-size: 24px;
                color: white;
                text-decoration: none;
            }

            .kehadiran-header-section h1 {
                margin: 0;
                font-size: 20px;
                font-weight: 600;
            }

        .kehadiran-main-content {
            padding: 0 20px;
        }

        .filter-bar {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 8px 0px;
            border-radius: 12px;
            margin-bottom: 20px;
        }

            .filter-bar .date-range {
                font-size: 14px;
                font-weight: bold;
                background-color: #c5d5ff;
                color: #1B3F6B;
                padding: 6px 12px;
                border-radius: 8px;
                display: inline-block;
            }

            .filter-bar .filter-icons {
                display: flex;
                gap: 15px;
            }

                .filter-bar .filter-icons i {
                    font-size: 20px;
                    color: #1E2D56;
                    cursor: pointer;
                }

        .summary-card {
            background-color: #DAF6FA;
            border-radius: 12px;
            padding: 15px;
            margin: 20px 0 20px 0;
            border: 1px solid var(--border-color);
            color: #3898AD;
        }

        .summary-table {
            width: 100%;
            border-collapse: collapse;
        }

            .summary-table td {
                padding: 8px 0;
                font-size: 14px;
            }

                .summary-table td:last-child {
                    text-align: right;
                    font-weight: 600;
                    color: var(--primary-color);
                }

            .summary-table .sisa-kehadiran td {
                font-weight: 600;
                color: var(--text-color);
            }

        .status-filter-container {
            display: flex;
            flex-wrap: wrap;
            gap: 8px;
            margin: 20px 0;
        }

        .status-filter-badge {
            padding: 6px 15px;
            border-radius: 20px;
            font-size: 13px;
            font-weight: 500;
            cursor: pointer;
            background-color: #e9ecef;
            color: var(--text-color-light);
            border: 1px solid var(--border-color);
            transition: all 0.2s ease-in-out;
        }

            .status-filter-badge.active {
                background-color: #1E2D56;
                color: white;
            }

        .kehadiran-list-container {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 16px;
        }

        .no-data-message {
            text-align: center;
            padding: 40px 20px;
            color: var(--text-color-light);
            font-size: 16px;
            font-style: italic;
            display: none;
        }

        .kehadiran-item-card {
            background-color: var(--card-bg-color);
            border-radius: 12px;
            padding: 15px;
            border: 1px solid var(--border-color);
            display: flex;
            flex-direction: column;
            gap: 10px;
        }

        .kehadiran-item-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

            .kehadiran-item-header .kehadiran-id {
                font-weight: 600;
                font-size: 14px;
                color: var(--text-color);
            }

        .kehadiran-item-status {
            padding: 5px 12px;
            border-radius: 20px;
            font-size: 12px;
            font-weight: 500;
        }

        .kehadiran-item-body .kehadiran-type {
            font-size: 14px;
            color: var(--text-color-light);
        }

        .modal-overlay {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background-color: rgba(0,0,0,0.6);
            display: none;
            justify-content: center;
            align-items: center;
            z-index: 1000;
            opacity: 0;
            transition: opacity 0.2s ease-in-out;
        }

            .modal-overlay.visible {
                display: flex;
                opacity: 1;
            }

        .modal-content {
            background-color: white;
            border-radius: 16px;
            box-shadow: 0 10px 25px rgba(0,0,0,0.1);
            pointer-events: auto;
            padding: 24px;
            width: 90%;
            max-width: 500px;
        }

        .modal-header {
            display: flex;
            align-items: center;
            margin-bottom: 16px;
        }

        .modal-icon {
            font-size: 36px;
            color: #2A458A;
            margin-right: 12px;
        }

        .modal-title {
            font-size: 20px;
            font-weight: bold;
            color: #1F2937;
            margin: 0;
        }

        .modal-message {
            font-size: 15px;
            color: #6B7280;
            line-height: 22px;
            margin-bottom: 24px;
        }

