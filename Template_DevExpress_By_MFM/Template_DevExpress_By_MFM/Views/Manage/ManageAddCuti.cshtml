@model Template_DevExpress_By_MFM.Models.CutiModel
@{
    ViewBag.Title = "Tambah Cuti";
    var logSession = HttpContext.Current.Session["SHealth"] as Template_DevExpress_By_MFM.Models.SessionLogin;
}

/* GANTI SELURUH BLOK
<style>
    ANDA DENGAN INI */
    :root {
        --dark-blue: #1B3D97;
        --light-gray-bg: #f4f7fa;
        --card-bg: #ffffff;
        --text-dark: #333;
        --text-light: #6c757d;
        --border-color: #dee2e6;
        --red-required: #dc3545;
        --blue-primary: #0d6efd;
        --green-submit: #198754;
    }

    body {
        background-color: var(--light-gray-bg);
        margin: 0;
        font-family: 'Poppins', sans-serif;
    }

    /* === HEADER UTAMA === */
    .form-header-section {
        background: var(--dark-blue);
        color: white;
        padding: 20px;
        text-align: center;
        position: relative;
        border-bottom-left-radius: 20px;
        border-bottom-right-radius: 20px;
    }

        .form-header-section .back-arrow {
            position: absolute;
            left: 20px;
            top: 50%;
            transform: translateY(-50%);
            font-size: 24px;
            color: white;
            text-decoration: none;
        }

        .form-header-section h1 {
            margin: 0;
            font-size: 20px;
            font-weight: 600;
        }

    /* === KONTEN UTAMA & FORMULIR === */
    .form-content-container {
        background-color: var(--card-bg);
        margin: 20px;
        padding: 25px;
        border-radius: 16px;
        box-shadow: 0 4px 15px rgba(0,0,0,0.07);
    }

    .form-group {
        margin-bottom: 20px;
    }

    label {
        font-size: 14px;
        font-weight: 600;
        color: var(--text-dark);
        margin-bottom: 8px;
        display: block;
    }

        label .required-star {
            color: var(--red-required);
        }

    .form-control, .form-select {
        width: 100%;
        padding: 12px 15px;
        border: 1px solid var(--border-color);
        border-radius: 10px;
        font-size: 14px;
        box-sizing: border-box;
        background-color: white;
    }

    input.form-control[readonly] {
        background-color: #e9ecef;
        cursor: not-allowed;
    }

    select.form-control, select.form-select {
        appearance: none;
        -webkit-appearance: none;
        background-image: url('data:image/svg+xml;charset=UTF-8,<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="%236c757d" viewBox="0 0 16 16"><path fill-rule="evenodd" d="M1.646 4.646a.5.5 0 0 1 .708 0L8 10.293l5.646-5.647a.5.5 0 0 1 .708.708l-6 6a.5.5 0 0 1-.708 0l-6-6a.5.5 0 0 1 0-.708z"/></svg>');
        background-repeat: no-repeat;
        background-position: right 15px center;
        background-size: 12px;
    }

    .form-row {
        display: flex;
        gap: 20px;
    }

    .form-col-6 {
        flex: 1;
    }

    /* === Elemen Input Khusus (Tanggal & Durasi) === */
    .date-input-wrapper {
        position: relative;
    }

        .date-input-wrapper i.fa-calendar {
            position: absolute;
            right: 15px;
            top: 50%;
            transform: translateY(-50%);
            color: var(--text-light);
        }

    #Durasi + .input-addon-text {
        position: absolute;
        right: 15px;
        top: 50%;
        transform: translateY(-50%);
        color: var(--text-light);
        font-size: 14px;
    }

    .duration-wrapper {
        position: relative;
    }

    /* === Berkas Lampiran === */
    .attachment-label {
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .attachment-note {
        font-size: 12px;
        color: var(--text-light);
    }

    .btn-browse {
        display: block;
        width: 100%;
        padding: 12px;
        border: 1px solid var(--border-color);
        background-color: white;
        border-radius: 10px;
        text-align: left;
        color: var(--text-light);
        cursor: pointer;
    }

    .file-name-preview {
        margin-top: 10px;
        font-size: 13px;
        color: var(--dark-blue);
    }

    /* === Note & Tombol === */
    .note-box {
        background-color: #e7f3fe;
        color: #31708f;
        padding: 15px;
        border-radius: 10px;
        margin-top: 25px;
        font-size: 14px;
    }

    .form-actions {
        margin-top: 30px;
        display: flex;
        flex-direction: column;
        gap: 15px;
    }

    .btn-action {
        width: 100%;
        padding: 15px;
        border: none;
        border-radius: 12px;
        font-size: 16px;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.2s ease-in-out;
    }

        .btn-action:hover {
            transform: translateY(-2px);
            box-shadow: 0 4px 10px rgba(0,0,0,0.15);
        }

    .btn-submit {
        background-color: var(--green-submit);
        color: white;
    }

    .btn-print {
        background-color: var(--blue-primary);
        color: white;
    }
</style>


<!-- GANTI HTML LAMA ANDA DENGAN BLOK INI -->
<div class="form-page-container">
    <div class="form-header-section">
        <a href="@Url.Action("ManageCutiKaryawan", "Manage")" class="back-arrow">&#8592;</a>
        <h1>Tambah Cuti</h1>
    </div>

    <form id="cutiForm">
        @Html.AntiForgeryToken()

        <div class="form-content-container">

            <div class="form-group">
                <label for="cuti_id">No. Pengajuan Cuti</label>
                @Html.TextBoxFor(m => m.cuti_id, new { @class = "form-control", @readonly = "readonly", id = "cuti_id", placeholder = "Generated Otomatis" })
            </div>

            <div class="form-group">
                <label for="permohonan_untuk">Permohonan Untuk <span class="required-star">*</span></label>
                <input type="text" id="permohonan_untuk" class="form-control" value="@logSession?.fullname" readonly />
            </div>

            <div class="form-group">
                <label for="tipe_cuti">Tipe Cuti <span class="required-star">*</span></label>
                @Html.DropDownListFor(m => m.tipe_cuti,
                    new SelectList(new[] { "Cuti Pribadi", "Cuti Besar", "Cuti Khusus" }),
                    "-- Pilih Jenis Cuti --",
                    new { @class = "form-select form-control", required = "required", id = "tipe_cuti" })
            </div>

            <div id="cutiKhususSection" class="form-group" style="display: none;">
                <label for="sub_tipe_cuti">Jenis Cuti Khusus <span class="required-star">*</span></label>
                <select id="sub_tipe_cuti" name="sub_tipe_cuti" class="form-select form-control"></select>
            </div>

            <div class="form-row">
                <div class="form-col-6">
                    <div class="form-group">
                        <label for="TanggalMulai">Mulai Dari <span class="required-star">*</span></label>
                        <div class="date-input-wrapper">
                            @Html.TextBoxFor(m => m.tanggal_awal, "{0:yyyy-MM-dd}", new { @class = "form-control", type = "date", required = "required", id = "TanggalMulai" })
                            <i class="fa fa-calendar"></i>
                        </div>
                    </div>
                </div>
                <div class="form-col-6">
                    <div class="form-group">
                        <label for="TanggalSelesai">Sampai Dengan <span class="required-star">*</span></label>
                        <div class="date-input-wrapper">
                            @Html.TextBoxFor(m => m.tanggal_akhir, "{0:yyyy-MM-dd}", new { @class = "form-control", type = "date", required = "required", id = "TanggalSelesai" })
                            <i class="fa fa-calendar"></i>
                        </div>
                    </div>
                </div>
            </div>

            <div class="form-group">
                <label for="Durasi">Durasi</label>
                <div class="duration-wrapper">
                    @Html.TextBoxFor(m => m.durasi, new { @class = "form-control", @readonly = "readonly", id = "Durasi" })
                    <span class="input-addon-text">/ hari</span>
                </div>
            </div>

            <div class="form-group">
                <label for="Keterangan">Keterangan</label>
                @Html.TextAreaFor(m => m.alasan, new { @class = "form-control", placeholder = "Masukan Keterangan ...", id = "Keterangan", rows = "4" })
            </div>

            <div id="lampiranSection" class="form-group" style="display: none;">
                <div class="attachment-label">
                    <label>Berkas Lampiran <span id="lampiranRequired" class="required-star" style="display:none;">*</span></label>
                    <span class="attachment-note">*jpg, pdf, zip (Max 2mb)</span>
                </div>
                <button type="button" class="btn-browse" onclick="$('#lampiranFile').click();">Browse...</button>
                <input type="file" id="lampiranFile" name="lampiranFile" style="display: none;" accept=".jpg,.jpeg,.png,.pdf,.zip">
                <div class="file-name-preview" id="filePreview"></div>
            </div>

            <div class="note-box">
                <strong>Note:</strong>
                <p style="margin: 5px 0 0 0;">Lampirkan berkas cuti yang sudah di tanda tangan basah!</p>
            </div>

            <div class="form-actions">
                <button type="button" class="btn-action btn-print" onclick="window.print()">
                    <i class="fa fa-print"></i> Print & Save
                </button>
                <button type="button" id="btnSubmit" class="btn-action btn-submit">Submit</button>
            </div>

        </div>
    </form>
</div>


@section Scripts {
    <script>
$(document-).ready(function() {

    // --- SESUAIKAN JIKA PERLU ---
    // Pastikan logSession tidak null dan properti 'npk' atau 'kry_npk' ada
    @{
        string employeeNpk = "";
        if (logSession != null) { employeeNpk = logSession.npk; } // Ganti .npk jika nama properti beda
    }
    const userNpk = '@employeeNpk';

    // --- DATA & ELEMEN JQUERY (Tetap sama) ---
    const itemsKhusus = [
        // ... (data array Anda tetap di sini) ...
    ];

    const $tipeCuti = $("#tipe_cuti");
    const $cutiKhususSection = $("#cutiKhususSection");
    const $subTipeCuti = $("#sub_tipe_cuti");
    const $lampiranSection = $("#lampiranSection");
    const $lampiranFile = $("#lampiranFile");
    const $lampiranRequired = $("#lampiranRequired");
    const $filePreview = $("#filePreview"); // diubah dari filePreview menjadi browse button
    const $browseButton = $(".btn-browse"); // Elemen baru
    const $tanggalMulai = $("#TanggalMulai");
    const $tanggalSelesai = $("#TanggalSelesai");
    const $durasiInput = $("#Durasi");


    // ===============================================
    // FUNGSI UTAMA (Tidak banyak berubah)
    // ===============================================

    // --- Tampilkan/Sembunyikan Field Berdasarkan Tipe Cuti ---
    $tipeCuti.on("change", function () {
        const selectedType = $(this).val();

        if (selectedType === "Cuti Khusus") {
            $subTipeCuti.empty().append('<option value="">-- Pilih Jenis --</option>');
            itemsKhusus.forEach(item => {
                $subTipeCuti.append(`<option value="${item.value}">${item.label}</option>`);
            });
            $subTipeCuti.prop('required', true);
            $cutiKhususSection.slideDown();

            $lampiranFile.prop('required', true);
            $lampiranRequired.show();
            $lampiranSection.slideDown();

        } else if (selectedType === "Cuti Pribadi" || selectedType === "Cuti Besar") {
            $subTipeCuti.prop('required', false).val('');
            $cutiKhususSection.slideUp();

            $lampiranFile.prop('required', false);
            $lampiranRequired.hide();
            $lampiranSection.slideDown();

        } else {
            $subTipeCuti.prop('required', false).val('');
            $cutiKhususSection.slideUp();
            $lampiranFile.prop('required', false);
            $lampiranSection.slideUp();
        }
    });

    // --- Kalkulasi Durasi ---
    function hitungDurasi() {
        const tglAwal = $tanggalMulai.val();
        const tglAkhir = $tanggalSelesai.val();

        if (tglAwal && tglAkhir) {
            const startDate = new Date(tglAwal);
            const endDate = new Date(tglAkhir);

            if (endDate < startDate) {
                $durasiInput.val('');
                return;
            }
            const diffTime = Math.abs(endDate - startDate);
            const diffDays = Math.ceil(diffTime / (1000 * 60 * 60 * 24)) + 1;
            $durasiInput.val(diffDays);
        } else {
            $durasiInput.val('');
        }
    }

    $tanggalMulai.on('change', function() {
        const startDateVal = $(this).val();
        if(startDateVal) {
            $tanggalSelesai.attr('min', startDateVal);
             if ($tanggalSelesai.val() < startDateVal) {
                $tanggalSelesai.val('');
             }
        }
        hitungDurasi();
    });
    $tanggalSelesai.on('change', hitungDurasi);


    // --- [PERBAIKAN] Logika Preview File ---
    $lampiranFile.on("change", function(e) {
        const file = e.target.files[0];

        if (!file) {
            $browseButton.text("Browse...");
            $browseButton.css('color', 'var(--text-light)');
            return;
        }

        // Tampilkan nama file di tombol browse
        $browseButton.text(file.name);
        $browseButton.css('color', 'var(--text-dark)');
    });


    // --- Pengiriman Form via AJAX (Logika inti tetap sama) ---
    $("#btnSubmit").on("click", function() {
        if (!$("#cutiForm")[0].checkValidity()) {
            $("#cutiForm")[0].reportValidity();
            return;
        }

        const $submitButton = $(this);
        $submitButton.prop("disabled", true).text("Mengirim...");

        const formData = new FormData();
        formData.append('kry_npk', userNpk);
        formData.append('tipe_cuti', $("#tipe_cuti").val());
        formData.append('mulai_dari', $("#TanggalMulai").val());
        formData.append('sampai_dengan', $("#TanggalSelesai").val());
        formData.append('durasi', $("#Durasi").val());
        formData.append('alasan', $("#Keterangan").val());
        formData.append('status', "Menunggu Persetujuan");
        formData.append('tanggal_pengajuan', new Date().toISOString());

        if ($("#tipe_cuti").val() === "Cuti Khusus") {
            formData.append('sub_tipe_cuti', $("#sub_tipe_cuti").val());
        }

        if ($lampiranFile[0].files.length > 0) {
            formData.append('lampiranFile', $lampiranFile[0].files[0]);
        }

        $.ajax({
            url: '/api/CutiApi/createCuti',
            type: 'POST',
            data: formData,
            processData: false,
            contentType: false,
            success: function (response) {

                Swal.fire({
                    icon: 'success',
                    title: 'Berhasil!',
                    text: `Pengajuan cuti Anda berhasil disubmit.`,
                    confirmButtonText: 'OK'
                }).then(() => {
                    // Redirect ke halaman daftar cuti
                    window.location.href = '@Url.Action("ManageCutiKaryawan", "Manage")';
                });
            },
            error: function(xhr) {
                console.error("Gagal mengirim data:", xhr.responseText);
                 Swal.fire({
                    icon: 'error',
                    title: 'Gagal!',
                    text: 'Terjadi kesalahan saat mengirim data. Silakan coba lagi.'
                });
            },
            complete: function() {
                $submitButton.prop("disabled", false).text("Submit");
            }
        });
    });
});
    </script>
}