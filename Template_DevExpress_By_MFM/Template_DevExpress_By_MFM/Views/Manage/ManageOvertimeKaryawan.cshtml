    <script>
        const EMPLOYEE_NIK = '@nik';
        const EMPLOYEE_PLANT = '@plant';

        const END_YEAR = new Date().getFullYear();
        const FALLBACK_START_YEAR = 2015;

        // Array bulan
        const months = [
            { value: 0, label: "Januari" }, { value: 1, label: "Februari" }, { value: 2, label: "Maret" },
            { value: 3, label: "April" }, { value: 4, label: "Mei" }, { value: 5, label: "Juni" },
            { value: 6, label: "Juli" }, { value: 7, label: "Agustus" }, { value: 8, label: "September" },
            { value: 9, label: "Oktober" }, { value: 10, label: "November" }, { value: 11, label: "Desember" },
        ];

        // STATE UTAMA
        let currentPeriode = 'periodeGajian';
        let currentStatus = 'Semua';
        let allOvertimeData = [];
        let filteredOvertimeData = [];
        let searchKeyword = '';

        let currentYear = new Date().getFullYear();
        let selectedMonth = new Date().getMonth();
        let selectedYear = currentYear;

        // ===================== OAUTH + TOKEN FLOW BARU =====================

        document.addEventListener("DOMContentLoaded", function () {
            moment.locale('id');
            updatePeriodeSelectorDisplay();

            // binding event UI
            bindOvertimeEvents();

            // mulai: OAuth dulu, baru load data lembur
            startOvertimeOAuth().then(() => {
                initializeAuthFlow();
            });
        });

        async function startOvertimeOAuth() {
            try {
                console.log("Starting OAuth...");

                const authResponse = await fetch("/api/OvertimeApi/auth");
                const authData = await authResponse.json();

                console.log("AUTH RESULT:", authData);

                let code = authData.CODE;

                if (!code) {
                    console.error("Code tidak ditemukan");
                    showNoDataMessage("Otentikasi gagal: code tidak ditemukan.");
                    return;
                }

                // STEP 2 � GET TOKEN
                const tokenResponse = await fetch("/api/OvertimeApi/token", {
                    method: "POST",
                    headers: { "Content-Type": "application/json" },
                    body: JSON.stringify({ code: code })
                });

                const tokenData = await tokenResponse.json();

                console.log("TOKEN RESULT:", tokenData);

                if (tokenData.STATUS === true) {
                    // simpan token ke sessionStorage
                    sessionStorage.setItem("access_token", tokenData.access_token);
                    sessionStorage.setItem("refresh_token", tokenData.refresh_token);

                    setupAutoRefresh(tokenData);
                } else {
                    console.error("Gagal dapat token:", tokenData);
                    showNoDataMessage("Gagal mendapatkan token akses dari server.");
                }
            }
            catch (err) {
                console.error(err);
                showNoDataMessage("Terjadi kesalahan saat proses otentikasi.");
            }
        }

        function setupAutoRefresh(tokenData) {
            const refreshToken = tokenData.refresh_token;
            const expiresAt = tokenData.expires_in;

            if (!expiresAt || !refreshToken) {
                console.warn("No expires_in / refresh_token, skip auto refresh.");
                return;
            }

            // Convert to Date object
            let expDate = convertToDate(expiresAt);

            // FIX: TAMBAHIN +7 JAM BIAR SINKRON DENGAN SERVER
            expDate = new Date(expDate.getTime() + (7 * 60 * 60 * 1000));

            console.log("Adjusted Expiry:", expDate);

            const refreshTime = expDate.getTime() - Date.now() - (1 * 60 * 1000);

            console.log("Refreshing in (ms):", refreshTime);

            if (isNaN(refreshTime)) {
                console.warn("Cannot parse expiry time, skipping auto refresh");
                return;
            }

            if (refreshTime > 0) {
                setTimeout(() => refreshAccessToken(refreshToken), refreshTime);
            } else {
                // kalau sudah expired ? langsung refresh sekali
                refreshAccessToken(refreshToken);
            }
        }

        function convertToDate(dateString) {
            // Format 1: DD-MM-YYYY HH:mm:ss
            if (dateString.includes("-") && !isNaN(dateString[0])) {
                const [datePart, timePart] = dateString.split(" ");
                const [day, month, year] = datePart.split("-");
                return new Date(`${year}-${month}-${day}T${timePart}`);
            }

            // Format 2: MonthName, DD YYYY HH:mm:ss  (ex: "December, 01 2025 15:55:18")
            if (dateString.includes(",")) {
                return new Date(dateString.replace(",", ""));
            }

            // fallback
            return new Date(dateString);
        }

        let isRefreshing = false;

        async function refreshAccessToken(refreshToken) {
            if (isRefreshing) return;
            isRefreshing = true;

            console.log("Refreshing token...");

            const response = await fetch("/api/OvertimeApi/refresh", {
                method: "POST",
                headers: { "Content-Type": "application/json" },
                body: JSON.stringify({ refresh_token: refreshToken })
            });

            const data = await response.json();

            console.log("REFRESH RESULT:", data);

            isRefreshing = false;

            if (data.STATUS === true) {
                console.log("Token successfully refreshed!");

                // update token baru di sessionStorage
                sessionStorage.setItem("access_token", data.access_token);
                sessionStorage.setItem("refresh_token", data.refresh_token);

                setupAutoRefresh(data); // pasang timer baru lagi
            } else {
                console.error("FAILED REFRESH TOKEN:", data);
            }
        }

        // ===================== FLOW AWAL & AUTH CHECK FE LAMA =====================

        function initializeAuthFlow() {
            if (EMPLOYEE_NIK === 'NIK_NOT_FOUND' || EMPLOYEE_NIK === '') {
                showNoDataMessage("NIK Karyawan tidak ditemukan. Gagal memulai otentikasi.");
                return;
            }

            const urlParams = new URLSearchParams(window.location.search);
            const authError = urlParams.get('authError');
            if (authError) {
                showNoDataMessage("Otentikasi Gagal. Silakan coba muat ulang halaman.");
                window.history.replaceState(null, null, window.location.pathname);
                return;
            }

            fetchAndRenderOvertime();
        }

        function redirectToAuthorize() {
            window.location.replace(AUTHORIZE_CONTROLLER_URL);
        }

        // ===================== PENGAMBILAN DATA LEMBUR (API BARU) =====================

        async function fetchAndRenderOvertime() {

            const container = $('#overtimeList');
            container.html('<div class="loading-message" style="text-align: center; padding: 20px; color: #666;"><i class="fas fa-spinner fa-spin"></i> Memuat data...</div>');

            const range = getPeriodeRange();
            const startDate = range.start.clone();
            const endDate = range.end.clone();

            const accessToken = sessionStorage.getItem("access_token");
            if (!accessToken) {
                showNoDataMessage("Sesi habis, ulangi otentikasi.");
                return;
            }

            let allResults = [];

            // ? LOOP DARI TGL 1 SAMPAI TGL AKHIR
            while (startDate.isSameOrBefore(endDate, 'day')) {

                const tgl = startDate.format("YYYY-MM-DD");

                const dataToSend = {
                    nik: EMPLOYEE_NIK,
                    com: "gsbattery",
                    tgl: tgl
                };

                console.log("Fetching:", tgl);

                const res = await fetch("/api/OvertimeApi/getStatus", {
                    method: "POST",
                    headers: {
                        "Content-Type": "application/json",
                        "Authorization": "Bearer " + accessToken
                    },
                    body: JSON.stringify(dataToSend)
                });

                if (res.ok) {
                    const response = await res.json();
                    if (response.STATUS === true && response.RESULT) {
                        allResults = allResults.concat(response.RESULT);
                    }
                }

                startDate.add(1, "day");
            }

            $('.loading-message').remove();

            if (allResults.length === 0) {
                showNoDataMessage("Tidak ada data lembur bulan ini.");
                return;
            }

            allOvertimeData = allResults;

            updateRingkasanStatus();
            updateOvertimeListView(allResults);
        }

        // =========================
