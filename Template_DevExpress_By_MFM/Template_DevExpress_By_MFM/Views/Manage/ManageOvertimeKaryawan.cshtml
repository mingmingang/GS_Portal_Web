        async function loadOvertimeDetail(npk, plant) {

            console.log("GET DETAIL:", npk, plant);

            const container = $('#overtimeDetailContainer');
            container.html("<p>Loading...</p>");

            try {

                const res = await fetch("/api/OvertimeApi/list", {
                    method: "POST",
                    headers: { "Content-Type": "application/json" },
                    body: JSON.stringify({ npk: npk, plant: plant })
                });

                const result = await res.json();
                console.log("DETAIL RESULT:", result);

                if (!result || !result.data || result.data.length === 0) {
                    container.html(`<p>Tidak ada data lembur ditemukan.</p>`);
                    return;
                }

                // Render hasilnya
                container.empty();
                result.data.forEach(item => {
                    container.append(`
                <div style="padding:10px;border-bottom:1px solid #eee;">
                    <strong>${item.ovt_date}</strong><br>
                    ${item.time_start} - ${item.time_end}
                </div>
            `);
                });

            } catch (err) {
                console.error(err);
                container.html("<p>Terjadi error load data.</p>");
            }
        }


