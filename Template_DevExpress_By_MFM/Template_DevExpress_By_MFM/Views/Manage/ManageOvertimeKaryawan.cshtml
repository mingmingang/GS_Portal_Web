        function getMonthYear(offset) {
            const now = new Date(); let month = now.getMonth() + offset; let year = now.getFullYear();
            while (month < 0) { month += 12; year -= 1; }
            while (month > 11) { month -= 12; year += 1; }
            return { month: month % 12, year: year };
        }

