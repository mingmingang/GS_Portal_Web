        }

        .status-card {
            flex: 1;
            background: white;
            border-radius: 8px;
            padding: 15px;
            text-align: center;
            box-shadow: 0 4px 8px rgba(0,0,0,0.1);
            border: 1px solid #e0e0e0;
        }

        .status-label {
            font-size: 14px;
            font-weight: 500;
            color: #6c757d;
            margin-bottom: 5px;
            text-transform: uppercase;
        }

        .status-value {
            font-size: 30px;
            font-weight: 800;
        }

        .paid-card .status-value {
            color: #4CAF50;
        }

        .unpaid-card .status-value {
            color: #f7110a;
        }

        /* Daftar Over Time Section */
        .list-header-container {
            margin-bottom: 20px;
        }

        .list-title {
            font-size: 18px;
            font-weight: 700;
            color: #1E2D56;
            margin: 0 0 16px 0;
        }

        .status-filter-tabs {
            display: flex;
            gap: 12px;
            margin-bottom: 20px;
        }

        .status-tab-btn {
            flex: 1;
