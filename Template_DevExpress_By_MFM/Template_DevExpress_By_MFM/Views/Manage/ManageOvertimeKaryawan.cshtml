        function updateOvertimeListView(data) {
            $('#statusFilterContainer .status-tab-btn').removeClass('active');
            $(`#statusFilterContainer .status-tab-btn[data-status="${currentStatus}"]`)
                .addClass('active');

            // 2?? FILTER STATUS
            let filteredData = data;


            if (currentStatus !== "Semua") {
                filteredData = data.filter(item => {
                    if (currentStatus === "Paid") return item.STATUS_PAID === "Y";
                    if (currentStatus === "Unpaid") return item.STATUS_PAID === "N";
                    return false;
                });
            }
            filteredOvertimeData = filteredData;
            if (searchKeyword.trim() !== '') {
                filteredOvertimeData = filteredOvertimeData.filter(function (item) {
                    const npk = (item.NPK || '').toString().toLowerCase();
                    return npk.includes(searchKeyword.toLowerCase());
                });
            }
            renderAllData(filteredOvertimeData);
        }

        function showNoDataMessage(customMessage = null) {
            const container = $('#overtimeList');
            const periodeName = getDisplayPeriodeText();
            const statusName = currentStatus;
            let message = customMessage || `Tidak ada data lembur untuk periode "${periodeName}" dengan status "${statusName}"`;

            if (searchKeyword.trim() !== '' && !customMessage) {
                message = `Tidak ada data yang cocok dengan NPK "${searchKeyword}" pada periode ini.`;
            }

            container.html(`
                <div class="no-data-container" style="display: block;">
                    <h4 class="no-data-title">Tidak ada data</h4>
                    <p class="no-data-text">${message}</p>
                </div>
            `);
        }

        function renderAllData(data) {
            const container = $('#overtimeList');
            if (!data || data.length === 0) { showNoDataMessage(); return; }
            container.empty();

            data.forEach(item => {
                moment.locale('id');
                const dateMoment = moment(item.TGL_SHIFT);
                const dayOfWeek = dateMoment.format('dddd');
                const formattedDate = dateMoment.format('D MMM YYYY');
                const isPaid = item.STATUS_PAID === 'Y';
                let statusText = isPaid ? 'Paid' : 'Unpaid';
                const statusClass = statusText.toLowerCase();
                const npk = item.NPK || 'N/A';
                const itemId = `${item.TGL_SHIFT}_${item.NPK}`;

                const card = `
                    <div class="card" data-id="${itemId}">
                        <div class="card-content">
                            <div class="card-left-section">
                                <p class="card-npk">NPK : ${npk}</p>
                                <p class="card-date-label-wrapper">Tanggal</p>
                                <div class="card-date-info">
                                    <p class="card-date"><i class="fas fa-clock"></i> ${dayOfWeek}, ${formattedDate}</p>
                                </div>
                            </div>
                            <div class="card-right-section">
                                <span class="card-status-badge status-${statusClass}">${statusText}</span>
                                <a href="/Manage/ManageDetailOverTime/${itemId}" class="card-action-link">
                                    Lihat <i class="fas fa-arrow-right"></i>
                                </a>
                            </div>
                        </div>
                    </div>
                `;
                container.append(card);
            });
        }

        // ===================== EVENT HANDLERS (DARI SCRIPT LAMA) =====================

        function bindOvertimeEvents() {
            // Periode selector (bulan)
            $('#periodeDropdownIcon, #periodeSelectorCard').on('click', function (e) {
                e.stopPropagation();
                if (currentPeriode !== 'periode-bulan' || selectedMonth === null) { selectedYear = END_YEAR; selectedMonth = new Date().getMonth(); }
                renderMonthPicker();
            });

            // Periode filter (M, M-1, M-2)
            //$('#periodeFilterIcon').on('click', function (e) { e.stopPropagation(); renderPeriodeFilterModal(); });

            // Panduan modal
            $('#panduanOvertimeIcon').on('click', function (e) { e.stopPropagation(); $('#panduanOvertimeModal').addClass('show'); });

            // Status tab
            $('#statusFilterContainer .status-tab-btn').on('click', function () {
                $('#statusFilterContainer .status-tab-btn').removeClass('active');
                $(this).addClass('active');

                currentStatus = $(this).data('status');

                updateOvertimeListView(allOvertimeData); // ? langsung filter
            });


            // Search
            $('#searchInput').on('input', function () { searchKeyword = $(this).val(); updateOvertimeListView(allOvertimeData); });

            // Modal controls
            $('#closeMonthPickerModal').on('click', function () { $('#monthPickerModal').removeClass('show'); });
            $('#monthPickerModal').on('click', function (e) { if (e.target.id === 'monthPickerModal') { $('#monthPickerModal').removeClass('show'); } });

            //$('#closePeriodeFilterModal').on('click', function () { $('#periodeFilterModal').removeClass('show'); });
            //$('#periodeFilterModal').on('click', function (e) { if (e.target.id === 'periodeFilterModal') { $('#periodeFilterModal').removeClass('show'); } });

            // Panduan Modal Handlers
            $('#closePanduanOvertimeModalX, #closePanduanOvertimeButton').on('click', function () {
                $('#panduanOvertimeModal').removeClass('show');
            });
            $('#panduanOvertimeModal').on('click', function (e) {
                if (e.target.id === 'panduanOvertimeModal') {
                    $('#panduanOvertimeModal').removeClass('show');
                }
            });
            $('#applyMonthFilter').on('click', function () { handleMonthYearModalChange(); });
        }
