        function getPeriodeRange() {
            let year, month;
            const now = new Date();

            if (currentPeriode === 'periode-bulan' && selectedMonth !== null) {
                year = selectedYear;
                month = selectedMonth;
            } else {
                month = now.getMonth();
                year = now.getFullYear();
            }

            const start = moment(new Date(year, month, 1));
            const end = moment(new Date(year, month + 1, 0));
            return { start, end };
        }

