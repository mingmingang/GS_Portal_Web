            font-size: 15px;
            color: #4B5563;
            line-height: 1.5;
            margin-bottom: 28px;
        }

        .panduan-list {
            list-style: none;
            padding: 0;
            margin: 0;
        }

            .panduan-list li {
                margin-bottom: 12px;
                display: flex;
                align-items: flex-start;
                font-size: 14px;
                color: #333;
            }

        .panduan-status-label {
            font-weight: 600;
            flex-shrink: 0;
            width: 130px; /* Lebar disesuaikan agar tidak terlalu lebar */
            padding: 4px 8px;
            border-radius: 4px;
            text-align: center;
            margin-right: 12px;
            font-size: 13px;
            color: white; /* Default white for colored backgrounds */
        }

            /* Status colors for the Guide */
            .panduan-status-label.status-paid {
                background-color: #4CAF50;
            }

            .panduan-status-label.status-unpaid {
                background-color: #f7110a;
            }

            .panduan-status-label.status-belumverifikasi { /* Mengganti status-menunggu */
                background-color: #fca311;
                color: #1E2D56; /* Warna teks gelap */
            }

        .apply-button { /* Style untuk tombol 'Mengerti' */
            background-color: #1E2D56;
            color: white;
            padding: 12px;
            border: none;
            border-radius: 20px;
            font-size: 16px;
            font-weight: 600;
            cursor: pointer;
            width: 100%;
            transition: background-color 0.2s;
        }

            .apply-button:hover {
                background-color: #2A4A7B;
            }

        .panduan-modal-icon {
            font-size: 24px;
            color: #1E2D56;
        }
    </style>
</head>
<body>
