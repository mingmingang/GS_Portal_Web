        function getDisplayPeriodeText() {
            if (currentPeriode === 'periode-bulan' && selectedMonth !== null) {
                return `${months[selectedMonth].label} ${selectedYear}`;
            }
            const now = new Date();
            return `${months[now.getMonth()].label} ${now.getFullYear()}`;
        }

        function updatePeriodeSelectorDisplay() {
            $('#periodeSelectorText').text(getDisplayPeriodeText());
        }

        function updateRingkasanStatus() {
            if (!allOvertimeData || allOvertimeData.length === 0) { $('#paidCount').text('0'); $('#unpaidCount').text('0'); return; }
            const paidCount = allOvertimeData.filter(item => item.STATUS_PAID === 'Y').length;
            const unpaidCount = allOvertimeData.filter(item => item.STATUS_PAID === 'N').length;
            $('#paidCount').text(paidCount); $('#unpaidCount').text(unpaidCount);
        }

        function renderYearSelector() {
            const $selector = $('#yearSelector'); $selector.empty();
            for (let year = END_YEAR; year >= FALLBACK_START_YEAR; year--) {
                const isSelected = year === selectedYear; $selector.append(`<option value="${year}" ${isSelected ? 'selected' : ''}>${year}</option>`);
            }
            $selector.val(selectedYear);
            // Auto-apply removed (Year)
        }

        function renderMonthSelector() {
            const $selector = $('#monthSelector'); $selector.empty();
            months.forEach(month => {
                const isSelected = selectedMonth === month.value; $selector.append(`<option value="${month.value}" ${isSelected ? 'selected' : ''}>${month.label}</option>`);
            });
            $selector.val(selectedMonth);
            // Auto-apply removed (Month)
        }

        function handleMonthYearModalChange() {
            const newYear = parseInt($('#yearSelector').val());
            const newMonth = parseInt($('#monthSelector').val());
            currentYear = newYear; 
            selectedYear = newYear; // Update global selectedYear state
            selectedMonth = newMonth;
            currentPeriode = 'periode-bulan';
            $('#monthPickerModal').removeClass('show'); updatePeriodeSelectorDisplay(); fetchAndRenderOvertime();
        }

        function renderMonthPicker() {
            const $modal = $('#monthPickerModal'); renderYearSelector(); renderMonthSelector();
            $modal.addClass('show');
        }

