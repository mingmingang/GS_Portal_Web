    </div>
    <!-- Modal Pembatalan IMP -->
    <div class="modal-overlay preview-modal cancel-modal" id="cancelModal">
        <div class="modal-content">
            <button type="button" class="btn-close-custom" aria-label="Close"><i class="fas fa-times"></i></button>
            <div class="modal-header">
                <div class="modal-header-left">
                    <i class="fas fa-times-circle fa-lg text-danger"></i>
                    <h5 class="modal-title">Batalkan IMP</h5>
                </div>
            </div>
            <div class="modal-body">
                <div class="form-group">
                    <label for="alasanPembatalan" class="form-label">
                        Alasan Pembatalan
                        <span class="required-star">*</span>
                        <span id="alasanError" class="label-error">Wajib diisi</span>
                    </label>
                    <textarea id="alasanPembatalan"
                              class="form-control"
                              placeholder="Masukkan alasan pembatalan..."
                              maxlength="50"
                              rows="4"></textarea>
                    <div class="char-count">
                        <span id="charCount">0</span>/50 karakter
                    </div>
