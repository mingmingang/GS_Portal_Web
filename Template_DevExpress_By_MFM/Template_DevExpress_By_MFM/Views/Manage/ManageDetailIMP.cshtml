            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" id="cancelCancelBtn">Batal</button>
                <button type="button" class="btn btn-cancel-modal" id="confirmCancelBtn">Batalkan IMP</button>
            </div>
        </div>
    </div>
    <!-- Modal Pemberitahuan -->
    <div class="modal-overlay preview-modal alert-modal" id="alertModal">
        <div class="modal-content">
            <button type="button" class="btn-close-custom" aria-label="Close"><i class="fas fa-times"></i></button>
            <div class="modal-body">
                <div id="alertIcon" class="alert-icon">
                    <i class="fas fa-info-circle alert-info"></i>
                </div>
                <h4 id="alertTitle" class="modal-title mb-3">Pemberitahuan</h4>
                <p id="alertMessage" class="mb-4">Pesan pemberitahuan akan ditampilkan di sini.</p>
                <button type="button" class="btn btn-ok" id="alertOkBtn">OK</button>
            </div>
        </div>
    </div>
    <!-- Modal Konfirmasi Custom -->
    <div class="modal-overlay preview-modal alert-modal" id="confirmModal">
        <div class="modal-content">
            <button type="button" class="btn-close-custom" aria-label="Close"><i class="fas fa-times"></i></button>
            <div class="modal-body">
                <div id="confirmIcon" class="alert-icon">
                    <i class="fas fa-question-circle alert-info"></i>
                </div>
                <h4 id="confirmTitle" class="modal-title mb-3">Konfirmasi</h4>
                <p id="confirmMessage" class="mb-4">Pesan konfirmasi akan ditampilkan di sini.</p>
                <div class="d-flex gap-2 justify-content-center">
                    <button type="button" class="btn btn-secondary" id="confirmNoBtn">Tidak</button>
                    <button type="button" class="btn btn-primary" id="confirmYesBtn">Ya</button>
                </div>
            </div>
        </div>
    </div>
    <script>
        (function ($) {
            "use strict";
            $(document).ready(function () {
                const impId = new URLSearchParams(window.location.search).get('id');
                const API_BASE_URL = "/api/IMPApi";
                // Koordinat POLITEKNIK ASTRA
                const TARGET_LATITUDE = -6.347684155007094;
                const TARGET_LONGITUDE = 107.14836653677264;
                const ALLOWED_RADIUS = 100; // 100 meter

                // Fungsi untuk menampilkan modal pemberitahuan
                function showAlert(title, message, type = 'info') {
                    const $modal = $('#alertModal');
                    const $icon = $('#alertIcon');
                    const $title = $('#alertTitle');
                    const $message = $('#alertMessage');
                    // Set icon berdasarkan type
                    $icon.empty();
                    let iconClass = 'fas fa-info-circle alert-info';
                    switch (type) {
                        case 'success':
                            iconClass = 'fas fa-check-circle alert-success';
                            break;
                        case 'warning':
                            iconClass = 'fas fa-exclamation-triangle alert-warning';
                            break;
                        case 'error':
                            iconClass = 'fas fa-times-circle alert-error';
                            break;
                        case 'info':
                        default:
                            iconClass = 'fas fa-info-circle alert-info';
                            break;
                    }
                    $icon.append(`<i class="${iconClass}"></i>`);
                    $title.text(title);
                    $message.text(message);
                    $modal.addClass('visible');
                }

                // Fungsi untuk menampilkan modal konfirmasi custom
                function showConfirm(title, message) {
                    return new Promise((resolve) => {
                        const $modal = $('#confirmModal');
                        const $title = $('#confirmTitle');
                        const $message = $('#confirmMessage');
                        $title.text(title);
                        $message.text(message);
                        $modal.addClass('visible');
                        // Event handlers
                        $('#confirmYesBtn').off('click').on('click', function () {
                            $modal.removeClass('visible');
                            resolve(true);
                        });
                        $('#confirmNoBtn').off('click').on('click', function () {
                            $modal.removeClass('visible');
                            resolve(false);
                        });
                        $('.btn-close-custom', $modal).off('click').on('click', function () {
                            $modal.removeClass('visible');
                            resolve(false);
                        });
                    });
                }

                // Fungsi untuk menampilkan modal pembatalan
                function showCancelModal() {
                    return new Promise((resolve) => {
                        const $modal = $('#cancelModal');
                        const $textarea = $('#alasanPembatalan');
                        const $charCount = $('#charCount');
                        const $confirmBtn = $('#confirmCancelBtn');
                        const $errorMsg = $('#alasanError');

                        // Reset form
                        $textarea.val('');
                        $charCount.text('0');
                        $errorMsg.hide();
                        $textarea.removeClass('is-invalid');

                        // Tombol langsung enable
                        $confirmBtn.prop('disabled', false);

                        $modal.addClass('visible');

                        // Event handler untuk textarea
                        $textarea.off('input').on('input', function () {
                            const text = $(this).val();
                            const charCount = text.length;
                            $charCount.text(charCount);

                            // Validasi max length 50 karakter
                            if (charCount > 50) {
                                $(this).val(text.substring(0, 50));
                                $charCount.text('50');
                            }

                            // Sembunyikan error jika user mulai mengetik
                            $errorMsg.hide();
                            $textarea.removeClass('is-invalid');
                        });

                        // Event handlers untuk tombol
                        $('#confirmCancelBtn').off('click').on('click', function () {
                            const alasan = $textarea.val().trim();

                            // Validasi: alasan wajib diisi
                            if (!alasan) {
                                $errorMsg.show();
                                $textarea.addClass('is-invalid');
                                $textarea.focus();
                                return;
                            }

                            $modal.removeClass('visible');
                            resolve(alasan);
                        });

                        $('#cancelCancelBtn').off('click').on('click', function () {
                            $modal.removeClass('visible');
                            resolve(null);
                        });

                        $('.btn-close-custom', $modal).off('click').on('click', function () {
                            $modal.removeClass('visible');
                            resolve(null);
                        });
                    });
                }

                // Helper functions dengan error handling yang lebih baik
                const formatDate = val => {
                    if (!val) return "N/A";
                    try {
                        const date = new Date(val);
                        return isNaN(date.getTime()) ? "N/A" : date.toLocaleDateString('id-ID', {
                            day: 'numeric',
                            month: 'long',
                            year: 'numeric'
                        });
                    } catch (e) {
                        return "N/A";
                    }
                };

                const formatDateTime = val => {
                    if (!val) return "N/A";
                    try {
                        const date = new Date(val);
                        return isNaN(date.getTime()) ? "N/A" : date.toLocaleDateString('id-ID', {
                            day: 'numeric',
                            month: 'long',
                            year: 'numeric',
                            hour: '2-digit',
                            minute: '2-digit'
                        });
                    } catch (e) {
                        return "N/A";
                    }
                };

                const formatTime = val => {
                    if (!val) return "N/A";
                    if (typeof val === 'string') {
                        // Handle string time format (HH:mm:ss)
                        const timeParts = val.split(':');
                        return `${timeParts[0]}:${timeParts[1]}`;
                    }
                    return val;
                };

                const getStatusStyle = status => ({
                    "Selesai": { text: "Selesai", bg: "bg-success", icon: "fa-check-circle" },
                    "Disetujui": { text: "Disetujui", bg: "bg-success", icon: "fa-check-circle" },
                    "Belum Diverifikasi": { text: "Belum Diverifikasi", bg: "bg-warning", icon: "fa-hourglass-half" },
                    "Menunggu Persetujuan": { text: "Menunggu Persetujuan", bg: "bg-menunggu", icon: "fa-hourglass-half" },
                    "Ditolak": { text: "Ditolak", bg: "bg-danger", icon: "fa-times-circle" },
                    "Dibatalkan": { text: "Dibatalkan", bg: "bg-danger", icon: "fa-ban" }
                })[status] || { text: status, bg: "bg-secondary", icon: "fa-question-circle" };

                // Fungsi untuk validasi lokasi
                function validateLocation() {
                    return new Promise((resolve, reject) => {
                        if (!navigator.geolocation) {
                            reject(new Error('Geolokasi tidak didukung oleh browser ini'));
                            return;
                        }

                        navigator.geolocation.getCurrentPosition(
                            (position) => {
                                const userLat = position.coords.latitude;
                                const userLng = position.coords.longitude;
                                // Hitung jarak menggunakan Haversine formula
                                const distance = calculateDistance(
                                    userLat,
                                    userLng,
                                    TARGET_LATITUDE,
                                    TARGET_LONGITUDE
                                );
                                console.log(`Jarak dari lokasi: ${distance.toFixed(2)} meter`);
                                if (distance <= ALLOWED_RADIUS) {
                                    resolve(true);
                                } else {
                                    resolve(false);
                                }
                            },
                            (error) => {
                                console.error('Error mendapatkan lokasi:', error);
                                let errorMessage = 'Tidak dapat mengakses lokasi. ';
                                switch (error.code) {
                                    case error.PERMISSION_DENIED:
                                        errorMessage += 'Izin lokasi ditolak. Harap izinkan akses lokasi di browser Anda.';
                                        break;
                                    case error.POSITION_UNAVAILABLE:
                                        errorMessage += 'Informasi lokasi tidak tersedia.';
                                        break;
                                    case error.TIMEOUT:
                                        errorMessage += 'Permintaan lokasi timeout.';
                                        break;
                                    default:
                                        errorMessage += 'Error tidak diketahui.';
                                        break;
                                }
                                reject(new Error(errorMessage));
                            },
                            {
                                enableHighAccuracy: true,
                                timeout: 10000,
                                maximumAge: 0
                            }
                        );
                    });
                }

                // Fungsi untuk menghitung jarak antara dua koordinat (dalam meter)
                function calculateDistance(lat1, lon1, lat2, lon2) {
                    const R = 6371e3; // Radius bumi dalam meter
                    const φ1 = lat1 * Math.PI / 180;
                    const φ2 = lat2 * Math.PI / 180;
                    const Δφ = (lat2 - lat1) * Math.PI / 180;
                    const Δλ = (lon2 - lon1) * Math.PI / 180;
                    const a = Math.sin(Δφ / 2) * Math.sin(Δφ / 2) +
                        Math.cos(φ1) * Math.cos(φ2) *
                        Math.sin(Δλ / 2) * Math.sin(Δλ / 2);
                    const c = 2 * Math.atan2(Math.sqrt(a), Math.sqrt(1 - a));
                    const distance = R * c;
                    return distance;
                }

                // Modal handlers
                $('.modal-overlay, .btn-close-custom').on('click', function (e) {
                    if (e.target === this || $(this).hasClass('btn-close-custom')) {
                        $(this).closest('.modal-overlay').removeClass('visible');
                    }
                });

                // Handler untuk modal pemberitahuan
                $('#alertOkBtn').on('click', function () {
                    $('#alertModal').removeClass('visible');
                });

                // Fungsi baru untuk menampilkan preview file
                async function showFilePreview(fileKey, filePath, fileName, npk) {
                    if (!filePath) {
                        console.error("File path is not provided.");
                        showAlert('Error', 'Path file tidak tersedia', 'error');
                        return;
                    }

                    try {
                        // URL dengan parameter NPK yang benar
                        const downloadUrl = `/api/IMPApi/file/${impId}/${fileKey}?npk=${encodeURIComponent(npk)}`;
                        console.log('Requesting file from:', downloadUrl);

                        // Image Preview Logic
                        if (!filePath.toLowerCase().endsWith('.pdf')) {
                            const $modal = $('#imageModal');
                            $modal.find('#imageModalFileName').text(fileName);
                            $modal.find('#imageDownloadLink').attr('href', downloadUrl);

                            const timestamp = new Date().getTime();
                            $modal.find('#imagePreview').attr('src', downloadUrl + '&t=' + timestamp);
                            $modal.addClass('visible');
                            return;
                        }

                        // PDF Preview Logic - Gunakan approach sederhana dulu
                        const $modal = $('#pdfGalleryModal');
                        $modal.find('.modal-title').text('Pratinjau Dokumen');
                        $modal.find('#pdfModalFileName').text(fileName);
                        $modal.find('#pdfDownloadLink').attr('href', downloadUrl);

                        // Tampilkan embed PDF sebagai fallback
                        $modal.find('#pdfImageContainer').html(`
                                    <div class="text-center">
                                        <embed src="${downloadUrl}#toolbar=0&navpanes=0&scrollbar=0"
                                               type="application/pdf"
                                               width="100%"
                                               height="500px"
                                               style="border: 1px solid #e5e7eb; border-radius: 8px;">
                                        <div class="mt-3">
                                            <small class="text-muted">
                                                Jika PDF tidak tampil,
                                                <a href="${downloadUrl}" target="_blank" class="text-primary">klik di sini untuk membuka di tab baru</a>
                                                atau
                                                <a href="${downloadUrl}" download class="text-primary">unduh file</a>.
                                            </small>
                                        </div>
                                    </div>
                                `);

                        $modal.addClass('visible');

                    } catch (error) {
                        console.error("Error in showFilePreview:", error);
                        showAlert('Error', `Gagal memuat preview file: ${error.message}`, 'error');
                    }
                }

                function setupFileLinks(data) {
                    const $container = $('#fileLinksContainer').empty();
                    if (data.imp_berkas_lampiran) {
                        const fileName = data.imp_berkas_lampiran.split('/').pop();
                        const linkHtml = `
                                    <div class="detail-row">
                                        <div class="detail-label">Berkas Lampiran</div>
                                        <a href="#" class="detail-value"
                                           data-key="lampiran"
                                           data-path="${data.imp_berkas_lampiran}"
                                           data-filename="${fileName}"
                                           data-npk="${data.imp_npk}"> <!-- TAMBAHKAN NPK -->
                                           Lihat File
                                        </a>
                                    </div>`;
                        $container.append(linkHtml);
                        $('#lampiranCard').show();
                    }

                    $container.off('click.preview').on('click.preview', 'a', function (e) {
                        e.preventDefault();
                        const $this = $(this);
                        showFilePreview(
                            $this.data('key'),
                            $this.data('path'),
                            $this.data('filename'),
                            $this.data('npk') // PASS NPK KE FUNCTION
                        );
                    });
                }

                function updateKehadiranDisplay(data) {
                    const berangkatAktual = data.imp_berangkat_aktual;
                    const kembaliAktual = data.imp_kembali_aktual;
                    // Selalu tampilkan card kehadiran
                    $('#kehadiranCard').show();
                    // Format untuk berangkat aktual
                    if (berangkatAktual && berangkatAktual !== "Belum Tercatat") {
                        try {
                            const berangkatDate = new Date(berangkatAktual);
                            if (!isNaN(berangkatDate.getTime())) {
                                $('#berangkatDateDisplay').text(berangkatDate.toLocaleDateString('id-ID', {
                                    day: 'numeric',
                                    month: 'long',
                                    year: 'numeric'
                                }));
                                $('#berangkatTimeDisplay').text(berangkatDate.toLocaleTimeString('id-ID', {
                                    hour: '2-digit',
                                    minute: '2-digit'
                                }));
                            } else {
                                $('#berangkatDateDisplay').text('-');
                                $('#berangkatTimeDisplay').text('--:--');
                            }
                        } catch (e) {
                            $('#berangkatDateDisplay').text('-');
                            $('#berangkatTimeDisplay').text('--:--');
                        }
                    } else {
                        $('#berangkatDateDisplay').text('-');
                        $('#berangkatTimeDisplay').text('--:--');
                    }
                    // Format untuk kembali aktual
                    if (kembaliAktual && kembaliAktual !== "Belum Tercatat") {
                        try {
                            const kembaliDate = new Date(kembaliAktual);
                            if (!isNaN(kembaliDate.getTime())) {
                                $('#kembaliDateDisplay').text(kembaliDate.toLocaleDateString('id-ID', {
                                    day: 'numeric',
                                    month: 'long',
                                    year: 'numeric'
                                }));
                                $('#kembaliTimeDisplay').text(kembaliDate.toLocaleTimeString('id-ID', {
                                    hour: '2-digit',
                                    minute: '2-digit'
                                }));
                            } else {
                                $('#kembaliDateDisplay').text('-');
                                $('#kembaliTimeDisplay').text('--:--');
                            }
                        } catch (e) {
                            $('#kembaliDateDisplay').text('-');
                            $('#kembaliTimeDisplay').text('--:--');
                        }
                    } else {
                        $('#kembaliDateDisplay').text('-');
                        $('#kembaliTimeDisplay').text('--:--');
                    }
                }

                function populateUI(data) {
                    console.log('Data from API:', data); // Debug log
                    // Status
                    const status = getStatusStyle(data.imp_status);
                    $('#statusBadge').text(status.text).removeClass('bg-success bg-warning bg-danger bg-secondary').addClass(status.bg);
                    // Detail Pengajuan
                    $('#noRequest').text(data.imp_no_request || '-');
                    $('#npkKaryawan').text(data.imp_npk || 'N/A');
                    $('#jenisKegiatan').text(data.imp_jenis_kegiatan || 'N/A');
                    $('#shift').text(data.imp_shift || 'N/A');
                    $('#waktuIzin').text(data.imp_waktu_izin || 'N/A');
                    $('#tanggalDibuat').text(formatDateTime(data.imp_created_date));
                    $('#dibuatOleh').text(data.imp_created_by || 'N/A');

                    // Jadwal Izin - Gunakan field yang sesuai
                    $('#tanggalBerangkat').text(formatDate(data.imp_tanggal_berangkat || data.imp_tanggal_berangkat_raw));
                    $('#waktuBerangkat').html(data.imp_waktu_berangkat && data.imp_waktu_berangkat !== "Tidak Ditentukan" ?
                        `<span class="time-display">${formatTime(data.imp_waktu_berangkat)}</span>` : 'N/A');
                    $('#tanggalKembali').text(formatDate(data.imp_tanggal_kembali || data.imp_tanggal_kembali_raw));
                    $('#waktuKembali').html(data.imp_waktu_kembali && data.imp_waktu_kembali !== "Tidak Ditentukan" ?
                        `<span class="time-display">${formatTime(data.imp_waktu_kembali)}</span>` : 'N/A');
                    $('#durasi').text(data.durasi || 'N/A');

                    // Kehadiran Display - SELALU tampilkan card
                    updateKehadiranDisplay(data);

                    // Keterangan
                    if (data.imp_keterangan) {
                        $('#keterangan').text(data.imp_keterangan);
                        $('#keteranganCard').show();
                    }

                    // File links - Sertakan NPK dari data untuk otorisasi
                    setupFileLinks(data, data.imp_npk);

                    // Alasan Penolakan/Pembatalan
                    if (data.imp_status === 'Dibatalkan' && data.imp_alasan_pembatalan) {
                        $('#alasanJudul').text('Alasan Pembatalan');
                        $('#alasanIsi').text(data.imp_alasan_pembatalan);
                        $('#alasanContainer').show();
                    } else if (data.imp_status === 'Ditolak' && data.imp_alasan_penolakan) {
                        $('#alasanJudul').text('Alasan Penolakan');
                        $('#alasanIsi').text(data.imp_alasan_penolakan);
                        $('#alasanContainer').show();
                    }

                    // DYNAMIC BUTTONS - Tombol Berangkat/Kembali berdasarkan waktu izin
                    const dynamicButtons = [];
                    // Cancel button
                    if (data.bisa_dibatalkan) {
                        dynamicButtons.push(`
                                    <button type="button" class="btn btn-cancel" id="cancelButton">
                                        <i class="fas fa-times me-2"></i> Batalkan IMP
                                    </button>
                                `);
                    }

                    // TOMBOL KEHADIRAN - Tampilkan berdasarkan kondisi waktu izin
                    // SESUAI API: Hanya untuk status "Selesai"
                    if (data.imp_status === 'Selesai' || data.imp_status === 'Disetujui') {
                        const waktuIzin = data.imp_waktu_izin;
                        // Perbaikan: Cek apakah data aktual sudah ada atau belum
                        const belumBerangkat = !data.imp_berangkat_aktual || data.imp_berangkat_aktual === "Belum Tercatat";
                        const belumKembali = !data.imp_kembali_aktual || data.imp_kembali_aktual === "Belum Tercatat";
                        console.log('Tombol kondisi - Waktu Izin:', waktuIzin);
                        console.log('Tombol kondisi - Belum Berangkat:', belumBerangkat);
                        console.log('Tombol kondisi - Belum Kembali:', belumKembali);
                        if (waktuIzin === 'Awal jam kerja') {
                            // Hanya tombol Kembali
                            if (belumKembali) {
                                dynamicButtons.push(`
                                            <button type="button" class="btn btn-kembali" id="kembaliButton">
                                                <i class="fas fa-sign-in-alt me-2"></i> Catat Kembali
                                            </button>
                                        `);
                            }
                        } else if (waktuIzin === 'Diantara jam kerja') {
                            // Kedua tombol
                            if (belumBerangkat) {
                                dynamicButtons.push(`
                                            <button type="button" class="btn btn-berangkat" id="berangkatButton">
                                                <i class="fas fa-sign-out-alt me-2"></i> Catat Berangkat
                                            </button>
                                        `);
                            }
                            if (belumKembali) {
                                dynamicButtons.push(`
                                            <button type="button" class="btn btn-kembali" id="kembaliButton">
                                                <i class="fas fa-sign-in-alt me-2"></i> Catat Kembali
                                            </button>
                                        `);
                            }
                        } else if (waktuIzin === 'Akhir jam kerja') {
                            // Hanya tombol Berangkat
                            if (belumBerangkat) {
                                dynamicButtons.push(`
                                            <button type="button" class="btn btn-berangkat" id="berangkatButton">
                                                <i class="fas fa-sign-out-alt me-2"></i> Catat Berangkat
                                            </button>
                                        `);
                            }
                        }
                    }
                    $('#dynamicButtonContainer').html(dynamicButtons.join(''));

                    // Button event handlers
                    $('#cancelButton').on('click', async function () {
                        const alasan = await showCancelModal();
                        if (alasan) {
                            cancelIMP(alasan);
                        }
                    });

                    // Event handlers untuk tombol kehadiran
                    $('#berangkatButton').on('click', function () {
                        $('#confirmBerangkatModal').addClass('visible');
                    });

                    // Event handler untuk tombol kembali dengan validasi lokasi
                    $('#kembaliButton').on('click', async function () {
                        const $btn = $(this);
                        const originalText = $btn.html();
                        // Nonaktifkan tombol sementara
                        $btn.prop('disabled', true).html('<i class="fas fa-spinner fa-spin me-2"></i>Memeriksa lokasi...');
                        // Validasi lokasi sebelum menampilkan modal
                        validateLocation()
                            .then((isWithinRadius) => {
                                $btn.prop('disabled', false).html(originalText);
                                if (isWithinRadius) {
                                    $('#confirmKembaliModal').addClass('visible');
                                } else {
                                    showAlert(
                                        'Lokasi Tidak Sesuai',
                                        'Anda tidak berada dalam radius 100 meter dari GS BATTERY KARAWANG. Tidak dapat mencatat kembali.',
                                        'warning'
                                    );
                                }
                            })
                            .catch(async (error) => {
                                $btn.prop('disabled', false).html(originalText);
                                console.error('Error validasi lokasi:', error);
                                // Tanyakan apakah ingin melanjutkan tanpa validasi lokasi
                                const shouldContinue = await showConfirm(
                                    'Peringatan Lokasi',
                                    error.message + '\nApakah Anda ingin tetap mencatat waktu kembali?'
                                );
                                if (shouldContinue) {
                                    $('#confirmKembaliModal').addClass('visible');
                                }
                            });
                    });

                    // Show content
                    $('#loadingIndicator').hide();
                    $('#stickyStatusContainer').show();
                    $('#detailContainer').show();
                }

                // Fungsi untuk mencatat berangkat aktual
                function catatBerangkatAktual() {
                    const $button = $('#confirmBerangkatBtn');
                    $button.prop('disabled', true).html('<i class="fas fa-spinner fa-spin"></i> Menyimpan...');
                    // Sesuai dengan API: kirim imp_id saja
                    const requestData = {
                        imp_id: parseInt(impId) // Pastikan integer
                    };
                    console.log('Sending berangkat request:', requestData);
                    $.ajax({
                        url: `${API_BASE_URL}/update-berangkat-aktual`,
                        method: 'POST',
                        contentType: 'application/json',
                        data: JSON.stringify(requestData),
                        success: function (response) {
                            console.log('Berangkat response:', response);
                            if (response.code === 200) {
                                $('#confirmBerangkatModal').removeClass('visible');
                                showAlert(
                                    'Berhasil',
                                    'Berangkat aktual berhasil dicatat',
                                    'success'
                                );
                                setTimeout(() => {
                                    location.reload();
                                }, 1500);
                            } else {
                                showAlert(
                                    'Gagal',
                                    'Gagal mencatat berangkat: ' + response.message,
                                    'error'
                                );
                                $button.prop('disabled', false).text('Ya, Catat Berangkat');
                            }
                        },
                        error: function (xhr) {
                            console.error('Error:', xhr);
                            showAlert(
                                'Kesalahan',
                                'Terjadi kesalahan saat mencatat berangkat',
                                'error'
                            );
                            $button.prop('disabled', false).text('Ya, Catat Berangkat');
                        }
                    });
                }

                // Fungsi untuk mencatat kembali aktual
                function catatKembaliAktual() {
                    const $button = $('#confirmKembaliBtn');
                    $button.prop('disabled', true).html('<i class="fas fa-spinner fa-spin"></i> Menyimpan...');
                    // Sesuai dengan API: kirim imp_id saja
                    const requestData = {
                        imp_id: parseInt(impId) // Pastikan integer
                    };
                    console.log('Sending kembali request:', requestData);
                    $.ajax({
                        url: `${API_BASE_URL}/update-kembali-aktual`,
                        method: 'POST',
                        contentType: 'application/json',
                        data: JSON.stringify(requestData),
                        success: function (response) {
                            console.log('Kembali response:', response);
                            if (response.code === 200) {
                                $('#confirmKembaliModal').removeClass('visible');
                                showAlert(
                                    'Berhasil',
                                    'Kembali aktual berhasil dicatat',
                                    'success'
                                );
                                setTimeout(() => {
                                    location.reload();
                                }, 1500);
                            } else {
                                showAlert(
                                    'Gagal',
                                    'Gagal mencatat kembali: ' + response.message,
                                    'error'
                                );
                                $button.prop('disabled', false).text('Ya, Catat Kembali');
                            }
                        },
                        error: function (xhr) {
                            console.error('Error:', xhr);
                            showAlert(
                                'Kesalahan',
                                'Terjadi kesalahan saat mencatat kembali',
                                'error'
                            );
                            $button.prop('disabled', false).text('Ya, Catat Kembali');
                        }
                    });
                }

                // API functions
                function cancelIMP(alasan) {
                    $.ajax({
                        url: `${API_BASE_URL}/cancel`,
                        method: 'POST',
                        contentType: 'application/json',
                        data: JSON.stringify({
                            imp_id: impId,
                            alasan_pembatalan: alasan
                        }),
                        success: function (response) {
                            if (response.code === 200) {
                                showAlert(
                                    'Berhasil',
                                    'IMP berhasil dibatalkan',
                                    'success'
                                );
                                setTimeout(() => {
                                    location.reload();
                                }, 1500);
                            } else {
                                showAlert(
                                    'Gagal',
                                    'Gagal membatalkan IMP: ' + response.message,
                                    'error'
                                );
                            }
                        },
                        error: function (xhr) {
                            showAlert(
                                'Kesalahan',
                                'Terjadi kesalahan saat membatalkan IMP',
                                'error'
                            );
                        }
                    });
                }

                // Event handlers untuk modal konfirmasi kehadiran
                $('#confirmBerangkatBtn').on('click', catatBerangkatAktual);
                $('#confirmKembaliBtn').on('click', catatKembaliAktual);
                $('#cancelBerangkatBtn').on('click', function () {
                    $('#confirmBerangkatModal').removeClass('visible');
                });
                $('#cancelKembaliBtn').on('click', function () {
                    $('#confirmKembaliModal').removeClass('visible');
                });

                // Close modal ketika klik di luar
                $('#confirmBerangkatModal, #confirmKembaliModal, #alertModal, #confirmModal, #cancelModal').on('click', function (e) {
                    if ($(e.target).is('.modal-overlay')) {
                        $(this).removeClass('visible');
                    }
                });

                // Main execution
                if (!impId) {
                    $('#loadingIndicator').hide();
                    $('#errorIndicator').text('ID IMP tidak ditemukan di URL.').show();
                    return;
                }

                $.ajax({
                    url: `${API_BASE_URL}/${impId}`,
                    method: 'GET',
                    success: function (response) {
                        console.log('API Response:', response);
                        if (response && response.code === 200 && response.data) {
                            populateUI(response.data);
                        } else {
                            $('#loadingIndicator').hide();
                            $('#errorIndicator').text(response.message || 'Gagal memuat data. Respons tidak valid.').show();
                        }
                    },
                    error: (xhr) => {
                        $('#loadingIndicator').hide();
                        let errorMessage = 'Gagal memuat data. Silakan coba lagi.';
                        try {
                            const errorResponse = JSON.parse(xhr.responseText);
                            errorMessage = errorResponse.message || errorResponse.Message || errorMessage;
                        } catch (e) {
                            errorMessage = xhr.responseText || errorMessage;
                        }
                        $('#errorIndicator').text(errorMessage).show();
                    }
                });
            });
        })(jQuery);
    </script>
</body>
</html>