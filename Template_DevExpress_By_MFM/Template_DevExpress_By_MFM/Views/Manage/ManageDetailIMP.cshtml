    <!-- Modal Konfirmasi Berangkat -->
    <div class="modal-overlay preview-modal" id="confirmBerangkatModal">
        <div class="modal-content">
            <button type="button" class="btn-close-custom" aria-label="Close"><i class="fas fa-times"></i></button>
            <div class="modal-header">
                <div class="modal-header-left">
                    <i class="fas fa-play-circle fa-lg text-primary"></i>
                    <h5 class="modal-title">Konfirmasi Berangkat</h5>
                </div>
            </div>
            <div class="modal-body text-center">
                <p>Apakah Anda yakin ingin mencatat waktu berangkat sekarang?</p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" id="cancelBerangkatBtn">Tidak</button>
                <button type="button" class="btn btn-primary" id="confirmBerangkatBtn">Ya, Catat Berangkat</button>
            </div>
        </div>
    </div>
    <!-- Modal Konfirmasi Kembali -->
    <div class="modal-overlay preview-modal" id="confirmKembaliModal">
        <div class="modal-content">
            <button type="button" class="btn-close-custom" aria-label="Close"><i class="fas fa-times"></i></button>
            <div class="modal-header">
                <div class="modal-header-left">
                    <i class="fas fa-sign-out-alt fa-lg text-success"></i>
                    <h5 class="modal-title">Konfirmasi Kembali</h5>
                </div>
            </div>
            <div class="modal-body text-center">
                <p>Apakah Anda yakin ingin mencatat waktu kembali sekarang?</p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" id="cancelKembaliBtn">Tidak</button>
                <button type="button" class="btn btn-primary" id="confirmKembaliBtn">Ya, Catat Kembali</button>
            </div>
