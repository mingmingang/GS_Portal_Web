@{
    var logSession = HttpContext.Current.Session["SHealth"] as Template_DevExpress_By_MFM.Models.SessionLogin;
    Layout = null;
    string plant = logSession != null ? logSession.plant : "PLANT_NOT_FOUND";
}
<!DOCTYPE html>
<html>
<head>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Detail Over Time</title>

    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700&display=swap" rel="stylesheet">

    <style>
        body {
            margin: 0;
            font-family: 'Poppins', sans-serif;
            background: #f4f7fa;
        }

        .detail-header-section {
            background: linear-gradient(135deg, #1E2D56, #2A4A7B);
            padding: 16px;
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            z-index: 1000;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .back-arrow {
            position: absolute;
            left: 16px;
            color: #fff;
            font-size: 20px;
            text-decoration: none;
        }

        .detail-header-section h1 {
            color: #fff;
            font-size: 18px;
            margin: 0;
        }

        .detail-page-container {
            padding-top: 80px;
            padding-bottom: 40px;
        }

        .status-info-bar {
            background: #E0EDFF;
            margin: 20px;
            padding: 12px 16px;
            border-radius: 8px;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .status-badge {
            padding: 6px 16px;
            border-radius: 20px;
            font-weight: 600;
            color: #fff;
        }

        .badge-paid {
            background: #4CAF50;
        }

        .badge-unpaid {
            background: #F44336;
        }

        .detail-content {
            max-width: 800px;
            margin: auto;
        }

        .detail-card {
            background: #fff;
            border-radius: 16px;
            padding: 24px;
            margin: 20px;
            box-shadow: 0 4px 12px rgba(0,0,0,.05);
        }

        .detail-card-title {
            font-size: 18px;
            margin-bottom: 20px;
            border-bottom: 1px solid #eee;
            padding-bottom: 12px;
        }

        .detail-row {
            display: flex;
            justify-content: space-between;
            margin-bottom: 14px;
        }

        .detail-label {
            color: #888;
        }

        .detail-value {
            font-weight: 600;
        }
    </style>
</head>

<body>
    <div class="detail-page-container">

        <div class="detail-header-section">
            <a href="javascript:history.back()" class="back-arrow">
                <i class="fas fa-arrow-left"></i>
            </a>
            <h1>Detail Over Time</h1>
        </div>

        <div class="status-info-bar">
            <span>Status</span>
            <span id="ot-status" class="status-badge badge-unpaid">Loading</span>
        </div>

        <div class="detail-content">
            <div class="detail-card">
                <h3 class="detail-card-title">Informasi Lembur</h3>

                <div class="detail-row"><span class="detail-label">Hari</span><span id="ot-hari" class="detail-value">-</span></div>
                <div class="detail-row"><span class="detail-label">Tanggal</span><span id="ot-tanggal" class="detail-value">-</span></div>
                <div class="detail-row"><span class="detail-label">WD / WE / NH</span><span id="ot-wd" class="detail-value">-</span></div>
                <div class="detail-row"><span class="detail-label">Jam</span><span id="ot-jam" class="detail-value">-</span></div>
                <div class="detail-row"><span class="detail-label">Shift</span><span id="ot-shift" class="detail-value">-</span></div>
                <div class="detail-row"><span class="detail-label">Durasi</span><span id="ot-durasi" class="detail-value">-</span></div>
            </div>
        </div>

    </div>

    <script src="https://ajax.googleapis.com/ajax/libs/jquery/3.6.0/jquery.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/moment.js/2.29.1/moment.min.js"></script>

    <script>
$(document).ready(async function () {
    moment.locale('id');

    const id = location.pathname.split('/').pop();
    if (!id || !id.includes('_')) return;

    const [tgl, npk] = id.split('_');
    const token = sessionStorage.getItem("access_token");

    // =============================
    // GET STATUS (SEMUA DATA UTAMA)
    // =============================
    const resStatus = await fetch("/api/OvertimeApi/getStatus", {
        method: "POST",
        headers: {
            "Content-Type": "application/json",
            "Authorization": "Bearer " + token
        },
        body: JSON.stringify({ nik: npk, com: "gsbattery", tgl })
    });
    const statusData = await resStatus.json();

    // =============================
    // GET LIST (HANYA TYPE HARI)
    // =============================
    const resList = await fetch("/api/OvertimeApi/list", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ npk, plant: "@plant" })
    });
    const listData = await resList.json();

    // =============================
    // RENDER TANGGAL
    // =============================
    const m = moment(tgl);
    $("#ot-hari").text(m.format("dddd"));
    $("#ot-tanggal").text(m.format("D MMMM YYYY"));

    // =============================
    // TYPE HARI (DARI LIST)
    // =============================
    let typeHari = "-";

    const rec = listData.data?.find(x =>
        x.ovt_date === m.format("DD/MM/YYYY")
    );

    if (rec && rec.typeday) {
        typeHari = rec.typeday === "OFF" ? "WE" : rec.typeday;
    }

    $("#ot-wd").text(typeHari);

    // =============================
    // DATA DARI GET STATUS
    // =============================
    if (statusData.RESULT?.length > 0) {
        const r = statusData.RESULT[0];

        // STATUS
        const status = r.STATUS_PAID === "Y" ? "Paid" : "Unpaid";
        $("#ot-status")
            .text(status)
            .removeClass("badge-paid badge-unpaid")
            .addClass(status === "Paid" ? "badge-paid" : "badge-unpaid");

        // SHIFT
        $("#ot-shift").text(r.SHIFT_CODE || "-");

        // JAM
        const start = r.ABSEN_IN
            ? r.ABSEN_IN.substring(11, 16)
            : "-";

        const end = r.ABSEN_OUT
            ? r.ABSEN_OUT.substring(11, 16)
            : "-";

        $("#ot-jam").text(`${start} - ${end}`);

        // DURASI (MENIT ? JAM)
        const durasi =
            r.TOTAL_OT != null
                ? (r.TOTAL_OT / 60).toFixed(1) + " Jam"
                : "-";

        $("#ot-durasi").text(durasi);
    }

});
    </script>

</body>
</html>
