        .note-box {
            background-color: #EFF6FF;
            padding: 15px;
            border-radius: 8px;
            font-size: 14px;
            color: #1E40AF;
            border-left: 4px solid #3B82F6
        }

            .note-box strong {
                color: #1D4ED8
            }

            .note-box.error {
                margin-top: 25px;
                background-color: #FEF2F2;
                color: #991B1B;
                border-left-color: #EF4444
            }

        .form-actions {
            display: flex;
            justify-content: flex-end;
            gap: 12px
        }

        .btn {
            padding: 10px 28px;
            font-size: 14px;
            font-weight: 600;
            border-radius: 8px;
            border: 1px solid transparent;
            cursor: pointer;
            transition: all .2s
        }

        .btn-batal {
            background-color: #F3F4F6;
            color: #374151;
            border-color: #D1D5DB
        }

            .btn-batal:hover {
                background-color: #E5E7EB
            }

        .btn-simpan {
            background-color: #16A34A;
            color: white
        }

            .btn-simpan:hover {
                background-color: #15803D
            }

            .btn-simpan:disabled {
                background-color: #86EFAC;
                cursor: not-allowed
            }

        .custom-modal-overlay {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(0,0,0,0.5);
            display: none;
            align-items: center;
            justify-content: center;
            z-index: 1050;
            opacity: 0;
            transition: opacity .2s ease
        }

            .custom-modal-overlay.show {
                display: flex !important;
                opacity: 1
            }

        .custom-modal {
            background: white;
            padding: 30px 35px;
            border-radius: 16px;
            width: 90%;
            max-width: 400px;
            box-shadow: 0 5px 15px rgba(0,0,0,0.2);
            text-align: center;
            transform: scale(0.95);
            transition: transform .2s ease
        }

        .custom-modal-overlay.show .custom-modal {
            transform: scale(1)
        }

        .modal-title {
            font-size: 24px;
            font-weight: bold;
            color: #333;
            margin: 0 0 15px 0
        }

        .modal-text {
            font-size: 16px;
            color: #666;
            margin-bottom: 30px;
            line-height: 1.5;
        }

        .modal-actions {
            display: flex;
            justify-content: center;
            gap: 15px
        }

        .modal-btn {
            flex: 1;
            padding: 12px 20px;
            border-radius: 8px;
            border: none;
            font-size: 16px;
            font-weight: bold;
            cursor: pointer;
            transition: background-color .2s
        }

        .modal-btn-cancel {
            background-color: #E9ECEF;
            color: #495057
        }

            .modal-btn-cancel:hover {
                background-color: #dee2e6
            }

        .modal-btn-confirm {
            background-color: #1F4AB8;
            color: white
        }

            .modal-btn-confirm:hover {
                background-color: #1a3f99
            }

        .modal-icon-success .checkmark {
            width: 80px;
            height: 80px;
            border-radius: 50%;
            display: inline-block;
            stroke-width: 3;
            stroke: #fff;
            stroke-miterlimit: 10;
            box-shadow: inset 0 0 0 #28a745;
            animation: fill .4s ease-in-out .4s forwards,scale .3s ease-in-out .9s both
        }

        .modal-icon-success .checkmark-circle {
            stroke-dasharray: 166;
            stroke-dashoffset: 166;
            stroke-width: 3;
            stroke-miterlimit: 10;
            stroke: #28a745;
            fill: none;
            animation: stroke .6s cubic-bezier(0.65,0,0.45,1) forwards
        }

        .modal-icon-success .checkmark-check {
            transform-origin: 50% 50%;
            stroke-dasharray: 48;
            stroke-dashoffset: 48;
            animation: stroke .3s cubic-bezier(0.65,0,0.45,1) .8s forwards
        }

        @@keyframes stroke {
            100% {
                stroke-dashoffset: 0
            }
        }

        @@keyframes scale {
            0%, 100% {
                transform: none
            }

            50% {
                transform: scale3d(1.1,1.1,1)
            }
        }

        @@keyframes fill {
            100% {
                box-shadow: inset 0 0 0 50px #28a745
            }
        }

        .modal-text-success {
            font-size: 18px;
            color: #495057;
            margin-top: 15px;
            margin-bottom: 25px
        }

        .file-upload-wrapper {
            width: 100%;
        }

        .file-upload-actions {
            display: flex;
            gap: 10px;
            margin-bottom: 8px;
        }

        .btn-upload {
            flex: 1;
            padding: 8px 15px;
            font-size: 14px;
            font-weight: 500;
            border-radius: 6px;
            border: 1px solid #D1D5DB;
            background-color: #F9FAFB;
            color: #374151;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            transition: background-color .2s;
        }

            .btn-upload:hover {
                background-color: #F3F4F6;
            }

        .file-preview {
            font-size: 13px;
            color: #4B5563;
            padding: 8px 12px;
            background-color: #F3F4F6;
            border-radius: 6px;
            border: 1px dashed #D1D5DB;
            text-align: center;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

            .file-preview .file-name {
                font-style: italic;
                color: #6B7280;
            }

                .file-preview .file-name.selected {
                    font-style: normal;
                    font-weight: 500;
                    color: #1F2937;
                }

        .file-upload-wrapper.is-invalid .file-preview {
            border-color: #EF4444;
            border-style: solid;
        }

        /* Style untuk textarea */
        textarea.form-control {
            min-height: 100px;
            resize: vertical;
        }

        .conditional-field {
            display: block !important;
        }

        .file-upload-wrapper {
            display: block !important;
        }

        /* Tambahkan style untuk preview file */
        .file-preview-container {
            background-color: #f8f9fa;
            border-radius: 8px;
            padding: 10px;
            text-align: center;
            border: 1px solid #dee2e6;
        }

        .pdf-preview {
            padding: 15px;
        }

        .pdf-filename {
            margin-top: 8px;
            font-size: 14px;
            color: #495057;
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
        }

        /* Style untuk character count */
        #charCount {
            font-weight: 600;
            font-size: 12px;
        }

        /* Style untuk input yang disabled */
        .form-control:disabled {
            background-color: #f3f4f6;
            color: #6b7280;
            cursor: not-allowed;
        }
    </style>
</head>
<body>
    <div class="imp-page-container">
        <div class="blue-section">
            <div class="page-header-standalone">
                <a href="@Url.Action("ManageIMPKaryawan", "Manage")" class="back-button" aria-label="Kembali">
                    <i class="fas fa-arrow-left"></i>
                </a>
                <h1 class="page-header-title">@ViewBag.Title</h1>
            </div>
        </div>

        <!-- SECTION 2: Form Content Area -->
        <div class="form-content-section">
            <div class="imp-container">

                <div id="dateValidationError" class="note-box error" style="display: none;"></div>

                <form id="impForm" class="form" novalidate enctype="multipart/form-data">
                    @Html.AntiForgeryToken()
                    <input type="hidden" id="imp_created_by" name="imp_created_by" value="@ViewBag.NamaKaryawan" />
                    <!-- Tambahkan field hidden untuk waktu aktual -->
                    <input type="hidden" id="imp_berangkat_aktual" name="imp_berangkat_aktual" />
                    <input type="hidden" id="imp_kembali_aktual" name="imp_kembali_aktual" />

                    <!-- Baris 1: Info Karyawan (Readonly) -->
                    <div class="form-row">
                        <div class="form-col">
                            <label>No. Permohonan IMP</label>
                            <input type="text" id="imp_no_request" name="imp_no_request" class="form-control" value="Memuat nomor..." readonly>
                        </div>
                        <div class="form-col">
                            <label>NPK</label>
                            <input type="text" id="imp_npk" name="imp_npk" class="form-control" value="@ViewBag.Npk" readonly>
                        </div>
                        <div class="form-col">
                            <label>Nama Karyawan</label>
                            <input type="text" id="namaKaryawan" class="form-control" value="@ViewBag.NamaKaryawan" readonly>
                        </div>
                    </div>

                    <!-- Baris 2: Jenis Kegiatan dan Waktu Izin -->
                    <div class="form-row">
                        <div class="form-col">
                            <label>Jenis Kegiatan <span class="text-danger">*</span><span class="error-message"></span></label>
                            <select id="imp_jenis_kegiatan" name="imp_jenis_kegiatan" class="form-control" required>
                                <option value="">Pilih Jenis Kegiatan</option>
                                <option value="Lebih dari 4 jam">Lebih dari 4 jam</option>
                                <option value="Kurang dari 4 jam">Kurang dari 4 jam</option>
                                <option value="Dispensasi">Dispensasi</option>
                            </select>
                        </div>
                        <div class="form-col">
                            <label>Shift <span class="text-danger">*</span><span class="error-message"></span></label>
                            <select id="imp_shift" name="imp_shift" class="form-control" required>
                                <option value="">Pilih Shift</option>
                                <option value="Shift I">Shift I (Jam 07.00 s/d 16.00 WIB)</option>
                                <option value="Shift II">Shift II (Jam 16.00 s/d 24.00 WIB)</option>
                                <option value="Shift III">Shift III (Jam 00.00 s/d 07.00 WIB)</option>
                                <option value="Shift Merah">Shift Merah (Jam 07.00 s/d 16.00 WIB)</option>
                                <option value="Shift Putih">Shift Putih (Jam 21.00 s/d 05.00 WIB)</option>
                            </select>
                        </div>
                        <div class="form-col">
                            <label>Waktu Izin <span class="text-danger">*</span><span class="error-message"></span></label>
                            <select id="imp_waktu_izin" name="imp_waktu_izin" class="form-control" required>
                                <option value="">Pilih Waktu Izin</option>
                                <option value="Awal jam kerja">Awal jam kerja</option>
                                <option value="Diantara jam kerja">Diantara jam kerja</option>
                                <option value="Akhir jam kerja">Akhir jam kerja</option>
                            </select>
                        </div>
                    </div>

                    <!-- Baris 4: DateTimePicker untuk Berangkat dan Kembali -->
                    <div class="form-row">
                        <div class="form-col">
                            <label>Waktu Berangkat <span class="text-danger">*</span><span class="error-message"></span></label>
                            <input type="datetime-local" id="imp_waktu_berangkat" name="imp_waktu_berangkat" class="form-control" required>
                        </div>
                        <div class="form-col">
                            <label>Waktu Kembali <span class="text-danger">*</span><span class="error-message"></span></label>
                            <input type="datetime-local" id="imp_waktu_kembali" name="imp_waktu_kembali" class="form-control" required>
                        </div>
                    </div>

                    <!-- Baris 5: Keterangan (dengan maxlength) dan Berkas Lampiran -->
                    <div class="form-row">
                        <div class="form-col">
                            <label>Keterangan <span class="text-danger">*</span><span class="error-message"></span></label>
                            <textarea id="imp_keterangan" name="imp_keterangan" class="form-control" placeholder="Tambahkan keterangan jika diperlukan" rows="4" maxlength="50" required></textarea>
                            <small><span id="charCount">0</span>/50 karakter</small>
                        </div>
                        @RenderFileUpload("berkasLampiranUpload", "Berkas Lampiran", "imp_berkas_lampiran", false)
                    </div>

                    <!-- Note Box -->
                    <div class="note-box">
                        <strong>Perhatian:</strong> Pastikan data yang Anda isi sudah benar sebelum menyimpan. Izin yang sudah disimpan tidak dapat diubah tanpa persetujuan atasan.
                    </div>

                    <!-- Tombol Aksi -->
                    <div class="form-actions">
                        <button type="button" class="btn btn-batal">Batal</button>
                        <button type="submit" class="btn btn-simpan">Kirim</button>
                    </div>

                </form>
            </div>
        </div>

        <!-- Modals -->
        <div id="confirmModal" class="custom-modal-overlay">
            <div class="custom-modal">
                <h2 class="modal-title">Konfirmasi Pengajuan</h2>
                <p class="modal-text">Apakah Anda yakin data yang dimasukkan sudah benar?</p>
                <div class="modal-actions">
                    <button id="cancel-save-btn" class="modal-btn modal-btn-cancel">Periksa Lagi</button>
                    <button id="confirm-save-btn" class="modal-btn modal-btn-confirm">Ya, Kirim</button>
                </div>
            </div>
        </div>
        <div id="successModal" class="custom-modal-overlay">
            <div class="custom-modal">
                <div class="modal-icon-success">
                    <svg class="checkmark" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 52 52">
                        <circle class="checkmark-circle" cx="26" cy="26" r="25" fill="none" />
                        <path class="checkmark-check" fill="none" d="M14.1 27.2l7.1 7.2 16.7-16.8" />
                    </svg>
                </div>
                <p class="modal-text-success">Pengajuan IMP berhasil disimpan!</p>
                <button id="close-success-btn" class="modal-btn modal-btn-confirm" style="width: 50%; margin: 0 auto;">OK</button>
            </div>
        </div>

        <!-- Modal Kamera -->
        <div id="cameraModal" class="custom-modal-overlay">
            <div class="custom-modal" style="max-width: 640px; padding: 15px; background-color: #333;">
                <video id="cameraFeed" playsinline autoplay style="width: 100%; border-radius: 8px; transform: scaleX(-1);"></video>
                <canvas id="cameraCanvas" style="display:none;"></canvas>
                <div class="modal-actions" style="margin-top: 15px;">
                    <button id="cancelCameraBtn" class="modal-btn modal-btn-cancel">Batal</button>
                    <button id="snapPhotoBtn" class="modal-btn modal-btn-confirm"><i class="fas fa-camera"></i> Ambil Foto</button>
                </div>
            </div>
        </div>
    </div>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/select2/4.0.13/js/select2.min.js"></script>

    <script>
        $(document).ready(function () {
            let currentStream, currentFileInputTarget;
            const cameraModal = $('#cameraModal');
            const video = document.getElementById('cameraFeed');
            const canvas = document.getElementById('cameraCanvas');
            const snapBtn = $('#snapPhotoBtn');
            const cancelCamBtn = $('#cancelCameraBtn');
            const $submitButton = $('.btn-simpan');
            const originalButtonHtml = $submitButton.html();

            // Konfigurasi shift yang diperbarui
            const shiftSettings = {
                "Shift I": { start: "07:00", end: "16:00", sameDay: true },
                "Shift II": { start: "16:00", end: "24:00", sameDay: true },
                "Shift III": { start: "00:00", end: "07:00", sameDay: true },
                "Shift Merah": { start: "07:00", end: "16:00", sameDay: true },
                "Shift Putih": { start: "21:00", end: "05:00", sameDay: false } // Bisa beda hari
            };

            // Inisialisasi Select2 untuk semua dropdown
            $('#imp_jenis_kegiatan, #imp_waktu_izin, #imp_shift').select2({
                placeholder: "Pilih opsi",
                allowClear: false,
            });

            // Fungsi untuk menampilkan konfirmasi
            function showConfirm(title, text, confirmButtonText) {
                return new Promise((resolve) => {
                    $('#confirmModal .modal-title').text(title);
                    $('#confirmModal .modal-text').text(text);
                    $('#confirmModal').addClass('show');

                    $('#confirm-save-btn').off('click').on('click', function() {
                        $('#confirmModal').removeClass('show');
                        resolve(true);
                    });

                    $('#cancel-save-btn').off('click').on('click', function() {
                        $('#confirmModal').removeClass('show');
                        resolve(false);
                    });
                });
            }

            // Set datetime constraints
            function setDateTimeConstraints() {
                const today = new Date();
                const year = today.getFullYear();
                const minDate = `${year}-01-01T00:00`;
                const maxDate = `${year}-12-31T23:59`;

                $('#imp_waktu_berangkat, #imp_waktu_kembali').attr('min', minDate).attr('max', maxDate);
            }

            // Generate nomor IMP
            function generateImpNo() {
                const $impNoField = $('#imp_no_request');
                $submitButton.prop('disabled', true).text('Menunggu No...');

                // Generate nomor berdasarkan format yang diharapkan
                const date = new Date();
                const year = date.getFullYear();
                const month = String(date.getMonth() + 1).padStart(2, '0');
                const day = String(date.getDate()).padStart(2, '0');
                const randomNum = Math.floor(1000 + Math.random() * 9000);

                const impNo = `IMP${year}${month}${day}${randomNum}`;
                $impNoField.val(impNo);
                $submitButton.prop('disabled', false).html(originalButtonHtml);
            }

            // Fungsi untuk menghitung durasi dalam jam
            function calculateDuration() {
                const startTime = $('#imp_waktu_berangkat').val();
                const endTime = $('#imp_waktu_kembali').val();

                if (!startTime || !endTime) return 0;

                const startDate = new Date(startTime);
                const endDate = new Date(endTime);

                // Durasi dalam jam
                return (endDate - startDate) / (1000 * 60 * 60);
            }

            // Fungsi untuk validasi jenis kegiatan vs durasi (diperbarui untuk <= 4 jam)
            function validateJenisKegiatanVsDurasi() {
                const jenisKegiatan = $('#imp_jenis_kegiatan').val();
                const duration = calculateDuration();

                if (jenisKegiatan === "Dispensasi") {
                    return { isValid: true, message: "" };
                }

                // PERUBAHAN: "Kurang dari 4 jam" sekarang termasuk 4 jam (<= 4)
                if (jenisKegiatan === "Kurang dari 4 jam" && duration > 4) {
                    return {
                        isValid: false,
                        message: "Untuk jenis kegiatan 'Kurang dari 4 jam', durasi tidak boleh lebih dari 4 jam. Durasi saat ini: " + duration.toFixed(2) + " jam"
                    };
                }

                if (jenisKegiatan === "Lebih dari 4 jam" && duration <= 4) {
                    return {
                        isValid: false,
                        message: "Untuk jenis kegiatan 'Lebih dari 4 jam', durasi harus lebih dari 4 jam. Durasi saat ini: " + duration.toFixed(2) + " jam"
                    };
                }

                return { isValid: true, message: "" };
            }

            // Fungsi untuk mengatur disable/enable datetime berdasarkan waktu izin
            function setDateTimeInputsState() {
                const waktuIzin = $('#imp_waktu_izin').val();
                const selectedShift = $('#imp_shift').val();
                const shiftConfig = shiftSettings[selectedShift];

                if (!waktuIzin || !shiftConfig) return;

                // Reset semua state
                $('#imp_waktu_berangkat, #imp_waktu_kembali').prop('disabled', false);

                switch (waktuIzin) {
                    case 'Awal jam kerja':
                        $('#imp_waktu_berangkat').prop('disabled', true);
                        break;

                    case 'Akhir jam kerja':
                        $('#imp_waktu_kembali').prop('disabled', true);
                        break;

                    case 'Diantara jam kerja':
                        // Kedua input enabled
                        break;
                }
            }

            // Fungsi untuk menyesuaikan datetime berdasarkan shift dan waktu izin
            function adjustDateTimeBasedOnShift() {
                const selectedShift = $('#imp_shift').val();
                const shiftConfig = shiftSettings[selectedShift];
                const waktuIzin = $('#imp_waktu_izin').val();

                if (!shiftConfig || !waktuIzin) return;

                const today = new Date();
                const tomorrow = new Date(today);
                tomorrow.setDate(tomorrow.getDate() + 1);

                // Format datetime untuk input
                const formatDateTime = (date, time) => {
                    const [hours, minutes] = time.split(':');
                    const newDate = new Date(date);
                    newDate.setHours(parseInt(hours), parseInt(minutes), 0, 0);
                    return newDate.toISOString().slice(0, 16);
                };

                let startDateTime, endDateTime;

                if (shiftConfig.sameDay) {
                    // Shift dengan hari yang sama
                    startDateTime = formatDateTime(today, shiftConfig.start);
                    endDateTime = formatDateTime(today, shiftConfig.end);
                } else {
                    // Shift Putih - bisa beda hari
                    startDateTime = formatDateTime(today, shiftConfig.start);
                    endDateTime = formatDateTime(tomorrow, shiftConfig.end);
                }

                // Reset disabled state terlebih dahulu
                $('#imp_waktu_berangkat, #imp_waktu_kembali').prop('disabled', false);

                switch (waktuIzin) {
                    case 'Awal jam kerja':
                        // Untuk awal jam kerja, atur waktu berangkat sesuai start shift dan disable
                        $('#imp_waktu_berangkat').val(startDateTime).prop('disabled', true);
                        // Set waktu kembali default (1 jam setelah berangkat)
                        const startDate = new Date(startDateTime);
                        const defaultEndDate = new Date(startDate.getTime() + (60 * 60 * 1000)); // +1 jam
                        $('#imp_waktu_kembali').val(defaultEndDate.toISOString().slice(0, 16));
                        // Set imp_berangkat_aktual
                        $('#imp_berangkat_aktual').val(startDateTime);
                        break;

                    case 'Akhir jam kerja':
                        // Untuk akhir jam kerja, atur waktu kembali sesuai end shift dan disable
                        $('#imp_waktu_kembali').val(endDateTime).prop('disabled', true);
                        // Set waktu berangkat default (1 jam sebelum kembali)
                        const endDate = new Date(endDateTime);
                        const defaultStartDate = new Date(endDate.getTime() - (60 * 60 * 1000)); // -1 jam
                        $('#imp_waktu_berangkat').val(defaultStartDate.toISOString().slice(0, 16));
                        // Set imp_kembali_aktual
                        $('#imp_kembali_aktual').val(endDateTime);
                        break;

                    case 'Diantara jam kerja':
                        // Default values untuk diantara jam kerja
                        $('#imp_waktu_berangkat').val(startDateTime);
                        $('#imp_waktu_kembali').val(endDateTime);
                        break;
                }
            }

            // Validasi khusus untuk Shift Putih (boleh beda tanggal, tapi maksimal +1 hari dari berangkat)
            function validateShiftPutihDates() {
                const selectedShift = $('#imp_shift').val();
                const startTime = $('#imp_waktu_berangkat').val();
                const endTime = $('#imp_waktu_kembali').val();

                if (selectedShift !== "Shift Putih" || !startTime || !endTime) {
                    return { isValid: true, message: "" };
                }

                const startDate = new Date(startTime);
                const endDate = new Date(endTime);

                // Hitung selisih hari
                const timeDiff = endDate - startDate;
                const dayDiff = timeDiff / (1000 * 60 * 60 * 24);

                // Untuk Shift Putih, validasi bahwa kembali harus maksimal +1 hari dari berangkat
                if (dayDiff > 1) {
                    return {
                        isValid: false,
                        message: "Untuk Shift Putih, waktu kembali maksimal 1 hari setelah waktu berangkat."
                    };
                }

                // Validasi bahwa kembali harus setelah berangkat
                if (endDate <= startDate) {
                    return {
                        isValid: false,
                        message: "Untuk Shift Putih, waktu kembali harus setelah waktu berangkat."
                    };
                }

                return { isValid: true, message: "" };
            }

            // Validasi untuk shift selain Putih (harus tanggal sama)
            function validateSameDayShifts() {
                const selectedShift = $('#imp_shift').val();
                const startTime = $('#imp_waktu_berangkat').val();
                const endTime = $('#imp_waktu_kembali').val();

                if (selectedShift === "Shift Putih" || !startTime || !endTime) {
                    return { isValid: true, message: "" };
                }

                const startDate = new Date(startTime);
                const endDate = new Date(endTime);

                // Cek apakah tanggal sama
                const isSameDay = startDate.toDateString() === endDate.toDateString();

                if (!isSameDay) {
                    return {
                        isValid: false,
                        message: `Untuk ${selectedShift}, tanggal berangkat dan kembali harus sama.`
                    };
                }

                // Validasi bahwa kembali harus setelah berangkat
                if (endDate <= startDate) {
                    return {
                        isValid: false,
                        message: "Waktu kembali harus setelah waktu berangkat."
                    };
                }

                return { isValid: true, message: "" };
            }

            // Validasi waktu dalam rentang shift (khusus untuk diantara jam kerja)
            function validateTimeInShiftRange() {
                const selectedShift = $('#imp_shift').val();
                const startTime = $('#imp_waktu_berangkat').val();
                const endTime = $('#imp_waktu_kembali').val();
                const waktuIzin = $('#imp_waktu_izin').val();

                // Hanya validasi untuk diantara jam kerja
                if (waktuIzin !== 'Diantara jam kerja' || !selectedShift || !startTime || !endTime) {
                    return { isValid: true, message: "" };
                }

                const shiftConfig = shiftSettings[selectedShift];
                const startDate = new Date(startTime);
                const endDate = new Date(endTime);

                // Untuk shift dengan hari sama
                if (shiftConfig.sameDay) {
                    const startHour = startDate.getHours();
                    const endHour = endDate.getHours();

                    // Validasi jam berangkat dalam rentang shift
                    if (startHour < parseInt(shiftConfig.start.split(':')[0]) || startHour >= parseInt(shiftConfig.end.split(':')[0])) {
                        return {
                            isValid: false,
                            message: `Waktu berangkat harus dalam rentang shift ${selectedShift} (${shiftConfig.start} - ${shiftConfig.end})`
                        };
                    }

                    // Validasi jam kembali dalam rentang shift
                    if (endHour <= parseInt(shiftConfig.start.split(':')[0]) || endHour > parseInt(shiftConfig.end.split(':')[0])) {
                        return {
                            isValid: false,
                            message: `Waktu kembali harus dalam rentang shift ${selectedShift} (${shiftConfig.start} - ${shiftConfig.end})`
                        };
                    }
                } else {
                    // Untuk shift dengan hari berbeda (Shift Putih)
                    if (selectedShift === "Shift Putih") {
                        const startHour = startDate.getHours();
                        const endHour = endDate.getHours();

                        // Validasi jam berangkat (harus antara 21:00 - 23:59)
                        if (startHour < 21 || startHour > 23) {
                            return {
                                isValid: false,
                                message: `Waktu berangkat harus dalam rentang Shift Putih (21:00 - 23:59)`
                            };
                        }

                        // Validasi jam kembali (harus antara 00:00 - 05:00 di hari berikutnya)
                        if (endHour < 0 || endHour > 5) {
                            return {
                                isValid: false,
                                message: `Waktu kembali harus dalam rentang Shift Putih (00:00 - 05:00)`
                            };
                        }
                    }
                }

                return { isValid: true, message: "" };
            }

            // Fungsi untuk update character count
            function updateCharCount() {
                const currentLength = $('#imp_keterangan').val().length;
                $('#charCount').text(currentLength);

                if (currentLength >= 50) {
                    $('#charCount').css('color', '#dc2626');
                } else {
                    $('#charCount').css('color', '#6b7280');
                }
            }

            // Fungsi untuk validasi field
            function validateField($field) {
                const isFileInput = $field.is('input[type="file"]');
                const isRequired = $field.attr('required') !== undefined;

                // Skip validasi untuk file yang tidak required
                if (isFileInput && !isRequired) {
                    return true;
                }

                const $parentCol = $field.closest('.form-col');
                const $errorSpan = $parentCol.find('.error-message');
                let hasValue = isFileInput ? $field[0].files.length > 0 : ($field.val() && $.trim($field.val()) !== '');
                let $targetInvalid = isFileInput ? $field.closest('.file-upload-wrapper') : $field;

                if (isRequired && !hasValue) {
                    $errorSpan.text('Wajib diisi.');
                    $targetInvalid.addClass('is-invalid');
                    return false;
                }

                $errorSpan.text('');
                $targetInvalid.removeClass('is-invalid');
                return true;
            }

            // Inisialisasi validasi real-time
            function initRealTimeValidation() {
                $('#impForm').on('blur input change', ':input[required]', function () {
                    validateField($(this));
                });

                // Validasi khusus untuk textarea
                $('#imp_keterangan').on('blur input', function () {
                    validateField($(this));
                });
            }

            // Validasi file size dan type (hanya untuk file yang diupload)
            function validateFileInputs() {
                let isFileValid = true;
                const MAX_FILE_SIZE_MB = 2, MAX_BYTES = MAX_FILE_SIZE_MB * 1024 * 1024;
                const ALLOWED_EXT = ['jpg', 'jpeg', 'pdf'];

                $('.conditional-field:visible input[type="file"]').each(function () {
                    const file = this.files[0];
                    const $input = $(this);
                    const $errorSpan = $input.closest('.form-col').find('.error-message');

                    // Skip validasi jika tidak ada file dan field tidak required
                    if (!file && !$input.attr('required')) {
                        return;
                    }

                    if (file) {
                        const extension = file.name.toLowerCase().split('.').pop();
                        if (file.size > MAX_BYTES) {
                            isFileValid = false;
                            $errorSpan.text(`File > ${MAX_FILE_SIZE_MB}MB`);
                            $input.closest('.file-upload-wrapper').addClass('is-invalid');
                        }
                        if (!ALLOWED_EXT.includes(extension)) {
                            isFileValid = false;
                            $errorSpan.text(`Tipe file salah.`);
                            $input.closest('.file-upload-wrapper').addClass('is-invalid');
                        }
                    }
                });

                return isFileValid;
            }

            // Validasi form yang diperbarui
            function validateForm() {
                let isValid = true;
                $('.error-message').text('');
                $('.is-invalid').removeClass('is-invalid');
                $('#dateValidationError').hide();

                let errorMessages = [];

                // Validasi field required (termasuk file yang required)
                $('#impForm :input[required]:visible:not(:disabled)').each(function() {
                    if (!validateField($(this))) {
                        isValid = false;
                    }
                });

                // Validasi textarea keterangan
                if (!validateField($('#imp_keterangan'))) {
                    isValid = false;
                }

                // Validasi file inputs (hanya untuk file yang diupload)
                if (!validateFileInputs()) {
                    isValid = false;
                }

                // Validasi shift dates
                const shiftPutihValidation = validateShiftPutihDates();
                if (!shiftPutihValidation.isValid) {
                    errorMessages.push(shiftPutihValidation.message);
                    $('#imp_waktu_berangkat, #imp_waktu_kembali').addClass('is-invalid');
                }

                const sameDayValidation = validateSameDayShifts();
                if (!sameDayValidation.isValid) {
                    errorMessages.push(sameDayValidation.message);
                    $('#imp_waktu_berangkat, #imp_waktu_kembali').addClass('is-invalid');
                }

                // Validasi waktu dalam rentang shift (untuk diantara jam kerja)
                const timeRangeValidation = validateTimeInShiftRange();
                if (!timeRangeValidation.isValid) {
                    errorMessages.push(timeRangeValidation.message);
                    $('#imp_waktu_berangkat, #imp_waktu_kembali').addClass('is-invalid');
                }

                // Validasi jenis kegiatan vs durasi
                const jenisKegiatanValidation = validateJenisKegiatanVsDurasi();
                if (!jenisKegiatanValidation.isValid) {
                    errorMessages.push(jenisKegiatanValidation.message);
                    $('#imp_waktu_berangkat, #imp_waktu_kembali').addClass('is-invalid');
                }

                // Tampilkan error messages
                if (errorMessages.length > 0) {
                    $('#dateValidationError').html(errorMessages.join('<br>')).show();
                    isValid = false;
                }

                return isValid;
            }

            // Submit handler yang menggunakan FormData - DIPERBAIKI
            function submitFormAjax() {
                const $confirmButton = $('#confirm-save-btn');
                $confirmButton.prop('disabled', true).html('<i class="fas fa-spinner fa-spin"></i> Menyimpan...');

                // Buat FormData dari form - VERSI DIPERBAIKI
                const formData = new FormData();

                // Tambahkan semua field form secara manual
                formData.append('imp_npk', $('#imp_npk').val());
                formData.append('imp_jenis_kegiatan', $('#imp_jenis_kegiatan').val());
                formData.append('imp_waktu_izin', $('#imp_waktu_izin').val());
                formData.append('imp_shift', $('#imp_shift').val());
                formData.append('imp_waktu_berangkat', $('#imp_waktu_berangkat').val());
                formData.append('imp_waktu_kembali', $('#imp_waktu_kembali').val());
                formData.append('imp_keterangan', $('#imp_keterangan').val());
                formData.append('imp_no_request', $('#imp_no_request').val());
                formData.append('imp_created_by', $('#imp_created_by').val());

                // Tambahkan field waktu aktual jika ada nilainya
                if ($('#imp_berangkat_aktual').val()) {
                    formData.append('imp_berangkat_aktual', $('#imp_berangkat_aktual').val());
                }
                if ($('#imp_kembali_aktual').val()) {
                    formData.append('imp_kembali_aktual', $('#imp_kembali_aktual').val());
                }

                // Tambahkan file lampiran jika ada
                const fileInput = document.querySelector('input[name="imp_berkas_lampiran"]');
                if (fileInput && fileInput.files && fileInput.files.length > 0) {
                    formData.append('imp_berkas_lampiran', fileInput.files[0]);
                }

                // HAPUS BAGIAN INI - JANGAN gunakan field "values"
                // const impData = { ... }; 
                // formData.append('values', JSON.stringify(impData));

                console.log('FormData contents:');
                for (let pair of formData.entries()) {
                    console.log(pair[0] + ': ', pair[1]);
                }

                // Mengirim data ke API menggunakan FormData
                $.ajax({
                    url: '/api/IMPApi',
                    type: 'POST',
                    data: formData,
                    processData: false,
                    contentType: false,
                    success: function (response) {
                        console.log('Success response:', response);
                        $('.custom-modal-overlay').removeClass('show');
                        $('#successModal').addClass('show');
                    },
                    error: function (jqXHR, textStatus, errorThrown) {
                        $('.custom-modal-overlay').removeClass('show');
                        let errorMessage = 'Terjadi kesalahan saat menyimpan.';

                        console.log('Error details:', {
                            status: jqXHR.status,
                            statusText: jqXHR.statusText,
                            responseText: jqXHR.responseText,
                            textStatus: textStatus,
                            errorThrown: errorThrown
                        });

                        if (jqXHR.responseJSON && jqXHR.responseJSON.message) {
                            errorMessage = jqXHR.responseJSON.message;
                        } else if (jqXHR.responseText) {
                            try {
                                const response = JSON.parse(jqXHR.responseText);
                                if (response.message) errorMessage = response.message;
                            } catch (e) {
                                errorMessage = jqXHR.responseText || errorThrown;
                            }
                        }
                        alert('Error: ' + errorMessage);
                        $submitButton.prop('disabled', false);
                    },
                    complete: function () {
                        if (!$('#successModal').is(':visible')) {
                            $confirmButton.prop('disabled', false).text('Ya, Kirim');
                        }
                    }
                });
            }

            // Event handlers untuk perubahan dropdown
            $('#imp_shift').on('change', function() {
                adjustDateTimeBasedOnShift();
                setDateTimeInputsState();
                validateForm();
            });

            $('#imp_waktu_izin').on('change', function() {
                const selectedShift = $('#imp_shift').val();
                const shiftConfig = shiftSettings[selectedShift];
                const waktuIzin = $(this).val();

                if (shiftConfig && waktuIzin) {
                    adjustDateTimeBasedOnShift();
                    setDateTimeInputsState();
                }
                validateForm();
            });

            // Event handler untuk perubahan datetime (real-time validation)
            $('#imp_waktu_berangkat, #imp_waktu_kembali').on('change', function() {
                validateForm();
            });

            // Event handler untuk character count
            $('#imp_keterangan').on('input', function() {
                updateCharCount();
                validateForm();
            });

            // Event handlers untuk validasi real-time
            $('#impForm').on('blur', ':input[required]', function () {
                const $field = $(this);
                if ($field.is(':visible') && !$field.val()) {
                    $field.closest('.form-col').find('.error-message').text('Wajib diisi');
                }
            });

            $('#impForm').on('input change', ':input[required]', function () {
                const $field = $(this);
                if ($field.val()) {
                    $field.closest('.form-col').find('.error-message').text('');
                }
            });

            // Validasi real-time untuk textarea
            $('#imp_keterangan').on('blur input', function () {
                const $field = $(this);
                if (!$field.val()) {
                    $field.closest('.form-col').find('.error-message').text('Wajib diisi');
                } else {
                    $field.closest('.form-col').find('.error-message').text('');
                }
            });

            // Submit handler utama
            $('#impForm').on('submit', function (event) {
                event.preventDefault();

                if (!validateForm()) {
                    $('html, body').animate({ scrollTop: $('.is-invalid, .error-message:not(:empty)').first().offset().top - 100 }, 500);
                    return;
                }

                $submitButton.prop('disabled', true);
                $('#confirmModal').addClass('show');
            });

            // Tombol batal
            $('.btn-batal').on('click', function() {
                window.history.back();
            });

            // Tombol close success modal
            $('#close-success-btn').on('click', function() {
                $('#successModal').removeClass('show');
                window.location.href = '@Url.Action("ManageIMPKaryawan", "Manage")';
            });

            // Close modal ketika klik di luar
            $('.custom-modal-overlay').on('click', function(e) {
                if ($(e.target).is('.custom-modal-overlay, #cancel-save-btn')) {
                    $(this).removeClass('show');
                    $submitButton.prop('disabled', false);
                }
            });

            // Fungsi untuk preview file sebelum upload
            function previewFile(fileInput) {
                const $fileInput = $(fileInput);
                const $previewContainer = $fileInput.closest('.file-upload-wrapper').find('.file-preview-container');
                const $previewImage = $previewContainer.find('.file-preview-image');
                const $pdfPreview = $previewContainer.find('.pdf-preview');
                const $pdfFilename = $previewContainer.find('.pdf-filename');

                $previewContainer.hide();
                $previewImage.hide();
                $pdfPreview.hide();

                if (fileInput.files && fileInput.files[0]) {
                    const file = fileInput.files[0];
                    const fileType = file.type;
                    const fileName = file.name;

                    if (fileType.startsWith('image/')) {
                        const reader = new FileReader();
                        reader.onload = function (e) {
                            $previewImage.attr('src', e.target.result).show();
                            $previewContainer.show();
                        }
                        reader.readAsDataURL(file);
                    }
                    else if (fileType === 'application/pdf' || fileName.toLowerCase().endsWith('.pdf')) {
                        $pdfFilename.text(fileName);
                        $pdfPreview.show();
                        $previewContainer.show();
                    }
                }
            }

            // Event handler untuk file input
            $('.file-input-hidden').on('change', function () {
                const $fileInput = $(this), $wrapper = $fileInput.closest('.file-upload-wrapper'), $fileNameSpan = $wrapper.find('.file-name');
                if (this.files && this.files.length > 0) {
                    $fileNameSpan.text(this.files[0].name).addClass('selected');
                    previewFile(this); // Tampilkan preview file
                } else {
                    $fileNameSpan.text('Belum ada file dipilih').removeClass('selected');
                    $wrapper.find('.file-preview-container').hide();
                }
                // Validasi file hanya jika required
                if ($fileInput.attr('required')) {
                    validateField($fileInput);
                }
            });

            $('.file-upload-actions').on('click', '.btn-upload', function () {
                const action = $(this).data('action'), $fileInput = $(this).closest('.file-upload-wrapper').find('.file-input-hidden');
                currentFileInputTarget = $fileInput;
                if (action === 'pick') {
                    $fileInput.removeAttr('capture').trigger('click');
                    return;
                }
                if (action === 'capture') {
                    if (navigator.mediaDevices && navigator.mediaDevices.getUserMedia) {
                        navigator.mediaDevices.getUserMedia({ video: { facingMode: 'environment' } }).then(stream => {
                            currentStream = stream;
                            video.srcObject = stream;
                            video.play();
                            cameraModal.addClass('show');
                        }).catch(() => {
                            alert("Tidak bisa mengakses kamera. Silakan pilih file atau pastikan browser memiliki izin kamera.");
                            $fileInput.attr('capture', 'environment').trigger('click');
                        });
                    } else {
                        alert("Browser tidak mendukung kamera. Silakan pilih file.");
                        $fileInput.attr('capture', 'environment').trigger('click');
                    }
                }
            });

            // Kamera functionality
            function stopCamera() {
                if (currentStream) {
                    currentStream.getTracks().forEach(t => t.stop());
                }
                cameraModal.removeClass('show');
            }

            snapBtn.on('click', function () {
                canvas.width = video.videoWidth;
                canvas.height = video.videoHeight;
                canvas.getContext('2d').drawImage(video, 0, 0, canvas.width, canvas.height);
                canvas.toBlob(function (blob) {
                    const file = new File([blob], `capture_${new Date().toISOString()}.jpg`, { type: 'image/jpeg' });
                    const dataTransfer = new DataTransfer();
                    dataTransfer.items.add(file);
                    if (currentFileInputTarget) {
                        currentFileInputTarget[0].files = dataTransfer.files;
                        currentFileInputTarget.trigger('change');
                    }
                }, 'image/jpeg');
                stopCamera();
            });

            cancelCamBtn.on('click', stopCamera);

            // Konfirmasi save
            $('#confirm-save-btn').on('click', submitFormAjax);

            // Inisialisasi
            generateImpNo();
            setDateTimeConstraints();
            initRealTimeValidation();
            updateCharCount(); // Inisialisasi character count
            adjustDateTimeBasedOnShift();

            // Panggil setDateTimeInputsState setelah inisialisasi
            setTimeout(() => {
                setDateTimeInputsState();
            }, 100);
        });
    </script>
</body>
</html>