@using DevExtreme.AspNet.Mvc;
@{
    ViewBag.Title = "Tambah Izin Meninggalkan Pekerjaan";
    Layout = null;
}

@helper RenderFileUpload(string id, string label, string name)
{
    <div id="@id" class="form-col conditional-field">
        <label>@label <span class="text-danger">*</span><span class="error-message"></span></label>
        <div class="file-upload-wrapper">
            <!-- Tombol Aksi -->
            <div class="file-upload-actions">
                <button type="button" class="btn-upload" data-action="pick"><i class="fas fa-file-alt"></i> Pilih File</button>
                <button type="button" class="btn-upload" data-action="capture"><i class="fas fa-camera"></i> Kamera</button>
            </div>
            <!-- Input File Asli (disembunyikan) -->
            <input type="file" name="@name" class="file-input-hidden" required accept=".pdf, .jpg, .jpeg" style="display: none;">
            <!-- Preview Nama File -->
            <div class="file-preview">
                <span class="file-name">Belum ada file dipilih</span>
            </div>
        </div>
        <small>*.jpg, .jpeg, .pdf (Maks. 2MB)</small>
    </div>
}

<!DOCTYPE html>
<html>
<head>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewBag.Title</title>
    <!-- Referensi Font Awesome, jQuery & Select2 -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/select2/4.0.13/css/select2.min.css" rel="stylesheet" />
    <script src="https://ajax.googleapis.com/ajax/libs/jquery/3.6.0/jquery.min.js"></script>

    <style>
        body {
            margin: 0;
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
            -webkit-font-smoothing: antialiased;
            -moz-osx-font-smoothing: grayscale;
            background-color: #FFFFFF;
        }

        .imp-page-container {
            background-color: #FFFFFF
        }

        .blue-section {
            background-color: #2A458A;
            background-size: cover;
            background-position: center;
            background-repeat: no-repeat;
            position: sticky;
            top: 0;
            z-index: 10;
        }

        .blue-section2 {
            background-color: #2A458A;
            padding-bottom: 70px;
            background-image: url('../../../../assets/bg_navbarbot_index_reimbursement.png');
            background-size: cover;
            background-position: center;
            background-repeat: no-repeat
        }

        .page-header-standalone {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 16px;
            position: relative
        }

        .back-button {
            color: #fff;
            font-size: 20px;
            text-decoration: none;
            position: absolute;
            left: 16px;
            top: 50%;
            transform: translateY(-50%);
            z-index: 2
        }

        .page-header-title {
            color: #fff;
            font-size: 18px;
            font-weight: bold;
            margin: 0;
            text-align: center;
            width: 100%;
            z-index: 1
        }

        .form-content-section {
            background-color: #FFFFFF;
            margin-top: -30px;
            padding: 20px 16px 24px 16px
        }

        #impForm.form {
            display: flex;
            flex-direction: column;
            gap: 24px;
            margin: 0;
            padding-top: 24px
        }

        .form-row {
            display: flex;
            flex-wrap: wrap;
            gap: 20px
        }

        .form-col {
            width: calc((100% - 40px) / 3);
            flex-shrink: 0
        }

        .file-upload-row .form-col {
            width: calc((100% - 60px) / 4)
        }

        @@media (max-width:768px) {
            .form-col, .file-upload-row .form-col {
                width: 100%
            }
        }

        .imp-header {
            margin-bottom: 25px
        }

        .form-title {
            font-size: 20px;
            font-weight: 700;
            color: #111827;
            margin: 0 0 5px 0;
            display: flex;
            align-items: center;
            gap: 10px
        }

        .title-icon {
            color: #1B3D97;
            font-size: 20px
        }

        .form-subtitle {
            font-size: 14px;
            color: #6B7280;
            margin: 0
        }

        label {
            font-weight: 600;
            margin-bottom: 8px;
            display: flex;
            align-items: baseline;
            flex-wrap: wrap;
            font-size: 14px;
            color: #374151;
        }

        .text-danger {
            color: #DC2626;
            margin: 0 8px;
        }

        .error-message {
            color: #DC2626;
            font-size: 12px;
            font-weight: 500;
            font-style: italic;
        }

        small {
            color: #6B7280;
            font-size: 12px;
            margin-top: 4px;
            display: block
        }

        input[type="date"].form-control.is-invalid {
            border-color: #DC2626 !important;
        }

        .form-control.is-invalid {
            border-color: #DC2626 !important
        }

        select.form-control.is-invalid + .select2-container--default .select2-selection--single {
            border-color: #DC2626 !important;
        }

        .form-control, .select2-container .select2-selection--single {
            width: 100%;
            padding: 10px 12px;
            border: 1px solid #D1D5DB;
            border-radius: 8px;
            font-size: 14px;
            box-sizing: border-box;
            background-color: #ffffff;
            height: 42px !important
        }

            .form-control:disabled, input[readonly] {
                background-color: #F3F4F6;
                cursor: not-allowed;
                color: #6B7280
            }

        .select2-container--default .select2-selection--single .select2-selection__rendered {
            line-height: 20px;
            padding-left: 0;
            color: #1F2937
        }

        .select2-container--default .select2-selection--single .select2-selection__arrow {
            height: 40px
        }

        .select2-dropdown {
            border-radius: 8px;
            border: 1px solid #D1D5DB
        }

        .conditional-field {
            display: none
        }

        .note-box {
            background-color: #EFF6FF;
            padding: 15px;
            border-radius: 8px;
            font-size: 14px;
            color: #1E40AF;
            border-left: 4px solid #3B82F6
        }

            .note-box strong {
                color: #1D4ED8
            }

            .note-box.error {
                background-color: #FEF2F2;
                color: #991B1B;
                border-left-color: #EF4444
            }

        .form-actions {
            display: flex;
            justify-content: flex-end;
            gap: 12px
        }

        .btn {
            padding: 10px 28px;
            font-size: 14px;
            font-weight: 600;
            border-radius: 8px;
            border: 1px solid transparent;
            cursor: pointer;
            transition: all .2s
        }

        .btn-batal {
            background-color: #F3F4F6;
            color: #374151;
            border-color: #D1D5DB
        }

            .btn-batal:hover {
                background-color: #E5E7EB
            }

        .btn-simpan {
            background-color: #16A34A;
            color: white
        }

            .btn-simpan:hover {
                background-color: #15803D
            }

            .btn-simpan:disabled {
                background-color: #86EFAC;
                cursor: not-allowed
            }

        .custom-modal-overlay {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(0,0,0,0.5);
            display: none;
            align-items: center;
            justify-content: center;
            z-index: 1050;
            opacity: 0;
            transition: opacity .2s ease
        }

            .custom-modal-overlay.show {
                display: flex !important;
                opacity: 1
            }

        .custom-modal {
            background: white;
            padding: 30px 35px;
            border-radius: 16px;
            width: 90%;
            max-width: 400px;
            box-shadow: 0 5px 15px rgba(0,0,0,0.2);
            text-align: center;
            transform: scale(0.95);
            transition: transform .2s ease
        }

        .custom-modal-overlay.show .custom-modal {
            transform: scale(1)
        }

        .modal-title {
            font-size: 24px;
            font-weight: bold;
            color: #333;
            margin: 0 0 15px 0
        }

        .modal-text {
            font-size: 16px;
            color: #666;
            margin-bottom: 30px;
            line-height: 1.5;
        }

        .modal-actions {
            display: flex;
            justify-content: center;
            gap: 15px
        }

        .modal-btn {
            flex: 1;
            padding: 12px 20px;
            border-radius: 8px;
            border: none;
            font-size: 16px;
            font-weight: bold;
            cursor: pointer;
            transition: background-color .2s
        }

        .modal-btn-cancel {
            background-color: #E9ECEF;
            color: #495057
        }

            .modal-btn-cancel:hover {
                background-color: #dee2e6
            }

        .modal-btn-confirm {
            background-color: #1F4AB8;
            color: white
        }

            .modal-btn-confirm:hover {
                background-color: #1a3f99
            }

        .modal-icon-success .checkmark {
            width: 80px;
            height: 80px;
            border-radius: 50%;
            display: inline-block;
            stroke-width: 3;
            stroke: #fff;
            stroke-miterlimit: 10;
            box-shadow: inset 0 0 0 #28a745;
            animation: fill .4s ease-in-out .4s forwards,scale .3s ease-in-out .9s both
        }

        .modal-icon-success .checkmark-circle {
            stroke-dasharray: 166;
            stroke-dashoffset: 166;
            stroke-width: 3;
            stroke-miterlimit: 10;
            stroke: #28a745;
            fill: none;
            animation: stroke .6s cubic-bezier(0.65,0,0.45,1) forwards
        }

        .modal-icon-success .checkmark-check {
            transform-origin: 50% 50%;
            stroke-dasharray: 48;
            stroke-dashoffset: 48;
            animation: stroke .3s cubic-bezier(0.65,0,0.45,1) .8s forwards
        }

        @@keyframes stroke {
            100% {
                stroke-dashoffset: 0
            }
        }

        @@keyframes scale {
            0%, 100% {
                transform: none
            }

            50% {
                transform: scale3d(1.1,1.1,1)
            }
        }

        @@keyframes fill {
            100% {
                box-shadow: inset 0 0 0 50px #28a745
            }
        }

        .modal-text-success {
            font-size: 18px;
            color: #495057;
            margin-top: 15px;
            margin-bottom: 25px
        }

        .file-upload-wrapper {
            width: 100%;
        }

        .file-upload-actions {
            display: flex;
            gap: 10px;
            margin-bottom: 8px;
        }

        .btn-upload {
            flex: 1;
            padding: 8px 12px;
            font-size: 14px;
            font-weight: 500;
            border-radius: 6px;
            border: 1px solid #D1D5DB;
            background-color: #F9FAFB;
            color: #374151;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            transition: background-color .2s;
        }

            .btn-upload:hover {
                background-color: #F3F4F6;
            }

        .file-preview {
            font-size: 13px;
            color: #4B5563;
            padding: 8px 12px;
            background-color: #F3F4F6;
            border-radius: 6px;
            border: 1px dashed #D1D5DB;
            text-align: center;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

            .file-preview .file-name {
                font-style: italic;
                color: #6B7280;
            }

                .file-preview .file-name.selected {
                    font-style: normal;
                    font-weight: 500;
                    color: #1F2937;
                }

        .file-upload-wrapper.is-invalid .file-preview {
            border-color: #EF4444;
            border-style: solid;
        }

        /* Style untuk textarea */
        textarea.form-control {
            min-height: 100px;
            resize: vertical;
        }

        .conditional-field {
            display: block !important;
        }

        .file-upload-wrapper {
            display: block !important;
        }

    </style>
</head>
<body>
    <div class="imp-page-container">
        <div class="blue-section">
            <div class="page-header-standalone">
                <a href="javascript:window.history.back()" class="back-button" aria-label="Kembali">
                    <i class="fas fa-arrow-left"></i>
                </a>
                <h1 class="page-header-title">@ViewBag.Title</h1>
            </div>
        </div>

        <!-- SECTION 2: Form Content Area -->
        <div class="form-content-section">
            <div class="imp-container">

                <div id="dateValidationError" class="note-box error" style="display: none;"></div>

                <form id="impForm" class="form" novalidate enctype="multipart/form-data">
                    @Html.AntiForgeryToken()
                    <input type="hidden" id="imp_created_by" name="imp_created_by" value="@ViewBag.NamaKaryawan" />

                    <!-- Baris 1: Info Karyawan (Readonly) -->
                    <div class="form-row">
                        <div class="form-col">
                            <label>No. Permohonan IMP</label>
                            <input type="text" id="imp_no_request" name="imp_no_request" class="form-control" value="Memuat nomor..." readonly>
                        </div>
                        <div class="form-col">
                            <label>NPK</label>
                            <input type="text" id="imp_npk" name="imp_npk" class="form-control" value="@ViewBag.Npk" readonly>
                        </div>
                        <div class="form-col">
                            <label>Nama Karyawan</label>
                            <input type="text" id="namaKaryawan" class="form-control" value="@ViewBag.NamaKaryawan" readonly>
                        </div>
                    </div>

                    <!-- Baris 2: Jenis Kegiatan dan Waktu Izin -->
                    <div class="form-row">
                        <div class="form-col">
                            <label>Jenis Kegiatan <span class="text-danger">*</span><span class="error-message"></span></label>
                            <select id="imp_jenis_kegiatan" name="imp_jenis_kegiatan" class="form-control" required>
                                <option value="">Pilih Jenis Kegiatan</option>
                                <option value="Lebih dari 4 jam">Lebih dari 4 jam</option>
                                <option value="Kurang dari 4 jam">Kurang dari 4 jam</option>
                                <option value="Dispensasi">Dispensasi</option>
                            </select>
                        </div>
                        <div class="form-col">
                            <label>Waktu Izin <span class="text-danger">*</span><span class="error-message"></span></label>
                            <select id="imp_waktu_izin" name="imp_waktu_izin" class="form-control" required>
                                <option value="">Pilih Waktu Izin</option>
                                <option value="Awal jam kerja">Awal jam kerja</option>
                                <option value="Diantara jam kerja">Diantara jam kerja</option>
                                <option value="Akhir jam kerja">Akhir jam kerja</option>
                            </select>
                        </div>
                    </div>

                    <!-- Baris 4: Waktu Berangkat -->
                    <div class="form-row">
                        <div class="form-col">
                            <label>Tanggal Berangkat <span class="text-danger">*</span><span class="error-message"></span></label>
                            <input type="date" id="imp_tanggal_berangkat" name="imp_tanggal_berangkat" class="form-control" required>
                        </div>
                        <div class="form-col">
                            <label>Waktu Berangkat <span class="text-danger">*</span><span class="error-message"></span></label>
                            <input type="time" id="imp_waktu_berangkat" name="imp_waktu_berangkat" class="form-control" required>
                        </div>
                    </div>

                    <!-- Baris 5: Waktu Kembali -->
                    <div class="form-row">
                        <div class="form-col">
                            <label>Tanggal Kembali <span class="text-danger">*</span><span class="error-message"></span></label>
                            <input type="date" id="imp_tanggal_kembali" name="imp_tanggal_kembali" class="form-control" required>
                        </div>
                        <div class="form-col">
                            <label>Waktu Kembali <span class="text-danger">*</span><span class="error-message"></span></label>
                            <input type="time" id="imp_waktu_kembali" name="imp_waktu_kembali" class="form-control" required>
                        </div>
                    </div>

                    <!-- Baris 6: Keterangan dan Berkas Lampiran -->
                    <div class="form-row">
                        <div class="form-col">
                            <label>Keterangan</label>
                            <textarea id="imp_keterangan" name="imp_keterangan" class="form-control" placeholder="Tambahkan keterangan jika diperlukan" rows="4"></textarea>
                        </div>
                        <div class="form-col">
                            @RenderFileUpload("berkasLampiranUpload", "Berkas Lampiran", "imp_berkas_lampiran")
                        </div>
                    </div>

                    <!-- Note Box -->
                    <div class="note-box">
                        <strong>Perhatian:</strong> Pastikan data yang Anda isi sudah benar sebelum menyimpan. Izin yang sudah disimpan tidak dapat diubah tanpa persetujuan atasan.
                    </div>

                    <!-- Tombol Aksi -->
                    <div class="form-actions">
                        <button type="button" class="btn btn-batal">Batal</button>
                        <button type="submit" class="btn btn-simpan">Kirim Pengajuan</button>
                    </div>

                </form>
            </div>
        </div>

        <!-- Modals -->
        <div id="confirmModal" class="custom-modal-overlay">
            <div class="custom-modal">
                <h2 class="modal-title">Konfirmasi Pengajuan</h2>
                <p class="modal-text">Apakah Anda yakin data yang dimasukkan sudah benar?</p>
                <div class="modal-actions">
                    <button id="cancel-save-btn" class="modal-btn modal-btn-cancel">Periksa Lagi</button>
                    <button id="confirm-save-btn" class="modal-btn modal-btn-confirm">Ya, Kirim</button>
                </div>
            </div>
        </div>
        <div id="successModal" class="custom-modal-overlay">
            <div class="custom-modal">
                <div class="modal-icon-success">
                    <svg class="checkmark" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 52 52">
                        <circle class="checkmark-circle" cx="26" cy="26" r="25" fill="none" />
                        <path class="checkmark-check" fill="none" d="M14.1 27.2l7.1 7.2 16.7-16.8" />
                    </svg>
                </div>
                <p class="modal-text-success">Pengajuan IMP berhasil disimpan!</p>
                <button id="close-success-btn" class="modal-btn modal-btn-confirm" style="width: 50%; margin: 0 auto;">OK</button>
            </div>
        </div>

        <!-- Modal Kamera -->
        <div id="cameraModal" class="custom-modal-overlay">
            <div class="custom-modal" style="max-width: 640px; padding: 15px; background-color: #333;">
                <video id="cameraFeed" playsinline autoplay style="width: 100%; border-radius: 8px; transform: scaleX(-1);"></video>
                <canvas id="cameraCanvas" style="display:none;"></canvas>
                <div class="modal-actions" style="margin-top: 15px;">
                    <button id="cancelCameraBtn" class="modal-btn modal-btn-cancel">Batal</button>
                    <button id="snapPhotoBtn" class="modal-btn modal-btn-confirm"><i class="fas fa-camera"></i> Ambil Foto</button>
                </div>
            </div>
        </div>
    </div>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/select2/4.0.13/js/select2.min.js"></script>

    <script>
        $(document).ready(function () {
            let currentStream, currentFileInputTarget;
            const cameraModal = $('#cameraModal');
            const video = document.getElementById('cameraFeed');
            const canvas = document.getElementById('cameraCanvas');
            const snapBtn = $('#snapPhotoBtn');
            const cancelCamBtn = $('#cancelCameraBtn');
            const $submitButton = $('.btn-simpan');
            const originalButtonHtml = $submitButton.html();

            // Fungsi untuk menampilkan konfirmasi
            function showConfirm(title, text, confirmButtonText) {
                return new Promise((resolve) => {
                    $('#confirmModal .modal-title').text(title);
                    $('#confirmModal .modal-text').text(text);
                    $('#confirmModal').addClass('show');

                    $('#confirm-save-btn').off('click').on('click', function() {
                        $('#confirmModal').removeClass('show');
                        resolve(true);
                    });

                    $('#cancel-save-btn').off('click').on('click', function() {
                        $('#confirmModal').removeClass('show');
                        resolve(false);
                    });
                });
            }

            // Set tanggal min dan max (tahun berjalan)
            function setDateConstraints() {
                const today = new Date();
                const year = today.getFullYear();
                const minDate = `${year}-01-01`;
                const maxDate = `${year}-12-31`;

                $('#imp_tanggal_berangkat').attr('min', minDate).attr('max', maxDate);
                $('#imp_tanggal_kembali').attr('min', minDate).attr('max', maxDate);

                // Set tanggal default ke hari ini
                const todayStr = today.toISOString().split('T')[0];
                $('#imp_tanggal_berangkat').val(todayStr);

                // Set waktu default
                $('#imp_waktu_berangkat').val('08:00');
                $('#imp_waktu_kembali').val('17:00');
            }

            // Generate nomor IMP
            function generateImpNo() {
                const $impNoField = $('#imp_no_request');
                $submitButton.prop('disabled', true).text('Menunggu No...');

                // Generate nomor berdasarkan format yang diharapkan
                const date = new Date();
                const year = date.getFullYear();
                const month = String(date.getMonth() + 1).padStart(2, '0');
                const day = String(date.getDate()).padStart(2, '0');
                const randomNum = Math.floor(1000 + Math.random() * 9000);

                const impNo = `IMP${year}${month}${day}${randomNum}`;
                $impNoField.val(impNo);
                $submitButton.prop('disabled', false).html(originalButtonHtml);
            }

            // Fungsi untuk validasi field (sama seperti di reimbursement)
            function validateField($field) {
                const isFileInput = $field.is('input[type="file"]');
                const $parentCol = $field.closest('.form-col');
                const $errorSpan = $parentCol.find('.error-message');
                let hasValue = isFileInput ? $field[0].files.length > 0 : ($field.val() && $.trim($field.val()) !== '');
                let $targetInvalid = isFileInput ? $field.closest('.file-upload-wrapper') : $field;

                if ($field.is('[required]') && !hasValue) {
                    $errorSpan.text('Wajib diisi.');
                    $targetInvalid.addClass('is-invalid');
                    return false;
                }
                $errorSpan.text('');
                $targetInvalid.removeClass('is-invalid');
                return true;
            }

            // Inisialisasi validasi real-time
            function initRealTimeValidation() {
                $('#impForm').on('blur input change', ':input[required]', function () {
                    validateField($(this));
                });
            }

            // Validasi file size dan type (sama seperti di reimbursement)
            function validateFileInputs() {
                let isFileValid = true;
                const MAX_FILE_SIZE_MB = 2, MAX_BYTES = MAX_FILE_SIZE_MB * 1024 * 1024;
                const ALLOWED_EXT = ['jpg', 'jpeg', 'pdf'];

                $('.conditional-field:visible input[type="file"]').each(function () {
                    const file = this.files[0];
                    const $input = $(this);
                    const $errorSpan = $input.closest('.form-col').find('.error-message');

                    if (file) {
                        const extension = file.name.toLowerCase().split('.').pop();
                        if (file.size > MAX_BYTES) {
                            isFileValid = false;
                            $errorSpan.text(`File > ${MAX_FILE_SIZE_MB}MB`);
                            $input.closest('.file-upload-wrapper').addClass('is-invalid');
                        }
                        if (!ALLOWED_EXT.includes(extension)) {
                            isFileValid = false;
                            $errorSpan.text(`Tipe file salah.`);
                            $input.closest('.file-upload-wrapper').addClass('is-invalid');
                        }
                    }
                });

                return isFileValid;
            }

            // Validasi form
            function validateForm() {
                let isValid = true;
                $('.error-message').text('');
                $('#dateValidationError').hide();

                // Validasi field required (termasuk file)
                $('#impForm :input[required]:visible:not(:disabled)').each(function() {
                    if (!validateField($(this))) {
                        isValid = false;
                    }
                });

                // Validasi tanggal
                const startDate = $('#imp_tanggal_berangkat').val();
                const endDate = $('#imp_tanggal_kembali').val();

                if (startDate && endDate) {
                    const start = new Date(startDate);
                    const end = new Date(endDate);

                    if (start > end) {
                        isValid = false;
                        $('#dateValidationError').text("Tanggal berangkat tidak boleh lebih besar dari tanggal kembali.").show();
                    }
                }

                // Validasi waktu
                const startTime = $('#imp_waktu_berangkat').val();
                const endTime = $('#imp_waktu_kembali').val();

                if (startDate === endDate && startTime && endTime && startTime >= endTime) {
                    isValid = false;
                    $('#dateValidationError').text("Waktu berangkat harus lebih awal dari waktu kembali.").show();
                }

                return isValid;
            }

            // Submit handler yang menggunakan FormData seperti di reimbursement
            function submitFormAjax() {
                const $confirmButton = $('#confirm-save-btn');
                $confirmButton.prop('disabled', true).html('<i class="fas fa-spinner fa-spin"></i> Menyimpan...');

                const formData = new FormData(document.getElementById('impForm'));
                let formObject = {};

                formData.forEach((value, key) => {
                    if (!(value instanceof File)) formObject[key] = value
                });

                // Menambahkan field khusus IMP
                formObject['imp_jenis_kegiatan'] = $('#imp_jenis_kegiatan').val();
                formObject['imp_waktu_izin'] = $('#imp_waktu_izin').val();
                formObject['imp_tanggal_berangkat'] = $('#imp_tanggal_berangkat').val();
                formObject['imp_waktu_berangkat'] = $('#imp_waktu_berangkat').val();
                formObject['imp_tanggal_kembali'] = $('#imp_tanggal_kembali').val();
                formObject['imp_waktu_kembali'] = $('#imp_waktu_kembali').val();
                formObject['imp_keterangan'] = $('#imp_keterangan').val();

                // Menambahkan JSON data ke FormData
                formData.append('values', JSON.stringify(formObject));

                // Mengirim data ke API menggunakan FormData
                $.ajax({
                    url: '/api/IMPApi',
                    type: 'POST',
                    data: formData,
                    processData: false,
                    contentType: false,
                    success: function() {
                        $('.custom-modal-overlay').removeClass('show');
                        $('#successModal').addClass('show');
                    },
                    error: function(jqXHR) {
                        $('.custom-modal-overlay').removeClass('show');
                        alert('Error: ' + ((jqXHR.responseJSON && jqXHR.responseJSON.Message) || 'Terjadi kesalahan saat menyimpan.'));
                        $submitButton.prop('disabled', false);
                    },
                    complete: function() {
                        if (!$('#successModal').is(':visible')) {
                            $confirmButton.prop('disabled', false).text('Ya, Kirim');
                        }
                    }
                });
            }

            // Event handlers untuk validasi real-time
            $('#impForm').on('blur', ':input[required]', function () {
                const $field = $(this);
                if ($field.is(':visible') && !$field.val()) {
                    $field.closest('.form-col').find('.error-message').text('Wajib diisi');
                }
            });

            $('#impForm').on('input change', ':input[required]', function () {
                const $field = $(this);
                if ($field.val()) {
                    $field.closest('.form-col').find('.error-message').text('');
                }
            });

            // Ketika tanggal berangkat berubah, set tanggal kembali minimal sama dengan tanggal berangkat
            $('#imp_tanggal_berangkat').on('change', function() {
                const startDate = $(this).val();
                if (startDate) {
                    $('#imp_tanggal_kembali').attr('min', startDate);

                    // Jika tanggal kembali sebelumnya lebih awal dari tanggal berangkat, update
                    const endDate = $('#imp_tanggal_kembali').val();
                    if (endDate && new Date(endDate) < new Date(startDate)) {
                        $('#imp_tanggal_kembali').val(startDate);
                    }
                }
            });

            // Submit handler utama
            $('#impForm').on('submit', function (event) {
                event.preventDefault();
                let isFormValid = true;
                $('#dateValidationError').hide();

                $(this).find(':input[required]:visible:not(:disabled)').each(function () {
                    if (!validateField($(this))) isFormValid = false;
                });

                const MAX_FILE_SIZE_MB = 2, MAX_BYTES = MAX_FILE_SIZE_MB * 1024 * 1024;
                const ALLOWED_EXT = ['jpg', 'jpeg', 'pdf'];

                $(this).find('.conditional-field:visible input[type="file"]').each(function () {
                    const file = this.files[0], $input = $(this), $errorSpan = $input.closest('.form-col').find('.error-message');
                    if (file) {
                        const extension = file.name.toLowerCase().split('.').pop();
                        if (file.size > MAX_BYTES) {
                            isFormValid = false;
                            $errorSpan.text(`File > ${MAX_FILE_SIZE_MB}MB`);
                            $input.closest('.file-upload-wrapper').addClass('is-invalid');
                        }
                        if (!ALLOWED_EXT.includes(extension)) {
                            isFormValid = false;
                            $errorSpan.text(`Tipe file salah.`);
                            $input.closest('.file-upload-wrapper').addClass('is-invalid');
                        }
                    }
                });

                const startDate = $('#imp_tanggal_berangkat').val(), endDate = $('#imp_tanggal_kembali').val();
                if (startDate && endDate && startDate > endDate) {
                    isFormValid = false;
                    $('#dateValidationError').text("Tanggal berangkat tidak boleh lebih besar dari tanggal kembali.").show();
                    $('#imp_tanggal_berangkat, #imp_tanggal_kembali').addClass('is-invalid');
                }

                const startTime = $('#imp_waktu_berangkat').val(), endTime = $('#imp_waktu_kembali').val();
                if (startDate === endDate && startTime && endTime && startTime >= endTime) {
                    isFormValid = false;
                    $('#dateValidationError').text("Waktu berangkat harus lebih awal dari waktu kembali.").show();
                }

                if (!isFormValid) {
                    $('html, body').animate({ scrollTop: $('.is-invalid, .error-message:not(:empty)').first().offset().top - 100 }, 500);
                    return;
                }

                $submitButton.prop('disabled', true);
                $('#confirmModal').addClass('show');
            });

            // Tombol batal
            $('.btn-batal').on('click', function() {
                window.history.back();
            });

            // Tombol close success modal
            $('#close-success-btn').on('click', function() {
                $('#successModal').removeClass('show');
                window.location.href = '@Url.Action("ManageIMPKaryawan", "Manage")';
            });

            // Close modal ketika klik di luar
            $('.custom-modal-overlay').on('click', function(e) {
                if ($(e.target).is('.custom-modal-overlay, #cancel-save-btn')) {
                    $(this).removeClass('show');
                    $submitButton.prop('disabled', false);
                }
            });

            // Event handler untuk file input (sama seperti di reimbursement)
            $('.file-input-hidden').on('change', function () {
                const $fileInput = $(this), $wrapper = $fileInput.closest('.file-upload-wrapper'), $fileNameSpan = $wrapper.find('.file-name');
                if (this.files && this.files.length > 0) {
                    $fileNameSpan.text(this.files[0].name).addClass('selected');
                } else {
                    $fileNameSpan.text('Belum ada file dipilih').removeClass('selected');
                }
                validateField($fileInput);
            });

            $('.file-upload-actions').on('click', '.btn-upload', function () {
                const action = $(this).data('action'), $fileInput = $(this).closest('.file-upload-wrapper').find('.file-input-hidden');
                currentFileInputTarget = $fileInput;
                if (action === 'pick') {
                    $fileInput.removeAttr('capture').trigger('click');
                    return;
                }
                if (action === 'capture') {
                    if (navigator.mediaDevices && navigator.mediaDevices.getUserMedia) {
                        navigator.mediaDevices.getUserMedia({ video: { facingMode: 'environment' } }).then(stream => {
                            currentStream = stream;
                            video.srcObject = stream;
                            video.play();
                            cameraModal.addClass('show');
                        }).catch(() => {
                            alert("Tidak bisa mengakses kamera. Silakan pilih file atau pastikan browser memiliki izin kamera.");
                            $fileInput.attr('capture', 'environment').trigger('click');
                        });
                    } else {
                        alert("Browser tidak mendukung kamera. Silakan pilih file.");
                        $fileInput.attr('capture', 'environment').trigger('click');
                    }
                }
            });

            // Kamera functionality
            function stopCamera() {
                if (currentStream) {
                    currentStream.getTracks().forEach(t => t.stop());
                }
                cameraModal.removeClass('show');
            }

            snapBtn.on('click', function () {
                canvas.width = video.videoWidth;
                canvas.height = video.videoHeight;
                canvas.getContext('2d').drawImage(video, 0, 0, canvas.width, canvas.height);
                canvas.toBlob(function (blob) {
                    const file = new File([blob], `capture_${new Date().toISOString()}.jpg`, { type: 'image/jpeg' });
                    const dataTransfer = new DataTransfer();
                    dataTransfer.items.add(file);
                    if (currentFileInputTarget) {
                        currentFileInputTarget[0].files = dataTransfer.files;
                        currentFileInputTarget.trigger('change');
                    }
                }, 'image/jpeg');
                stopCamera();
            });

            cancelCamBtn.on('click', stopCamera);

            // Konfirmasi save
            $('#confirm-save-btn').on('click', submitFormAjax);

            // Inisialisasi
            generateImpNo();
            setDateConstraints();
            initRealTimeValidation();
        });
    </script>
</body>
</html>