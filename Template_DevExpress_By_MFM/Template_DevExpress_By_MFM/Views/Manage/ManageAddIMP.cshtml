        // Fungsi untuk menghitung durasi
        function calculateDuration() {
            const startTime = $('#imp_waktu_berangkat').val();
            const endTime = $('#imp_waktu_kembali').val();

            if (!startTime || !endTime) return 0;

            const startDate = new Date(startTime);
            const endDate = new Date(endTime);
            return (endDate - startDate) / (1000 * 60 * 60);
        }

        // Fungsi untuk validasi field
        function validateField($field) {
            const isFileInput = $field.is('input[type="file"]');
            const isRequired = $field.attr('required') !== undefined;
            const jenisKegiatan = $('#imp_jenis_kegiatan').val();

            if (isFileInput) {
                if (jenisKegiatan === 'Dispensasi') {
                    const hasFile = $field[0].files.length > 0;
                    const $parentCol = $field.closest('.form-col');
                    const $errorSpan = $parentCol.find('.error-message');
                    const $targetInvalid = $field.closest('.file-upload-wrapper');

                    if (isRequired && !hasFile) {
                        $errorSpan.text('Wajib diunggah untuk jenis kegiatan Dispensasi');
                        $targetInvalid.addClass('is-invalid');
                        return false;
                    }
                }
                return true;
            }

            const $parentCol = $field.closest('.form-col');
            const $errorSpan = $parentCol.find('.error-message');
            let hasValue = $field.val() && $.trim($field.val()) !== '';
            let $targetInvalid = $field;

            if (isRequired && !hasValue) {
                $errorSpan.text('Wajib diisi.');
                $targetInvalid.addClass('is-invalid');
                return false;
            }

            return true;
        }

        // Validasi file
        function validateFileInputs() {
            let isFileValid = true;
            const MAX_FILE_SIZE_MB = 2, MAX_BYTES = MAX_FILE_SIZE_MB * 1024 * 1024;
            const ALLOWED_EXT = ['jpg', 'jpeg', 'pdf'];
            const jenisKegiatan = $('#imp_jenis_kegiatan').val();

            $('.conditional-field:visible input[type="file"]').each(function () {
                const file = this.files[0];
                const $input = $(this);
                const $errorSpan = $input.closest('.form-col').find('.error-message');

                $errorSpan.text('');
                $input.closest('.file-upload-wrapper').removeClass('is-invalid');

                if (jenisKegiatan === 'Dispensasi') {
                    if (!file) {
                        isFileValid = false;
                        $errorSpan.text('Wajib diunggah untuk jenis kegiatan Dispensasi');
                        $input.closest('.file-upload-wrapper').addClass('is-invalid');
                        return;
                    }
                }

                if (file) {
                    const extension = file.name.toLowerCase().split('.').pop();
                    if (file.size > MAX_BYTES) {
                        isFileValid = false;
                        $errorSpan.text(`File > ${MAX_FILE_SIZE_MB}MB`);
                        $input.closest('.file-upload-wrapper').addClass('is-invalid');
                    }
                    if (!ALLOWED_EXT.includes(extension)) {
                        isFileValid = false;
                        $errorSpan.text(`Tipe file salah. Hanya .jpg, .jpeg, .pdf yang diperbolehkan.`);
                        $input.closest('.file-upload-wrapper').addClass('is-invalid');
                    }
                }
            });

            return isFileValid;
        }

        // Validasi aturan tanggal berdasarkan waktu izin
        function validateDateRule() {
            const waktuIzin = $('#imp_waktu_izin').val();
            const startTime = $('#imp_waktu_berangkat').val();
            const endTime = $('#imp_waktu_kembali').val();

            if (!startTime || !endTime) return { isValid: true, message: "" };

            const now = new Date();
            const today = new Date(now.getFullYear(), now.getMonth(), now.getDate());
            const tomorrow = new Date(today);
            tomorrow.setDate(tomorrow.getDate() + 1);

            const startDate = new Date(startTime);
            const endDate = new Date(endTime);

            if (waktuIzin === 'Awal jam kerja') {
                // Harus H-1: tanggal berangkat dan kembali harus >= besok
                if (startDate < tomorrow) {
                    return {
                        isValid: false,
                        message: "Untuk waktu izin 'Awal jam kerja', pengajuan harus H-1. Waktu berangkat tidak boleh hari ini atau tanggal yang sudah lewat."
                    };
                }
                if (endDate < tomorrow) {
                    return {
                        isValid: false,
                        message: "Untuk waktu izin 'Awal jam kerja', pengajuan harus H-1. Waktu kembali tidak boleh hari ini atau tanggal yang sudah lewat."
                    };
                }
            } else if (waktuIzin === 'Diantara jam kerja' || waktuIzin === 'Akhir jam kerja') {
                // Boleh H: tanggal berangkat dan kembali boleh hari ini atau besok
                // Tetapi harus >= hari ini
                if (startDate < today) {
                    return {
                        isValid: false,
                        message: "Waktu berangkat tidak boleh tanggal yang sudah lewat."
                    };
                }
                if (endDate < today) {
                    return {
                        isValid: false,
                        message: "Waktu kembali tidak boleh tanggal yang sudah lewat."
                    };
                }

                // Tambahan: jika memilih hari ini, waktu tidak boleh kurang dari waktu sekarang
                if (startDate.toDateString() === today.toDateString() && startDate < now) {
                    return {
                        isValid: false,
                        message: "Waktu berangkat tidak boleh kurang dari waktu sekarang jika memilih hari ini."
                    };
                }
                if (endDate.toDateString() === today.toDateString() && endDate < now) {
                    return {
                        isValid: false,
                        message: "Waktu kembali tidak boleh kurang dari waktu sekarang jika memilih hari ini."
                    };
                }
            }

            return { isValid: true, message: "" };
        }

        // Validasi Shift Putih
        function validateShiftPutihDates() {
            const selectedShift = $('#imp_shift').val();
            const startTime = $('#imp_waktu_berangkat').val();
            const endTime = $('#imp_waktu_kembali').val();

            if (selectedShift !== "Shift Putih" || !startTime || !endTime) {
                return { isValid: true, message: "" };
            }

            const startDate = new Date(startTime);
            const endDate = new Date(endTime);
            const timeDiff = endDate - startDate;
            const dayDiff = timeDiff / (1000 * 60 * 60 * 24);

            if (dayDiff > 1) {
                return {
                    isValid: false,
                    message: "Untuk Shift Putih, waktu kembali maksimal 1 hari setelah waktu berangkat."
                };
            }

            if (endDate <= startDate) {
                return {
                    isValid: false,
                    message: "Untuk Shift Putih, waktu kembali harus setelah waktu berangkat."
                };
            }

            return { isValid: true, message: "" };
        }

        // Validasi shift selain Putih
        function validateSameDayShifts() {
            const selectedShift = $('#imp_shift').val();
            const startTime = $('#imp_waktu_berangkat').val();
            const endTime = $('#imp_waktu_kembali').val();

            if (selectedShift === "Shift Putih" || !startTime || !endTime) {
                return { isValid: true, message: "" };
            }

            const startDate = new Date(startTime);
            const endDate = new Date(endTime);
            const isSameDay = startDate.toDateString() === endDate.toDateString();

            if (!isSameDay) {
                return {
                    isValid: false,
                    message: `Untuk ${selectedShift}, tanggal berangkat dan kembali harus sama.`
                };
            }

            if (endDate <= startDate) {
                return {
                    isValid: false,
                    message: "Waktu kembali harus setelah waktu berangkat."
                };
            }

            return { isValid: true, message: "" };
        }

        // Validasi waktu dalam rentang shift
        function validateTimeInShiftRange() {
            const selectedShift = $('#imp_shift').val();
            const startTime = $('#imp_waktu_berangkat').val();
            const endTime = $('#imp_waktu_kembali').val();
            const waktuIzin = $('#imp_waktu_izin').val();

            if (waktuIzin !== 'Diantara jam kerja' || !selectedShift || !startTime || !endTime) {
                return { isValid: true, message: "" };
            }

            const shiftConfig = shiftSettings[selectedShift];
            const startDate = new Date(startTime);
            const endDate = new Date(endTime);

            if (shiftConfig.sameDay) {
                const startHour = startDate.getHours();
                const endHour = endDate.getHours();

                if (startHour < parseInt(shiftConfig.start.split(':')[0]) || startHour >= parseInt(shiftConfig.end.split(':')[0])) {
                    return {
                        isValid: false,
                        message: `Waktu berangkat harus dalam rentang shift ${selectedShift} (${shiftConfig.start} - ${shiftConfig.end})`
                    };
                }

                if (endHour <= parseInt(shiftConfig.start.split(':')[0]) || endHour > parseInt(shiftConfig.end.split(':')[0])) {
                    return {
                        isValid: false,
                        message: `Waktu kembali harus dalam rentang shift ${selectedShift} (${shiftConfig.start} - ${shiftConfig.end})`
                    };
                }
            } else {
                if (selectedShift === "Shift Putih") {
                    const startHour = startDate.getHours();
                    const endHour = endDate.getHours();

                    if (startHour < 21 || startHour > 23) {
                        return {
                            isValid: false,
                            message: `Waktu berangkat harus dalam rentang Shift Putih (21:00 - 23:59)`
                        };
                    }

                    if (endHour < 0 || endHour > 5) {
                        return {
                            isValid: false,
                            message: `Waktu kembali harus dalam rentang Shift Putih (00:00 - 05:00)`
                        };
                    }
                }
            }

            return { isValid: true, message: "" };
        }

        // Validasi jenis kegiatan vs durasi
        function validateJenisKegiatanVsDurasi() {
            const jenisKegiatan = $('#imp_jenis_kegiatan').val();
            const duration = calculateDuration();

            if (jenisKegiatan === "Dispensasi") {
                return { isValid: true, message: "" };
            }

            if (jenisKegiatan === "Kurang dari 4 jam" && duration > 4) {
                return {
                    isValid: false,
                    message: "Untuk jenis kegiatan 'Kurang dari 4 jam', durasi tidak boleh lebih dari 4 jam. Durasi saat ini: " + duration.toFixed(2) + " jam"
                };
            }

            if (jenisKegiatan === "Lebih dari 4 jam" && duration <= 4) {
                return {
                    isValid: false,
                    message: "Untuk jenis kegiatan 'Lebih dari 4 jam', durasi harus lebih dari 4 jam. Durasi saat ini: " + duration.toFixed(2) + " jam"
                };
            }

            return { isValid: true, message: "" };
        }

