@using DevExtreme.AspNet.Mvc;
@{
    ViewBag.Title = "Tambah Izin Meninggalkan Pekerjaan";
    Layout = null;
}

@helper RenderFileUpload(string id, string label, string name, bool required = false)
{
    <div id="@id" class="form-col conditional-field">
        <div class="file-upload-header">
            <label>
                @label
                @if (required)
                {
                    <span class="text-danger">*</span>
                }
            </label>
            <span class="error-message"></span>
        </div>
        <div class="file-upload-wrapper">
            <!-- Tombol Aksi -->
            <div class="file-upload-actions">
                <button type="button" class="btn-upload" data-action="pick"><i class="fas fa-file-alt"></i> Pilih File</button>
                <button type="button" class="btn-upload" data-action="capture"><i class="fas fa-camera"></i> Kamera</button>
            </div>
            <!-- Input File Asli (disembunyikan) -->
            <input type="file" name="@name" class="file-input-hidden" @(required ? "required" : "") accept=".pdf, .jpg, .jpeg" style="display: none;">
            <!-- Preview Nama File -->
            <div class="file-preview">
                <span class="file-name">Belum ada file dipilih</span>
            </div>
        </div>
        <small>*.jpg, .jpeg, .pdf (Maks. 2MB)</small>
    </div>
}

<!DOCTYPE html>
<html>
<head>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewBag.Title</title>
    <!-- Referensi Font Awesome, jQuery & Select2 -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/select2/4.0.13/css/select2.min.css" rel="stylesheet" />
    <script src="https://ajax.googleapis.com/ajax/libs/jquery/3.6.0/jquery.min.js"></script>

    <style>
        /* Kode CSS yang sama seperti sebelumnya */
        body {
            margin: 0;
            font-family: "Inter", sans-serif;
            -webkit-font-smoothing: antialiased;
            -moz-osx-font-smoothing: grayscale;
            background-color: #FFFFFF;
        }

        .imp-page-container {
            background-color: #FFFFFF
        }

        .blue-section {
            background-color: #2A458A;
            background: linear-gradient(135deg, #1E2D56 0%, #2A4A7B 100%);
            background-size: cover;
            background-position: center;
            background-repeat: no-repeat;
            position: sticky;
            top: 0;
            z-index: 10;
        }

        .blue-section2 {
            background-color: #2A458A;
            padding-bottom: 70px;
            background-image: url('../../../../assets/bg_navbarbot_index_reimbursement.png');
            background-size: cover;
            background-position: center;
            background-repeat: no-repeat
        }

        .page-header-standalone {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 16px;
            position: relative
        }

        .back-button {
            color: #fff;
            font-size: 20px;
            text-decoration: none;
            position: absolute;
            left: 16px;
            top: 50%;
            transform: translateY(-50%);
            z-index: 2
        }

        .page-header-title {
            color: #fff;
            font-size: 18px;
            font-weight: bold;
            margin: 0;
            text-align: center;
            width: 100%;
            z-index: 1
        }

        .form-content-section {
            background-color: #FFFFFF;
            margin-top: -30px;
            padding: 20px 16px 24px 16px
        }

        #impForm.form {
            display: flex;
            flex-direction: column;
            gap: 24px;
            margin: 0;
            padding-top: 24px
        }

        .form-row {
            display: flex;
            flex-wrap: wrap;
            gap: 20px
        }

        .form-col {
            width: calc((100% - 40px) / 3);
            flex-shrink: 0
        }

        .file-upload-row .form-col {
            width: calc((100% - 60px) / 4)
        }

        @@media (max-width:768px) {
            .form-col, .file-upload-row .form-col {
                width: 100%
            }
        }

        .imp-header {
            margin-bottom: 25px
        }

        .form-title {
            font-size: 20px;
            font-weight: 700;
            color: #111827;
            margin: 0 0 5px 0;
            display: flex;
            align-items: center;
            gap: 10px
        }

        .title-icon {
            color: #1B3D97;
            font-size: 20px
        }

        .form-subtitle {
            font-size: 14px;
            color: #6B7280;
            margin: 0
        }

        label {
            font-weight: 600;
            margin-bottom: 8px;
            display: flex;
            align-items: baseline;
            flex-wrap: wrap;
            font-size: 14px;
            color: #374151;
        }

        .text-danger {
            color: #DC2626;
        }

        .error-message {
            color: #DC2626;
            font-size: 12px;
            font-weight: 500;
            font-style: italic;
        }

        small {
            color: #6B7280;
            font-size: 12px;
            margin-top: 4px;
            display: block
        }

        input[type="datetime-local"].form-control.is-invalid {
            border-color: #DC2626 !important;
        }

        .form-control.is-invalid {
            border-color: #DC2626 !important
        }

        select.form-control.is-invalid + .select2-container--default .select2-selection--single {
            border-color: #DC2626 !important;
        }

        .form-control, .select2-container .select2-selection--single {
            width: 100%;
            padding: 10px 12px;
            border: 1px solid #D1D5DB;
            border-radius: 8px;
            font-size: 14px;
            box-sizing: border-box;
            background-color: #ffffff;
            height: 42px !important
        }

            .form-control:disabled, input[readonly] {
                background-color: #F3F4F6;
                cursor: not-allowed;
                color: #6B7280
            }

        .select2-container--default .select2-selection--single .select2-selection__rendered {
            line-height: 20px;
            padding-left: 0;
            color: #1F2937
        }

        .select2-container--default .select2-selection--single .select2-selection__arrow {
            height: 40px
        }

        .select2-dropdown {
            border-radius: 8px;
            border: 1px solid #D1D5DB
        }

        .conditional-field {
            display: none
        }

        .note-box {
            background-color: #EFF6FF;
            padding: 15px;
            border-radius: 8px;
            font-size: 14px;
            color: #1E40AF;
            border-left: 4px solid #3B82F6
        }

            .note-box strong {
                color: #1D4ED8
            }

            .note-box.error {
                margin-top: 25px;
                background-color: #FEF2F2;
                color: #991B1B;
                border-left-color: #EF4444
            }

        .form-actions {
            display: flex;
            justify-content: flex-end;
            gap: 12px
        }

        .btn {
            padding: 10px 28px;
            font-size: 14px;
            font-weight: 600;
            border-radius: 8px;
            border: 1px solid transparent;
            cursor: pointer;
            transition: all .2s
        }

        .btn-batal {
            background-color: #F3F4F6;
            color: #374151;
            border-color: #D1D5DB
        }

            .btn-batal:hover {
                background-color: #E5E7EB
            }

        .btn-simpan {
            background-color: #198754;
            color: white
        }

            .btn-simpan:hover {
                background-color: #15803D
            }

            .btn-simpan:disabled {
                background-color: #86EFAC;
                cursor: not-allowed
            }

        .custom-modal-overlay {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(0,0,0,0.5);
            display: none;
            align-items: center;
            justify-content: center;
            z-index: 1050;
            opacity: 0;
            transition: opacity .2s ease
        }

            .custom-modal-overlay.show {
                display: flex !important;
                opacity: 1
            }

        .custom-modal {
            background: white;
            padding: 30px 35px;
            border-radius: 16px;
            width: 90%;
            max-width: 400px;
            box-shadow: 0 5px 15px rgba(0,0,0,0.2);
            text-align: center;
            transform: scale(0.95);
            transition: transform .2s ease
        }

        .custom-modal-overlay.show .custom-modal {
            transform: scale(1)
        }

        .modal-title {
            font-size: 24px;
            font-weight: bold;
            color: #333;
            margin: 0 0 15px 0
        }

        .modal-text {
            font-size: 16px;
            color: #666;
            margin-bottom: 30px;
            line-height: 1.5;
        }

        .modal-actions {
            display: flex;
            justify-content: center;
            gap: 15px
        }

        .modal-btn {
            flex: 1;
            padding: 12px 20px;
            border-radius: 8px;
            border: none;
            font-size: 16px;
            font-weight: bold;
            cursor: pointer;
            transition: background-color .2s
        }

        .modal-btn-cancel {
            background-color: #E9ECEF;
            color: #495057
        }

            .modal-btn-cancel:hover {
                background-color: #dee2e6
            }

        .modal-btn-confirm {
            background-color: #1F4AB8;
            color: white
        }

            .modal-btn-confirm:hover {
                background-color: #1a3f99
            }

        .modal-icon-success .checkmark {
            width: 80px;
            height: 80px;
            border-radius: 50%;
            display: inline-block;
            stroke-width: 3;
            stroke: #fff;
            stroke-miterlimit: 10;
            box-shadow: inset 0 0 0 #28a745;
            animation: fill .4s ease-in-out .4s forwards,scale .3s ease-in-out .9s both
        }

        .modal-icon-success .checkmark-circle {
            stroke-dasharray: 166;
            stroke-dashoffset: 166;
            stroke-width: 3;
            stroke-miterlimit: 10;
            stroke: #28a745;
            fill: none;
            animation: stroke .6s cubic-bezier(0.65,0,0.45,1) forwards
        }

        .modal-icon-success .checkmark-check {
            transform-origin: 50% 50%;
            stroke-dasharray: 48;
            stroke-dashoffset: 48;
            animation: stroke .3s cubic-bezier(0.65,0,0.45,1) .8s forwards
        }

        @@keyframes stroke {
            100% {
                stroke-dashoffset: 0
            }
        }

        @@keyframes scale {
            0%, 100% {
                transform: none
            }

            50% {
                transform: scale3d(1.1,1.1,1)
            }
        }

        @@keyframes fill {
            100% {
                box-shadow: inset 0 0 0 50px #28a745
            }
        }

        .modal-text-success {
            font-size: 18px;
            color: #495057;
            margin-top: 15px;
            margin-bottom: 25px
        }

        .file-upload-wrapper {
            width: 100%;
        }

        .file-upload-actions {
            display: flex;
            gap: 10px;
            margin-bottom: 8px;
        }

        .btn-upload {
            flex: 1;
            padding: 8px 15px;
            font-size: 14px;
            font-weight: 500;
            border-radius: 6px;
            border: 1px solid #D1D5DB;
            background-color: #F9FAFB;
            color: #374151;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            transition: background-color .2s;
        }

            .btn-upload:hover {
                background-color: #F3F4F6;
            }

        .file-preview {
            font-size: 13px;
            color: #4B5563;
            padding: 8px 12px;
            background-color: #F3F4F6;
            border-radius: 6px;
            border: 1px dashed #D1D5DB;
            text-align: center;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

            .file-preview .file-name {
                font-style: italic;
                color: #6B7280;
            }

                .file-preview .file-name.selected {
                    font-style: normal;
                    font-weight: 500;
                    color: #1F2937;
                }

        .file-upload-wrapper.is-invalid .file-preview {
            border-color: #EF4444;
            border-style: solid;
        }

        /* Style untuk textarea */
        textarea.form-control {
            min-height: 100px;
            resize: vertical;
        }

        .conditional-field {
            display: block !important;
        }

        .file-upload-wrapper {
            display: block !important;
        }

        /* Tambahkan style untuk preview file */
        .file-preview-container {
            background-color: #f8f9fa;
            border-radius: 8px;
            padding: 10px;
            text-align: center;
            border: 1px solid #dee2e6;
        }

        .pdf-preview {
            padding: 15px;
        }

        .pdf-filename {
            margin-top: 8px;
            font-size: 14px;
            color: #495057;
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
        }

        /* Style untuk character count */
        #charCount {
            font-weight: 600;
            font-size: 12px;
        }

        /* Style untuk input yang disabled */
        .form-control:disabled {
            background-color: #f3f4f6;
            color: #6b7280;
            cursor: not-allowed;
        }

        /* Tambahan style untuk aturan H-1 */
        input[type="datetime-local"]:disabled {
            background-color: #F3F4F6;
            color: #6B7280;
            cursor: not-allowed;
        }

        input[type="datetime-local"]::-webkit-calendar-picker-indicator {
            cursor: pointer;
        }

        input[type="datetime-local"]:disabled::-webkit-calendar-picker-indicator {
            display: none;
        }

        /* Style tambahan untuk informasi requirement */
        .file-upload-wrapper.required .file-preview {
            border-color: #3B82F6;
            background-color: #EFF6FF;
        }

        .file-upload-wrapper.required small {
            color: #1E40AF;
            font-weight: 500;
        }

        /* Style untuk header file upload */
        .file-upload-header {
            display: flex;
            align-items: flex-start;
            margin-bottom: 8px;
            flex-wrap: wrap;
            gap: 4px;
        }

            .file-upload-header label {
                display: flex;
                align-items: center;
                gap: 4px;
                margin-bottom: 0;
                flex-shrink: 0;
            }

            .file-upload-header .error-message {
                color: #DC2626;
                font-size: 12px;
                font-weight: 500;
                font-style: italic;
                flex-shrink: 0;
                white-space: nowrap;
            }

        /* Untuk menjaga konsistensi dengan field lainnya */
        .form-col label {
            display: flex;
            align-items: center;
            gap: 4px;
            flex-wrap: wrap;
        }

        .form-col .error-message {
            color: #DC2626;
            font-size: 12px;
            font-weight: 500;
            font-style: italic;
            margin-left: 4px;
            white-space: nowrap;
        }

        /* Atur khusus untuk file upload agar lebih rapi */
        .conditional-field .file-upload-header {
            margin-bottom: 8px;
        }

        .conditional-field label {
            margin-bottom: 0;
        }

        /* Style untuk note box list */
        .note-box ul {
            margin: 5px 0 0 0;
            padding-left: 20px;
        }

        .note-box li {
            margin-bottom: 3px;
        }
    </style>
</head>
<body>
    <div class="imp-page-container">
        <div class="blue-section">
            <div class="page-header-standalone">
                <a href="@Url.Action("ManageIMPKaryawan", "Manage")" class="back-button" aria-label="Kembali">
                    <i class="fas fa-arrow-left"></i>
                </a>
                <h1 class="page-header-title">@ViewBag.Title</h1>
            </div>
        </div>

        <!-- SECTION 2: Form Content Area -->
        <div class="form-content-section">
            <div class="imp-container">

                <div id="dateValidationError" class="note-box error" style="display: none;"></div>

                <form id="impForm" class="form" novalidate enctype="multipart/form-data">
                    @Html.AntiForgeryToken()
                    <input type="hidden" id="imp_created_by" name="imp_created_by" value="@ViewBag.NamaKaryawan" />
                    <!-- Tambahkan field hidden untuk waktu aktual -->
                    <input type="hidden" id="imp_berangkat_aktual" name="imp_berangkat_aktual" />
                    <input type="hidden" id="imp_kembali_aktual" name="imp_kembali_aktual" />

                    <!-- Baris 1: Info Karyawan (Readonly) -->
                    <div class="form-row">
                        <div class="form-col">
                            <label>No. Permohonan IMP</label>
                            <input type="text" id="imp_no_request" name="imp_no_request" class="form-control" value="Memuat nomor..." readonly>
                        </div>
                        <div class="form-col">
                            <label>NPK</label>
                            <input type="text" id="imp_npk" name="imp_npk" class="form-control" value="@ViewBag.Npk" readonly>
                        </div>
                        <div class="form-col">
                            <label>Nama Karyawan</label>
                            <input type="text" id="namaKaryawan" class="form-control" value="@ViewBag.NamaKaryawan" readonly>
                        </div>
                    </div>

                    <!-- Baris 2: Jenis Kegiatan dan Waktu Izin -->
                    <div class="form-row">
                        <div class="form-col">
                            <label>Jenis Kegiatan <span class="text-danger">*</span><span class="error-message"></span></label>
                            <select id="imp_jenis_kegiatan" name="imp_jenis_kegiatan" class="form-control" required>
                                <option value="">Pilih Jenis Kegiatan</option>
                                <option value="Lebih dari 4 jam">Lebih dari 4 jam</option>
                                <option value="Kurang dari 4 jam">Kurang dari 4 jam</option>
                                <option value="Dispensasi">Dispensasi</option>
                            </select>
                        </div>
                        <div class="form-col">
                            <label>Shift <span class="text-danger">*</span><span class="error-message"></span></label>
                            <select id="imp_shift" name="imp_shift" class="form-control" required>
                                <option value="">Pilih Shift</option>
                                <option value="Shift I">Shift I (Jam 07.00 s/d 16.00 WIB)</option>
                                <option value="Shift II">Shift II (Jam 16.00 s/d 24.00 WIB)</option>
                                <option value="Shift III">Shift III (Jam 00.00 s/d 07.00 WIB)</option>
                                <option value="Shift Merah">Shift Merah (Jam 07.00 s/d 16.00 WIB)</option>
                                <option value="Shift Putih">Shift Putih (Jam 21.00 s/d 05.00 WIB)</option>
                            </select>
                        </div>
                        <div class="form-col">
                            <label>Waktu Izin <span class="text-danger">*</span><span class="error-message"></span></label>
                            <select id="imp_waktu_izin" name="imp_waktu_izin" class="form-control" required>
                                <option value="">Pilih Waktu Izin</option>
                                <option value="Awal jam kerja">Awal jam kerja</option>
                                <option value="Diantara jam kerja">Diantara jam kerja</option>
                                <option value="Akhir jam kerja">Akhir jam kerja</option>
                            </select>
                        </div>
                    </div>

                    <!-- Baris 4: DateTimePicker untuk Berangkat dan Kembali -->
                    <div class="form-row">
                        <div class="form-col">
                            <label>Waktu Berangkat (MM/DD/YYYY) <span class="text-danger">*</span><span class="error-message"></span></label>
                            <input type="datetime-local" id="imp_waktu_berangkat" name="imp_waktu_berangkat" class="form-control" required>
                        </div>
                        <div class="form-col">
                            <label>Waktu Kembali (MM/DD/YYYY) <span class="text-danger">*</span><span class="error-message"></span></label>
                            <input type="datetime-local" id="imp_waktu_kembali" name="imp_waktu_kembali" class="form-control" required>
                        </div>
                    </div>

                    <!-- Baris 5: Keterangan (dengan maxlength) dan Berkas Lampiran -->
                    <div class="form-row">
                        <div class="form-col">
                            <label>Keterangan <span class="text-danger">*</span><span class="error-message"></span></label>
                            <textarea id="imp_keterangan" name="imp_keterangan" class="form-control" placeholder="Tambahkan keterangan jika diperlukan" rows="4" maxlength="50" required></textarea>
                            <small><span id="charCount">0</span>/50 karakter</small>
                        </div>
                        @RenderFileUpload("berkasLampiranUpload", "Berkas Lampiran", "imp_berkas_lampiran", false)
                    </div>

                    <!-- Note Box -->
                    <div class="note-box">
                        <strong>Catatan:</strong>
                        <ul>
                            <li>Waktu izin <strong>Awal jam kerja</strong> harus diajukan H-1</li>
                            <li>Waktu izin <strong>Diantara jam kerja</strong> boleh diajukan hari H</li>
                            <li>Waktu izin <strong>Akhir jam kerja</strong> boleh diajukan hari H</li>
                        </ul>
                    </div>

                    <!-- Tombol Aksi -->
                    <div class="form-actions">
                        <button type="button" class="btn btn-batal">Batal</button>
                        <button type="submit" class="btn btn-simpan">Kirim</button>
                    </div>

                </form>
            </div>
        </div>

        <!-- Modals -->
        <div id="confirmModal" class="custom-modal-overlay">
            <div class="custom-modal">
                <h2 class="modal-title">Konfirmasi Pengajuan</h2>
                <p class="modal-text">Apakah Anda yakin data yang dimasukkan sudah benar?</p>
                <div class="modal-actions">
                    <button id="cancel-save-btn" class="modal-btn modal-btn-cancel">Periksa Lagi</button>
                    <button id="confirm-save-btn" class="modal-btn modal-btn-confirm">Ya, Kirim</button>
                </div>
            </div>
        </div>
        <div id="successModal" class="custom-modal-overlay">
            <div class="custom-modal">
                <div class="modal-icon-success">
                    <svg class="checkmark" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 52 52">
                        <circle class="checkmark-circle" cx="26" cy="26" r="25" fill="none" />
                        <path class="checkmark-check" fill="none" d="M14.1 27.2l7.1 7.2 16.7-16.8" />
                    </svg>
                </div>
                <p class="modal-text-success">Pengajuan IMP berhasil disimpan!</p>
                <button id="close-success-btn" class="modal-btn modal-btn-confirm" style="width: 50%; margin: 0 auto;">OK</button>
            </div>
        </div>

        <!-- Modal Kamera -->
        <div id="cameraModal" class="custom-modal-overlay">
            <div class="custom-modal" style="max-width: 640px; padding: 15px; background-color: #333;">
                <video id="cameraFeed" playsinline autoplay style="width: 100%; border-radius: 8px; transform: scaleX(-1);"></video>
                <canvas id="cameraCanvas" style="display:none;"></canvas>
                <div class="modal-actions" style="margin-top: 15px;">
                    <button id="cancelCameraBtn" class="modal-btn modal-btn-cancel">Batal</button>
                    <button id="snapPhotoBtn" class="modal-btn modal-btn-confirm"><i class="fas fa-camera"></i> Ambil Foto</button>
                </div>
            </div>
        </div>
    </div>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/select2/4.0.13/js/select2.min.js"></script>

    <script>
    $(document).ready(function () {
        let currentStream, currentFileInputTarget;
        const cameraModal = $('#cameraModal');
        const video = document.getElementById('cameraFeed');
        const canvas = document.getElementById('cameraCanvas');
        const snapBtn = $('#snapPhotoBtn');
        const cancelCamBtn = $('#cancelCameraBtn');
        const $submitButton = $('.btn-simpan');
        const originalButtonHtml = $submitButton.html();

        // Variabel untuk menyimpan waktu asli berdasarkan shift
        let originalStartTime = null;
        let originalEndTime = null;

        // Konfigurasi shift
        const shiftSettings = {
            "Shift I": { start: "07:00", end: "16:00", sameDay: true, startHour: 7, endHour: 16 },
            "Shift II": { start: "16:00", end: "24:00", sameDay: true, startHour: 16, endHour: 24 },
            "Shift III": { start: "00:00", end: "07:00", sameDay: false, startHour: 0, endHour: 7 },
            "Shift Merah": { start: "07:00", end: "16:00", sameDay: true, startHour: 7, endHour: 16 },
            "Shift Putih": { start: "21:00", end: "05:00", sameDay: false, startHour: 21, endHour: 5 }
        };

        // Inisialisasi Select2
        $('#imp_jenis_kegiatan, #imp_waktu_izin, #imp_shift').select2({
            placeholder: "Pilih opsi",
            allowClear: false,
        });

        // Fungsi untuk mendapatkan tanggal dalam format YYYY-MM-DD
        function getFormattedDate(date) {
            const year = date.getFullYear();
            const month = String(date.getMonth() + 1).padStart(2, '0');
            const day = String(date.getDate()).padStart(2, '0');
            return `${year}-${month}-${day}`;
        }

        // Fungsi untuk mengatur batasan tanggal berdasarkan waktu izin
        function setDateTimeConstraints() {
            const waktuIzin = $('#imp_waktu_izin').val();
            const today = new Date();
            const tomorrow = new Date(today);
            tomorrow.setDate(tomorrow.getDate() + 1);

            let minDate;
            if (waktuIzin === 'Awal jam kerja') {
                // H-1: minimum tanggal besok
                minDate = tomorrow;
            } else {
                // H: boleh hari ini (untuk Diantara dan Akhir jam kerja)
                minDate = today;
            }

            const minYear = minDate.getFullYear();
            const minMonth = String(minDate.getMonth() + 1).padStart(2, '0');
            const minDay = String(minDate.getDate()).padStart(2, '0');
            const minDateString = `${minYear}-${minMonth}-${minDay}T00:00`;
            const maxDate = `${minYear}-12-31T23:59`;

            $('#imp_waktu_berangkat, #imp_waktu_kembali').attr('min', minDateString).attr('max', maxDate);
        }

        // Fungsi untuk mengatur requirement lampiran
        function updateLampiranRequirement() {
            const jenisKegiatan = $('#imp_jenis_kegiatan').val();
            const $lampiranField = $('input[name="imp_berkas_lampiran"]');
            const $lampiranLabel = $('#berkasLampiranUpload label');
            const $requiredStar = $lampiranLabel.find('.text-danger');
            const $fileUploadWrapper = $lampiranField.closest('.file-upload-wrapper');
            const $smallText = $fileUploadWrapper.find('small');

            if (jenisKegiatan === 'Dispensasi') {
                $lampiranField.attr('required', true);
                if ($requiredStar.length === 0) {
                    $lampiranLabel.append('<span class="text-danger">*</span>');
                }
                $fileUploadWrapper.addClass('required');
                $smallText.html('<strong>*.jpg, .jpeg, .pdf (Maks. 2MB) - Wajib untuk Dispensasi</strong>');
            } else {
                $lampiranField.removeAttr('required');
                $requiredStar.remove();
                $fileUploadWrapper.removeClass('required');
                $smallText.text('*.jpg, .jpeg, .pdf (Maks. 2MB)');
            }
        }

        // Fungsi untuk mengatur waktu otomatis berdasarkan aturan H-1/H
        function setAutoDateTime() {
            const selectedShift = $('#imp_shift').val();
            const waktuIzin = $('#imp_waktu_izin').val();
            const shiftConfig = shiftSettings[selectedShift];

            if (!shiftConfig || !waktuIzin) return;

            const today = new Date();
            const tomorrow = new Date(today);
            tomorrow.setDate(tomorrow.getDate() + 1);

            $('#imp_berangkat_aktual').val('');
            $('#imp_kembali_aktual').val('');

            // Tentukan tanggal target berdasarkan aturan H-1/H
            let targetDate;
            if (waktuIzin === 'Awal jam kerja') {
                targetDate = tomorrow; // H-1
            } else {
                targetDate = today; // H (boleh hari ini)
            }

            switch (waktuIzin) {
                case 'Awal jam kerja':
                    let startDateTime = `${getFormattedDate(targetDate)}T${shiftConfig.start}`;
                    const startTime = new Date(startDateTime);
                    const returnTime = new Date(startTime.getTime() + (60 * 60 * 1000));
                    let endDateTime = returnTime.toISOString().slice(0, 16);

                    originalStartTime = shiftConfig.start;
                    originalEndTime = "08:00";

                    $('#imp_waktu_berangkat').val(startDateTime);
                    $('#imp_waktu_kembali').val(endDateTime);
                    $('#imp_berangkat_aktual').val(startDateTime);
                    break;

                case 'Akhir jam kerja':
                    let endDateTime2 = `${getFormattedDate(targetDate)}T${shiftConfig.end}`;
                    if (!shiftConfig.sameDay) {
                        const dayAfterTarget = new Date(targetDate);
                        dayAfterTarget.setDate(dayAfterTarget.getDate() + 1);
                        endDateTime2 = `${getFormattedDate(dayAfterTarget)}T${shiftConfig.end}`;
                    }

                    const endTime = new Date(endDateTime2);
                    const departTime = new Date(endTime.getTime() - (60 * 60 * 1000));
                    let startDateTime2 = departTime.toISOString().slice(0, 16);

                    originalStartTime = "15:00";
                    originalEndTime = shiftConfig.end;

                    $('#imp_waktu_berangkat').val(startDateTime2);
                    $('#imp_waktu_kembali').val(endDateTime2);
                    $('#imp_kembali_aktual').val(endDateTime2);
                    break;

                case 'Diantara jam kerja':
                    if (shiftConfig.sameDay) {
                        const midShiftHour = Math.floor((shiftConfig.startHour + shiftConfig.endHour) / 2);
                        const startMid = `${getFormattedDate(targetDate)}T${String(midShiftHour).padStart(2, '0')}:00`;
                        const endMid = `${getFormattedDate(targetDate)}T${String(midShiftHour + 2).padStart(2, '0')}:00`;

                        originalStartTime = `${String(midShiftHour).padStart(2, '0')}:00`;
                        originalEndTime = `${String(midShiftHour + 2).padStart(2, '0')}:00`;

                        $('#imp_waktu_berangkat').val(startMid);
                        $('#imp_waktu_kembali').val(endMid);
                    }
                    break;
            }
        }

        // Fungsi untuk mengatur state input datetime
        function setDateTimeInputsState() {
            const waktuIzin = $('#imp_waktu_izin').val();
            $('#imp_waktu_berangkat, #imp_waktu_kembali').prop('disabled', false);

            switch (waktuIzin) {
                case 'Awal jam kerja': $('#imp_waktu_berangkat').prop('disabled', true); break;
                case 'Akhir jam kerja': $('#imp_waktu_kembali').prop('disabled', true); break;
            }
        }

        // Fungsi untuk sinkronisasi tanggal
        function handleDateTimeChange(changedField) {
            const selectedShift = $('#imp_shift').val();
            if (selectedShift === "Shift Putih") return;

            const startTime = $('#imp_waktu_berangkat').val();
            const endTime = $('#imp_waktu_kembali').val();

            if (!startTime || !endTime) return;

            const startDate = new Date(startTime);
            const endDate = new Date(endTime);

            if (changedField === 'berangkat') {
                const endFormatted = `${getFormattedDate(startDate)}T${originalEndTime || endTime.split('T')[1]}`;
                $('#imp_waktu_kembali').val(endFormatted);
            } else if (changedField === 'kembali') {
                const startFormatted = `${getFormattedDate(endDate)}T${originalStartTime || startTime.split('T')[1]}`;
                $('#imp_waktu_berangkat').val(startFormatted);
            }
        }

        // Generate nomor IMP
        function generateImpNo() {
