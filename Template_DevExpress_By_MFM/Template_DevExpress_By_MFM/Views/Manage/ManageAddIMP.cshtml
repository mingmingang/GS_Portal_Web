            }
        }

        .imp-header {
            margin-bottom: 25px
        }

        .form-title {
            font-size: 20px;
            font-weight: 700;
            color: #111827;
            margin: 0 0 5px 0;
            display: flex;
            align-items: center;
            gap: 10px
        }

        .title-icon {
            color: #1B3D97;
            font-size: 20px
        }

        .form-subtitle {
            font-size: 14px;
            color: #6B7280;
            margin: 0
        }

        label {
            font-weight: 600;
            margin-bottom: 8px;
            display: flex;
            align-items: baseline;
            flex-wrap: wrap;
            font-size: 14px;
            color: #374151;
        }

        .text-danger {
            color: #DC2626;
