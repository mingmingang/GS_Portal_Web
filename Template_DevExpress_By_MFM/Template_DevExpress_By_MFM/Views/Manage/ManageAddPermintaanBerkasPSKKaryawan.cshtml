@{
    ViewBag.Title = "Tambah Pengajuan Surat Keterangan";
}

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css" />
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.min.css">

<style>
    /* Base form styling yang disesuaikan dengan rancangan UI */
    .form-header {
        border-bottom: 1px solid #dee2e6;
        padding-bottom: 1.5rem;
        margin-bottom: 2rem;
    }

    .form-header h2 {
        font-size: 22px;
        font-weight: 600;
        margin-bottom: 8px;
        display: flex;
        align-items: center;
        gap: 12px;
        color: #1976d2;
    }

    .form-header p {
        color: #6c757d;
        margin-bottom: 0;
        font-size: 14px;
    }

    .form-header .header-icon {
        background: #e3f2fd;
        color: #1976d2;
        width: 40px;
        height: 40px;
        border-radius: 6px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 18px;
    }

    /* Form container dengan layout 2 kolom */
    .form-container {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 40px;
        align-items: start;
    }

    .form-column {
        display: flex;
        flex-direction: column;
        gap: 20px;
    }

    .form-group {
        display: flex;
        flex-direction: column;
        margin-bottom: 0;
    }

    .form-group label {
        margin-bottom: 8px;
        font-weight: 500;
        color: #333;
        font-size: 13px;
    }

    .form-group label.required::after {
        content: " *";
        color: #dc3545;
    }

    /* Form controls yang lebih rapi dan konsisten */
    .form-control {
        height: 45px;
        padding: 12px 16px;
        border: 1px solid #ced4da;
        border-radius: 6px;
        font-size: 14px;
        background-color: #fff;
        transition: all 0.2s ease;
        width: 100%;
    }

    .form-control:focus {
        outline: none;
        border-color: #1976d2;
        box-shadow: 0 0 0 3px rgba(25, 118, 210, 0.1);
    }

    .form-control[readonly] {
        background-color: #f8f9fa;
        color: #6c757d;
        cursor: not-allowed;
    }

    /* Select dropdown styling yang lebih baik */
    select.form-control {
        cursor: pointer;
        appearance: none;
        background-image: url("data:image/svg+xml,%3csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 16 16'%3e%3cpath fill='none' stroke='%23495057' stroke-linecap='round' stroke-linejoin='round' stroke-width='2' d='M2 5l6 6 6-6'/%3e%3c/svg%3e");
        background-repeat: no-repeat;
        background-position: right 12px center;
        background-size: 16px 12px;
        padding-right: 40px;
    }

    /* Textarea styling yang konsisten */
    textarea.form-control {
        height: auto;
        min-height: 140px;
        resize: vertical;
        font-family: inherit;
        line-height: 1.5;
    }

    /* Note box sesuai rancangan UI baru */
    .note-box {
        background-color: rgba(82, 157, 255, 0.2); /* #529DFF dengan opacity 20% */
        border: 1px solid rgba(82, 157, 255, 0.3);
        border-left: 4px solid #529DFF;
        border-radius: 6px;
        padding: 20px;
        margin-top: 25px;
        grid-column: 1 / -1; /* Span kedua kolom */
    }

    .note-box strong {
        display: block;
        margin-bottom: 10px;
        color: #000; /* Teks hitam sesuai rancangan */
        font-size: 14px;
        font-weight: 600;
    }

    .note-box ul {
        list-style: none;
        padding: 0;
        margin: 0;
    }

    .note-box li {
        color: #000; /* Teks hitam sesuai rancangan */
        font-size: 13px;
        line-height: 1.5;
        margin-bottom: 5px;
        position: relative;
        padding-left: 15px;
    }

    .note-box li::before {
        content: "•";
        position: absolute;
        left: 0;
        top: 0;
        font-weight: bold;
    }

    /* Form actions yang rapi */
    .form-actions {
        display: flex;
        justify-content: flex-end;
        gap: 12px;
        margin-top: 3rem;
        padding-top: 1.5rem;
        border-top: 1px solid #dee2e6;
        grid-column: 1 / -1; /* Span kedua kolom */
    }

    /* Button styling yang sesuai dengan rancangan */
    .btn {
        padding: 10px 24px;
        border: none;
        border-radius: 6px;
        font-size: 14px;
        font-weight: 500;
        cursor: pointer;
        transition: all 0.2s ease;
        text-decoration: none;
        display: inline-block;
        text-align: center;
        min-width: 80px;
    }

    .btn-cancel {
        background-color: #6c757d;
        color: white;
    }

    .btn-cancel:hover {
        background-color: #5a6268;
        color: white;
    }

    .btn-preview {
        background-color: #17a2b8;
        color: white;
    }

    .btn-preview:hover {
        background-color: #138496;
        color: white;
    }

    .btn-submit {
        background-color: #28a745;
        color: white;
    }

    .btn-submit:hover {
        background-color: #218838;
        color: white;
    }

    /* Responsive design */
    @@media (max-width: 768px) {
        .form-container {
            grid-template-columns: 1fr;
            gap: 20px;
        }

        .form-actions {
            flex-direction: column;
            gap: 10px;
        }

        .btn {
            width: 100%;
        }
    }
</style>

<div style="padding-top: 4rem;">
    <div class="card p-4 p-md-5">
        <div class="form-header">
            <h2>
                <div class="header-icon">
                    <i class="fas fa-file-alt"></i>
                </div>
                Tambah Pengajuan Surat Keterangan
            </h2>
            <p>Pastikan semua data terisi dengan benar untuk pengajuan surat keterangan.</p>
        </div>

        <form id="psk-form">
            <div class="form-container">
                <!-- Kolom Kiri -->
                <div class="form-column">
                    <div class="form-group">
                        <label for="npk">NPK</label>
                        <input type="text" id="npk" class="form-control" value="@ViewBag.Npk" readonly>
                    </div>

                    <div class="form-group">
                        <label for="alasanPermintaan" class="required">Alasan Permintaan</label>
                        <select id="alasanPermintaan" class="form-control" required>
                            <option value="" disabled selected>Pilih alasan</option>
                            <option value="Surat Keterangan Aktif Kerja">Surat Keterangan Aktif Kerja</option>
                            <option value="Surat Keterangan Aktif Bekerja untuk Keperluan Anak Sekolah">Surat Keterangan Aktif Bekerja untuk Keperluan Anak Sekolah</option>
                            <option value="Pengurusan KPR">Pengurusan KPR</option>
                            <option value="Pengurusan Passport">Pengurusan Passport</option>
                            <option value="Pengurusan Visa">Pengurusan Visa</option>
                        </select>
                    </div>
                </div>

                <!-- Kolom Kanan -->
                <div class="form-column">
                    <div class="form-group">
                        <label for="nama">Nama</label>
                        <input type="text" id="nama" class="form-control" value="@ViewBag.NamaKaryawan" readonly>
                    </div>

                    <div class="form-group">
                        <label for="keterangan" class="required">Keterangan</label>
                        <textarea id="keterangan" class="form-control" rows="5" placeholder="Masukkan Keterangan..." required></textarea>
                    </div>
                </div>

                <!-- Note Box (span kedua kolom) -->
                <div class="note-box">
                    <strong>Note:</strong>
                    <ul>
                        <li>Waktu pembuatan Max 3 Hari</li>
                        <li>Cara pengambilan (diambil melalui admin Seksi masing-masing)</li>
                    </ul>
                </div>

                <!-- Form Actions (span kedua kolom) -->
                <div class="form-actions">
                    <a href="@Url.Action("ManagePermintaanBerkasKaryawan", "Manage")" class="btn btn-cancel">Cancel</a>
                    <button type="button" class="btn btn-preview">Preview</button>
                    <button type="submit" class="btn btn-submit">Submit</button>
                </div>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        $(document).ready(function () {
            // Form submission handler
            $('#psk-form').on('submit', function (e) {
                e.preventDefault();

                const alasanPermintaan = $('#alasanPermintaan').val();
                const keterangan = $('#keterangan').val();

                // Validasi
                if (!alasanPermintaan || !keterangan.trim()) {
                     Swal.fire('Oops...', 'Alasan Permintaan dan Keterangan harus diisi.', 'error');
                     return;
                }

                Swal.fire({
                    title: 'Simpan Data',
                    text: 'Anda yakin ingin menyimpannya?',
                    icon: 'question',
                    showCancelButton: true,
                    confirmButtonColor: '#28a745',
                    cancelButtonColor: '#6c757d',
                    confirmButtonText: 'Simpan',
                    cancelButtonText: 'Tidak',
                    customClass: {
                         confirmButton: 'btn btn-success px-4',
                         cancelButton: 'btn btn-secondary px-4'
                    },
                    buttonsStyling: false
                }).then((result) => {
                    if (result.isConfirmed) {
                        const requestData = {
                            psk_ap: alasanPermintaan,
                            psk_ket: keterangan
                        };

                        $.ajax({
                            url: '/api/PermintaanPskApi',
                            type: 'POST',
                            contentType: 'application/json',
                            data: JSON.stringify(requestData),
                            success: function (response) {
                                Swal.fire({
                                    icon: 'success',
                                    title: 'Berhasil!',
                                    text: 'Data pengajuan Anda telah berhasil disimpan.',
                                    timer: 2000,
                                    showConfirmButton: false
                                }).then(() => {
                                    window.location.href = '@Url.Action("ManagePermintaanBerkasKaryawan", "Manage")';
                                });
                            },
                            error: function (xhr) {
                                Swal.fire('Terjadi Kesalahan', 'Gagal menyimpan data. Silakan coba lagi.', 'error');
                            }
                        });
                    }
                });
            });

            // Preview button handler
            $('.btn-preview').on('click', function() {
                const alasanPermintaan = $('#alasanPermintaan').val();
                const keterangan = $('#keterangan').val();

                if (!alasanPermintaan || !keterangan.trim()) {
                    Swal.fire('Oops...', 'Alasan Permintaan dan Keterangan harus diisi untuk melihat preview.', 'warning');
                    return;
                }

                Swal.fire({
                    title: 'Preview Pengajuan',
                    html: `
                        <div style="text-align: left; padding: 10px;">
                            <p><strong>Alasan Permintaan:</strong><br>${alasanPermintaan}</p>
                            <p><strong>Keterangan:</strong><br><span style="white-space: pre-wrap; background: #f8f9fa; padding: 10px; border-radius: 4px; display: block; margin-top: 5px;">${keterangan}</span></p>
                            <hr style="margin: 15px 0;"/>
                            <p style="font-size: 0.9em; color: #6c757d; font-style: italic;">(Ini adalah tampilan sementara. Pastikan semua detail sudah benar sebelum submit.)</p>
                        </div>
                    `,
                    icon: 'info',
                    confirmButtonText: 'Tutup',
                    width: '600px'
                });
            });
        });
    </script>
}