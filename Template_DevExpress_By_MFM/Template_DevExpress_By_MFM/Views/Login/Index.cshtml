@{
    ViewBag.Title = "Login";
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title - GS Track</title>

    <!-- Mengimpor Font & Ikon -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/icon?family=Material+Icons" rel="stylesheet">

    <!-- Library CSS -->
    <link href="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.min.css" rel="stylesheet">

    <style>
        /* CSS Anda tidak diubah, tetap sama */
        html, body {
            height: 100%;
            margin: 0;
            font-family: 'Poppins', sans-serif;
            overflow: hidden;
        }
        /* ... Sisa CSS Anda ... */
        body {
            background-color: #fff;
            position: relative;
            display: flex;
            justify-content: center;
            align-items: center;
        }

            body::before {
                content: '';
                position: absolute;
                top: -100px;
                right: -90px;
                width: 200px;
                height: 200px;
                border-radius: 100px;
                background-color: #2C4591;
                z-index: -1;
            }

            body::after {
                content: '';
                position: absolute;
                bottom: -120px;
                left: -120px;
                width: 250px;
                height: 250px;
                border-radius: 125px;
                background-color: #2C4591;
                opacity: 0.8;
                z-index: -1;
            }

        .container-wrapper {
            max-width: 450px;
            width: 100%;
            padding: 25px;
            box-sizing: border-box;
            max-height: 100vh;
            overflow-y: auto;
        }

        .image-login {
            width: 100%;
            max-width: 400px;
            height: 200px;
            object-fit: contain;
            display: block;
            margin: 0 auto;
        }

        .title {
            font-size: 60px;
            text-align: center;
            color: #21376A;
            font-weight: 500;
        }

        .title-bold {
            font-weight: 700;
        }

        .subtitle {
            text-align: justify;
            margin: 10px 0;
            font-size: 15px;
            color: #999;
            font-weight: 400;
        }

        .label {
            font-size: 17px;
            font-weight: 600;
            margin-bottom: 5px;
            color: #21376A;
            display: block;
        }

        .input, .input-password, .select-input {
            border: 1px solid #eee;
            border-radius: 10px;
            padding: 12px 15px;
            margin-bottom: 15px;
            font-size: 16px;
            background-color: #fff;
            font-family: 'Poppins', sans-serif;
            font-weight: 500;
            width: 100%;
            box-sizing: border-box;
        }

            .input::placeholder {
                color: #999;
            }

        .row-container {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 25px;
        }

        .remember-me {
            display: flex;
            align-items: center;
        }

        .remember-text {
            color: #21376A;
            font-size: 15px;
            font-weight: 500;
        }

        .forgot-link {
            color: #21376A;
            font-size: 14px;
            font-weight: 700;
            text-decoration: none;
            cursor: pointer;
        }

            .forgot-link:hover {
                text-decoration: underline;
            }

        .login-button {
            background-color: #21376A;
            padding: 14px;
            border-radius: 10px;
            text-align: center;
            box-shadow: 0px 2px 4px rgba(0, 0, 0, 0.1);
            border: none;
            width: 100%;
            cursor: pointer;
            transition: background-color 0.2s ease;
        }

            .login-button:hover {
                background-color: #1a2c52;
            }

        .button-text {
            color: #fff;
            font-size: 16px;
            font-weight: 600;
        }

        .password-wrapper {
            display: flex;
            align-items: center;
            border: 1px solid #eee;
            border-radius: 10px;
            padding-right: 10px;
            margin-bottom: 15px;
            background-color: #fff;
        }

        .input-password {
            flex: 1;
            padding: 12px 15px;
            border: none;
            margin-bottom: 0;
            outline: none;
        }

        .password-toggle-icon {
            cursor: pointer;
            color: #999;
        }

        /* Style tambahan untuk dropdown agar mirip dengan input lain */
        .select-input {
            -webkit-appearance: none;
            -moz-appearance: none;
            appearance: none;
            background-image: url("data:image/svg+xml;charset=UTF8,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='%23999'%3E%3Cpath d='M7 10l5 5 5-5z'/%3E%3C/svg%3E");
            background-repeat: no-repeat;
            background-position: right 15px center;
            background-size: 24px;
        }
    </style>
</head>
<body>
    <!-- Modal untuk Memilih Peran (Tidak Diubah) -->
    <div class="modal fade" id="modal-role-selection" tabindex="-1" role="dialog" aria-labelledby="modalRoleLabel" aria-hidden="true" data-backdrop="static" data-keyboard="false">
        <!-- ... Konten modal ... -->
        <div class="modal-dialog modal-dialog-centered"><div class="modal-content"><div class="modal-header"><h5 class="modal-title mt-0" id="modalRoleLabel">Pilih Peran untuk Sesi Ini</h5></div><div class="modal-body"><p>Anda memiliki beberapa peran yang tersedia. Silakan pilih peran yang ingin Anda gunakan untuk masuk:</p><div id="role-options-container" class="list-group"></div></div></div></div>
    </div>

    <!-- Container Utama Form Login -->
    <div class="container-wrapper">
        <img src="~/Content/images-new/logo_gs_battery_nonbg.png" alt="Login Illustration" class="image-login" />
        <div class="form-content">
            <h1 class="title"><span class="title-bold">GS</span> Track</h1>
            <p class="subtitle">Please enter your NPK, password, and select plant to log in.</p>

            <label for="plant" class="label">Plant</label>
            <select id="plant" name="plant" class="select-input">
                <option value="" disabled selected>Pilih Plant</option>
                <option value="J">Jakarta</option>
                <option value="K">Karawang</option>
                <option value="S">Sunter</option>
                <!-- Tambahkan plant lain di sini jika ada -->
            </select>

            <label for="username" class="label">NPK / Username</label>
            <input type="text" id="username" class="input" placeholder="Masukkan NPK" />

            <label for="userpassword" class="label">Password</label>
            <div class="password-wrapper">
                <input type="password" id="userpassword" class="input-password" placeholder="Masukkan password" />
                <span id="toggle-password" class="material-icons password-toggle-icon">visibility_off</span>
            </div>

            <input type="hidden" id="usertype" value="Local" />

            <div class="row-container">
                <div class="remember-me">
                    <a href="#" class="forgot-link">Remember Me?</a>
                </div>
                <a href="#" class="forgot-link">Forgot Password?</a>
            </div>

            <button id="btn_login" class="login-button">
                <span class="button-text">Log In</span>
            </button>
        </div>
    </div>

    <!-- Library JS (jQuery, Bootstrap JS, SweetAlert2) -->
    <script src="https://code.jquery.com/jquery-3.5.1.min.js"></script>
    <script src="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <script>
    // Variabel global untuk redirect setelah login (jika ada)
    var urlToOrder = false;
    var urlIDOrder = "";

    // Fungsi ini dijalankan setelah halaman HTML selesai dimuat
    $(document).ready(function () {

        // Logika untuk membaca parameter URL saat halaman pertama kali dibuka
        if (location.search != null) {
            var myParam = location.search.split('order=')[1];
            if (myParam != "" && myParam != undefined) {
                urlToOrder = true;
                urlIDOrder = myParam;
            } else {
                urlToOrder = false;
                urlIDOrder = "";
            }
        }

        // --- Logika untuk Tombol Show/Hide Password ---
        $('#toggle-password').click(function () {
            var passwordInput = $('#userpassword');
            var icon = $(this);
            if (passwordInput.attr('type') === 'password') {
                passwordInput.attr('type', 'text');
                icon.text('visibility');
            } else {
                passwordInput.attr('type', 'password');
                icon.text('visibility_off');
            }
        });

        // --- Logika untuk Memicu Login dengan Tombol 'Enter' ---
        function handleEnterKey(event) {
            if (event.keyCode === 13) {
                event.preventDefault();
                $('#btn_login').click();
            }
        }

        // Terapkan listener ke semua input field di form
        $('#plant').on('keyup', handleEnterKey);
        $('#username').on('keyup', handleEnterKey);
        $('#userpassword').on('keyup', handleEnterKey);


        // --- Logika Utama saat Tombol Login di-Klik ---
        $('#btn_login').click(function () {
            // Validasi input
            if ($('#plant').val() == "" || $('#plant').val() == null) {
                Swal.fire('Peringatan', 'Silakan pilih Plant!', 'warning');
                return;
            }
            if ($('#username').val() == "") {
                Swal.fire('Peringatan', 'NPK / Username masih kosong!', 'warning');
                return;
            }
            if ($('#userpassword').val() == "") {
                Swal.fire('Peringatan', 'Password masih kosong!', 'warning');
                return;
            }

            // AJAX call ke controller
            $.ajax({
                type: "POST",
                url: '@Url.Action("PostLogin", "Login")',
                data: {
                    username: $('#username').val(),
                    userpass: $('#userpassword').val(),
                    usertype: $('#usertype').val(),
                    plant: $('#plant').val()
                },
                beforeSend: function () {
                    Swal.fire({ title: 'Mohon Tunggu...', allowOutsideClick: false, didOpen: () => { Swal.showLoading() } });
                },
                success: function (response) {
                    Swal.close();
                    if (response.status === true) {
                        // Jika login sukses...
                        if (response.action === 'CHOOSE_ROLE') {
                            // Tampilkan modal pemilihan peran jika diperlukan
                            var rolesContainer = $('#role-options-container');
                            rolesContainer.empty();
                            response.roles.forEach(function (role) {
                                var button = $('<button type="button" class="list-group-item list-group-item-action role-select-btn"></button>');
                                button.text('Masuk sebagai ' + role);
                                button.attr('data-role', role);
                                rolesContainer.append(button);
                            });
                            $('#modal-role-selection').modal('show');
                        } else if (response.action === 'REDIRECT') {
                            // Langsung redirect jika hanya ada satu peran
                            loginSuccessRedirect();
                        }
                    } else {
                        // Jika login GAGAL...
                        var errorMessage = response.message || 'Gagal untuk masuk. Silakan coba lagi.';
                        var npk = $('#username').val();
                        var plantText = $('#plant option:selected').text();

                        // Tampilkan pesan error spesifik berdasarkan respons API
                        if (response.message && response.message.toLowerCase().includes('not for the selected plant')) {
                            Swal.fire({
                                icon: 'error',
                                title: 'Login Gagal',
                                html: 'NPK <strong>' + npk + '</strong> terdaftar, tetapi tidak aktif di plant <strong>' + plantText + '</strong>.<br/>Silakan periksa kembali pilihan Plant Anda.'
                            });
                        } else if (response.message && response.message.toLowerCase().includes('npk not found')) {
                            Swal.fire('Gagal!', 'NPK yang Anda masukkan tidak ditemukan di sistem.', 'error');
                        } else {
                            Swal.fire('Gagal!', errorMessage, 'error');
                        }
                    }
                },
                error: function (xhr, status, error) {
                    Swal.close();
                    console.error("AJAX Error:", { status: status, error: error, response: xhr.responseText });
                    Swal.fire('Error!', 'Tidak dapat terhubung ke server. Periksa konsol browser untuk detail.', 'error');
                }
            });
        });

    }); // Akhir dari $(document).ready()

    // --- Logika untuk memproses pemilihan peran dari Modal ---
    $(document).on('click', '.role-select-btn', function () {
        var selectedRole = $(this).data('role');
        $('#modal-role-selection').modal('hide');
        $.ajax({
            type: "POST",
            url: '@Url.Action("FinalizeLogin", "Login")',
            data: { selectedRole: selectedRole },
            beforeSend: function () {
                Swal.fire({ title: 'Memproses...', allowOutsideClick: false, didOpen: () => { Swal.showLoading() } });
            },
            success: function (response) {
                Swal.close();
                if (response.status === true && response.status_code === 200) {
                    loginSuccessRedirect();
                } else {
                    Swal.fire('Gagal!', response.message || 'Gagal memfinalisasi login.', 'error');
                }
            },
            error: function (xhr, status, error) {
                Swal.close();
                Swal.fire('Error', 'Terjadi kesalahan saat berkomunikasi dengan server.', 'error');
            }
        });
    });

    // --- Fungsi helper untuk redirect setelah login berhasil ---
    function loginSuccessRedirect() {
        Swal.fire({
            title: 'Berhasil!',
            text: 'Login sukses! Anda akan diarahkan...',
            icon: 'success',
            timer: 1500,
            showConfirmButton: false,
            allowOutsideClick: false
        }).then(function () {
             if (urlToOrder == true && urlIDOrder != undefined) {
                 var link = '@Html.Raw(Url.Action("ListManageOrder", "Manage", new { order = "replaceID" }))';
                 link = link.replace("replaceID", encodeURIComponent(urlIDOrder));
                 window.location.href = link;
             } else {
                 window.location.href = '@Url.Action("Index", "Home")';
             }
        });
    }

    </script>
</body>
</html>